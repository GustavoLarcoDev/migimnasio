@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>You're Invited! - Gus's Birthday Asado 🔥</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&display=swap" rel="stylesheet">
  <style>
    /* ═══════════════════════════════════════════════════════════════════════════
       RESET & VARIABLES
       ═══════════════════════════════════════════════════════════════════════════ */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --coral: #ff6b6b;
      --orange: #ff9f43;
      --yellow: #ffd93d;
      --green: #6bcb77;
      --blue: #4d96ff;
      --purple: #9b59b6;
      --fire: #ff4500;
      --bg-start: #1a0a2e;
      --bg-mid: #2d1b4e;
      --bg-end: #1a0a2e;
      --glass-bg: rgba(255, 255, 255, 0.06);
      --glass-border: rgba(255, 255, 255, 0.1);
      --accent-gradient: linear-gradient(135deg, #ff6b6b, #ff9f43);
      --fire-gradient: linear-gradient(135deg, #ff4500, #ff6b6b, #ffd93d);
      --text-primary: #f0f0f0;
      --text-secondary: rgba(255, 255, 255, 0.6);
      --text-muted: rgba(255, 255, 255, 0.35);
      --radius: 16px;
      --radius-sm: 10px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background: linear-gradient(135deg, var(--bg-start), var(--bg-mid), var(--bg-end));
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       FLOATING PARTICLES / STARS
       ═══════════════════════════════════════════════════════════════════════════ */
    .particles {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
      animation: particleFloat linear infinite;
    }

    .particle:nth-child(1)  { width: 2px; height: 2px; left: 5%;  top: 10%;  animation-duration: 25s; animation-delay: 0s;   opacity: 0.6; }
    .particle:nth-child(2)  { width: 3px; height: 3px; left: 15%; top: 20%;  animation-duration: 20s; animation-delay: -3s;  opacity: 0.4; }
    .particle:nth-child(3)  { width: 1px; height: 1px; left: 25%; top: 50%;  animation-duration: 28s; animation-delay: -5s;  opacity: 0.8; }
    .particle:nth-child(4)  { width: 2px; height: 2px; left: 35%; top: 80%;  animation-duration: 22s; animation-delay: -7s;  opacity: 0.5; }
    .particle:nth-child(5)  { width: 3px; height: 3px; left: 45%; top: 30%;  animation-duration: 30s; animation-delay: -2s;  opacity: 0.3; }
    .particle:nth-child(6)  { width: 1px; height: 1px; left: 55%; top: 60%;  animation-duration: 18s; animation-delay: -8s;  opacity: 0.7; }
    .particle:nth-child(7)  { width: 2px; height: 2px; left: 65%; top: 15%;  animation-duration: 26s; animation-delay: -4s;  opacity: 0.5; }
    .particle:nth-child(8)  { width: 3px; height: 3px; left: 75%; top: 45%;  animation-duration: 21s; animation-delay: -6s;  opacity: 0.4; }
    .particle:nth-child(9)  { width: 1px; height: 1px; left: 85%; top: 70%;  animation-duration: 27s; animation-delay: -1s;  opacity: 0.6; }
    .particle:nth-child(10) { width: 2px; height: 2px; left: 92%; top: 35%;  animation-duration: 23s; animation-delay: -9s;  opacity: 0.3; }
    .particle:nth-child(11) { width: 2px; height: 2px; left: 10%; top: 90%;  animation-duration: 19s; animation-delay: -11s; opacity: 0.5; }
    .particle:nth-child(12) { width: 1px; height: 1px; left: 30%; top: 5%;   animation-duration: 24s; animation-delay: -13s; opacity: 0.7; }
    .particle:nth-child(13) { width: 3px; height: 3px; left: 50%; top: 85%;  animation-duration: 29s; animation-delay: -10s; opacity: 0.3; background: rgba(255, 69, 0, 0.5); }
    .particle:nth-child(14) { width: 1px; height: 1px; left: 70%; top: 55%;  animation-duration: 17s; animation-delay: -12s; opacity: 0.6; }
    .particle:nth-child(15) { width: 2px; height: 2px; left: 88%; top: 25%;  animation-duration: 31s; animation-delay: -14s; opacity: 0.4; }
    .particle:nth-child(16) { width: 2px; height: 2px; left: 3%;  top: 40%;  animation-duration: 20s; animation-delay: -15s; opacity: 0.5; background: rgba(255, 107, 107, 0.5); }
    .particle:nth-child(17) { width: 3px; height: 3px; left: 40%; top: 95%;  animation-duration: 25s; animation-delay: -16s; opacity: 0.3; background: rgba(255, 159, 67, 0.4); }
    .particle:nth-child(18) { width: 1px; height: 1px; left: 60%; top: 8%;   animation-duration: 22s; animation-delay: -17s; opacity: 0.7; background: rgba(255, 217, 61, 0.5); }
    .particle:nth-child(19) { width: 2px; height: 2px; left: 80%; top: 65%;  animation-duration: 28s; animation-delay: -18s; opacity: 0.4; background: rgba(255, 69, 0, 0.4); }
    .particle:nth-child(20) { width: 1px; height: 1px; left: 20%; top: 75%;  animation-duration: 16s; animation-delay: -19s; opacity: 0.6; background: rgba(107, 203, 119, 0.5); }

    @@keyframes particleFloat {
      0%   { transform: translateY(0) translateX(0);     opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateY(-100vh) translateX(50px); opacity: 0; }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       FLOATING EMOJIS
       ═══════════════════════════════════════════════════════════════════════════ */
    .floating-emojis {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .float-emoji {
      position: absolute;
      font-size: 28px;
      animation: emojiFloat linear infinite;
      opacity: 0.15;
    }

    .float-emoji:nth-child(1) { left: 8%;  animation-duration: 18s; animation-delay: 0s;   }
    .float-emoji:nth-child(2) { left: 20%; animation-duration: 22s; animation-delay: -4s;  }
    .float-emoji:nth-child(3) { left: 35%; animation-duration: 15s; animation-delay: -8s;  }
    .float-emoji:nth-child(4) { left: 50%; animation-duration: 20s; animation-delay: -2s;  }
    .float-emoji:nth-child(5) { left: 65%; animation-duration: 17s; animation-delay: -6s;  }
    .float-emoji:nth-child(6) { left: 78%; animation-duration: 24s; animation-delay: -10s; }
    .float-emoji:nth-child(7) { left: 90%; animation-duration: 19s; animation-delay: -3s;  }
    .float-emoji:nth-child(8) { left: 12%; animation-duration: 21s; animation-delay: -12s; }
    .float-emoji:nth-child(9) { left: 42%; animation-duration: 16s; animation-delay: -7s;  }
    .float-emoji:nth-child(10){ left: 73%; animation-duration: 23s; animation-delay: -14s; }

    @@keyframes emojiFloat {
      0%   { transform: translateY(110vh) rotate(0deg);   opacity: 0; }
      10%  { opacity: 0.15; }
      90%  { opacity: 0.15; }
      100% { transform: translateY(-20vh) rotate(360deg);  opacity: 0; }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       PROGRESS BAR
       ═══════════════════════════════════════════════════════════════════════════ */
    .progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 16px 20px;
      background: rgba(26, 10, 46, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .progress-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
    }

    .progress-dot.active {
      background: var(--orange);
      box-shadow: 0 0 12px rgba(255, 159, 67, 0.5);
      transform: scale(1.3);
    }

    .progress-dot.completed {
      background: var(--green);
      box-shadow: 0 0 8px rgba(107, 203, 119, 0.4);
    }

    .progress-line {
      width: 40px;
      height: 2px;
      background: rgba(255, 255, 255, 0.1);
      transition: background 0.4s ease;
    }

    .progress-line.completed {
      background: linear-gradient(90deg, var(--green), var(--orange));
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       STEP CONTAINER & TRANSITIONS
       ═══════════════════════════════════════════════════════════════════════════ */
    .steps-wrapper {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    .step {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 24px 40px;
      position: relative;
      z-index: 1;
      opacity: 0;
      transform: translateX(60px);
      transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                  transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
      display: none;
    }

    .step.active {
      display: flex;
      opacity: 1;
      transform: translateX(0);
    }

    .step.exit-left {
      opacity: 0;
      transform: translateX(-60px);
    }

    .step.enter-right {
      transform: translateX(60px);
    }

    .step.enter-left {
      transform: translateX(-60px);
    }

    .step-content {
      max-width: 700px;
      width: 100%;
      text-align: center;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       TYPOGRAPHY
       ═══════════════════════════════════════════════════════════════════════════ */
    .title-huge {
      font-size: clamp(2.5rem, 8vw, 4.5rem);
      font-weight: 900;
      color: var(--coral);
      line-height: 1.1;
      margin-bottom: 12px;
      text-shadow: 0 0 40px rgba(255, 107, 107, 0.3);
    }

    .title-big {
      font-size: clamp(1.8rem, 5vw, 2.8rem);
      font-weight: 700;
      color: var(--orange);
      margin-bottom: 8px;
      text-shadow: 0 0 30px rgba(255, 159, 67, 0.3);
    }

    .subtitle {
      font-size: clamp(1.1rem, 3vw, 1.4rem);
      font-weight: 400;
      color: var(--text-secondary);
      margin-bottom: 32px;
    }

    .paragraph {
      font-size: 1.05rem;
      font-weight: 300;
      color: var(--text-secondary);
      line-height: 1.7;
      margin-bottom: 40px;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    .small-text {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-top: 8px;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       DATE BADGE
       ═══════════════════════════════════════════════════════════════════════════ */
    .date-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 24px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 600;
      color: var(--yellow);
      margin-bottom: 28px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      animation: badgePulse 3s ease-in-out infinite;
    }

    @@keyframes badgePulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(255, 159, 67, 0.2); }
      50%      { box-shadow: 0 0 20px 4px rgba(255, 159, 67, 0.15); }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       TYPING ANIMATION
       ═══════════════════════════════════════════════════════════════════════════ */
    .typing-text {
      display: inline-block;
      border-right: 2px solid var(--orange);
      padding-right: 4px;
      animation: blink 0.7s step-end infinite;
      white-space: nowrap;
      overflow: hidden;
    }

    @@keyframes blink {
      50% { border-color: transparent; }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       LETTER-BY-LETTER REVEAL
       ═══════════════════════════════════════════════════════════════════════════ */
    .reveal-letter {
      display: inline-block;
      opacity: 0;
      transform: translateY(20px) scale(0.8);
      animation: letterReveal 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      background: var(--accent-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    @@keyframes letterReveal {
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       BUTTONS
       ═══════════════════════════════════════════════════════════════════════════ */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 16px 40px;
      font-family: 'Outfit', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
      position: relative;
      overflow: hidden;
    }

    .btn-primary {
      background: var(--accent-gradient);
      color: #1a1a2e;
      box-shadow: 0 4px 20px rgba(255, 107, 107, 0.3);
    }

    .btn-primary:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 30px rgba(255, 107, 107, 0.5);
    }

    .btn-primary:active {
      transform: scale(0.95);
    }

    .btn-primary:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
      box-shadow: none;
    }

    .btn-glow {
      animation: btnGlow 2.5s ease-in-out infinite;
    }

    @@keyframes btnGlow {
      0%, 100% { box-shadow: 0 4px 20px rgba(255, 107, 107, 0.3); }
      50%      { box-shadow: 0 4px 40px rgba(255, 107, 107, 0.6), 0 0 60px rgba(255, 159, 67, 0.2); }
    }

    .btn-secondary {
      background: var(--glass-bg);
      color: var(--text-primary);
      border: 1px solid var(--glass-border);
      font-weight: 400;
      padding: 12px 28px;
      font-size: 0.95rem;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      transform: scale(1.03);
    }

    .btn-secondary:active {
      transform: scale(0.97);
    }

    .btn-group {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 32px;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       GLASS CARD
       ═══════════════════════════════════════════════════════════════════════════ */
    .glass-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 28px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
      border-color: rgba(255, 255, 255, 0.15);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       INPUT FIELDS
       ═══════════════════════════════════════════════════════════════════════════ */
    .input-group {
      position: relative;
      margin-bottom: 28px;
      text-align: left;
    }

    .input-field {
      width: 100%;
      padding: 16px 0;
      font-family: 'Outfit', sans-serif;
      font-size: 1.1rem;
      font-weight: 400;
      color: var(--text-primary);
      background: transparent;
      border: none;
      border-bottom: 2px solid rgba(255, 255, 255, 0.15);
      outline: none;
      transition: border-color 0.3s ease;
    }

    .input-field::placeholder {
      color: var(--text-muted);
    }

    .input-field:focus {
      border-bottom-color: var(--orange);
    }

    .input-field:focus + .input-line {
      transform: scaleX(1);
    }

    .input-line {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: var(--accent-gradient);
      transform: scaleX(0);
      transform-origin: center;
      transition: transform 0.3s ease;
    }

    textarea.input-field {
      resize: vertical;
      min-height: 80px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: var(--radius-sm);
      padding: 16px;
      margin-top: 8px;
    }

    textarea.input-field:focus {
      border-color: var(--orange);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       TOGGLE SWITCH
       ═══════════════════════════════════════════════════════════════════════════ */
    .toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0;
      gap: 16px;
    }

    .toggle-label {
      font-size: 1.05rem;
      font-weight: 400;
      color: var(--text-secondary);
    }

    .toggle {
      position: relative;
      width: 56px;
      height: 30px;
      flex-shrink: 0;
    }

    .toggle input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 30px;
      transition: 0.3s;
    }

    .toggle-slider::before {
      content: '';
      position: absolute;
      height: 22px;
      width: 22px;
      left: 4px;
      bottom: 4px;
      background: white;
      border-radius: 50%;
      transition: 0.3s;
    }

    .toggle input:checked + .toggle-slider {
      background: var(--accent-gradient);
    }

    .toggle input:checked + .toggle-slider::before {
      transform: translateX(26px);
    }

    .plus-one-section {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.3s ease;
      opacity: 0;
    }

    .plus-one-section.show {
      max-height: 200px;
      opacity: 1;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       MEAT CARDS GRID
       ═══════════════════════════════════════════════════════════════════════════ */
    .food-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin: 28px auto;
      max-width: 500px;
    }

    .food-card {
      background: var(--glass-bg);
      border: 2px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 24px 12px;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-align: center;
      position: relative;
      user-select: none;
    }

    .food-card:hover {
      transform: translateY(-4px);
      border-color: rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
    }

    .food-card.selected {
      border-color: var(--orange);
      background: rgba(255, 159, 67, 0.1);
      box-shadow: 0 0 20px rgba(255, 159, 67, 0.15);
    }

    .food-card.selected .food-check {
      opacity: 1;
      transform: scale(1);
    }

    .food-emoji {
      font-size: 2.8rem;
      margin-bottom: 8px;
      display: block;
    }

    .food-name {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .food-check {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 24px;
      height: 24px;
      background: var(--accent-gradient);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      color: #1a1a2e;
      font-weight: 900;
      opacity: 0;
      transform: scale(0.5);
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       FOOD REACTION TOASTS
       ═══════════════════════════════════════════════════════════════════════════ */
    .reaction-toast {
      position: fixed;
      top: 80px;
      left: 50%;
      transform: translateX(-50%) translateY(-20px) scale(0.8);
      padding: 14px 28px;
      border-radius: 50px;
      font-size: 1rem;
      font-weight: 700;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      white-space: nowrap;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
      animation: reactionPop 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      background: linear-gradient(135deg, var(--orange), var(--coral));
      color: #fff;
    }

    @@keyframes reactionPop {
      0%   { opacity: 0; transform: translateX(-50%) translateY(-20px) scale(0.8); }
      15%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1.1); }
      25%  { transform: translateX(-50%) translateY(0) scale(1); }
      75%  { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
      100% { opacity: 0; transform: translateX(-50%) translateY(-10px) scale(0.9); }
    }

    /* Screen shake */
    @@keyframes screenShake {
      0%, 100% { transform: translateX(0); }
      10%      { transform: translateX(-4px) rotate(-0.5deg); }
      30%      { transform: translateX(4px) rotate(0.5deg); }
      50%      { transform: translateX(-3px); }
      70%      { transform: translateX(3px); }
      90%      { transform: translateX(-1px); }
    }

    .shake {
      animation: screenShake 0.4s ease-out;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       MENU INFO SECTIONS (sides, drinks)
       ═══════════════════════════════════════════════════════════════════════════ */
    .menu-section {
      margin: 24px auto;
      max-width: 500px;
      text-align: left;
    }

    .menu-section-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--orange);
      margin-bottom: 12px;
    }

    .menu-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .menu-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: 50px;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-primary);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .menu-pill .pill-emoji {
      font-size: 1.1rem;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       ZELLE CARD
       ═══════════════════════════════════════════════════════════════════════════ */
    .zelle-card {
      background: linear-gradient(135deg, rgba(255, 159, 67, 0.08), rgba(255, 107, 107, 0.05));
      border: 1px solid rgba(255, 159, 67, 0.2);
      border-radius: var(--radius);
      padding: 24px;
      margin: 28px auto;
      max-width: 500px;
      text-align: center;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .zelle-card .zelle-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--orange);
      margin-bottom: 8px;
    }

    .zelle-card .zelle-number {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--yellow);
      margin: 12px 0;
      letter-spacing: 1px;
    }

    .zelle-card .zelle-note {
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       GIFT CARDS GRID
       ═══════════════════════════════════════════════════════════════════════════ */
    .gift-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 20px;
      margin: 28px 0;
      max-width: 750px;
    }

    .gift-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 24px 16px;
      text-align: center;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .gift-card:not(.claimed):hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.3);
      border-color: rgba(255, 255, 255, 0.15);
    }

    .gift-emoji {
      font-size: 3rem;
      margin-bottom: 12px;
      display: block;
    }

    .gift-photo {
      width: 90px;
      height: 90px;
      border-radius: 14px;
      object-fit: cover;
      margin: 0 auto 12px;
      display: block;
    }

    .gift-name {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 6px;
    }

    .gift-link {
      display: inline-block;
      font-size: 0.8rem;
      color: var(--blue);
      text-decoration: none;
      margin-bottom: 14px;
      transition: color 0.2s;
    }

    .gift-link:hover {
      color: var(--orange);
    }

    .btn-gift {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 22px;
      font-family: 'Outfit', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      background: var(--accent-gradient);
      color: #1a1a2e;
      transition: all 0.3s ease;
    }

    .btn-gift:hover {
      transform: scale(1.05);
      box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
    }

    .btn-gift:active {
      transform: scale(0.95);
    }

    /* Claimed overlay */
    .gift-card.claimed {
      pointer-events: none;
    }

    .gift-card.claimed::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(26, 10, 46, 0.75);
      border-radius: var(--radius);
      z-index: 1;
    }

    .claimed-badge {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-8deg);
      z-index: 2;
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .claimed-badge.taken {
      background: rgba(255, 71, 87, 0.9);
      color: white;
      border: 2px solid rgba(255, 71, 87, 0.5);
    }

    .claimed-badge.yours {
      background: rgba(107, 203, 119, 0.9);
      color: white;
      border: 2px solid rgba(107, 203, 119, 0.5);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       HUG BANNER
       ═══════════════════════════════════════════════════════════════════════════ */
    .hug-banner {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 40px 50px;
      backdrop-filter: blur(30px);
      -webkit-backdrop-filter: blur(30px);
      z-index: 10000;
      text-align: center;
      opacity: 0;
      transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .hug-banner.show {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }

    .hug-banner .hug-main {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--orange);
      margin-bottom: 6px;
    }

    .hug-banner .hug-sub {
      font-size: 8px;
      color: var(--text-muted);
      font-weight: 300;
    }

    .hug-hearts {
      position: absolute;
      pointer-events: none;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      overflow: hidden;
    }

    .hug-heart {
      position: absolute;
      font-size: 20px;
      animation: heartFloat 2s ease-out forwards;
    }

    @@keyframes heartFloat {
      0%   { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(-100px) scale(0.3); }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       CONFETTI
       ═══════════════════════════════════════════════════════════════════════════ */
    .confetti-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 9998;
      overflow: hidden;
    }

    .confetti-piece {
      position: absolute;
      top: -20px;
      animation: confettiFall linear forwards;
    }

    @@keyframes confettiFall {
      0%   { transform: translateY(-20px) rotate(0deg);   opacity: 1; }
      100% { transform: translateY(110vh) rotate(720deg);  opacity: 0.3; }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       SUMMARY CARD
       ═══════════════════════════════════════════════════════════════════════════ */
    .summary-card {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius);
      padding: 28px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      margin: 24px auto;
      max-width: 480px;
      text-align: left;
    }

    .summary-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .summary-row:last-child {
      border-bottom: none;
    }

    .summary-icon {
      font-size: 1.2rem;
      flex-shrink: 0;
      width: 28px;
      text-align: center;
    }

    .summary-label {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin-bottom: 2px;
    }

    .summary-value {
      font-size: 1rem;
      color: var(--text-primary);
      font-weight: 400;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       FOOTER
       ═══════════════════════════════════════════════════════════════════════════ */
    .footer-text {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 40px;
      font-weight: 300;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       LOADING SPINNER
       ═══════════════════════════════════════════════════════════════════════════ */
    .spinner {
      width: 28px;
      height: 28px;
      border: 3px solid rgba(255, 255, 255, 0.1);
      border-top-color: var(--orange);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 20px auto;
    }

    @@keyframes spin {
      to { transform: rotate(360deg); }
    }

    .loading-placeholder {
      text-align: center;
      padding: 40px 0;
      color: var(--text-muted);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       RESPONSIVE
       ═══════════════════════════════════════════════════════════════════════════ */
    @@media (max-width: 600px) {
      .food-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      .gift-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 14px;
      }

      .step {
        padding: 70px 16px 32px;
      }

      .glass-card {
        padding: 20px;
      }

      .btn {
        padding: 14px 32px;
        font-size: 1rem;
      }

      .hug-banner {
        padding: 30px 24px;
        width: 90%;
      }

      .summary-card {
        padding: 20px;
      }

      .progress-line {
        width: 24px;
      }

      .zelle-card {
        padding: 20px;
      }

      .menu-section {
        text-align: center;
      }
    }

    @@media (max-width: 420px) {
      .food-grid {
        grid-template-columns: 1fr 1fr 1fr;
        gap: 8px;
      }

      .food-card {
        padding: 16px 8px;
      }

      .food-emoji {
        font-size: 2.2rem;
      }

      .gift-grid {
        grid-template-columns: 1fr 1fr;
      }

      .menu-pills {
        justify-content: center;
      }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       ERROR DISPLAY
       ═══════════════════════════════════════════════════════════════════════════ */
    .error-msg {
      background: rgba(255, 71, 87, 0.15);
      border: 1px solid rgba(255, 71, 87, 0.3);
      border-radius: var(--radius-sm);
      padding: 12px 18px;
      font-size: 0.9rem;
      color: var(--coral);
      margin: 16px 0;
      display: none;
    }

    .error-msg.show {
      display: block;
      animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
      from { opacity: 0; transform: translateY(-5px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       MESSAGE TEXTAREA SECTION
       ═══════════════════════════════════════════════════════════════════════════ */
    .message-section {
      max-width: 500px;
      margin: 32px auto 0;
      text-align: left;
    }

    .message-section label {
      font-size: 1rem;
      font-weight: 600;
      color: var(--orange);
      display: block;
      margin-bottom: 8px;
    }
  </style>
</head>
<body>

  <!-- Floating Particles -->
  <div class="particles">
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div><div class="particle"></div>
    <div class="particle"></div><div class="particle"></div>
  </div>

  <!-- Floating Emojis -->
  <div class="floating-emojis">
    <div class="float-emoji">&#128293;</div>
    <div class="float-emoji">&#127881;</div>
    <div class="float-emoji">&#129385;</div>
    <div class="float-emoji">&#127866;</div>
    <div class="float-emoji">&#127790;</div>
    <div class="float-emoji">&#127880;</div>
    <div class="float-emoji">&#129395;</div>
    <div class="float-emoji">&#128293;</div>
    <div class="float-emoji">&#127382;</div>
    <div class="float-emoji">&#127867;</div>
  </div>

  <!-- Progress Bar -->
  <div class="progress-bar" id="progressBar">
    <div class="progress-dot active" data-step="1"></div>
    <div class="progress-line" data-after="1"></div>
    <div class="progress-dot" data-step="2"></div>
    <div class="progress-line" data-after="2"></div>
    <div class="progress-dot" data-step="3"></div>
    <div class="progress-line" data-after="3"></div>
    <div class="progress-dot" data-step="4"></div>
    <div class="progress-line" data-after="4"></div>
    <div class="progress-dot" data-step="5"></div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       STEP 1 — THE INVITATION
       ═══════════════════════════════════════════════════════════════════════════ -->
  <div class="step active" id="step1">
    <div class="step-content">
      <h1 class="title-huge" id="revealTitle"></h1>
      <p class="subtitle">
        <span class="typing-text" id="typingSubtitle"></span>
      </p>
      <div class="date-badge">&#128197; Saturday, April 4th &#183; 4:00 PM</div>
      <p class="paragraph">
        Nothing would make me happier than spending my birthday with the people I care about.
        Good food, cold drinks, and even better company. Come eat some fajitas with me &mdash;
        let's fire up the grill and make it a day to remember!
      </p>
      <button class="btn btn-primary btn-glow" onclick="goToStep(2)">
        Count Me In! &#128293;
      </button>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       STEP 2 — NAME & PLUS ONE
       ═══════════════════════════════════════════════════════════════════════════ -->
  <div class="step" id="step2">
    <div class="step-content">
      <h2 class="title-big">First Things First...</h2>
      <p class="subtitle">Who's coming to the party?</p>

      <div class="glass-card" style="text-align: left;">
        <div class="input-group">
          <input type="text" class="input-field" id="guestName" placeholder="What's your name?" autocomplete="name">
          <div class="input-line"></div>
        </div>

        <div class="toggle-row">
          <span class="toggle-label">Bringing a +1? &#128107;</span>
          <label class="toggle">
            <input type="checkbox" id="plusOneToggle">
            <span class="toggle-slider"></span>
          </label>
        </div>

        <div class="plus-one-section" id="plusOneSection">
          <div class="input-group">
            <input type="text" class="input-field" id="plusOneName" placeholder="What's their name?">
            <div class="input-line"></div>
          </div>
          <p class="small-text">The more the merrier! (but seriously, we need to know for the food)</p>
        </div>
      </div>

      <div class="btn-group">
        <button class="btn btn-secondary" onclick="goToStep(1)">&#8592; Back</button>
        <button class="btn btn-primary" id="btnStep2Next" disabled onclick="goToStep(3)">
          Next &#8594;
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       STEP 3 — EL ASADO
       ═══════════════════════════════════════════════════════════════════════════ -->
  <div class="step" id="step3">
    <div class="step-content">
      <h2 class="title-big">El Asado &#128293;</h2>
      <p class="subtitle">Everything's fajita-style! Pick the meats you want so I know how much to buy</p>

      <!-- Meat selection cards -->
      <div class="food-grid" id="foodGrid"></div>

      <!-- Sides -->
      <div class="menu-section">
        <div class="menu-section-title">&#127860; Also On The Table</div>
        <div class="menu-pills">
          <span class="menu-pill"><span class="pill-emoji">&#127834;</span> Patacones / Tostones</span>
          <span class="menu-pill"><span class="pill-emoji">&#129747;</span> Tortillas</span>
          <span class="menu-pill"><span class="pill-emoji">&#129367;</span> Ensalada de Frutas</span>
        </div>
      </div>

      <!-- Drinks -->
      <div class="menu-section">
        <div class="menu-section-title">&#127865; Drinks</div>
        <div class="menu-pills">
          <span class="menu-pill"><span class="pill-emoji">&#127865;</span> Margaritas</span>
          <span class="menu-pill"><span class="pill-emoji">&#127864;</span> Mojitos</span>
          <span class="menu-pill"><span class="pill-emoji">&#127866;</span> Modelos</span>
        </div>
      </div>

      <!-- Dietary Restrictions -->
      <div class="menu-section">
        <label style="font-size: 0.95rem; color: var(--text-secondary); display: block; margin-bottom: 4px;">
          Any dietary restrictions or allergies? Let me know!
        </label>
        <textarea class="input-field" id="dietaryRestrictions" placeholder="E.g., Vegetarian, no pork, allergic to something..."></textarea>
      </div>

      <!-- Zelle Card -->
      <div class="zelle-card">
        <div class="zelle-title">Want to chip in for the meats? &#129385;</div>
        <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 8px;">
          Totally not necessary &mdash; but if you want to help out:
        </p>
        <div class="zelle-number">Zelle: 7372876304</div>
        <div class="zelle-note">
          Your presence is more than enough! I just want everyone to eat well and have a great time &#128293;
        </div>
      </div>

      <div class="btn-group">
        <button class="btn btn-secondary" onclick="goToStep(2)">&#8592; Back</button>
        <button class="btn btn-primary" onclick="goToStep(4)">Next &#8594;</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       STEP 4 — GIFTS + BIRTHDAY MESSAGE
       ═══════════════════════════════════════════════════════════════════════════ -->
  <div class="step" id="step4">
    <div class="step-content">
      <h2 class="title-big">Almost Done! &#127873;</h2>
      <p class="subtitle" style="line-height: 1.6;">
        If you wanna surprise me... here are some ideas &#128521;
      </p>

      <div class="gift-grid" id="giftGrid">
        <div class="loading-placeholder">
          <div class="spinner"></div>
          <p>Loading gift ideas...</p>
        </div>
      </div>

      <div id="giftError" class="error-msg"></div>

      <!-- Birthday Message -->
      <div class="message-section">
        <label>&#127874; Leave me a birthday message!</label>
        <textarea class="input-field" id="birthdayMessage" placeholder="Happy birthday Gus! ..."></textarea>
      </div>

      <div class="btn-group">
        <button class="btn btn-secondary" onclick="goToStep(3)">&#8592; Back</button>
        <button class="btn btn-primary btn-glow" onclick="submitRSVP()">Send RSVP! &#127881;</button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       STEP 5 — CONFIRMATION / THANK YOU
       ═══════════════════════════════════════════════════════════════════════════ -->
  <div class="step" id="step5">
    <div class="step-content">
      <div id="submittingView" style="display: none;">
        <div class="spinner" style="width: 40px; height: 40px; border-width: 4px;"></div>
        <p style="color: var(--text-secondary); margin-top: 16px;">Saving your RSVP...</p>
      </div>

      <div id="successView" style="display: none;">
        <h1 class="title-huge">You're All Set! &#129395;</h1>
        <p class="subtitle">See you on Saturday, April 4th at 4 PM! &#128293;</p>

        <div class="summary-card" id="summaryCard">
          <!-- Filled dynamically -->
        </div>

        <p class="paragraph" style="margin-top: 28px;">
          Gus is already fired up to see you. Don't be late... the fajitas won't wait &#128527;&#128293;
        </p>

        <p class="footer-text">Made with &#10084;&#65039; and way too much code</p>
      </div>

      <div id="submitError" class="error-msg" style="max-width: 480px; margin: 0 auto;"></div>
    </div>
  </div>

  <!-- Hug Banner (global) -->
  <div class="hug-banner" id="hugBanner">
    <div class="hug-hearts" id="hugHearts"></div>
    <div style="font-size: 3rem; margin-bottom: 12px;">&#129303;</div>
    <div class="hug-main">You are so sweet</div>
    <div class="hug-sub">(and cheap as s***...)</div>
  </div>

  <!-- Confetti Container -->
  <div class="confetti-container" id="confettiContainer"></div>

  <script>
    /* ═══════════════════════════════════════════════════════════════════════════
       STATE
       ═══════════════════════════════════════════════════════════════════════════ */
    let currentStep = 1;
    let gifts = [];
    let selectedFoods = new Set();
    let claimedByMe = new Set();
    let hugBannerVisible = false;

    const MENU_MEATS = [
      { id: 'carne-asada', name: 'Carne Asada', emoji: '\u{1F969}', reaction: 'Great choice! \u{1F525}\u{1F969}' },
      { id: 'pollo-asado', name: 'Pollo Asado', emoji: '\u{1F357}', reaction: 'Pollo gang! \u{1F357}\u{1F525}' },
      { id: 'chorizo',     name: 'Chorizo Asado', emoji: '\u{1F32D}', reaction: '\u00A1Que rico! \u{1F32D}\u{1F525}' },
    ];

    /* ═══════════════════════════════════════════════════════════════════════════
       INITIALIZATION
       ═══════════════════════════════════════════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', () => {
      animateTitle();
      animateSubtitle();
      renderFoods();
      loadGifts();
      setupNameInput();
      setupPlusOneToggle();
    });

    /* ═══════════════════════════════════════════════════════════════════════════
       LETTER-BY-LETTER TITLE REVEAL
       ═══════════════════════════════════════════════════════════════════════════ */
    function animateTitle() {
      const title = "You're Invited!";
      const container = document.getElementById('revealTitle');
      container.innerHTML = '';

      title.split('').forEach((char, i) => {
        const span = document.createElement('span');
        span.className = 'reveal-letter';
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.animationDelay = `${i * 0.05 + 0.3}s`;
        container.appendChild(span);
      });
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       TYPING SUBTITLE EFFECT
       ═══════════════════════════════════════════════════════════════════════════ */
    function animateSubtitle() {
      const text = "to Gus's Birthday Asado \u{1F525}";
      const el = document.getElementById('typingSubtitle');
      el.textContent = '';
      let i = 0;

      const delay = 1200;
      setTimeout(() => {
        const interval = setInterval(() => {
          el.textContent = text.slice(0, i + 1);
          i++;
          if (i >= text.length) {
            clearInterval(interval);
            setTimeout(() => { el.style.borderRight = 'none'; }, 1500);
          }
        }, 55);
      }, delay);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       STEP NAVIGATION
       ═══════════════════════════════════════════════════════════════════════════ */
    function goToStep(step) {
      if (step === currentStep) return;
      if (step > 2 && currentStep === 2) {
        const name = document.getElementById('guestName').value.trim();
        if (!name) {
          document.getElementById('guestName').focus();
          return;
        }
      }

      const goingForward = step > currentStep;
      const oldStep = document.getElementById(`step${currentStep}`);
      const newStep = document.getElementById(`step${step}`);

      updateProgress(step);

      oldStep.classList.add(goingForward ? 'exit-left' : 'enter-right');

      setTimeout(() => {
        oldStep.classList.remove('active', 'exit-left', 'enter-right');
        oldStep.style.display = 'none';

        newStep.style.display = 'flex';
        newStep.classList.add(goingForward ? 'enter-right' : 'enter-left');

        newStep.offsetHeight;

        requestAnimationFrame(() => {
          newStep.classList.remove('enter-right', 'enter-left');
          newStep.classList.add('active');
        });

        currentStep = step;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }, 250);
    }

    function updateProgress(step) {
      const dots = document.querySelectorAll('.progress-dot');
      const lines = document.querySelectorAll('.progress-line');

      dots.forEach((dot, i) => {
        const s = i + 1;
        dot.classList.remove('active', 'completed');
        if (s === step) dot.classList.add('active');
        else if (s < step) dot.classList.add('completed');
      });

      lines.forEach((line, i) => {
        const afterStep = i + 1;
        line.classList.toggle('completed', afterStep < step);
      });
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       NAME INPUT & PLUS ONE TOGGLE
       ═══════════════════════════════════════════════════════════════════════════ */
    function setupNameInput() {
      const input = document.getElementById('guestName');
      const btn = document.getElementById('btnStep2Next');

      input.addEventListener('input', () => {
        btn.disabled = !input.value.trim();
      });

      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter' && input.value.trim()) goToStep(3);
      });
    }

    function setupPlusOneToggle() {
      const toggle = document.getElementById('plusOneToggle');
      const section = document.getElementById('plusOneSection');

      toggle.addEventListener('change', () => {
        section.classList.toggle('show', toggle.checked);
        if (toggle.checked) {
          setTimeout(() => document.getElementById('plusOneName').focus(), 350);
        }
      });
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       RENDER MEAT CARDS
       ═══════════════════════════════════════════════════════════════════════════ */
    function renderFoods() {
      const grid = document.getElementById('foodGrid');
      grid.innerHTML = MENU_MEATS.map(meat => `
        <div class="food-card" data-food-id="${meat.id}" data-food-name="${meat.name}" data-reaction="${escAttr(meat.reaction)}" onclick="toggleFood(this)">
          <div class="food-check">\u2713</div>
          <span class="food-emoji">${meat.emoji}</span>
          <div class="food-name">${escHtml(meat.name)}</div>
        </div>
      `).join('');
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       TOGGLE FOOD SELECTION
       ═══════════════════════════════════════════════════════════════════════════ */
    function toggleFood(card) {
      const id = card.dataset.foodId;

      if (selectedFoods.has(id)) {
        selectedFoods.delete(id);
        card.classList.remove('selected');
      } else {
        selectedFoods.add(id);
        card.classList.add('selected');
        showFoodReaction(card.dataset.reaction);
      }
    }

    function showFoodReaction(text) {
      if (!text) return;

      const toast = document.createElement('div');
      toast.className = 'reaction-toast';
      toast.textContent = text;
      document.body.appendChild(toast);

      document.body.classList.add('shake');
      setTimeout(() => document.body.classList.remove('shake'), 400);
      setTimeout(() => toast.remove(), 2600);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       LOAD GIFTS
       ═══════════════════════════════════════════════════════════════════════════ */
    async function loadGifts() {
      try {
        const res = await fetch('/birthday/api/gifts');
        if (!res.ok) throw new Error('Failed to load gifts');
        gifts = await res.json();
        renderGifts();
      } catch (err) {
        document.getElementById('giftGrid').innerHTML =
          '<p style="color: var(--coral); grid-column: 1/-1;">Could not load gift ideas. Please refresh the page.</p>';
      }
    }

    function renderGifts() {
      const grid = document.getElementById('giftGrid');

      let html = gifts.map(gift => {
        const isClaimed = gift.claimed;
        const isClaimedByMe = claimedByMe.has(gift.id);
        const photoHtml = gift.photo
          ? `<img class="gift-photo" src="${gift.photo}" alt="${escHtml(gift.name)}">`
          : `<span class="gift-emoji">\u{1F381}</span>`;
        const linkHtml = gift.link
          ? `<a class="gift-link" href="${escAttr(gift.link)}" target="_blank" rel="noopener">View \u2192</a><br>`
          : '';

        let badgeHtml = '';
        let cardClass = 'gift-card';

        if (isClaimedByMe) {
          cardClass += ' claimed';
          badgeHtml = '<div class="claimed-badge yours">Claimed by you \u2713</div>';
        } else if (isClaimed) {
          cardClass += ' claimed';
          badgeHtml = '<div class="claimed-badge taken">Sorry, too late! \u{1F605}</div>';
        }

        const btnHtml = (!isClaimed && !isClaimedByMe)
          ? `<button class="btn-gift" onclick="claimGift('${gift.id}', event)">I'll Get This!</button>`
          : '';

        return `
          <div class="${cardClass}" id="gift-${gift.id}">
            ${badgeHtml}
            ${photoHtml}
            <div class="gift-name">${escHtml(gift.name)}</div>
            ${linkHtml}
            ${btnHtml}
          </div>
        `;
      }).join('');

      // Add the HUG card at the end
      html += `
        <div class="gift-card" id="gift-hug" style="cursor: pointer;" onclick="claimHug()">
          <span class="gift-emoji">\u{1F917}</span>
          <div class="gift-name">A Hug</div>
          <button class="btn-gift" onclick="claimHug(); event.stopPropagation();">I'll Give This!</button>
        </div>
      `;

      grid.innerHTML = html;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       CLAIM GIFT
       ═══════════════════════════════════════════════════════════════════════════ */
    async function claimGift(giftId, e) {
      if (e) e.stopPropagation();
      const errEl = document.getElementById('giftError');
      errEl.classList.remove('show');

      try {
        const res = await fetch('/birthday/api/gifts/claim', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ giftId })
        });

        if (res.status === 409) {
          const updatedRes = await fetch('/birthday/api/gifts');
          gifts = await updatedRes.json();
          renderGifts();
          errEl.textContent = "Someone just claimed that gift! They beat you to it \u{1F605}";
          errEl.classList.add('show');
          return;
        }

        if (!res.ok) throw new Error('Failed to claim gift');

        claimedByMe.add(giftId);
        const gift = gifts.find(g => g.id === giftId);
        if (gift) gift.claimed = true;
        renderGifts();

      } catch (err) {
        errEl.textContent = 'Something went wrong. Please try again.';
        errEl.classList.add('show');
      }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       CLAIM HUG
       ═══════════════════════════════════════════════════════════════════════════ */
    function claimHug() {
      if (hugBannerVisible) return;
      hugBannerVisible = true;

      const banner = document.getElementById('hugBanner');
      banner.classList.add('show');

      const heartsContainer = document.getElementById('hugHearts');
      heartsContainer.innerHTML = '';
      for (let i = 0; i < 12; i++) {
        const heart = document.createElement('div');
        heart.className = 'hug-heart';
        heart.textContent = '\u2764\uFE0F';
        heart.style.left = Math.random() * 80 + 10 + '%';
        heart.style.top = Math.random() * 60 + 20 + '%';
        heart.style.animationDelay = Math.random() * 1 + 's';
        heart.style.fontSize = (14 + Math.random() * 14) + 'px';
        heartsContainer.appendChild(heart);
      }

      setTimeout(() => {
        banner.classList.remove('show');
        hugBannerVisible = false;
      }, 4000);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       SUBMIT RSVP
       ═══════════════════════════════════════════════════════════════════════════ */
    async function submitRSVP() {
      const name = document.getElementById('guestName').value.trim();
      const plusOne = document.getElementById('plusOneToggle').checked;
      const plusOneName = document.getElementById('plusOneName').value.trim();
      const extra = document.getElementById('dietaryRestrictions').value.trim();
      const message = document.getElementById('birthdayMessage').value.trim();
      const errEl = document.getElementById('submitError');
      errEl.classList.remove('show');

      if (!name) {
        goToStep(2);
        return;
      }

      // Get selected meat names
      const selectedFoodNames = MENU_MEATS
        .filter(m => selectedFoods.has(m.id))
        .map(m => m.name);

      // Show step 5 with loading
      document.getElementById('submittingView').style.display = 'block';
      document.getElementById('successView').style.display = 'none';
      document.getElementById('submitError').classList.remove('show');
      goToStep(5);

      await new Promise(r => setTimeout(r, 400));

      try {
        const res = await fetch('/birthday/api/rsvp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            plusOne,
            plusOneName: plusOne ? plusOneName : null,
            foods: selectedFoodNames,
            extra: extra || null,
            message: message || null
          })
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || 'Failed to submit RSVP');
        }

        document.getElementById('submittingView').style.display = 'none';
        document.getElementById('successView').style.display = 'block';

        buildSummary(name, plusOne, plusOneName, selectedFoodNames, extra, message);

        launchConfetti();

      } catch (err) {
        document.getElementById('submittingView').style.display = 'none';
        errEl.textContent = err.message || 'Something went wrong. Please try again.';
        errEl.classList.add('show');
      }
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       BUILD SUMMARY CARD
       ═══════════════════════════════════════════════════════════════════════════ */
    function buildSummary(name, plusOne, plusOneName, foodNames, extra, message) {
      const card = document.getElementById('summaryCard');
      let rows = '';

      rows += summaryRow('\u{1F44B}', 'Guest', name);
      if (plusOne) {
        rows += summaryRow('\u{1F46B}', '+1', plusOneName || 'Yes (name not provided)');
      }
      if (foodNames.length > 0) {
        rows += summaryRow('\u{1F969}', 'Meats', foodNames.join(', '));
      }
      if (extra) {
        rows += summaryRow('\u{26A0}\uFE0F', 'Dietary', extra);
      }
      if (message) {
        rows += summaryRow('\u{1F4AC}', 'Message', message);
      }
      if (claimedByMe.size > 0) {
        const claimedNames = gifts.filter(g => claimedByMe.has(g.id)).map(g => g.name);
        if (claimedNames.length > 0) {
          rows += summaryRow('\u{1F381}', 'Gift', claimedNames.join(', '));
        }
      }

      card.innerHTML = rows;
    }

    function summaryRow(icon, label, value) {
      return `
        <div class="summary-row">
          <span class="summary-icon">${icon}</span>
          <div>
            <div class="summary-label">${label}</div>
            <div class="summary-value">${escHtml(value)}</div>
          </div>
        </div>
      `;
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       CONFETTI
       ═══════════════════════════════════════════════════════════════════════════ */
    function launchConfetti() {
      const container = document.getElementById('confettiContainer');
      container.innerHTML = '';

      const colors = ['#ff6b6b', '#ff9f43', '#ffd93d', '#6bcb77', '#4d96ff', '#ff4500', '#feca57', '#00d2d3', '#ff6348', '#a29bfe'];
      const shapes = ['square', 'circle', 'strip'];

      for (let i = 0; i < 60; i++) {
        const piece = document.createElement('div');
        piece.className = 'confetti-piece';

        const color = colors[Math.floor(Math.random() * colors.length)];
        const shape = shapes[Math.floor(Math.random() * shapes.length)];
        const size = 6 + Math.random() * 10;
        const left = Math.random() * 100;
        const duration = 2.5 + Math.random() * 3;
        const delay = Math.random() * 1.5;

        piece.style.left = left + '%';
        piece.style.backgroundColor = color;
        piece.style.animationDuration = duration + 's';
        piece.style.animationDelay = delay + 's';
        piece.style.opacity = 0.8 + Math.random() * 0.2;

        if (shape === 'circle') {
          piece.style.width = size + 'px';
          piece.style.height = size + 'px';
          piece.style.borderRadius = '50%';
        } else if (shape === 'strip') {
          piece.style.width = (size * 0.4) + 'px';
          piece.style.height = (size * 1.8) + 'px';
          piece.style.borderRadius = '2px';
        } else {
          piece.style.width = size + 'px';
          piece.style.height = size + 'px';
          piece.style.borderRadius = '2px';
        }

        container.appendChild(piece);
      }

      setTimeout(() => { container.innerHTML = ''; }, 7000);
    }

    /* ═══════════════════════════════════════════════════════════════════════════
       UTILITIES
       ═══════════════════════════════════════════════════════════════════════════ */
    function escHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    function escAttr(str) {
      return str.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#039;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
  </script>
</body>
</html>
