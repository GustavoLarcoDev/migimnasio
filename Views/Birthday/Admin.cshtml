@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Party Command Center</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --coral: #ff6b6b;
      --orange: #ff9f43;
      --yellow: #ffd93d;
      --green: #6bcb77;
      --blue: #4d96ff;
      --bg-start: #1a0a2e;
      --bg-mid: #2d1b4e;
      --bg-end: #1a0a2e;
      --glass-bg: rgba(255, 255, 255, 0.06);
      --glass-border: rgba(255, 255, 255, 0.12);
      --glass-hover: rgba(255, 255, 255, 0.1);
      --text-primary: #f0f0f0;
      --text-secondary: rgba(255, 255, 255, 0.6);
      --text-muted: rgba(255, 255, 255, 0.35);
      --danger: #ff4757;
      --radius: 16px;
      --radius-sm: 10px;
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
      font-family: 'Outfit', sans-serif;
      background: linear-gradient(135deg, var(--bg-start), var(--bg-mid), var(--bg-end));
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Toast */
    #toast-container { position: fixed; top: 24px; right: 24px; z-index: 10000; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
    .toast { pointer-events: auto; padding: 14px 22px; border-radius: var(--radius-sm); font-size: 14px; font-weight: 500; backdrop-filter: blur(20px); border: 1px solid var(--glass-border); animation: toastIn 0.4s ease, toastOut 0.4s ease forwards; animation-delay: 0s, 3s; max-width: 380px; box-shadow: 0 8px 32px rgba(0,0,0,0.3); }
    .toast.success { background: rgba(107,203,119,0.2); border-color: var(--green); color: var(--green); }
    .toast.error { background: rgba(255,71,87,0.2); border-color: var(--danger); color: var(--danger); }
    .toast.info { background: rgba(77,150,255,0.2); border-color: var(--blue); color: var(--blue); }
    @@keyframes toastIn { from { opacity: 0; transform: translateX(60px); } to { opacity: 1; transform: translateX(0); } }
    @@keyframes toastOut { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(60px); } }

    .btn { padding: 13px 28px; border: none; border-radius: var(--radius-sm); font-family: 'Outfit', sans-serif; font-size: 15px; font-weight: 600; cursor: pointer; transition: var(--transition); display: inline-flex; align-items: center; gap: 8px; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-primary { background: linear-gradient(135deg, var(--orange), var(--coral)); color: #fff; width: 100%; }
    .btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(255,107,107,0.3); }
    .btn-accent { background: linear-gradient(135deg, var(--blue), #6db3ff); color: #fff; }
    .btn-accent:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(77,150,255,0.3); }
    .btn-danger { background: rgba(255,71,87,0.15); color: var(--danger); border: 1px solid rgba(255,71,87,0.3); }
    .btn-danger:hover:not(:disabled) { background: rgba(255,71,87,0.25); }
    .btn-sm { padding: 8px 16px; font-size: 13px; border-radius: 8px; }
    .btn-ghost { background: var(--glass-bg); color: var(--text-secondary); border: 1px solid var(--glass-border); }
    .btn-ghost:hover:not(:disabled) { background: var(--glass-hover); color: var(--text-primary); }

    /* Dashboard */
    #dashboard { display: block; max-width: 1200px; margin: 0 auto; padding: 24px 20px 60px; animation: fadeUp 0.5s ease; }
    .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; flex-wrap: wrap; gap: 16px; }
    .header h1 { font-size: 28px; font-weight: 800; }
    .header h1 span { background: linear-gradient(135deg, var(--orange), var(--coral)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .header-subtitle { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; font-style: italic; }
    .btn-logout { background: rgba(255,255,255,0.06); color: var(--text-secondary); border: 1px solid var(--glass-border); padding: 10px 20px; border-radius: var(--radius-sm); font-family: 'Outfit',sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; transition: var(--transition); }
    .btn-logout:hover { background: rgba(255,71,87,0.15); color: var(--danger); border-color: rgba(255,71,87,0.3); }

    /* Tabs */
    .tabs { display: flex; gap: 4px; background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 5px; margin-bottom: 28px; overflow-x: auto; }
    .tab-btn { flex: 1; padding: 12px 20px; background: none; border: none; border-radius: 12px; color: var(--text-secondary); font-family: 'Outfit',sans-serif; font-size: 14px; font-weight: 500; cursor: pointer; transition: var(--transition); white-space: nowrap; }
    .tab-btn:hover { color: var(--text-primary); background: rgba(255,255,255,0.04); }
    .tab-btn.active { background: rgba(255,255,255,0.1); color: var(--text-primary); font-weight: 600; box-shadow: 0 2px 12px rgba(0,0,0,0.2); }
    .tab-content { display: none; animation: fadeUp 0.35s ease; }
    .tab-content.active { display: block; }

    /* Stats Cards */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 28px; }
    .stat-card { background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 24px; transition: var(--transition); animation: fadeUp 0.5s ease backwards; }
    .stat-card:nth-child(1) { animation-delay: 0.05s; }
    .stat-card:nth-child(2) { animation-delay: 0.1s; }
    .stat-card:nth-child(3) { animation-delay: 0.15s; }
    .stat-card:nth-child(4) { animation-delay: 0.2s; }
    .stat-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.2); box-shadow: 0 12px 40px rgba(0,0,0,0.2); }
    .stat-card .stat-icon { font-size: 32px; margin-bottom: 12px; }
    .stat-card .stat-value { font-size: 36px; font-weight: 800; line-height: 1; margin-bottom: 6px; }
    .stat-card .stat-label { font-size: 13px; color: var(--text-secondary); font-weight: 400; }
    .stat-card .stat-joke { font-size: 10px; color: var(--text-muted); font-style: italic; margin-top: 4px; }
    .stat-card:nth-child(1) .stat-value { color: var(--coral); }
    .stat-card:nth-child(2) .stat-value { color: var(--yellow); }
    .stat-card:nth-child(3) .stat-value { color: var(--green); }
    .stat-card:nth-child(4) .stat-value { color: var(--orange); }

    /* Meat Chart */
    .chart-section { background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 28px; margin-bottom: 28px; }
    .chart-section h3 { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
    .chart-section .chart-joke { font-size: 11px; color: var(--text-muted); font-style: italic; margin-bottom: 20px; }
    .chart-bar-row { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
    .chart-bar-label { width: 140px; font-size: 13px; font-weight: 500; text-align: right; flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .chart-bar-track { flex: 1; height: 28px; background: rgba(255,255,255,0.04); border-radius: 8px; overflow: hidden; position: relative; }
    .chart-bar-fill { height: 100%; border-radius: 8px; transition: width 0.8s cubic-bezier(0.4,0,0.2,1); display: flex; align-items: center; padding-left: 10px; font-size: 12px; font-weight: 600; min-width: 36px; background: linear-gradient(90deg, var(--orange), var(--coral)); }

    /* Messages Section */
    .messages-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-bottom: 28px; }
    .message-card { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 20px; transition: var(--transition); }
    .message-card:hover { transform: translateY(-3px); border-color: rgba(255,255,255,0.2); box-shadow: 0 8px 28px rgba(0,0,0,0.2); }
    .message-card .msg-name { font-size: 14px; font-weight: 600; color: var(--orange); margin-bottom: 8px; }
    .message-card .msg-text { font-size: 14px; color: var(--text-secondary); line-height: 1.5; font-style: italic; }

    /* Dietary alerts */
    .dietary-section { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 24px; margin-bottom: 28px; }
    .dietary-section h3 { font-size: 18px; font-weight: 600; margin-bottom: 6px; }
    .dietary-section .dietary-joke { font-size: 11px; color: var(--text-muted); font-style: italic; margin-bottom: 16px; }
    .dietary-item { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .dietary-item:last-child { border-bottom: none; }
    .dietary-item .di-name { font-size: 13px; font-weight: 600; color: var(--yellow); min-width: 100px; }
    .dietary-item .di-text { font-size: 13px; color: var(--text-secondary); }

    /* Glass Table */
    .glass-card { background: var(--glass-bg); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: var(--radius); overflow: hidden; }
    .card-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--glass-border); flex-wrap: wrap; gap: 12px; }
    .card-header h3 { font-size: 18px; font-weight: 600; }
    .card-header .count-badge { background: rgba(255,255,255,0.08); padding: 4px 12px; border-radius: 20px; font-size: 12px; color: var(--text-secondary); font-weight: 500; }
    .card-header .header-joke { font-size: 10px; color: var(--text-muted); font-style: italic; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; }
    th { text-align: left; padding: 14px 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); border-bottom: 1px solid var(--glass-border); white-space: nowrap; }
    td { padding: 14px 20px; font-size: 14px; border-bottom: 1px solid rgba(255,255,255,0.04); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    .badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-yes { background: rgba(107,203,119,0.15); color: var(--green); }
    .badge-no { background: rgba(255,255,255,0.06); color: var(--text-muted); }
    .badge-claimed { background: rgba(255,217,61,0.15); color: var(--yellow); }
    .badge-available { background: rgba(107,203,119,0.15); color: var(--green); }

    .food-tags { display: flex; flex-wrap: wrap; gap: 4px; }
    .food-tag { padding: 3px 8px; background: rgba(255,159,67,0.12); border-radius: 5px; font-size: 12px; color: var(--orange); }

    /* Item Grid (gifts) */
    .items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; padding: 20px 24px; }
    .item-card { background: rgba(255,255,255,0.04); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); overflow: hidden; transition: var(--transition); animation: fadeUp 0.4s ease backwards; }
    .item-card:hover { transform: translateY(-3px); border-color: rgba(255,255,255,0.2); box-shadow: 0 8px 28px rgba(0,0,0,0.2); }
    .item-card-img { width: 100%; height: 160px; object-fit: cover; display: block; }
    .item-card-placeholder { width: 100%; height: 160px; display: flex; align-items: center; justify-content: center; font-size: 56px; background: rgba(255,255,255,0.03); }
    .item-card-body { padding: 16px; }
    .item-card-body h4 { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
    .item-card-body .meta { font-size: 12px; color: var(--text-secondary); margin-bottom: 12px; }
    .item-card-body .meta a { color: var(--blue); text-decoration: none; }
    .item-card-body .meta a:hover { text-decoration: underline; }
    .item-card-actions { display: flex; gap: 8px; flex-wrap: wrap; }

    /* Modal */
    .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(6px); z-index: 5000; align-items: center; justify-content: center; padding: 20px; }
    .modal-overlay.open { display: flex; }
    .modal { background: linear-gradient(145deg, #1a0a2e, #2d1b4e); border: 1px solid var(--glass-border); border-radius: var(--radius); width: 100%; max-width: 480px; padding: 32px; animation: fadeUp 0.3s ease; max-height: 90vh; overflow-y: auto; }
    .modal h3 { font-size: 20px; font-weight: 700; margin-bottom: 24px; }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 6px; }
    .form-group input { width: 100%; padding: 12px 16px; background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); color: var(--text-primary); font-family: 'Outfit',sans-serif; font-size: 14px; outline: none; transition: var(--transition); }
    .form-group input:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(77,150,255,0.15); }
    .form-group input[type="file"] { padding: 10px 14px; cursor: pointer; }
    .form-group input[type="file"]::file-selector-button { background: rgba(77,150,255,0.15); border: 1px solid rgba(77,150,255,0.3); color: var(--blue); padding: 6px 14px; border-radius: 6px; font-family: 'Outfit',sans-serif; font-size: 13px; font-weight: 500; cursor: pointer; margin-right: 10px; transition: var(--transition); }
    .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px; }

    .empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); }
    .empty-state .empty-icon { font-size: 56px; margin-bottom: 16px; }
    .empty-state p { font-size: 15px; font-weight: 400; }
    .empty-state .empty-joke { font-size: 11px; font-style: italic; margin-top: 8px; opacity: 0.7; }
    .loading-spinner { display: flex; align-items: center; justify-content: center; padding: 60px; }
    .spinner { width: 36px; height: 36px; border: 3px solid var(--glass-border); border-top-color: var(--orange); border-radius: 50%; animation: spin 0.8s linear infinite; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12); border-radius: 3px; }

    @@media (max-width: 768px) {
      .header h1 { font-size: 22px; }
      .stat-card .stat-value { font-size: 28px; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .tab-btn { padding: 10px 14px; font-size: 13px; }
      .items-grid { grid-template-columns: 1fr; }
      .chart-bar-label { width: 100px; font-size: 12px; }
      th, td { padding: 10px 14px; font-size: 13px; }
      .messages-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 480px) {
      .stats-grid { grid-template-columns: 1fr; }
      .modal { padding: 24px 20px; }
    }
  </style>
</head>
<body>

  <div id="toast-container"></div>

  <div id="dashboard">
    <div class="header">
      <h1>&#128293; <span>Party Command Center</span></h1>
      <button class="btn-logout" onclick="logout()">&#128682; Logout</button>
    </div>
    <p class="header-subtitle">a.k.a. Gus's anxiety dashboard &mdash; where obsessing over headcount is a personality trait</p>

    <div class="tabs">
      <button class="tab-btn active" data-tab="overview">&#128202; Overview</button>
      <button class="tab-btn" data-tab="rsvps">&#128203; RSVPs</button>
      <button class="tab-btn" data-tab="messages">&#128172; Messages</button>
      <button class="tab-btn" data-tab="gifts">&#127873; Gifts</button>
    </div>

    <!-- TAB: Overview -->
    <div class="tab-content active" id="tab-overview">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-icon">&#128100;</div>
          <div class="stat-value" id="stat-guests">-</div>
          <div class="stat-label">RSVPs</div>
          <div class="stat-joke">people who actually responded</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">&#128101;</div>
          <div class="stat-value" id="stat-plusones">-</div>
          <div class="stat-label">Plus Ones</div>
          <div class="stat-joke">freeloaders tagging along</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">&#127860;</div>
          <div class="stat-value" id="stat-attending">-</div>
          <div class="stat-label">Mouths to Feed</div>
          <div class="stat-joke">RIP Gus's wallet</div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">&#127873;</div>
          <div class="stat-value" id="stat-gifts">-</div>
          <div class="stat-label">Gifts Claimed</div>
          <div class="stat-joke">proof your friends aren't ALL cheap</div>
        </div>
      </div>

      <!-- Meat Chart -->
      <div class="chart-section">
        <h3>&#129385; Meat Demand</h3>
        <div class="chart-joke">a.k.a. how much meat to buy so nobody complains</div>
        <div id="food-chart"></div>
      </div>

      <!-- Dietary Restrictions -->
      <div class="dietary-section" id="dietary-section" style="display:none;">
        <h3>&#9888;&#65039; Dietary Restrictions</h3>
        <div class="dietary-joke">people with actual needs... respect</div>
        <div id="dietary-list"></div>
      </div>
    </div>

    <!-- TAB: RSVPs -->
    <div class="tab-content" id="tab-rsvps">
      <div class="glass-card">
        <div class="card-header">
          <div>
            <h3>&#128203; Guest List</h3>
            <div class="header-joke">who's actually showing up (hopefully)</div>
          </div>
          <span class="count-badge" id="rsvp-count">0 responses</span>
        </div>
        <div id="rsvps-body">
          <div class="loading-spinner"><div class="spinner"></div></div>
        </div>
      </div>
    </div>

    <!-- TAB: Messages -->
    <div class="tab-content" id="tab-messages">
      <div class="glass-card">
        <div class="card-header">
          <div>
            <h3>&#128172; Birthday Messages</h3>
            <div class="header-joke">nice things people said (hopefully)</div>
          </div>
          <span class="count-badge" id="msg-count">0 messages</span>
        </div>
        <div id="messages-body" style="padding: 20px 24px;">
          <div class="loading-spinner"><div class="spinner"></div></div>
        </div>
      </div>
    </div>

    <!-- TAB: Gifts -->
    <div class="tab-content" id="tab-gifts">
      <div class="glass-card">
        <div class="card-header">
          <div>
            <h3>&#127873; Gift Registry</h3>
            <div class="header-joke">the wishlist nobody asked for</div>
          </div>
          <div style="display:flex;gap:10px;align-items:center;">
            <span class="count-badge" id="gift-count">0 / 0 claimed</span>
            <button class="btn btn-accent btn-sm" onclick="openModal('gift')">+ Add Gift</button>
          </div>
        </div>
        <div id="gifts-body">
          <div class="loading-spinner"><div class="spinner"></div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Gift Modal -->
  <div class="modal-overlay" id="modal-gift">
    <div class="modal">
      <h3>&#127873; Add Gift</h3>
      <p style="font-size: 12px; color: var(--text-muted); font-style: italic; margin-bottom: 20px;">add something you actually want, not socks</p>
      <form id="gift-form">
        <div class="form-group">
          <label>Name</label>
          <input type="text" id="gift-name" placeholder="e.g. Bluetooth Speaker" required>
        </div>
        <div class="form-group">
          <label>Link (optional)</label>
          <input type="url" id="gift-link" placeholder="https://amazon.com/...">
        </div>
        <div class="form-group">
          <label>Photo (optional)</label>
          <input type="file" id="gift-photo" accept="image/*">
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-ghost btn-sm" onclick="closeModal('gift')">Cancel</button>
          <button type="submit" class="btn btn-accent btn-sm" id="gift-submit-btn">Add Gift</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function toast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const el = document.createElement('div');
      el.className = `toast ${type}`;
      el.textContent = message;
      container.appendChild(el);
      setTimeout(() => el.remove(), 3500);
    }

    async function api(method, path, body = null, isFormData = false) {
      const opts = { method, credentials: 'same-origin', headers: {} };
      if (body) {
        if (isFormData) { opts.body = body; }
        else { opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body); }
      }
      const res = await fetch(path, opts);
      if (res.status === 401 || res.status === 403) {
        toast('Not authenticated. Redirecting to login...', 'error');
        setTimeout(() => { window.location.href = '/Negocios/Login'; }, 1500);
        throw new Error('Unauthorized');
      }
      if (!res.ok) {
        const errText = await res.text().catch(() => 'Unknown error');
        throw new Error(errText || `HTTP ${res.status}`);
      }
      const ct = res.headers.get('content-type');
      return (ct && ct.includes('application/json')) ? res.json() : null;
    }

    function logout() { window.location.href = '/Negocios/Logout'; }

    // Auto-load
    document.getElementById('dashboard').style.display = 'block';
    api('GET', '/birthday/api/admin/stats')
      .then(() => { toast('Welcome back, party planner! \u{1F525}', 'success'); loadAll(); })
      .catch(err => { if (err.message !== 'Unauthorized') toast('Failed to load. Check admin access.', 'error'); });

    // Tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(`tab-${btn.dataset.tab}`).classList.add('active');
      });
    });

    let allRsvps = [];

    function loadAll() {
      loadStats();
      loadRsvps();
      loadGifts();
    }

    // ---- Stats ----
    async function loadStats() {
      try {
        const s = await api('GET', '/birthday/api/admin/stats');
        document.getElementById('stat-guests').textContent = s.totalGuests ?? 0;
        document.getElementById('stat-plusones').textContent = s.totalPlusOnes ?? 0;
        document.getElementById('stat-attending').textContent = s.totalAttending ?? 0;
        document.getElementById('stat-gifts').textContent = `${s.giftsClaimed ?? 0}/${s.giftsTotal ?? 0}`;
        renderFoodChart(s.foodCounts || {});
      } catch (err) {
        if (err.message !== 'Unauthorized') toast('Failed to load stats', 'error');
      }
    }

    function renderFoodChart(foodCounts) {
      const container = document.getElementById('food-chart');
      const entries = Object.entries(foodCounts);
      if (entries.length === 0) {
        container.innerHTML = '<div class="empty-state" style="padding:30px"><p>No meat selections yet</p><div class="empty-joke">either nobody responded or everyone\'s vegetarian</div></div>';
        return;
      }
      const max = Math.max(...entries.map(([, v]) => v), 1);
      container.innerHTML = entries.map(([name, count]) => {
        const pct = Math.max((count / max) * 100, 8);
        return `<div class="chart-bar-row"><div class="chart-bar-label">${escHtml(name)}</div><div class="chart-bar-track"><div class="chart-bar-fill" style="width:${pct}%">${count}</div></div></div>`;
      }).join('');
    }

    // ---- RSVPs ----
    async function loadRsvps() {
      const body = document.getElementById('rsvps-body');
      body.innerHTML = '<div class="loading-spinner"><div class="spinner"></div></div>';
      try {
        allRsvps = await api('GET', '/birthday/api/admin/rsvps');
        document.getElementById('rsvp-count').textContent = `${allRsvps.length} response${allRsvps.length !== 1 ? 's' : ''}`;

        if (allRsvps.length === 0) {
          body.innerHTML = '<div class="empty-state"><div class="empty-icon">&#128172;</div><p>Nobody has RSVP\'d yet...</p><div class="empty-joke">are you sure you have friends? share the link!</div></div>';
          return;
        }

        body.innerHTML = `<div class="table-wrap"><table><thead><tr>
          <th>Name</th><th>+1</th><th>Meats</th><th>Dietary</th><th>Message</th><th>Date</th><th></th>
        </tr></thead><tbody>${allRsvps.map(r => `<tr>
          <td><strong>${escHtml(r.name || '')}</strong></td>
          <td>${r.plusOne ? `<span class="badge badge-yes">Yes</span> ${r.plusOneName ? escHtml(r.plusOneName) : ''}` : '<span class="badge badge-no">No</span>'}</td>
          <td><div class="food-tags">${(() => { try { const f = typeof r.foods === 'string' ? JSON.parse(r.foods) : (r.foods || []); return f.length ? f.map(x => `<span class="food-tag">${escHtml(x)}</span>`).join('') : '<span style="color:var(--text-muted)">-</span>'; } catch { return '-'; } })()} </div></td>
          <td style="max-width:150px;color:var(--text-secondary);font-size:13px">${escHtml(r.extra || '-')}</td>
          <td style="max-width:180px;color:var(--text-secondary);font-size:13px;font-style:italic">${escHtml(r.message || '-')}</td>
          <td style="white-space:nowrap;color:var(--text-muted);font-size:12px">${r.createdAt ? new Date(r.createdAt).toLocaleDateString() : '-'}</td>
          <td><button class="btn btn-danger btn-sm" onclick="deleteRsvp('${r.id}')">Delete</button></td>
        </tr>`).join('')}</tbody></table></div>`;

        // Update dietary section and messages
        renderDietary();
        renderMessages();
      } catch (err) {
        if (err.message !== 'Unauthorized') { body.innerHTML = '<div class="empty-state"><p>Failed to load RSVPs</p></div>'; toast('Failed to load RSVPs', 'error'); }
      }
    }

    function renderDietary() {
      const section = document.getElementById('dietary-section');
      const list = document.getElementById('dietary-list');
      const withDietary = allRsvps.filter(r => r.extra && r.extra.trim() !== '');
      if (withDietary.length === 0) { section.style.display = 'none'; return; }
      section.style.display = 'block';
      list.innerHTML = withDietary.map(r =>
        `<div class="dietary-item"><span class="di-name">${escHtml(r.name)}</span><span class="di-text">${escHtml(r.extra)}</span></div>`
      ).join('');
    }

    function renderMessages() {
      const body = document.getElementById('messages-body');
      const withMsg = allRsvps.filter(r => r.message && r.message.trim() !== '');
      document.getElementById('msg-count').textContent = `${withMsg.length} message${withMsg.length !== 1 ? 's' : ''}`;

      if (withMsg.length === 0) {
        body.innerHTML = '<div class="empty-state"><div class="empty-icon">&#128172;</div><p>No messages yet</p><div class="empty-joke">the love is clearly overwhelming...</div></div>';
        return;
      }
      body.innerHTML = `<div class="messages-grid">${withMsg.map(r =>
        `<div class="message-card"><div class="msg-name">${escHtml(r.name)} says:</div><div class="msg-text">"${escHtml(r.message)}"</div></div>`
      ).join('')}</div>`;
    }

    async function deleteRsvp(id) {
      if (!confirm('Uninvite this person? Savage. \u{1F480}')) return;
      try {
        await api('DELETE', `/birthday/api/admin/rsvps/${id}`);
        toast('RSVP deleted. They\'ll never know... right?', 'success');
        loadRsvps();
        loadStats();
      } catch { toast('Failed to delete RSVP', 'error'); }
    }

    // ---- Gifts ----
    async function loadGifts() {
      const body = document.getElementById('gifts-body');
      body.innerHTML = '<div class="loading-spinner"><div class="spinner"></div></div>';
      try {
        const gifts = await api('GET', '/birthday/api/admin/gifts');
        const claimed = gifts.filter(g => g.claimed).length;
        document.getElementById('gift-count').textContent = `${claimed} / ${gifts.length} claimed`;

        if (gifts.length === 0) {
          body.innerHTML = '<div class="empty-state"><div class="empty-icon">&#127873;</div><p>No gifts yet</p><div class="empty-joke">add something before your friends just bring a card with $5 in it</div></div>';
          return;
        }

        body.innerHTML = `<div class="items-grid">${gifts.map((g, i) => `
          <div class="item-card" style="animation-delay:${i * 0.05}s">
            ${g.photo ? `<img class="item-card-img" src="${escAttr(g.photo)}" alt="${escAttr(g.name)}" loading="lazy">` : `<div class="item-card-placeholder">\u{1F381}</div>`}
            <div class="item-card-body">
              <h4>${escHtml(g.name)}</h4>
              <div class="meta">
                <span class="badge ${g.claimed ? 'badge-claimed' : 'badge-available'}">${g.claimed ? 'Claimed' : 'Available'}</span>
                ${g.link ? ` &middot; <a href="${escAttr(g.link)}" target="_blank" rel="noopener">View Link</a>` : ''}
              </div>
              <div class="item-card-actions">
                ${g.claimed ? `<button class="btn btn-ghost btn-sm" onclick="unclaimGift('${g.id}')">Unclaim</button>` : ''}
                <button class="btn btn-danger btn-sm" onclick="deleteGift('${g.id}')">Delete</button>
              </div>
            </div>
          </div>`).join('')}</div>`;
      } catch (err) {
        if (err.message !== 'Unauthorized') { body.innerHTML = '<div class="empty-state"><p>Failed to load gifts</p></div>'; toast('Failed to load gifts', 'error'); }
      }
    }

    async function deleteGift(id) {
      if (!confirm('Delete this gift? You sure you don\'t want it?')) return;
      try { await api('DELETE', `/birthday/api/admin/gifts/${id}`); toast('Gift deleted', 'success'); loadGifts(); loadStats(); }
      catch { toast('Failed to delete gift', 'error'); }
    }

    async function unclaimGift(id) {
      if (!confirm('Unclaim this gift? Someone changed their mind...')) return;
      try { await api('PUT', `/birthday/api/admin/gifts/${id}/unclaim`); toast('Gift unclaimed', 'success'); loadGifts(); loadStats(); }
      catch { toast('Failed to unclaim gift', 'error'); }
    }

    // ---- Modal ----
    function openModal(type) { document.getElementById(`modal-${type}`).classList.add('open'); }
    function closeModal(type) { document.getElementById(`modal-${type}`).classList.remove('open'); }
    document.querySelectorAll('.modal-overlay').forEach(o => { o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); }); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open')); });

    document.getElementById('gift-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('gift-submit-btn');
      const name = document.getElementById('gift-name').value.trim();
      const link = document.getElementById('gift-link').value.trim();
      const photo = document.getElementById('gift-photo').files[0];
      if (!name) { toast('Name is required', 'error'); return; }
      btn.disabled = true; btn.textContent = 'Adding...';
      try {
        const fd = new FormData();
        fd.append('name', name);
        if (link) fd.append('link', link);
        if (photo) fd.append('photo', photo);
        await api('POST', '/birthday/api/admin/gifts', fd, true);
        toast('Gift added! Now pray someone claims it \u{1F64F}', 'success');
        closeModal('gift'); document.getElementById('gift-form').reset(); loadGifts(); loadStats();
      } catch (err) { toast('Failed to add gift: ' + err.message, 'error'); }
      finally { btn.disabled = false; btn.textContent = 'Add Gift'; }
    });

    function escHtml(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }
    function escAttr(str) { return str.replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  </script>
</body>
</html>
