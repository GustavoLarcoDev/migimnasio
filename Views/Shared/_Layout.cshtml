<!DOCTYPE html>
<html lang="es" data-theme="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - My-Negocio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Metronic Style -->
    <link rel="stylesheet" href="~/css/metronic-style.css" />

    <!-- Apply theme before render to prevent flash -->
    <script>
    (function() {
        var t = localStorage.getItem('mg-theme') || '';
        if (t) document.documentElement.setAttribute('data-theme', t);
    })();
    </script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.css" />

    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Page-specific CSS -->
    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            --bs-body-font-family: 'Inter', sans-serif;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--mg-primary, #3E97FF) !important;
        }

        .navbar {
            padding: 1rem 0;
            background: var(--mg-topbar-bg) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075) !important;
        }

        .navbar .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            color: var(--mg-gray-700, #5E6278);
            transition: color 0.2s ease;
        }

        .navbar .nav-link:hover {
            color: var(--mg-primary, #3E97FF) !important;
        }

        .btn-outline-primary {
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            border-width: 2px;
            transition: all 0.3s ease;
        }

        .footer {
            background: var(--mg-dark, #181C32);
            color: #fff;
            padding: 1.5rem 0;
            margin-top: 2rem;
        }

        .footer a {
            color: var(--mg-gray-500, #A1A5B7);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer a:hover {
            color: #fff;
        }

        .sticky-navbar {
            position: sticky;
            top: 0;
            z-index: 1030;
        }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">
    <!-- Header -->
    <header class="sticky-navbar">
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop me-2 fs-3"></i>
                    My-Negocio
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="demo">
                                Características
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="planes">
                                Planes
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="faq">
                                FAQ
                            </a>
                        </li>
                        <li class="nav-item ms-lg-3">
                            <a class="nav-link fw-semibold" href="/negocios">
                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Iniciar Sesión
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary btn-sm px-3 py-2 fw-bold" href="#contacto">
                                <i class="bi bi-rocket-takeoff me-1"></i>
                                Probar Gratis
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer pt-4">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-lg-4 d-flex align-items-center">
                    <i class="bi bi-shop me-2 fs-3 text-primary"></i>
                    <h5 class="mb-0 fw-bold">My-Negocio</h5>
                </div>
                <div class="col-lg-4 text-center">
                    <p class="text-white-50 mb-0">Para ti, que emprendes, para ti, que vives.</p>
                </div>
                <div class="col-lg-4 d-flex justify-content-lg-end justify-content-center gap-3">
                    <a href="https://wa.me/593997143142?text=Hola%20quiero%20información%20de%20My-Negocio" target="_blank" rel="noopener" class="text-white fs-5" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                    <a href="mailto:mynegociooficiall@gmail.com" class="text-white fs-5" title="Email"><i class="bi bi-envelope-fill"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>
    <script>toastr.options.escapeHtml = true;</script>
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Smooth Scroll (anchors internos) -->
    <script>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href !== '#' && document.querySelector(href)) {
                    e.preventDefault();
                    document.querySelector(href).scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Navbar scroll effect
        window.addEventListener('scroll', function () {
            const navbar = document.querySelector('.navbar');
            if (!navbar) return;

            if (window.scrollY > 50) {
                navbar.style.boxShadow = '0 0.5rem 1rem rgba(0,0,0,0.15)';
            } else {
                navbar.style.boxShadow = '0 0.125rem 0.25rem rgba(0,0,0,0.075)';
            }
        });
    </script>

    <!-- Page-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
