    </div>
    <style>
        .qr-zoomable { cursor: zoom-in; transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .qr-zoomable:hover { transform: scale(1.05); box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
        @@keyframes qrZoomIn { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
