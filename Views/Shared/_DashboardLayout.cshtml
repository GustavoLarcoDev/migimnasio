    <!-- Perfil Tab System -->
    <script>
    (function() {
        var _negocioId = '@(ViewData["NegocioId"]?.ToString() ?? "")';
        var _perfilCargado = false;

        // Load logo into topbar on page load
        function cargarLogoTopbar() {
            if (!_negocioId) return;
            $.get('/Negocios/GetPerfilNegocio?negocioId=' + _negocioId, function(data) {
                if (data.logoUrl) {
                    actualizarLogoTopbar(data.logoUrl);
                }
            });
        }

        function actualizarLogoTopbar(url) {
            var container = document.getElementById('topbarLogoContainer');
            if (!container) return;
            var icon = document.getElementById('topbarDefaultIcon');
            if (icon) icon.style.display = 'none';
            // Remove old img if exists
            var oldImg = container.querySelector('img');
            if (oldImg) oldImg.remove();
            var img = document.createElement('img');
            img.src = url;
            img.style.cssText = 'width:38px;height:38px;object-fit:cover;border-radius:50%;';
            img.alt = 'Logo';
            container.appendChild(img);
        }

        function cargarPerfil() {
            if (!_negocioId) return;
            $.get('/Negocios/GetPerfilNegocio?negocioId=' + _negocioId, function(data) {
                // Logo
                if (data.logoUrl) {
                    $('#perfilLogoImg').attr('src', data.logoUrl).show();
                    $('#perfilLogoPlaceholder').hide();
                    actualizarLogoTopbar(data.logoUrl);
                } else {
                    $('#perfilLogoImg').hide();
                    $('#perfilLogoPlaceholder').show();
                }
                // Info
                $('#perfilNombre').text(data.nombre || '');
                var tipoLabel = { membresias: 'Membresías', artesanal: 'Artesanal', tienda: 'Tienda', restaurante: 'Restaurante' };
                $('#perfilTipoBadge').text(tipoLabel[data.tipoNegocio] || data.tipoNegocio);
                $('#perfilEmail').val(data.email || '');
                $('#perfilTelefono').val(data.telefono || '');
                $('#perfilDireccion').val(data.direccion || '');
                // Suscripción
                if (data.diasRestantes !== null) {
                    var cls = data.diasRestantes > 7 ? 'text-success' : (data.diasRestantes > 0 ? 'text-warning' : 'text-danger');
                    $('#perfilDiasRestantes').html('<span class="' + cls + ' fw-bold fs-4">' + data.diasRestantes + '</span> <small class="text-muted">días restantes</small>');
                } else {
                    $('#perfilDiasRestantes').html('<span class="text-muted">Sin fecha</span>');
                }
                $('#perfilDiasSuscrito').html('<span class="fw-bold fs-4">' + data.diasSuscrito + '</span> <small class="text-muted">días suscrito</small>');
                var fecha = data.fechaRegistro ? new Date(data.fechaRegistro).toLocaleDateString('es-EC', { year: 'numeric', month: 'long', day: 'numeric' }) : '-';
                $('#perfilFechaRegistro').text(fecha);
                if (data.esPrueba) $('#perfilPruebaBadge').show(); else $('#perfilPruebaBadge').hide();
            }).fail(function() {
                toastr.error('Error al cargar el perfil');
            });
        }

        function subirLogo() {
            var input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/jpeg,image/png,image/webp';
            input.onchange = function() {
                var file = input.files[0];
                if (!file) return;
                if (file.size > 2 * 1024 * 1024) { toastr.error('La imagen no debe superar 2MB'); return; }
                var fd = new FormData();
                fd.append('negocioId', _negocioId);
                fd.append('imagen', file);
                $.ajax({
                    url: '/Negocios/SubirLogoNegocio',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            toastr.success('Logo actualizado');
                            $('#perfilLogoImg').attr('src', res.url).show();
                            $('#perfilLogoPlaceholder').hide();
                            actualizarLogoTopbar(res.url);
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function(xhr) {
                        var msg = xhr.responseJSON?.message || 'Error al subir logo';
                        toastr.error(msg);
                    }
                });
            };
            input.click();
        }

        function guardarPerfil() {
            var email = $('#perfilEmail').val();
            var telefono = $('#perfilTelefono').val();
            var direccion = $('#perfilDireccion').val();
            $.post('/Negocios/ActualizarPerfilNegocio', {
                negocioId: _negocioId,
                email: email,
                telefono: telefono,
                direccion: direccion
            }, function(res) {
                if (res.success) toastr.success(res.message);
                else toastr.error(res.message);
            }).fail(function(xhr) {
                toastr.error(xhr.responseJSON?.message || 'Error al guardar');
            });
        }

        function cambiarPassword() {
            var actual = $('#perfilPassActual').val();
            var nueva = $('#perfilPassNueva').val();
            var confirmar = $('#perfilPassConfirmar').val();
            if (!actual || !nueva) { toastr.warning('Completa todos los campos'); return; }
            if (nueva.length < 6) { toastr.warning('La contraseña debe tener al menos 6 caracteres'); return; }
            if (nueva !== confirmar) { toastr.warning('Las contraseñas no coinciden'); return; }
            $.post('/Negocios/CambiarPassword', {
                negocioId: _negocioId,
                passwordActual: actual,
                passwordNueva: nueva
            }, function(res) {
                if (res.success) {
                    toastr.success(res.message);
                    $('#perfilPassActual, #perfilPassNueva, #perfilPassConfirmar').val('');
                } else {
                    toastr.error(res.message);
                }
            }).fail(function(xhr) {
                toastr.error(xhr.responseJSON?.message || 'Error al cambiar contraseña');
            });
        }

        // Expose functions
        window._perfilSubirLogo = subirLogo;
        window._perfilGuardar = guardarPerfil;
        window._perfilCambiarPassword = cambiarPassword;

        // Load on tab show
        document.addEventListener('mg-tab-shown', function(e) {
            if (e.detail.tab === 'perfilTab' && !_perfilCargado) {
                _perfilCargado = true;
                cargarPerfil();
            } else if (e.detail.tab === 'perfilTab') {
                cargarPerfil();
            }
        });

        // Load logo on page init
        cargarLogoTopbar();
    })();
    </script>

