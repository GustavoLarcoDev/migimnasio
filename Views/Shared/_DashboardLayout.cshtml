    <script>
    // ═══════════════ QR CODE GENERATION HELPERS ═══════════════
    var _qrLinkCurrentDataUrl = null;

    function mostrarQRLink(url, titulo, descripcion) {
        $('#modalQRLinkTitle').html('<i class="bi bi-qr-code me-2"></i>' + (titulo || 'Codigo QR'));
        $('#qrLinkDescription').text(descripcion || 'Escanea este codigo con tu celular');
        $('#qrLinkUrl').val(url);

        var container = document.getElementById('qrLinkCanvas');
        container.innerHTML = '';

        try {
            var qr = qrcode(0, 'M');
            qr.addData(url);
            qr.make();

            var moduleCount = qr.getModuleCount();
            var cellSize = Math.max(4, Math.floor(260 / moduleCount));
            var size = cellSize * moduleCount + 20;

            var canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            var ctx = canvas.getContext('2d');

            // White background
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, size, size);

            // Draw QR modules
            ctx.fillStyle = '#000000';
            var offset = 10;
            for (var row = 0; row < moduleCount; row++) {
                for (var col = 0; col < moduleCount; col++) {
                    if (qr.isDark(row, col)) {
                        ctx.fillRect(offset + col * cellSize, offset + row * cellSize, cellSize, cellSize);
                    }
                }
            }

            canvas.style.maxWidth = '260px';
            canvas.style.width = '100%';
            canvas.style.borderRadius = '12px';
            canvas.style.border = '1px solid var(--mg-border-color)';
            canvas.className = 'qr-zoomable';
            container.appendChild(canvas);

            _qrLinkCurrentDataUrl = canvas.toDataURL('image/png');
        } catch (e) {
            container.innerHTML = '<div class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Error al generar QR</div>';
            _qrLinkCurrentDataUrl = null;
        }

        new bootstrap.Modal('#modalQRLink').show();
    }

    function copiarQRLink() {
        var url = document.getElementById('qrLinkUrl').value;
        navigator.clipboard.writeText(url).then(function() {
            toastr.success('Link copiado al portapapeles');
        }).catch(function() {
            // Fallback
            var inp = document.getElementById('qrLinkUrl');
            inp.select();
            document.execCommand('copy');
            toastr.success('Link copiado al portapapeles');
        });
    }

    function descargarQRLink() {
        if (!_qrLinkCurrentDataUrl) { toastr.error('No hay QR para descargar'); return; }
        var a = document.createElement('a');
        a.href = _qrLinkCurrentDataUrl;
        a.download = 'codigo-qr.png';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
    </script>

