    <!-- Sidebar Navigation Logic -->
    <script>
    (function() {
        // Sidebar toggle (mobile)
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle = document.getElementById('sidebarToggle');

        function openSidebar() {
            sidebar.classList.add('show');
            overlay.classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeSidebar() {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
            document.body.style.overflow = '';
        }

        if (toggle) toggle.addEventListener('click', openSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);

        // Sidebar tab navigation
        const sidebarLinks = document.querySelectorAll('[data-mg-tab]');
        const tabPanes = document.querySelectorAll('.tab-pane');

        sidebarLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-mg-tab');

                // Update sidebar active state
                sidebarLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');

                // Show/hide tab panes
                tabPanes.forEach(pane => {
                    if (pane.id === targetId) {
                        pane.classList.add('show', 'active');
                    } else {
                        pane.classList.remove('show', 'active');
                    }
                });

                // Trigger tab-specific loading
                const event = new CustomEvent('mg-tab-shown', { detail: { tab: targetId } });
                document.dispatchEvent(event);

                // Close sidebar on mobile
                closeSidebar();
            });
        });

        // Theme switcher
        var currentTheme = localStorage.getItem('mg-theme') || '';
        function updateThemeUI() {
            document.querySelectorAll('.mg-theme-option').forEach(function(btn) {
                var val = btn.getAttribute('data-theme-value');
                var check = btn.querySelector('.bi-check2');
                if (val === currentTheme) {
                    btn.classList.add('active');
                    if (check) check.classList.remove('d-none');
                } else {
                    btn.classList.remove('active');
                    if (check) check.classList.add('d-none');
                }
            });
        }
        updateThemeUI();

        document.querySelectorAll('.mg-theme-option').forEach(function(btn) {
            btn.addEventListener('click', function() {
                currentTheme = this.getAttribute('data-theme-value');
                document.documentElement.setAttribute('data-theme', currentTheme);
                localStorage.setItem('mg-theme', currentTheme);
                updateThemeUI();
            });
        });
    })();
    </script>

    <script>
    $.ajaxSetup({ headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } });
    </script>

    <!-- Perfil Tab System -->
    <script>
    (function() {
        var _negocioId = '@(ViewData["NegocioId"]?.ToString() ?? "")';
        var _perfilCargado = false;

        // Load logo into topbar on page load
        function cargarLogoTopbar() {
            if (!_negocioId) return;
            $.get('/Negocios/GetPerfilNegocio?negocioId=' + _negocioId, function(data) {
                if (data.logoUrl) {
                    actualizarLogoTopbar(data.logoUrl);
                }
            });
        }

        function actualizarLogoTopbar(url) {
            var container = document.getElementById('topbarLogoContainer');
            if (!container) return;
            var icon = document.getElementById('topbarDefaultIcon');
            if (icon) icon.style.display = 'none';
            // Remove old img if exists
            var oldImg = container.querySelector('img');
            if (oldImg) oldImg.remove();
            var img = document.createElement('img');
            img.src = url;
            img.style.cssText = 'width:38px;height:38px;object-fit:cover;border-radius:50%;';
            img.alt = 'Logo';
            container.appendChild(img);
        }

        function cargarPerfil() {
            if (!_negocioId) return;
            $.get('/Negocios/GetPerfilNegocio?negocioId=' + _negocioId, function(data) {
                // Logo
                if (data.logoUrl) {
                    $('#perfilLogoImg').attr('src', data.logoUrl).show();
                    $('#perfilLogoPlaceholder').hide();
                    actualizarLogoTopbar(data.logoUrl);
                } else {
                    $('#perfilLogoImg').hide();
                    $('#perfilLogoPlaceholder').show();
                }
                // Info
                $('#perfilNombre').text(data.nombre || '');
                var tipoLabel = { membresias: 'Membresías', artesanal: 'Artesanal', tienda: 'Tienda', restaurante: 'Restaurante' };
                $('#perfilTipoBadge').text(tipoLabel[data.tipoNegocio] || data.tipoNegocio);
                $('#perfilEmail').val(data.email || '');
                $('#perfilTelefono').val(data.telefono || '');
                $('#perfilDireccion').val(data.direccion || '');
                // Suscripción
                if (data.diasRestantes !== null) {
                    var cls = data.diasRestantes > 7 ? 'text-success' : (data.diasRestantes > 0 ? 'text-warning' : 'text-danger');
                    $('#perfilDiasRestantes').html('<span class="' + cls + ' fw-bold fs-4">' + data.diasRestantes + '</span> <small class="text-muted">días restantes</small>');
                } else {
                    $('#perfilDiasRestantes').html('<span class="text-muted">Sin fecha</span>');
                }
                $('#perfilDiasSuscrito').html('<span class="fw-bold fs-4">' + data.diasSuscrito + '</span> <small class="text-muted">días suscrito</small>');
                var fecha = data.fechaRegistro ? new Date(data.fechaRegistro).toLocaleDateString('es-EC', { year: 'numeric', month: 'long', day: 'numeric' }) : '-';
                $('#perfilFechaRegistro').text(fecha);
                if (data.esPrueba) $('#perfilPruebaBadge').show(); else $('#perfilPruebaBadge').hide();
            }).fail(function() {
                toastr.error('Error al cargar el perfil');
            });
        }

        function subirLogo() {
            var input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/jpeg,image/png,image/webp';
            input.onchange = function() {
                var file = input.files[0];
                if (!file) return;
                if (file.size > 2 * 1024 * 1024) { toastr.error('La imagen no debe superar 2MB'); return; }
                var fd = new FormData();
                fd.append('negocioId', _negocioId);
                fd.append('imagen', file);
                $.ajax({
                    url: '/Negocios/SubirLogoNegocio',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            toastr.success('Logo actualizado');
                            $('#perfilLogoImg').attr('src', res.url).show();
                            $('#perfilLogoPlaceholder').hide();
                            actualizarLogoTopbar(res.url);
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    error: function(xhr) {
                        var msg = xhr.responseJSON?.message || 'Error al subir logo';
                        toastr.error(msg);
                    }
                });
            };
            input.click();
        }

        function guardarPerfil() {
            var email = $('#perfilEmail').val();
            var telefono = $('#perfilTelefono').val();
            var direccion = $('#perfilDireccion').val();
            $.post('/Negocios/ActualizarPerfilNegocio', {
                negocioId: _negocioId,
                email: email,
                telefono: telefono,
                direccion: direccion
            }, function(res) {
                if (res.success) toastr.success(res.message);
                else toastr.error(res.message);
            }).fail(function(xhr) {
                toastr.error(xhr.responseJSON?.message || 'Error al guardar');
            });
        }

        function cambiarPassword() {
            var actual = $('#perfilPassActual').val();
            var nueva = $('#perfilPassNueva').val();
            var confirmar = $('#perfilPassConfirmar').val();
            if (!actual || !nueva) { toastr.warning('Completa todos los campos'); return; }
            if (nueva.length < 6) { toastr.warning('La contraseña debe tener al menos 6 caracteres'); return; }
            if (nueva !== confirmar) { toastr.warning('Las contraseñas no coinciden'); return; }
            $.post('/Negocios/CambiarPassword', {
                negocioId: _negocioId,
                passwordActual: actual,
                passwordNueva: nueva
            }, function(res) {
                if (res.success) {
                    toastr.success(res.message);
                    $('#perfilPassActual, #perfilPassNueva, #perfilPassConfirmar').val('');
                } else {
                    toastr.error(res.message);
                }
            }).fail(function(xhr) {
                toastr.error(xhr.responseJSON?.message || 'Error al cambiar contraseña');
            });
        }

        // Expose functions
        window._perfilSubirLogo = subirLogo;
        window._perfilGuardar = guardarPerfil;
        window._perfilCambiarPassword = cambiarPassword;

        // Load on tab show
        document.addEventListener('mg-tab-shown', function(e) {
            if (e.detail.tab === 'perfilTab' && !_perfilCargado) {
                _perfilCargado = true;
                cargarPerfil();
            } else if (e.detail.tab === 'perfilTab') {
                cargarPerfil();
            }
        });

        // Load logo on page init
        cargarLogoTopbar();
    })();
    </script>

    <!-- Facturación Electrónica SRI -->
    <script>
    (function() {
        var _negocioId = '@(ViewData["NegocioId"]?.ToString() ?? "")';
        if (!_negocioId) return;

        window._facturacionActiva = false;
        var _facturacionCargada = false;

        // Check if facturación is active and show/hide sidebar link
        function checkFacturacion() {
            $.get('/Negocios/GetPerfilNegocio?negocioId=' + _negocioId, function(d) {
                window._facturacionActiva = d.facturacionActiva || false;
                if (window._facturacionActiva) {
                    document.querySelectorAll('.mg-facturacion-link').forEach(function(el) { el.classList.remove('d-none'); });
                }
            });
        }

        function cargarConfigFacturacion() {
            $.get('/Negocios/GetPerfilNegocio?negocioId=' + _negocioId, function(d) {
                // Fill config form in perfil
                $('#sriToggle').prop('checked', d.facturacionActiva || false);
                toggleSriFields(d.facturacionActiva);
                $('#sriRuc').val(d.ruc || '');
                $('#sriRazonSocial').val(d.razonSocial || '');
                $('#sriNombreComercial').val(d.nombreComercial || '');
                $('#sriDireccionMatriz').val(d.direccionMatriz || '');
                $('#sriEstablecimiento').val(d.codigoEstablecimiento || '001');
                $('#sriPuntoEmision').val(d.puntoEmision || '001');
                $('#sriAmbiente').val(d.sriAmbiente || 1);
                $('#sriObligadoContabilidad').prop('checked', d.obligadoContabilidad || false);
                $('#sriContribuyenteEspecial').val(d.contribuyenteEspecial || '');
                $('#sriRegimenContribuyente').val(d.regimenContribuyente || '');
                $('#sriAgenteRetencion').val(d.agenteRetencion || '');
                if (d.tieneCertificado) {
                    $('#sriCertBadge').removeClass('d-none').text('Certificado cargado');
                    // Validate certificate
                    $.get('/Negocios/ValidarCertificado?negocioId=' + _negocioId, function(c) {
                        if (c.valid) {
                            $('#sriCertBadge').removeClass('bg-danger').addClass('bg-success').text('Certificado válido — vence: ' + new Date(c.vencimiento).toLocaleDateString('es-EC'));
                        } else {
                            $('#sriCertBadge').removeClass('bg-success').addClass('bg-danger').text(c.message);
                        }
                    });
                } else {
                    $('#sriCertBadge').addClass('d-none');
                }
            });
        }

        function toggleSriFields(activa) {
            if (activa) { $('#sriConfigFields').slideDown(); } else { $('#sriConfigFields').slideUp(); }
        }

        function guardarConfigSri() {
            $.post('/Negocios/GuardarConfigFacturacion', {
                negocioId: _negocioId,
                ruc: $('#sriRuc').val(),
                razonSocial: $('#sriRazonSocial').val(),
                nombreComercial: $('#sriNombreComercial').val(),
                direccionMatriz: $('#sriDireccionMatriz').val(),
                codigoEstablecimiento: $('#sriEstablecimiento').val(),
                puntoEmision: $('#sriPuntoEmision').val(),
                sriAmbiente: parseInt($('#sriAmbiente').val()),
                obligadoContabilidad: $('#sriObligadoContabilidad').is(':checked'),
                contribuyenteEspecial: $('#sriContribuyenteEspecial').val(),
                regimenContribuyente: $('#sriRegimenContribuyente').val(),
                agenteRetencion: $('#sriAgenteRetencion').val()
            }, function(r) {
                if (r.success) toastr.success(r.message); else toastr.error(r.message);
            }).fail(function(x) { toastr.error(x.responseJSON?.message || 'Error'); });
        }

        function toggleFacturacion() {
            var activa = $('#sriToggle').is(':checked');
            $.post('/Negocios/ToggleFacturacion', { negocioId: _negocioId, activa: activa }, function(r) {
                if (r.success) {
                    toastr.success(r.message);
                    window._facturacionActiva = activa;
                    toggleSriFields(activa);
                    if (activa) document.querySelectorAll('.mg-facturacion-link').forEach(function(el) { el.classList.remove('d-none'); });
                    else document.querySelectorAll('.mg-facturacion-link').forEach(function(el) { el.classList.add('d-none'); });
                } else {
                    toastr.error(r.message);
                    $('#sriToggle').prop('checked', !activa);
                }
            }).fail(function(x) {
                toastr.error(x.responseJSON?.message || 'Error');
                $('#sriToggle').prop('checked', !activa);
            });
        }

        function subirCertificado() {
            var file = $('#sriCertFile')[0]?.files[0];
            var pass = $('#sriCertPassword').val();
            if (!file) { toastr.warning('Selecciona un archivo .p12'); return; }
            if (!pass) { toastr.warning('Ingresa la contraseña del certificado'); return; }
            var fd = new FormData();
            fd.append('negocioId', _negocioId);
            fd.append('certificado', file);
            fd.append('password', pass);
            $.ajax({
                url: '/Negocios/SubirCertificado', type: 'POST', data: fd,
                processData: false, contentType: false,
                success: function(r) {
                    if (r.success) { toastr.success(r.message); cargarConfigFacturacion(); }
                    else toastr.error(r.message);
                },
                error: function(x) { toastr.error(x.responseJSON?.message || 'Error al subir certificado'); }
            });
        }

        // ── Tab Facturación ──
        var _facTabCargado = false;
        function cargarTabFacturacion() {
            // Stats
            $.get('/Negocios/GetEstadisticasFacturacion?negocioId=' + _negocioId, function(s) {
                $('#facStatEmitidas').text(s.totalEmitidas);
                $('#facStatAutorizadas').text(s.autorizadas);
                $('#facStatPendientes').text(s.pendientes);
                $('#facStatMonto').text('$' + (s.montoTotal || 0).toFixed(2));
            });
            // Table
            cargarTablaFacturas();
        }

        function cargarTablaFacturas() {
            var desde = $('#facFiltroDesde').val() || '';
            var hasta = $('#facFiltroHasta').val() || '';
            var estado = $('#facFiltroEstado').val() || '';
            var url = '/Negocios/GetFacturas?negocioId=' + _negocioId;
            if (desde) url += '&desde=' + desde;
            if (hasta) url += '&hasta=' + hasta;
            if (estado) url += '&estado=' + estado;

            $.get(url, function(data) {
                var html = '';
                if (!data || data.length === 0) {
                    html = '<tr><td colspan="7" class="text-center text-muted py-4">No hay facturas</td></tr>';
                } else {
                    data.forEach(function(f) {
                        var badgeCls = f.estadoSri === 'Autorizada' ? 'bg-success' : (f.estadoSri === 'Pendiente' || f.estadoSri === 'Recibida' ? 'bg-warning text-dark' : (f.estadoSri === 'Anulada' ? 'bg-secondary' : 'bg-danger'));
                        html += '<tr>' +
                            '<td class="small">' + escHtml(f.numeroCompleto) + '</td>' +
                            '<td class="small">' + new Date(f.fechaEmision).toLocaleDateString('es-EC') + '</td>' +
                            '<td class="small">' + escHtml(f.compradorRazonSocial || '') + '</td>' +
                            '<td class="small">' + escHtml(f.compradorIdentificacion || '') + '</td>' +
                            '<td class="small fw-bold">$' + f.importeTotal.toFixed(2) + '</td>' +
                            '<td><span class="badge ' + badgeCls + '">' + escHtml(f.estadoSri) + '</span></td>' +
                            '<td class="text-end">' +
                                '<div class="btn-group btn-group-sm">' +
                                (f.estadoSri === 'Autorizada' ? '<button class="btn btn-outline-primary btn-sm" onclick="window._facDescargarXml(\'' + f.facturaId + '\')" title="XML"><i class="bi bi-file-code"></i></button>' +
                                '<button class="btn btn-outline-danger btn-sm" onclick="window._facDescargarRide(\'' + f.facturaId + '\')" title="RIDE PDF"><i class="bi bi-file-pdf"></i></button>' +
                                '<button class="btn btn-outline-success btn-sm" onclick="window._facEnviarEmail(\'' + f.facturaId + '\')" title="Enviar email"><i class="bi bi-envelope"></i></button>' : '') +
                                ((f.estadoSri === 'Pendiente' || f.estadoSri === 'NoAutorizada') ? '<button class="btn btn-outline-warning btn-sm" onclick="window._facReintentar(\'' + f.facturaId + '\')" title="Reintentar"><i class="bi bi-arrow-repeat"></i></button>' : '') +
                                (f.estadoSri !== 'Anulada' ? '<button class="btn btn-outline-secondary btn-sm" onclick="window._facAnular(\'' + f.facturaId + '\')" title="Anular"><i class="bi bi-x-circle"></i></button>' : '') +
                                '</div>' +
                            '</td></tr>';
                    });
                }
                $('#facturasTableBody').html(html);
            });
        }

        // ── Modal Facturar (items editables) ──
        var _facItemCounter = 0;

        function agregarFilaItem(item) {
            item = item || { descripcion: '', cantidad: 1, precioUnitario: 0, descuento: 0, codigo: '001' };
            var idx = _facItemCounter++;
            var sub = ((item.cantidad || 1) * (item.precioUnitario || 0) - (item.descuento || 0));
            var tr = '<tr data-fac-idx="' + idx + '">' +
                '<td><input type="text" class="form-control form-control-sm fac-item-input" data-field="descripcion" value="' + escAttr(item.descripcion || '') + '" placeholder="Descripción"></td>' +
                '<td><input type="number" class="form-control form-control-sm text-center fac-item-input" data-field="cantidad" value="' + (item.cantidad || 1) + '" min="1" step="1" style="width:70px"></td>' +
                '<td><input type="number" class="form-control form-control-sm text-end fac-item-input" data-field="precioUnitario" value="' + (item.precioUnitario || 0).toFixed(2) + '" min="0" step="0.01" style="width:90px"></td>' +
                '<td><input type="number" class="form-control form-control-sm text-end fac-item-input" data-field="descuento" value="' + (item.descuento || 0).toFixed(2) + '" min="0" step="0.01" style="width:70px"></td>' +
                '<td class="text-end fac-row-subtotal">$' + Math.max(0, sub).toFixed(2) + '</td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-danger fac-remove-item" title="Eliminar"><i class="bi bi-trash"></i></button></td>' +
                '</tr>';
            $('#facModalItems').append(tr);
        }

        function recalcularTotalesFactura() {
            var subtotal = 0;
            $('#facModalItems tr').each(function() {
                var cant = parseFloat($(this).find('[data-field="cantidad"]').val()) || 0;
                var precio = parseFloat($(this).find('[data-field="precioUnitario"]').val()) || 0;
                var desc = parseFloat($(this).find('[data-field="descuento"]').val()) || 0;
                var sub = Math.max(0, cant * precio - desc);
                $(this).find('.fac-row-subtotal').text('$' + sub.toFixed(2));
                subtotal += sub;
            });
            var iva = subtotal * 0.15;
            $('#facModalSubtotal').text('$' + subtotal.toFixed(2));
            $('#facModalIva').text('$' + iva.toFixed(2));
            $('#facModalTotal').text('$' + (subtotal + iva).toFixed(2));
        }

        // Event delegation para inputs editables
        $(document).on('input change', '.fac-item-input', recalcularTotalesFactura);
        $(document).on('click', '.fac-remove-item', function() {
            $(this).closest('tr').remove();
            recalcularTotalesFactura();
        });
        $('#btnAgregarItemFac').on('click', function() { agregarFilaItem(); });

        function abrirModalFacturar(items, reciboId, compradorInfo) {
            $('#facModalItems').empty();
            _facItemCounter = 0;
            (items || []).forEach(function(item) { agregarFilaItem(item); });
            recalcularTotalesFactura();

            window._facModalReciboId = reciboId || null;

            // Datos del comprador
            if (compradorInfo && compradorInfo.nombre) {
                $('#facModalRazonSocial').val(compradorInfo.nombre);
                $('#facModalEmail').val(compradorInfo.email || '');
                $('#facModalTipoId').val('05');
                $('#facModalIdentificacion').val('');
            } else {
                $('#facModalTipoId').val('07');
                $('#facModalIdentificacion').val('9999999999999');
                $('#facModalRazonSocial').val('CONSUMIDOR FINAL');
                $('#facModalEmail').val('');
            }
            $('#facModalDireccion').val('');
            $('#facModalFormaPago').val('01');
            bootstrap.Modal.getOrCreateInstance($('#modalFacturar')[0]).show();
        }

        // Buscar contribuyente en SRI
        var _buscandoSri = false;
        function buscarContribuyenteSri() {
            if (_buscandoSri) return;
            var id = $('#facModalIdentificacion').val().trim();
            if (!id || (id.length !== 10 && id.length !== 13)) {
                toastr.warning('Ingrese cédula (10 dígitos) o RUC (13 dígitos)');
                return;
            }
            _buscandoSri = true;
            var btn = $('#btnBuscarSri');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
            $.get('/Negocios/BuscarContribuyenteSri', { identificacion: id })
                .done(function(r) {
                    if (r && r.success) {
                        $('#facModalRazonSocial').val(r.razonSocial);
                        $('#facModalTipoId').val(r.tipoIdentificacion);
                        toastr.success('Datos encontrados: ' + r.razonSocial);
                    } else {
                        toastr.warning(r?.message || 'No se encontró contribuyente');
                    }
                })
                .fail(function() { toastr.error('Error al consultar el SRI'); })
                .always(function() {
                    btn.prop('disabled', false).html('<i class="bi bi-search"></i>');
                    _buscandoSri = false;
                });
        }
        $('#btnBuscarSri').on('click', buscarContribuyenteSri);
        $('#facModalIdentificacion').on('blur', function() {
            var v = $(this).val().trim();
            if (v.length === 10 || v.length === 13) buscarContribuyenteSri();
        });

        // Facturar desde recibo (llamado desde tablas de recibos)
        function facturarDesdeRecibo(reciboId) {
            if (!window._facturacionActiva) { toastr.warning('Facturación electrónica no está activa'); return; }
            mgGet('/Negocios/GetReciboParaFactura', { reciboId: reciboId, negocioId: _negocioId }, function(r) {
                if (r && r.success) {
                    abrirModalFacturar(r.items, r.reciboId, { nombre: r.destinatarioNombre, email: r.destinatarioEmail });
                } else {
                    toastr.error(r?.message || 'Error al cargar datos del recibo');
                }
            });
        }

        function emitirFacturaDesdeModal() {
            var btn = $('#btnEmitirFactura');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Emitiendo...');

            // Leer items desde el DOM (editables)
            var items = [];
            $('#facModalItems tr').each(function() {
                var desc = $(this).find('[data-field="descripcion"]').val().trim();
                var cant = parseFloat($(this).find('[data-field="cantidad"]').val()) || 0;
                var precio = parseFloat($(this).find('[data-field="precioUnitario"]').val()) || 0;
                var descuento = parseFloat($(this).find('[data-field="descuento"]').val()) || 0;
                if (desc && cant > 0 && precio > 0) {
                    items.push({
                        codigoPrincipal: '001',
                        descripcion: desc,
                        cantidad: cant,
                        precioUnitario: precio,
                        descuento: descuento,
                        porcentajeIva: 15
                    });
                }
            });

            if (items.length === 0) {
                toastr.warning('Agregue al menos un item con descripción y precio');
                btn.prop('disabled', false).html('<i class="bi bi-file-earmark-check me-1"></i>Emitir Factura');
                return;
            }

            var payload = {
                negocioId: _negocioId,
                reciboId: window._facModalReciboId,
                compradorIdentificacion: $('#facModalIdentificacion').val(),
                compradorTipoIdentificacion: $('#facModalTipoId').val(),
                compradorRazonSocial: $('#facModalRazonSocial').val(),
                compradorEmail: $('#facModalEmail').val(),
                compradorDireccion: $('#facModalDireccion').val(),
                formaPagoSri: $('#facModalFormaPago').val(),
                items: items
            };

            $.ajax({
                url: '/Negocios/EmitirFactura',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(r) {
                    if (r.success) {
                        toastr.success(r.message);
                        bootstrap.Modal.getOrCreateInstance($('#modalFacturar')[0]).hide();
                        if (_facTabCargado) cargarTablaFacturas();
                        // Recargar tabla de recibos si existe
                        if (typeof tablaRecibos !== 'undefined' && tablaRecibos) tablaRecibos.ajax.reload();
                    } else {
                        toastr.error(r.message);
                    }
                },
                error: function(x) { toastr.error(x.responseJSON?.message || 'Error al emitir factura'); },
