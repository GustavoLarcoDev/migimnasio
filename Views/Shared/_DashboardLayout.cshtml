    <!-- Modal: QR Code para Links Publicos (menus, catalogos) -->
    <div class="modal fade" id="modalQRLink" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0" style="border-radius: 20px; background: var(--mg-card-bg);">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title" id="modalQRLinkTitle" style="color: var(--mg-text-color);">
                        <i class="bi bi-qr-code me-2"></i>Codigo QR
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center px-4 pb-4">
                    <div id="qrLinkCanvas" class="mb-3"></div>
                    <p class="text-muted small mb-3" id="qrLinkDescription">Escanea este codigo con tu celular</p>
                    <div class="input-group input-group-sm mb-3">
                        <input type="text" class="form-control" id="qrLinkUrl" readonly
                               style="background: var(--mg-body-bg); color: var(--mg-text-color); border-color: var(--mg-border-color); border-radius: 8px 0 0 8px; font-size: 0.75rem;">
                        <button class="btn btn-outline-primary" type="button" onclick="copiarQRLink()" style="border-radius: 0 8px 8px 0;">
                            <i class="bi bi-clipboard"></i>
                        </button>
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-sm btn-primary" onclick="descargarQRLink()">
                            <i class="bi bi-download me-1"></i>Descargar
                        </button>
                        <button class="btn btn-sm btn-outline-primary" onclick="window.open(document.getElementById('qrLinkUrl').value, '_blank')">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Abrir Link
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
    // ═══════════════ QR CODE GENERATION HELPERS ═══════════════
    var _qrLinkCurrentDataUrl = null;

    function mostrarQRLink(url, titulo, descripcion) {
        $('#modalQRLinkTitle').html('<i class="bi bi-qr-code me-2"></i>' + (titulo || 'Codigo QR'));
        $('#qrLinkDescription').text(descripcion || 'Escanea este codigo con tu celular');
        $('#qrLinkUrl').val(url);

        var container = document.getElementById('qrLinkCanvas');
        container.innerHTML = '';

        try {
            var qr = qrcode(0, 'M');
            qr.addData(url);
            qr.make();

            var moduleCount = qr.getModuleCount();
            var cellSize = Math.max(4, Math.floor(260 / moduleCount));
            var size = cellSize * moduleCount + 20;

            var canvas = document.createElement('canvas');
            canvas.width = size;
            canvas.height = size;
            var ctx = canvas.getContext('2d');

            // White background
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, size, size);

            // Draw QR modules
            ctx.fillStyle = '#000000';
            var offset = 10;
            for (var row = 0; row < moduleCount; row++) {
                for (var col = 0; col < moduleCount; col++) {
                    if (qr.isDark(row, col)) {
                        ctx.fillRect(offset + col * cellSize, offset + row * cellSize, cellSize, cellSize);
                    }
                }
            }

            canvas.style.maxWidth = '260px';
            canvas.style.width = '100%';
            canvas.style.borderRadius = '12px';
            canvas.style.border = '1px solid var(--mg-border-color)';
            canvas.className = 'qr-zoomable';
            container.appendChild(canvas);

            _qrLinkCurrentDataUrl = canvas.toDataURL('image/png');
        } catch (e) {
            container.innerHTML = '<div class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Error al generar QR</div>';
            _qrLinkCurrentDataUrl = null;
        }

        new bootstrap.Modal('#modalQRLink').show();
    }

    function copiarQRLink() {
        var url = document.getElementById('qrLinkUrl').value;
        navigator.clipboard.writeText(url).then(function() {
            toastr.success('Link copiado al portapapeles');
        }).catch(function() {
            // Fallback
            var inp = document.getElementById('qrLinkUrl');
            inp.select();
            document.execCommand('copy');
            toastr.success('Link copiado al portapapeles');
        });
    }

    function descargarQRLink() {
        if (!_qrLinkCurrentDataUrl) { toastr.error('No hay QR para descargar'); return; }
        var a = document.createElement('a');
        a.href = _qrLinkCurrentDataUrl;
        a.download = 'codigo-qr.png';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
    </script>

    <!-- QR Zoom Overlay (global) -->
    <div id="qrZoomOverlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;z-index:99999;
        background:rgba(0,0,0,0.85);cursor:zoom-out;align-items:center;justify-content:center;padding:20px;"
         onclick="cerrarQrZoom()">
        <img id="qrZoomImg" src="" alt="QR" style="max-width:90vw;max-height:90vh;border-radius:16px;
            box-shadow:0 0 60px rgba(0,0,0,0.5);animation:qrZoomIn 0.25s ease-out;" />
    </div>
    <style>
        .qr-zoomable { cursor: zoom-in; transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .qr-zoomable:hover { transform: scale(1.05); box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
        @@keyframes qrZoomIn { from { transform: scale(0.7); opacity: 0; } to { transform: scale(1); opacity: 1; } }
    </style>
    <script>
        function abrirQrZoom(src) {
            if (!src) return;
            document.getElementById('qrZoomImg').src = src;
            var ov = document.getElementById('qrZoomOverlay');
            ov.style.display = 'flex';
        }
        function cerrarQrZoom() {
            document.getElementById('qrZoomOverlay').style.display = 'none';
            document.getElementById('qrZoomImg').src = '';
        }
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') cerrarQrZoom(); });
        document.addEventListener('click', function(e) {
            var img = e.target.closest('.qr-zoomable');
            if (img) { e.preventDefault(); e.stopPropagation(); abrirQrZoom(img.src); }
        });
    </script>
</body>
</html>
