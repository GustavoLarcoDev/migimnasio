                    <a href="mailto:mynegociooficiall@gmail.com?subject=Cuenta%20bloqueada%20-%20Renovar%20suscripci%C3%B3n" class="btn btn-outline-primary w-100" style="font-weight:500;">
                        <i class="bi bi-envelope me-2"></i>mynegociooficiall@gmail.com
                    </a>
                </div>
                <div style="margin-top:1.5rem;padding-top:1rem;border-top:1px solid #EFF2F5;">
                    <form method="post" action="@Url.Action("Logout", "Auth")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-light btn-sm" style="color:#7E8299;">
                            <i class="bi bi-box-arrow-left me-1"></i>Cerrar Sesion
