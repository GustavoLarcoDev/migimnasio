@model Gimnasio.Models.Gym

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard - " + Model.GimnasioNombre;
    ViewData["GimnasioId"] = Model.GimnasioId;
    ViewData["GimnasioNombre"] = Model.GimnasioNombre;
    ViewData["DuenoNombre"] = Model.DuenoGimnasio;
    var gimnasioId = Model.GimnasioId;
}

<div class="tab-content" id="dashboardTabsContent">
    <!-- TAB CLIENTES -->
    <div class="tab-pane fade show active" id="clientesTab" role="tabpanel">
        <!-- Action Buttons -->
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button id="btnCrearCliente" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Nuevo Cliente
            </button>
            <button id="btnExportClientesExcel" class="btn btn-success">
                <i class="bi bi-file-earmark-excel me-2"></i>Exportar
            </button>
            <button id="btnImportarExcel" class="btn btn-outline-primary">
                <i class="bi bi-upload me-2"></i>Importar Excel
            </button>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-label">Total Clientes</div>
                            <div class="stat-value" id="totalClientes">0</div>
                        </div>
                        <div class="stat-icon bg-light-primary">
                            <i class="bi bi-people-fill text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-label">Activos</div>
                            <div class="stat-value" id="clientesActivos">0</div>
                        </div>
                        <div class="stat-icon bg-light-success">
                            <i class="bi bi-check-circle-fill text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-label">Vencidos</div>
                            <div class="stat-value" id="clientesVencidos">0</div>
                        </div>
                        <div class="stat-icon bg-light-danger">
                            <i class="bi bi-x-circle-fill text-danger"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="stat-label">Ingresos Mes</div>
                            <div class="stat-value" id="ingresosMes">$0</div>
                        </div>
                        <div class="stat-icon bg-light-info">
                            <i class="bi bi-currency-dollar text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Import Zone (hidden by default) -->
        <div id="importZone" class="mg-card border-2 border-dashed mb-4 d-none">
            <div class="card-body text-center py-5">
                <i class="bi bi-cloud-upload fs-1 text-primary mb-3 d-block"></i>
                <h5>Arrastra tu archivo Excel aquí</h5>
                <p class="text-muted">O haz clic para seleccionar (solo Nombre y Apellido son obligatorios)</p>
                <input type="file" id="excelFileInput" accept=".xlsx,.xls" class="d-none">
            </div>
        </div>

        <!-- Clients Table -->
        <div class="mg-card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="clientesTable" class="table table-row-bordered align-middle gs-0 gy-3">
                        <thead>
                        <tr class="fw-bold text-muted">
                            <th>Cliente</th>
                            <th>Precio</th>
                            <th>Fecha Inicio</th>
                            <th>Vencimiento</th>
                            <th>Días Rest.</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                        </thead>
                        <tbody class="text-gray-600 fw-semibold"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB LOGS+ -->
    <div class="tab-pane fade" id="logsTab" role="tabpanel">
        <!-- Quick Add Form -->
        <div class="mg-card mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Registrar Movimiento</h5>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Descripción</label>
                        <input type="text" class="form-control form-control-lg" id="logDescripcion" placeholder="Ej: Vendido un Gatorade">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Monto ($)</label>
                        <input type="number" step="0.01" class="form-control form-control-lg" id="logMonto" placeholder="4 o -15">
                    </div>
                    <div class="col-md-3">
                        <button id="btnRegistrarLog" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-check-lg me-2"></i>Registrar
                        </button>
                    </div>
                </div>
                <small class="text-muted mt-2 d-block">Usa valores positivos para ingresos y negativos para gastos</small>
            </div>
        </div>

        <!-- Export and Clear Buttons -->
        <div class="d-flex gap-2 mb-4">
            <button id="btnEliminarTodosLogs" class="btn btn-danger">
                <i class="bi bi-trash3 me-2"></i>Eliminar Logs
            </button>
            <button id="btnExportLogsExcel" class="btn btn-success ms-auto">
                <i class="bi bi-file-earmark-excel me-2"></i>Exportar
            </button>
        </div>

        <!-- Logs Table -->
        <div class="mg-card">
            <div class="card-body">
                <div class="table-responsive">
                    <table id="logsTable" class="table table-row-bordered align-middle gs-0 gy-3">
                        <thead>
                        <tr class="fw-bold text-muted">
                            <th>Descripción</th>
                            <th>Cliente</th>
                            <th>Monto</th>
                            <th>Fecha</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB VENTAS -->
    <div class="tab-pane fade" id="ventasTab" role="tabpanel">
        <!-- Top Bar: Period Pills + Refresh -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <div class="mg-period-pills" id="ventasPeriodPills">
                <button class="mg-pill active" data-periodo="dia">Día</button>
                <button class="mg-pill" data-periodo="semana">Semana</button>
                <button class="mg-pill" data-periodo="mes">Mes</button>
            </div>
            <button id="btnRefrescarVentas" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-clockwise me-2"></i>Refrescar</button>
        </div>

        <!-- Ventas Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-6 col-12">
                <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, #7239EA 100%);">
                    <div class="card-body text-white">
                        <span class="d-block mb-2 opacity-75" id="ventasIngresosLabel">Ingresos del Día</span>
                        <span class="fs-2x fw-bolder" id="ventasIngresos">$0</span>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-6 col-12">
                <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-danger) 0%, #D9214E 100%);">
                    <div class="card-body text-white">
                        <span class="d-block mb-2 opacity-75" id="ventasGastosLabel">Gastos del Día</span>
                        <span class="fs-2x fw-bolder" id="ventasGastos">$0</span>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-6 col-12">
                <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-success) 0%, #2DBE6C 100%);">
                    <div class="card-body text-white">
                        <span class="d-block mb-2 opacity-75" id="ventasGananciaLabel">Ganancia Neta del Día</span>
                        <span class="fs-2x fw-bolder" id="ventasGanancia">$0</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="mg-card">
                    <div class="card-body text-center">
                        <i class="bi bi-calendar-check text-primary fs-1 mb-2"></i>
                        <h6 class="text-muted">Membresías 30 días (mes)</h6>
                        <span class="fs-3 fw-bold" id="ventasMembresias">$0</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mg-card">
                    <div class="card-body text-center">
                        <i class="bi bi-person-walking text-info fs-1 mb-2"></i>
                        <h6 class="text-muted">Clientes Diarios Hoy</h6>
                        <span class="fs-3 fw-bold" id="ventasClientesDiarios">0</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mg-card">
                    <div class="card-body text-center">
                        <i class="bi bi-graph-up-arrow text-success fs-1 mb-2"></i>
                        <h6 class="text-muted">Ganancia del Mes</h6>
                        <span class="fs-3 fw-bold" id="ventasGananciaMes">$0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="mg-card">
                    <div class="card-header bg-white border-0">
                        <h5 class="fw-bold mb-0">Ingresos vs Gastos</h5>
                    </div>
                    <div class="card-body"><div id="chartBarVentas"></div></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mg-card">
                    <div class="card-header bg-white border-0">
                        <h5 class="fw-bold mb-0">Nuevos Clientes</h5>
                    </div>
                    <div class="card-body"><div id="chartClientes"></div></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mg-card">
                    <div class="card-header bg-white border-0">
                        <h5 class="fw-bold mb-0" id="chartResumenTitle">Resumen del Día</h5>
                    </div>
                    <div class="card-body"><div id="chartResumen"></div></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mg-card">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Usuarios Diarios</h5>
                        <button id="btnEnviarMensajesMasivos" class="btn btn-sm btn-success">
                            <i class="bi bi-whatsapp me-2"></i>Mensaje
                        </button>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table id="tablaUsuariosDiarios" class="table table-row-bordered align-middle gs-0 gy-3">
                                <thead>
                                    <tr class="fw-bold text-muted">
                                        <th>Nombre</th>
                                        <th>Teléfono</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB NOTIFICACIONES -->
    <div class="tab-pane fade" id="notificacionesTab" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Notificaciones</h4>
            <div class="d-flex gap-2">
                <button id="btnGenerarNotificaciones" class="btn btn-primary">
                    <i class="bi bi-arrow-repeat me-2"></i>Generar Notificaciones
                </button>
                <button id="btnMarcarTodasLeidasTab" class="btn btn-outline-primary">
                    <i class="bi bi-check-all me-2"></i>Marcar todas leídas
                </button>
            </div>
        </div>

        <div id="notificacionesList" class="d-flex flex-column gap-2">
            <div class="text-center py-5 text-muted">
                <i class="bi bi-bell-slash fs-1 d-block mb-3"></i>
                <p>No hay notificaciones. Haz clic en "Generar Notificaciones" para verificar membresías próximas a vencer.</p>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear/Editar Cliente -->
<div class="modal fade" id="clienteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h3 class="modal-title fw-bolder" id="modalTitle">Nuevo Cliente</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="clienteForm">
                    <input type="hidden" id="clienteId" name="ClienteId" />
                    <input type="hidden" name="GimnasioId" value="@gimnasioId" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold required">Nombre</label>
                            <input type="text" class="form-control" name="Nombre" id="nombre" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold required">Apellido</label>
                            <input type="text" class="form-control" name="Apellido" id="apellido" required />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" name="Email" id="email" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold required">Teléfono</label>
                            <input type="tel" class="form-control" name="Telefono" id="telefono" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Dirección</label>
                        <input type="text" class="form-control" name="Direccion" id="direccion" />
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold required">Días</label>
                            <input type="number" class="form-control" name="Dias" id="dias" min="1" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold required">Precio ($)</label>
                            <input type="number" step="0.01" class="form-control" name="Precio" id="precio" min="0" required />
                        </div>
                        <div class="col-md-4 mb-3 pt-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="EsDiario" id="esDiario" value="true" />
                                <label class="form-check-label fw-semibold" for="esDiario">Es Diario</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarCliente" class="btn btn-primary"><i class="bi bi-save me-2"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Renovar -->
<div class="modal fade" id="renovarModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h3 class="modal-title fw-bolder">Renovar Membresía</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="renovarClienteId" />
                <p class="text-muted mb-4">Cliente: <strong id="renovarClienteNombre"></strong></p>
                <div class="mb-3">
                    <label class="form-label fw-semibold required">Días</label>
                    <input type="number" class="form-control" id="renovarDias" min="1" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold required">Precio ($)</label>
                    <input type="number" step="0.01" class="form-control" id="renovarPrecio" min="0" required />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarRenovar" class="btn btn-success"><i class="bi bi-save me-2"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Import Results -->
<div class="modal fade" id="importResultModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h3 class="modal-title fw-bolder">Resultado de Importación</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="importResultBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const gimnasioId = '@gimnasioId';
let tablaClientes, tablaLogs, tablaUsuariosDiarios;
let modoEdicion = false;

$(document).ready(function () {
    cargarEstadisticas();
    cargarTablaClientes();
    initLogsTab();
    cargarNotificacionesCount();

    // Generate notifications on load
    $.post('/Gimnasios/GenerarNotificaciones', { gimnasioId });
});

// Tab change via sidebar
document.addEventListener('mg-tab-shown', function(e) {
    if (e.detail.tab === 'ventasTab') {
        cargarVentasStats();
        cargarCharts();
    } else if (e.detail.tab === 'logsTab') {
        if (!tablaLogs) cargarTablaLogs();
    } else if (e.detail.tab === 'notificacionesTab') {
        cargarNotificacionesTab();
    }
});

// ===== CLIENTES =====
function cargarEstadisticas() {
    $.get('/Gimnasios/GetDashboardStats', { gimnasioId }, function(data) {
        $('#totalClientes').text(data.totalClientes);
        $('#clientesActivos').text(data.clientesActivos);
        $('#clientesVencidos').text(data.clientesVencidos);
        $('#ingresosMes').text('$' + data.ingresosMes.toFixed(2));
    });
}

function cargarTablaClientes() {
    tablaClientes = $('#clientesTable').DataTable({
        ajax: { url: '/Gimnasios/GetClientes', data: { gimnasioId }, dataSrc: '' },
        columns: [
            { data: null, render: (d,t,r) => `<strong>${r.nombreCompleto}</strong><br><small class="text-muted">${r.telefono || '-'}</small>` },
            { data: 'precio', render: d => '$' + d.toFixed(2) },
            { data: 'fechaDeCreacion', render: d => new Date(d).toLocaleDateString('es-MX') },
            { data: 'fechaQueTermina', render: d => new Date(d).toLocaleDateString('es-MX') },
            { data: 'diasRestantes', render: d => d < 0 ? '<span class="badge bg-danger">Vencido</span>' : `<span class="badge bg-${d <= 3 ? 'warning' : 'success'}">${d} días</span>` },
            { data: null, orderable: false, className: 'text-end', render: (d,t,r) => {
                let btns = '';
                const cleanPhone = r.telefono ? r.telefono.replace(/\D/g, '') : '';
                if (cleanPhone.length >= 10) {
                     btns += `<a href="https://wa.me/${cleanPhone}" class="btn btn-sm btn-icon btn-light-success me-1" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>`;
                }
                const safeName = r.nombreCompleto.replace(/'/g, "\\'");
                const safePrecio = r.precio || 0;
                btns += `
                    <button class="btn btn-sm btn-icon btn-light-warning me-1" onclick="abrirModalRenovar('${r.clienteId}','${safeName}', ${safePrecio})" title="Renovar"><i class="bi bi-arrow-repeat"></i></button>
                    <button class="btn btn-sm btn-icon btn-light-primary me-1" onclick="editarCliente('${r.clienteId}')" title="Editar"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-icon btn-light-danger" onclick="eliminarCliente('${r.clienteId}','${safeName}')" title="Eliminar"><i class="bi bi-trash"></i></button>
                `;
                return btns;
            }}
        ],
        order: [[4, 'asc']],
        responsive: true,
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' }
    });
}

$('#btnCrearCliente').click(function() {
    modoEdicion = false;
    $('#modalTitle').text('Nuevo Cliente');
    $('#clienteForm')[0].reset();
    $('#clienteId').val('');
    $('#clienteModal').modal('show');
});

$('#btnGuardarCliente').click(function() {
    if (!$('#clienteForm')[0].checkValidity()) { $('#clienteForm')[0].reportValidity(); return; }
    const url = modoEdicion ? '/Gimnasios/EditarCliente' : '/Gimnasios/CrearCliente';
    $.post(url, $('#clienteForm').serialize(), function(r) {
        if (r.success) {
            $('#clienteModal').modal('hide');
            tablaClientes.ajax.reload();
            cargarEstadisticas();
            if (tablaLogs) tablaLogs.ajax.reload();
            toastr.success(r.message);
        }
    }).fail(xhr => toastr.error(xhr.responseJSON?.message || 'Error'));
});

function editarCliente(id) {
    $.get('/Gimnasios/GetCliente', { id, gimnasioId }, function(d) {
        modoEdicion = true;
        $('#modalTitle').text('Editar Cliente');
        $('#clienteId').val(d.clienteId);
        $('#nombre').val(d.nombre);
        $('#apellido').val(d.apellido);
        $('#email').val(d.email);
        $('#telefono').val(d.telefono);
        $('#direccion').val(d.direccion);
        $('#dias').val(d.dias);
        $('#precio').val(d.precio);
        $('#esDiario').prop('checked', d.esDiario);
        $('#clienteModal').modal('show');
    });
}

function eliminarCliente(id, nombre) {
    Swal.fire({
        title: '¿Estás seguro?',
        text: `Se eliminará al cliente "${nombre}". Esta acción no se puede deshacer.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#F1416C',
        cancelButtonColor: '#3E97FF',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            $.post('/Gimnasios/EliminarCliente', { id, gimnasioId }, function(r) {
                if (r.success) {
                    tablaClientes.ajax.reload();
                    cargarEstadisticas();
                    if (tablaLogs) tablaLogs.ajax.reload();
                    Swal.fire('¡Eliminado!', r.message, 'success');
                } else {
                    Swal.fire('Error', r.message || 'No se pudo eliminar', 'error');
                }
            }).fail(xhr => Swal.fire('Error', xhr.responseJSON?.message || 'Ocurrió un error', 'error'));
        }
    });
}

function abrirModalRenovar(id, nombre, precio) {
    $('#renovarClienteId').val(id);
    $('#renovarClienteNombre').text(nombre);
    $('#renovarDias').val('30');
    $('#renovarPrecio').val(precio || '');
    $('#renovarModal').modal('show');
}

$('#btnConfirmarRenovar').click(function() {
    const id = $('#renovarClienteId').val();
    const dias = $('#renovarDias').val();
    const precio = $('#renovarPrecio').val();
    if (!dias || !precio) { toastr.error('Complete todos los campos'); return; }

    const btn = $(this);
    const originalText = btn.html();
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');

    $.post('/Gimnasios/RenovarCliente', { id, gimnasioId, dias, precio }, function(r) {
        if (r.success) {
            $('#renovarModal').modal('hide');
            tablaClientes.ajax.reload();
            cargarEstadisticas();
            if (tablaLogs) tablaLogs.ajax.reload();
            Swal.fire('¡Guardado!', r.message, 'success');
        }
    }).fail(xhr => {
        Swal.fire('Error', xhr.responseJSON?.message || 'Error al renovar', 'error');
    }).always(() => {
        btn.prop('disabled', false).html(originalText);
    });
});

$('#btnExportClientesExcel').click(() => window.location.href = '/Gimnasios/ExportClientesExcel?gimnasioId=' + gimnasioId);

// Import Excel
$('#btnImportarExcel').click(() => $('#importZone').toggleClass('d-none'));
$('#importZone').on('click', () => $('#excelFileInput').click());
$('#excelFileInput').on('change', function() { if (this.files.length) uploadExcel(this.files[0]); });
$('#importZone').on('dragover', e => { e.preventDefault(); $(e.currentTarget).addClass('border-primary'); });
$('#importZone').on('dragleave', e => $(e.currentTarget).removeClass('border-primary'));
$('#importZone').on('drop', function(e) { e.preventDefault(); $(this).removeClass('border-primary'); if (e.originalEvent.dataTransfer.files.length) uploadExcel(e.originalEvent.dataTransfer.files[0]); });

function uploadExcel(file) {
    const formData = new FormData();
    formData.append('file', file);
    formData.append('gimnasioId', gimnasioId);
    $.ajax({
        url: '/Gimnasios/ImportarClientesExcel',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function(r) {
            let html = `<div class="alert alert-success"><strong>${r.clientesCreados}</strong> clientes creados</div>`;
            if (r.clientesOmitidos > 0) html += `<div class="alert alert-warning"><strong>${r.clientesOmitidos}</strong> omitidos (duplicados)</div>`;
            if (r.erroresCount > 0) html += `<div class="alert alert-danger"><strong>${r.erroresCount}</strong> errores</div>`;
            $('#importResultBody').html(html);
            $('#importResultModal').modal('show');
            tablaClientes.ajax.reload();
            cargarEstadisticas();
            $('#importZone').addClass('d-none');
        },
        error: xhr => toastr.error(xhr.responseJSON?.message || 'Error al importar')
    });
}

// ===== LOGS =====
function initLogsTab() {}

function cargarTablaLogs() {
    if (tablaLogs) { tablaLogs.destroy(); }

    tablaLogs = $('#logsTable').DataTable({
        ajax: {
            url: '/Gimnasios/GetLogs',
            data: { gimnasioId: gimnasioId },
            dataSrc: '',
            error: function(xhr, error, code) {
                console.error('DataTables error:', xhr.responseText);
                toastr.error('Error al cargar los logs: ' + (xhr.responseJSON?.message || 'Error desconocido'));
            }
        },
        columns: [
            { data: 'message' },
            { data: 'nombreCliente', render: d => d || '<span class="text-muted">-</span>' },
            { data: 'monto', render: d => `<span class="${d >= 0 ? 'text-success' : 'text-danger'} fw-bold">${d >= 0 ? '+' : ''}$${d.toFixed(2)}</span>` },
            { data: 'fecha', render: d => new Date(d).toLocaleString('es-MX') }
        ],
        order: [[3, 'desc']],
        language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' }
    });
}

$('#btnRegistrarLog').click(function() {
    const message = $('#logDescripcion').val();
    const monto = $('#logMonto').val();
    if (!message || monto === '') { toastr.error('Complete todos los campos'); return; }
    $.post('/Gimnasios/CrearLog', { GimnasioId: gimnasioId, Message: message, Monto: monto }, function(r) {
        if (r.success) { $('#logDescripcion').val(''); $('#logMonto').val(''); tablaLogs.ajax.reload(); toastr.success(r.message); }
    }).fail(xhr => toastr.error(xhr.responseJSON?.message || 'Error'));
});

$('#btnExportLogsExcel').click(function() {
    window.location.href = `/Gimnasios/ExportLogsExcel?gimnasioId=${gimnasioId}`;
});

$('#btnEliminarTodosLogs').click(function() {
    Swal.fire({
        title: '¿Estás seguro?',
        text: "Se eliminarán TODOS los logs. Esta acción no se puede deshacer.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#F1416C',
        cancelButtonColor: '#3E97FF',
        confirmButtonText: 'Sí, eliminar todo',
        cancelButtonText: 'Cancelar'
    }).then((result) => {
        if (result.isConfirmed) {
            $.post('/Gimnasios/EliminarTodosLogs', { gimnasioId }, function(r) {
                if (r.success) {
                    tablaLogs.ajax.reload();
                    Swal.fire('¡Eliminados!', r.message, 'success');
                } else {
                    Swal.fire('Error', r.message || 'No se pudieron eliminar los logs', 'error');
                }
            }).fail(xhr => Swal.fire('Error', xhr.responseJSON?.message || 'Ocurrió un error', 'error'));
        }
    });
});

// ===== VENTAS =====
let chartBarVentas = null, chartClientes = null, chartResumen = null;
let ventasPeriodoActual = 'dia';
let ventasStatsData = null;

const periodoLabels = {
    dia: { ingresos: 'Ingresos del Día', gastos: 'Gastos del Día', ganancia: 'Ganancia Neta del Día', resumen: 'Resumen del Día' },
    semana: { ingresos: 'Ingresos de la Semana', gastos: 'Gastos de la Semana', ganancia: 'Ganancia Neta de la Semana', resumen: 'Resumen de la Semana' },
    mes: { ingresos: 'Ingresos del Mes', gastos: 'Gastos del Mes', ganancia: 'Ganancia Neta del Mes', resumen: 'Resumen del Mes' }
};

const periodoKeys = {
    dia: { ingresos: 'ingresosDia', gastos: 'gastosDia', ganancia: 'gananciaDia' },
    semana: { ingresos: 'ingresosSemana', gastos: 'gastosSemana', ganancia: 'gananciaSemana' },
    mes: { ingresos: 'ingresosMes', gastos: 'gastosMes', ganancia: 'gananciaMes' }
};

function cargarVentasStats() {
    $.get('/Gimnasios/GetVentasStats', { gimnasioId }, function(d) {
        ventasStatsData = d;
        actualizarStatCards();
        $('#ventasMembresias').text('$' + d.membresias30Dias.toFixed(2));
        $('#ventasClientesDiarios').text(d.clientesDiariosHoy);
        $('#ventasGananciaMes').text('$' + d.gananciaMes.toFixed(2));
    });
}

function actualizarStatCards() {
    if (!ventasStatsData) return;
    const d = ventasStatsData;
    const keys = periodoKeys[ventasPeriodoActual];
    const labels = periodoLabels[ventasPeriodoActual];

    $('#ventasIngresosLabel').text(labels.ingresos);
    $('#ventasGastosLabel').text(labels.gastos);
    $('#ventasGananciaLabel').text(labels.ganancia);
    $('#ventasIngresos').text('$' + d[keys.ingresos].toFixed(2));
    $('#ventasGastos').text('$' + d[keys.gastos].toFixed(2));
    $('#ventasGanancia').text('$' + d[keys.ganancia].toFixed(2));
    $('#chartResumenTitle').text(labels.resumen);
}

function cargarCharts() {
    const periodo = ventasPeriodoActual;

    // Bar chart: Ingresos vs Gastos
    $.get('/Gimnasios/GetChartData', { gimnasioId, periodo }, function(d) {
        if (chartBarVentas) chartBarVentas.destroy();
        chartBarVentas = new ApexCharts(document.querySelector("#chartBarVentas"), {
            series: [{ name: 'Ingresos', data: d.ingresos }, { name: 'Gastos', data: d.gastos }],
            chart: { type: 'bar', height: 300, toolbar: { show: false } },
            colors: ['#50CD89', '#F1416C'],
            xaxis: { categories: d.labels },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
            dataLabels: { enabled: false },
            legend: { position: 'top' }
        });
        chartBarVentas.render();

        // Donut: Resumen from the same data
        const totalIngresos = d.ingresos.reduce((a, b) => a + b, 0);
        const totalGastos = d.gastos.reduce((a, b) => a + b, 0);
        if (chartResumen) chartResumen.destroy();
        chartResumen = new ApexCharts(document.querySelector("#chartResumen"), {
            series: [totalIngresos || 1, totalGastos || 0],
            chart: { type: 'donut', height: 300 },
            labels: ['Ingresos', 'Gastos'],
            colors: ['#50CD89', '#F1416C'],
            legend: { position: 'bottom' },
            plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Total', formatter: w => '$' + w.globals.seriesTotals.reduce((a,b)=>a+b,0).toFixed(2) } } } } },
            dataLabels: { enabled: true, formatter: (val) => val.toFixed(1) + '%' }
        });
        chartResumen.render();
    });

    // Area chart: Nuevos Clientes
    $.get('/Gimnasios/GetClientesChartData', { gimnasioId, periodo }, function(d) {
        if (chartClientes) chartClientes.destroy();
        chartClientes = new ApexCharts(document.querySelector("#chartClientes"), {
            series: [{ name: 'Nuevos Clientes', data: d.nuevosClientes }],
            chart: { type: 'area', height: 300, toolbar: { show: false } },
            colors: ['#3E97FF'],
            xaxis: { categories: d.labels },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.1 } },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 2 }
        });
        chartClientes.render();
    });

    // Tabla usuarios diarios
    if (tablaUsuariosDiarios) { tablaUsuariosDiarios.destroy(); }
    tablaUsuariosDiarios = $('#tablaUsuariosDiarios').DataTable({
        ajax: { url: '/Gimnasios/GetClientesDiarios', data: { gimnasioId }, dataSrc: '' },
        columns: [
            { data: 'nombreCompleto' },
            { data: 'telefono', render: d => d || '<span class="text-muted">No registrado</span>' },
            { data: 'fechaDeCreacion', render: d => new Date(d).toLocaleDateString('es-MX') }
        ],
        pageLength: 5,
        lengthChange: false,
        searching: false,
        info: false
    });
}

// Period pill click handler
$('#ventasPeriodPills').on('click', '.mg-pill', function() {
    $('#ventasPeriodPills .mg-pill').removeClass('active');
    $(this).addClass('active');
    ventasPeriodoActual = $(this).data('periodo');
    actualizarStatCards();
    cargarCharts();
});

$('#btnRefrescarVentas').click(function() {
    cargarVentasStats();
    cargarCharts();
});

