        title: 'Mensaje de Mi Negocio',
        text: 'Disculpa por las molestias, aún estamos trabajando en los mensajes para listas de difusión. Por ahora puedes usar el mensaje unitario que se encuentra en tu lista de clientes principal.',
        confirmButtonText: 'Entendido',
        confirmButtonColor: '#3E97FF'
    });
});

// ===== NOTIFICACIONES =====
function cargarNotificacionesCount() {
    $.get('/Gimnasios/GetNotificacionesCount', { gimnasioId }, function(d) {
        const count = d.count;
        if (count > 0) {
            $('#topbarNotifBadge').text(count).removeClass('d-none');
            $('#sidebarNotifBadge').text(count).removeClass('d-none');
        } else {
            $('#topbarNotifBadge').addClass('d-none');
            $('#sidebarNotifBadge').addClass('d-none');
        }
    });
}

function cargarNotificacionesDropdown() {
    $.get('/Gimnasios/GetNotificaciones', { gimnasioId }, function(data) {
        let html = '';
        if (data.length === 0) {
            html = '<div class="text-center py-4 text-muted"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i>Sin notificaciones</div>';
        } else {
            data.slice(0, 10).forEach(n => {
                html += `<div class="mg-notification-item ${n.leida ? '' : 'unread'}" data-id="${n.id}">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-clock-fill ${n.leida ? 'text-muted' : 'text-warning'} mt-1"></i>
                        <div>
                            <p class="mb-1 small ${n.leida ? 'text-muted' : 'fw-semibold'}">${n.mensaje}</p>
                            <small class="text-muted">${new Date(n.fechaCreacion).toLocaleString('es-MX')}</small>
                        </div>
                    </div>
                </div>`;
            });
        }
        $('#notifDropdownBody').html(html);
    });
}

function cargarNotificacionesTab() {
    $.get('/Gimnasios/GetNotificaciones', { gimnasioId }, function(data) {
        let html = '';
        if (data.length === 0) {
            html = '<div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i><p>No hay notificaciones.</p></div>';
        } else {
            data.forEach(n => {
                html += `<div class="mg-card p-3 ${n.leida ? '' : 'border-start border-3 border-primary'}">
                    <div class="d-flex align-items-start gap-3">
                        <div class="stat-icon ${n.leida ? 'bg-light' : 'bg-light-warning'}" style="min-width:40px;">
                            <i class="bi bi-clock-fill ${n.leida ? 'text-muted' : 'text-warning'}"></i>
                        </div>
                        <div class="flex-grow-1">
                            <p class="mb-1 ${n.leida ? 'text-muted' : 'fw-semibold'}">${n.mensaje}</p>
                            <small class="text-muted">${new Date(n.fechaCreacion).toLocaleString('es-MX')}</small>
                        </div>
                        ${!n.leida ? `<button class="btn btn-sm btn-light-primary" onclick="marcarLeida('${n.id}')"><i class="bi bi-check"></i></button>` : ''}
                    </div>
                </div>`;
            });
        }
        $('#notificacionesList').html(html);
    });
}

function marcarLeida(id) {
    $.post('/Gimnasios/MarcarNotificacionLeida', { id, gimnasioId }, function(r) {
        if (r.success) {
            cargarNotificacionesTab();
            cargarNotificacionesCount();
        }
    });
}

$('#bellBtn').on('show.bs.dropdown', function() {
    cargarNotificacionesDropdown();
});

$('#btnMarcarTodasLeidas, #btnMarcarTodasLeidasTab').click(function() {
    $.post('/Gimnasios/MarcarTodasNotificacionesLeidas', { gimnasioId }, function(r) {
        if (r.success) {
            toastr.success(r.message);
            cargarNotificacionesCount();
            cargarNotificacionesDropdown();
            cargarNotificacionesTab();
        }
    });
});

$('#btnGenerarNotificaciones').click(function() {
    const btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Generando...');
    $.post('/Gimnasios/GenerarNotificaciones', { gimnasioId }, function(r) {
        if (r.success) {
            toastr.success(r.message);
            cargarNotificacionesTab();
            cargarNotificacionesCount();
        }
    }).always(() => {
        btn.prop('disabled', false).html('<i class="bi bi-arrow-repeat me-2"></i>Generar Notificaciones');
    });
});
</script>
}
