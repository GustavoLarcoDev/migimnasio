@{
    ViewData["Title"] = "Seguimiento de pedido";
    var pedidoId = ViewBag.PedidoId?.ToString() ?? "";
}

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
<style>
    /* ── Page Layout ──────────────────────────────────── */
    .tracking-page {
        min-height: calc(100vh - 160px);
    }
    .tracking-header {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        padding: 1rem 0;
    }
    .tracking-header h1 {
        font-weight: 800;
        font-size: 1.25rem;
        margin: 0;
    }

    /* ── Step Indicator ───────────────────────────────── */
    .tracking-steps {
        display: flex;
        flex-direction: column;
    }
    .step {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        position: relative;
    }
    .step-connector {
        position: absolute;
        left: 17px;
        top: 36px;
        width: 2px;
        height: calc(100% - 20px);
    }
    .step:last-child .step-connector { display: none; }

    .step-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .85rem;
        flex-shrink: 0;
        z-index: 1;
        transition: all .3s;
    }
    .step.completed .step-icon {
        background: #28a745;
        color: #fff;
    }
    .step.completed .step-connector {
        background: #28a745;
    }
    .step.active .step-icon {
        background: #0d6efd;
        color: #fff;
        animation: stepPulse 2s infinite;
        box-shadow: 0 0 0 6px rgba(13,110,253,.2);
    }
    .step.active .step-connector {
        background: linear-gradient(to bottom, #0d6efd 0%, #e9ecef 100%);
    }
    .step.pending .step-icon {
        background: #e9ecef;
        color: #adb5bd;
    }
    .step.pending .step-connector {
        background: #e9ecef;
    }

    @@keyframes stepPulse {
        0%, 100% { box-shadow: 0 0 0 6px rgba(13,110,253,.2); }
        50% { box-shadow: 0 0 0 12px rgba(13,110,253,.1); }
    }

    .step-content {
        padding-bottom: 1.25rem;
        min-height: 52px;
    }
    .step-title {
        font-weight: 700;
        font-size: .9rem;
        color: #212529;
        margin-bottom: .1rem;
    }
    .step.pending .step-title { color: #adb5bd; }
    .step-time {
        font-size: .78rem;
        color: #6c757d;
    }

    /* ── Map ──────────────────────────────────────────── */
    #tracking-map {
        height: 350px;
        border-radius: 1rem;
        z-index: 1;
    }
    @@media (max-width: 767px) {
        #tracking-map { height: 250px; }
    }

    /* ── Cards ────────────────────────────────────────── */
    .info-card {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 1.1rem;
        margin-bottom: 1rem;
    }
    .info-card h6 {
        font-weight: 700;
        margin-bottom: .6rem;
    }

    /* ── Motorizado Card ─────────────────────────────── */
    .moto-card {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .moto-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        background: #e9ecef;
    }
    .moto-avatar-placeholder {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d6efd, #6610f2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.5rem;
        flex-shrink: 0;
    }
    .moto-actions {
        display: flex;
        gap: .5rem;
        margin-top: .5rem;
    }
    .moto-actions a {
        padding: .35rem .75rem;
        border-radius: 2rem;
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
    }

    /* ── Proximity Banner ────────────────────────────── */
    .proximity-banner {
        display: none;
        background: linear-gradient(135deg, #28a745, #20c997);
        color: #fff;
        text-align: center;
        padding: .75rem;
        border-radius: .75rem;
        font-weight: 700;
        font-size: .95rem;
        animation: bannerPulse 2s infinite;
        margin-bottom: 1rem;
    }
    .proximity-banner.visible { display: block; }
    @@keyframes bannerPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.02); }
    }

    /* ── Cancelled State ─────────────────────────────── */
    .cancelled-overlay {
        text-align: center;
        padding: 3rem 1rem;
    }

    /* ── Connection Banner ────────────────────────────── */
    .conn-banner {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1050;
        padding: .5rem;
        text-align: center;
        font-size: .85rem;
        font-weight: 600;
        display: none;
    }
</style>
}

<div class="conn-banner" id="conn-banner"></div>

<div class="tracking-header">
    <div class="container d-flex align-items-center gap-3">
        <a href="/Delivery" class="text-white text-decoration-none">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <h1><i class="bi bi-geo-alt me-2"></i>Seguimiento de pedido</h1>
    </div>
</div>

<div class="container py-3 tracking-page" id="tracking-content" style="display:none;">
    <!-- Proximity Banner -->
    <div class="proximity-banner" id="proximity-banner">
        <i class="bi bi-bicycle me-2"></i>Tu pedido esta cerca! Estate atento.
    </div>

    <div class="row g-3">
        <!-- Left Column: Steps + Motorizado -->
        <div class="col-lg-5 order-lg-1 order-2">
            <!-- Step Indicator -->
            <div class="info-card">
                <h6><i class="bi bi-list-check me-2"></i>Estado del pedido</h6>
                <div class="tracking-steps" id="tracking-steps">
                    <!-- Steps rendered by JS -->
                </div>
            </div>

            <!-- Motorizado Info (hidden initially) -->
            <div class="info-card" id="moto-card" style="display:none;">
                <h6><i class="bi bi-person-badge me-2"></i>Tu motorizado</h6>
                <div class="moto-card">
                    <div id="moto-avatar"></div>
                    <div class="flex-grow-1">
                        <div class="fw-bold" id="moto-name">-</div>
                        <div class="text-muted small" id="moto-stats">-</div>
                        <div class="moto-actions" id="moto-actions"></div>
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="info-card">
                <h6><i class="bi bi-bag me-2"></i>Tu pedido</h6>
                <div id="order-items"></div>
                <hr class="my-2">
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Comida</span>
                    <span class="fw-bold" id="cost-food">$0.00</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Delivery</span>
                    <span class="fw-bold" id="cost-delivery">$0.00</span>
                </div>
                <div class="d-flex justify-content-between mt-1 pt-1 border-top">
                    <span class="fw-bold">Total</span>
                    <span class="fw-bold text-primary fs-5" id="cost-total">$0.00</span>
                </div>
            </div>

            <!-- Cancel Button (only for early states) -->
            <div id="cancel-section" class="text-center mb-3">
                <button class="btn btn-outline-danger rounded-pill px-4" id="btn-cancel" onclick="cancelarPedido()">
                    <i class="bi bi-x-circle me-1"></i> Cancelar pedido
                </button>
            </div>
        </div>

        <!-- Right Column: Map -->
        <div class="col-lg-7 order-lg-2 order-1">
            <div class="info-card">
                <h6><i class="bi bi-map me-2"></i>Mapa en tiempo real</h6>
                <div id="tracking-map"></div>
            </div>
        </div>
    </div>
</div>

<!-- Loading State -->
<div class="text-center py-5" id="loading-state">
    <div class="spinner-grow text-primary" style="width:3rem;height:3rem;" role="status"></div>
    <p class="text-muted mt-3 fs-5">Cargando seguimiento...</p>
</div>

<!-- Cancelled State -->
<div class="cancelled-overlay" id="cancelled-state" style="display:none;">
    <i class="bi bi-x-circle text-danger" style="font-size:4rem;"></i>
    <h3 class="fw-bold mt-3">Pedido cancelado</h3>
    <p class="text-muted fs-5" id="cancel-reason">-</p>
    <a href="/Delivery" class="btn btn-primary rounded-pill px-4 mt-2">
        <i class="bi bi-arrow-left me-1"></i> Volver al inicio
    </a>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
(function () {
    'use strict';

    var pedidoId = '@pedidoId';
    if (!pedidoId) { window.location.href = '/Delivery'; return; }

    var map, markerRestaurante, markerCliente, markerMoto;
    var pedidoData = null;

    // ── Interval Tracking (memory leak prevention) ────────
    var fallbackPollingId = null;
    var fallbackPollingStarted = false;

    function cleanupAllIntervals() {
        if (fallbackPollingId) { clearInterval(fallbackPollingId); fallbackPollingId = null; }
    }

    window.addEventListener('beforeunload', cleanupAllIntervals);

    // ── Step Definitions ───────────────────────────────────
    var STEPS = [
        { key: 'nuevo',       icon: 'bi-check-lg',          title: 'Pedido creado',                    dateField: 'fechaCreacion' },
        { key: 'tomado',      icon: 'bi-bicycle',           title: 'Motorizado acepto',                dateField: 'fechaTomado' },
        { key: 'confirmado',  icon: 'bi-clipboard-check',   title: 'Restaurante confirmo items',       dateField: 'fechaConfirmado' },
        { key: 'preparando',  icon: 'bi-fire',              title: 'Preparando tu orden',              dateField: 'fechaPreparando' },
        { key: 'listo',       icon: 'bi-bag-check',         title: 'Comida lista',                     dateField: 'fechaListo' },
        { key: 'recogido',    icon: 'bi-box-seam',          title: 'Motorizado recogio la comida',     dateField: 'fechaRecogido' },
        { key: 'en_camino',   icon: 'bi-truck',             title: 'En camino hacia ti',               dateField: 'fechaRecogido' },
        { key: 'entregado',   icon: 'bi-check-circle-fill', title: 'Entregado',                        dateField: 'fechaEntregado' }
    ];

    var STATE_ORDER = ['nuevo', 'tomado', 'confirmado', 'preparando', 'listo', 'recogido', 'en_camino', 'entregado'];

    function getStepIndex(estado) {
        var idx = STATE_ORDER.indexOf(estado);
        return idx >= 0 ? idx : 0;
    }

    // ── Format Date/Time ───────────────────────────────────
    function fmtTime(dateStr) {
        if (!dateStr) return '';
        var d = new Date(dateStr);
        if (isNaN(d.getTime())) return '';
        return d.toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' });
    }

    // ── Render Steps ───────────────────────────────────────
    function renderSteps(data) {
        var stepsContainer = document.getElementById('tracking-steps');
        stepsContainer.innerHTML = '';

        var currentIdx = getStepIndex(data.estado);

        STEPS.forEach(function (step, i) {
            var status = 'pending';
            if (i < currentIdx) status = 'completed';
            else if (i === currentIdx) status = 'active';

            var timeStr = '';
            if (data[step.dateField] && (status === 'completed' || status === 'active')) {
                timeStr = fmtTime(data[step.dateField]);
            }

            var stepEl = document.createElement('div');
            stepEl.className = 'step ' + status;
            stepEl.innerHTML =
                '<div class="step-icon"><i class="bi ' + step.icon + '"></i></div>' +
                '<div class="step-connector"></div>' +
                '<div class="step-content">' +
                '  <div class="step-title">' + step.title + '</div>' +
                (timeStr ? '<div class="step-time">' + timeStr + '</div>' : '') +
                '</div>';

            stepsContainer.appendChild(stepEl);
        });
    }

    // ── Render Order Items ─────────────────────────────────
    function renderItems(data) {
        var container = document.getElementById('order-items');
        container.innerHTML = '';

        if (data.items) {
            data.items.forEach(function (item) {
                var div = document.createElement('div');
                div.className = 'd-flex justify-content-between py-1';
                var nameHtml = escHtml(item.nombreProducto);
                if (item.rechazado) {
                    nameHtml = '<del class="text-muted">' + nameHtml + '</del> <span class="badge bg-danger-subtle text-danger">No disponible</span>';
                }
                div.innerHTML =
                    '<span>' + item.cantidad + 'x ' + nameHtml + '</span>' +
                    '<span class="fw-semibold' + (item.rechazado ? ' text-muted text-decoration-line-through' : '') + '">$' + item.subtotal.toFixed(2) + '</span>';
                container.appendChild(div);
            });
        }

        document.getElementById('cost-food').textContent = '$' + (data.costoComida || 0).toFixed(2);
        document.getElementById('cost-delivery').textContent = '$' + (data.costoEnvio || 0).toFixed(2);
        document.getElementById('cost-total').textContent = '$' + (data.total || 0).toFixed(2);
    }

    // ── Render Motorizado Info ─────────────────────────────
    function renderMotorizado(data) {
        if (!data.motorizadoNombre) {
            document.getElementById('moto-card').style.display = 'none';
            return;
        }

        document.getElementById('moto-card').style.display = 'block';
        document.getElementById('moto-name').textContent = data.motorizadoNombre;
        document.getElementById('moto-stats').textContent =
            (data.motorizadoTotalEntregas || 0) + ' entregas realizadas';

        var avatarEl = document.getElementById('moto-avatar');
        if (data.motorizadoFoto) {
            avatarEl.innerHTML = '<img src="' + escAttr(data.motorizadoFoto) + '" class="moto-avatar" alt="">';
        } else {
            avatarEl.innerHTML = '<div class="moto-avatar-placeholder"><i class="bi bi-person-fill"></i></div>';
        }

        var actionsEl = document.getElementById('moto-actions');
        actionsEl.innerHTML = '';
        if (data.motorizadoTelefono) {
            var tel = data.motorizadoTelefono.replace(/\s/g, '');
            actionsEl.innerHTML =
                '<a href="tel:' + tel + '" class="btn btn-sm btn-outline-primary">' +
                '  <i class="bi bi-telephone me-1"></i>Llamar' +
                '</a>' +
                '<a href="https://wa.me/' + tel.replace('+', '') + '" target="_blank" class="btn btn-sm btn-success">' +
                '  <i class="bi bi-whatsapp me-1"></i>WhatsApp' +
                '</a>';
        }
    }

    // ── Cancel Visibility ──────────────────────────────────
    function updateCancelVisibility(estado) {
        var cancelable = ['nuevo', 'tomado', 'confirmado'];
        document.getElementById('cancel-section').style.display =
            cancelable.indexOf(estado) >= 0 ? '' : 'none';
    }

    // ── Map Setup ──────────────────────────────────────────
    function initMap(data) {
        if (map) return; // Already initialized

        var centerLat = data.latitudCliente || -0.1807;
        var centerLng = data.longitudCliente || -78.4678;

        map = L.map('tracking-map').setView([centerLat, centerLng], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap',
            maxZoom: 19
        }).addTo(map);

        // Restaurant marker (red)
        if (data.latitudRestaurante && data.longitudRestaurante &&
            data.latitudRestaurante !== 0 && data.longitudRestaurante !== 0) {
            markerRestaurante = L.marker(
                [data.latitudRestaurante, data.longitudRestaurante],
                { icon: createIcon('#dc3545', 'bi-shop') }
            ).addTo(map).bindPopup('<strong>' + escHtml(data.restauranteNombre) + '</strong><br>Restaurante');
        }

        // Client marker (green)
        if (data.latitudCliente && data.longitudCliente) {
            markerCliente = L.marker(
                [data.latitudCliente, data.longitudCliente],
                { icon: createIcon('#28a745', 'bi-house-door-fill') }
            ).addTo(map).bindPopup('<strong>Tu ubicacion</strong>');
        }

        // Motorizado marker (blue) — only if we have position
        if (data.motorizadoLatitud && data.motorizadoLongitud) {
            markerMoto = L.marker(
                [data.motorizadoLatitud, data.motorizadoLongitud],
                { icon: createIcon('#0d6efd', 'bi-bicycle') }
            ).addTo(map).bindPopup('<strong>Motorizado</strong>');
        }

        // Fit bounds to show all markers
        var bounds = [];
        if (markerCliente) bounds.push(markerCliente.getLatLng());
        if (markerRestaurante) bounds.push(markerRestaurante.getLatLng());
        if (markerMoto) bounds.push(markerMoto.getLatLng());
        if (bounds.length >= 2) {
            map.fitBounds(bounds, { padding: [50, 50] });
        }

        setTimeout(function () { map.invalidateSize(); }, 300);
    }

    function createIcon(color, iconClass) {
        return L.divIcon({
            html: '<div style="background:' + color + ';width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.3);">' +
                  '<i class="bi ' + iconClass + '" style="color:#fff;font-size:.9rem;"></i></div>',
            className: '',
            iconSize: [32, 32],
            iconAnchor: [16, 16]
        });
    }

    function updateMotoMarker(lat, lng) {
        if (!map) return;
        if (!markerMoto) {
            markerMoto = L.marker([lat, lng], {
                icon: createIcon('#0d6efd', 'bi-bicycle')
            }).addTo(map).bindPopup('<strong>Motorizado</strong>');
        } else {
            markerMoto.setLatLng([lat, lng]);
        }
    }

    // ── Load Tracking Data ─────────────────────────────────
    async function loadTracking() {
        try {
            var res = await fetch('/Delivery/GetPedidoTracking/' + pedidoId);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            var data = await res.json();

            if (!data) {
                document.getElementById('loading-state').innerHTML =
                    '<div class="text-center py-5"><i class="bi bi-exclamation-triangle text-warning" style="font-size:3rem;"></i>' +
                    '<h5 class="mt-3">Pedido no encontrado</h5>' +
                    '<a href="/Delivery" class="btn btn-primary rounded-pill mt-2">Volver</a></div>';
                return;
            }

            pedidoData = data;

            // Handle cancelled
            if (data.estado === 'cancelado') {
                document.getElementById('loading-state').style.display = 'none';
                var cancelState = document.getElementById('cancelled-state');
                cancelState.style.display = 'block';
                var reason = '';
                if (data.canceladoPor) reason += 'Cancelado por: ' + data.canceladoPor;
                if (data.razonCancelacion) reason += (reason ? '. ' : '') + data.razonCancelacion;
                document.getElementById('cancel-reason').textContent = reason || 'Sin razon especificada';
                return;
            }

            // Handle delivered
            if (data.estado === 'entregado') {
                showDeliveredAlert(data);
            }

            // Render everything
            document.getElementById('loading-state').style.display = 'none';
            document.getElementById('tracking-content').style.display = 'block';

            renderSteps(data);
            renderItems(data);
            renderMotorizado(data);
            updateCancelVisibility(data.estado);
            initMap(data);
        } catch (err) {
            console.error('Error loading tracking:', err);
            document.getElementById('loading-state').innerHTML =
                '<div class="text-center py-5"><i class="bi bi-wifi-off text-danger" style="font-size:3rem;"></i>' +
                '<h5 class="mt-3">Error de conexion</h5>' +
                '<button class="btn btn-primary rounded-pill mt-2" onclick="window.location.reload()">Reintentar</button></div>';
        }
    }

    // ── Delivered Alert ─────────────────────────────────────
    function showDeliveredAlert(data) {
        Swal.fire({
            title: 'Pedido entregado!',
            html:
                '<div class="text-center">' +
                '  <p class="fs-5">Paga al motorizado:</p>' +
                '  <h2 class="text-success fw-bold">$' + (data.costoEnvio || 0).toFixed(2) + '</h2>' +
                '  <p class="text-muted">por el delivery</p>' +
                '  <hr>' +
                '  <p class="mb-1">Total comida: <strong>$' + (data.costoComida || 0).toFixed(2) + '</strong></p>' +
                '  <p class="mb-1">Total delivery: <strong>$' + (data.costoEnvio || 0).toFixed(2) + '</strong></p>' +
                '  <p class="fw-bold fs-5 mt-2">Total: $' + (data.total || 0).toFixed(2) + '</p>' +
                '</div>',
            icon: 'success',
            confirmButtonText: 'Entendido',
            confirmButtonColor: '#0d6efd',
            allowOutsideClick: false
        });
    }

    // ── Update UI from SignalR event ───────────────────────
    function refreshTracking(checkTerminal) {
        loadTracking().then(function () {
            // Stop polling if order reached a terminal state
            if (checkTerminal && pedidoData) {
                var estado = pedidoData.estado;
                if (estado === 'entregado' || estado === 'cancelado') {
                    cleanupAllIntervals();
                }
            }
        });
    }

    // ── SignalR ────────────────────────────────────────────
    var connBanner = document.getElementById('conn-banner');

    var connection = new signalR.HubConnectionBuilder()
        .withUrl('/hubs/pedido')
        .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
        .build();

    // All state-change events trigger a full refresh
    connection.on('PedidoTomado', function (data) {
        toastr.success('Motorizado encontrado: ' + (data.motorizadoNombre || ''));
        refreshTracking();
    });

    connection.on('ItemsConfirmados', function () {
        toastr.info('El restaurante confirmo tus items');
        refreshTracking();
    });

    connection.on('OrdenIniciada', function () {
        toastr.info('Tu orden esta siendo preparada');
        refreshTracking();
    });

    connection.on('ComidaLista', function () {
        toastr.info('Tu comida esta lista!');
        refreshTracking();
    });

    connection.on('ComidaRecogida', function () {
        toastr.success('El motorizado recogio tu comida!');
        refreshTracking();
    });

    connection.on('UbicacionMotorizado', function (data) {
        if (data && data.latitud && data.longitud) {
            updateMotoMarker(data.latitud, data.longitud);
        }
    });

    connection.on('PedidoCerca', function () {
        document.getElementById('proximity-banner').classList.add('visible');
        toastr.success('Tu pedido esta muy cerca!', '', { timeOut: 8000 });
    });

    connection.on('PedidoEntregado', function () {
        cleanupAllIntervals();
        refreshTracking();
    });

    connection.on('PedidoCancelado', function (data) {
        cleanupAllIntervals();
        Swal.fire({
            title: 'Pedido cancelado',
            text: data.razon || 'El pedido fue cancelado',
            icon: 'info',
            confirmButtonText: 'Entendido',
            confirmButtonColor: '#0d6efd'
        }).then(function () {
            window.location.href = '/Delivery';
        });
    });

    connection.on('ItemRechazado', function (data) {
        toastr.warning('Un item no esta disponible: ' + (data.nombreProducto || ''));
        refreshTracking();
    });

    connection.on('EstadoCambiado', function () {
        refreshTracking();
    });

    connection.onreconnecting(function () {
        connBanner.className = 'conn-banner';
        connBanner.style.display = 'block';
        connBanner.style.background = '#ffc107';
        connBanner.style.color = '#000';
        connBanner.textContent = 'Reconectando...';
    });

    connection.onreconnected(function () {
        connBanner.style.display = 'none';
        connection.invoke('JoinPedidoGroup', pedidoId).catch(function () {});
        refreshTracking();
    });

    connection.onclose(function () {
        connBanner.className = 'conn-banner';
        connBanner.style.display = 'block';
        connBanner.style.background = '#dc3545';
        connBanner.style.color = '#fff';
        connBanner.textContent = 'Sin conexion. Reintentando...';
        // Fallback polling (guard against duplicate creation)
        if (!fallbackPollingStarted) {
            fallbackPollingStarted = true;
            fallbackPollingId = setInterval(function () { refreshTracking(true); }, 15000);
        }
    });

    connection.start()
        .then(function () {
            return connection.invoke('JoinPedidoGroup', pedidoId);
        })
        .catch(function (err) {
            console.error('SignalR error:', err);
            // Fallback: poll (guard against duplicate creation)
            if (!fallbackPollingStarted) {
                fallbackPollingStarted = true;
                fallbackPollingId = setInterval(function () { refreshTracking(true); }, 15000);
            }
        });

    // ── Cancel ─────────────────────────────────────────────
    window.cancelarPedido = function () {
        Swal.fire({
            title: 'Cancelar pedido?',
            text: 'Estas seguro de que quieres cancelar tu pedido?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Si, cancelar',
            cancelButtonText: 'No',
            confirmButtonColor: '#dc3545'
        }).then(async function (result) {
            if (!result.isConfirmed) return;

            try {
                var res = await fetch('/Delivery/CancelarPedido', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pedidoId: pedidoId, razon: 'Cancelado por el cliente' })
                });
                var data = await res.json();

                if (data.success) {
                    toastr.info('Pedido cancelado');
                    setTimeout(function () { window.location.href = '/Delivery'; }, 1000);
                } else {
                    Swal.fire('Error', data.message || 'No se pudo cancelar', 'error');
                }
            } catch (err) {
                Swal.fire('Error', 'Error de conexion', 'error');
            }
        });
    };

    // ── Helpers ─────────────────────────────────────────────
    function escHtml(s) {
        if (!s) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s));
        return d.innerHTML;
    }
    function escAttr(s) {
        if (!s) return '';
        return escHtml(s).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // ── Init ───────────────────────────────────────────────
    loadTracking();
})();
</script>
}
