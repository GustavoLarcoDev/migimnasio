@{
    ViewData["Title"] = "Checkout";
}

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
<style>
    .checkout-header {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        padding: 1.25rem 0;
    }
    .checkout-header h1 {
        font-weight: 800;
        font-size: 1.4rem;
        margin: 0;
    }

    /* Cart Summary */
    .cart-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .6rem 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .cart-item:last-child { border-bottom: none; }
    .cart-item-qty {
        background: #0d6efd;
        color: #fff;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .8rem;
        flex-shrink: 0;
    }

    /* Map */
    #map {
        height: 280px;
        border-radius: .75rem;
        z-index: 1;
    }

    /* Cost Breakdown */
    .cost-row {
        display: flex;
        justify-content: space-between;
        padding: .4rem 0;
    }
    .cost-total {
        font-weight: 800;
        font-size: 1.2rem;
        border-top: 2px solid #0d6efd;
        padding-top: .6rem;
        margin-top: .4rem;
    }

    /* Section cards */
    .checkout-section {
        background: #fff;
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,.06);
        padding: 1.25rem;
        margin-bottom: 1rem;
    }
    .checkout-section h6 {
        font-weight: 700;
        margin-bottom: .75rem;
    }

    .payment-note {
        background: #fff3cd;
        border-radius: .75rem;
        padding: .75rem 1rem;
        font-size: .9rem;
    }

    .btn-confirmar {
        padding: .85rem;
        font-weight: 700;
        font-size: 1.05rem;
        border-radius: .75rem;
    }

    /* Empty cart */
    .empty-cart {
        padding: 3rem 0;
        text-align: center;
    }
</style>
}

<div class="checkout-header">
    <div class="container d-flex align-items-center gap-3">
        <a href="javascript:history.back()" class="text-white text-decoration-none">
            <i class="bi bi-arrow-left fs-5"></i>
        </a>
        <h1><i class="bi bi-bag-check me-2"></i>Checkout</h1>
    </div>
</div>

<div class="container py-3" id="checkout-content" style="display:none;">
    <div class="row g-3">
        <!-- Left Column: Cart + Map + Address -->
        <div class="col-lg-7">
            <!-- Cart Summary -->
            <div class="checkout-section">
                <h6><i class="bi bi-bag me-2"></i>Tu pedido <span class="text-muted fw-normal" id="restaurant-name-label"></span></h6>
                <div id="cart-items-list"></div>
            </div>

            <!-- Delivery Location -->
            <div class="checkout-section">
                <h6><i class="bi bi-geo-alt me-2"></i>Ubicacion de entrega</h6>
                <p class="text-muted small mb-2">Arrastra el marcador o haz clic en el mapa para ajustar tu ubicacion</p>
                <div id="map"></div>
                <div class="mt-2">
                    <input type="text" class="form-control" id="direccion"
                           placeholder="Direccion de entrega (se completa automaticamente)">
                    <input type="hidden" id="lat">
                    <input type="hidden" id="lng">
                </div>
            </div>

            <!-- Client Info -->
            <div class="checkout-section">
                <h6><i class="bi bi-person me-2"></i>Tus datos</h6>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Nombre <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="nombre" placeholder="Tu nombre completo"
                           required autocomplete="name">
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold">Telefono <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">+593</span>
                        <input type="tel" class="form-control" id="telefono" placeholder="9XXXXXXXX"
                               maxlength="10" required autocomplete="tel">
                    </div>
                </div>
                <div>
                    <label class="form-label small fw-bold">Notas para el restaurante</label>
                    <textarea class="form-control" id="notas" rows="2"
                              placeholder="Instrucciones especiales, alergias, etc."></textarea>
                </div>
            </div>
        </div>

        <!-- Right Column: Costs + Confirm -->
        <div class="col-lg-5">
            <!-- Delivery Fee -->
            <div class="checkout-section">
                <h6><i class="bi bi-bicycle me-2"></i>Costo de delivery</h6>
                <p class="text-muted small mb-2">
                    Los motorizados veran este monto y decidiran si toman tu pedido.
                    A mayor monto, mas rapido encontraras un motorizado.
                </p>
                <div class="input-group">
                    <span class="input-group-text fw-bold">$</span>
                    <input type="number" class="form-control form-control-lg fw-bold text-center"
                           id="costoEnvio" min="1" step="0.50" value="2.00"
                           style="font-size:1.3rem;">
                </div>
                <div class="text-muted small mt-1">Minimo: $1.00</div>
            </div>

            <!-- Cost Breakdown -->
            <div class="checkout-section">
                <h6><i class="bi bi-receipt me-2"></i>Resumen</h6>
                <div class="cost-row">
                    <span class="text-muted">Comida</span>
                    <span class="fw-bold" id="cost-food">$0.00</span>
                </div>
                <div class="cost-row">
                    <span class="text-muted">Delivery</span>
                    <span class="fw-bold" id="cost-delivery">$2.00</span>
                </div>
                <div class="cost-row cost-total">
                    <span>Total</span>
                    <span class="text-primary" id="cost-total">$0.00</span>
                </div>
            </div>

            <!-- Payment Note -->
            <div class="payment-note mb-3">
                <i class="bi bi-cash-coin me-2 text-warning"></i>
                <strong>Solo efectivo</strong> — Paga al motorizado cuando recibas tu pedido.
            </div>

            <!-- Confirm Button -->
            <button class="btn btn-primary btn-confirmar w-100" id="btn-confirm" onclick="confirmarPedido()">
                <i class="bi bi-check-circle me-2"></i>Confirmar Pedido
            </button>
        </div>
    </div>
</div>

<!-- Empty Cart State -->
<div class="container" id="empty-cart-state" style="display:none;">
    <div class="empty-cart">
        <i class="bi bi-bag text-muted" style="font-size:3.5rem;"></i>
        <h4 class="fw-bold mt-3">Tu carrito esta vacio</h4>
        <p class="text-muted">Agrega productos de un restaurante para continuar</p>
        <a href="/Delivery" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-shop me-1"></i> Ver restaurantes
        </a>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
    'use strict';

    var CART_KEY = 'delivery_cart';
    var map, marker;

    // ── Cart ───────────────────────────────────────────────
    function getCart() {
        try {
            return JSON.parse(localStorage.getItem(CART_KEY)) || { items: [] };
        } catch (e) {
            return { items: [] };
        }
    }

    var cart = getCart();

    if (!cart.items || cart.items.length === 0) {
        document.getElementById('empty-cart-state').style.display = 'block';
        return;
    }

    document.getElementById('checkout-content').style.display = 'block';

    // ── Render Cart Items ──────────────────────────────────
    var cartList = document.getElementById('cart-items-list');
    var foodTotal = 0;

    if (cart.restauranteNombre) {
        document.getElementById('restaurant-name-label').textContent = '- ' + cart.restauranteNombre;
    }

    cart.items.forEach(function (item) {
        var subtotal = item.cantidad * item.precio;
        foodTotal += subtotal;

        var div = document.createElement('div');
        div.className = 'cart-item';
        div.innerHTML =
            '<div class="d-flex align-items-center gap-2">' +
            '  <span class="cart-item-qty">' + item.cantidad + '</span>' +
            '  <span class="fw-semibold">' + escHtml(item.nombre) + '</span>' +
            '</div>' +
            '<span class="fw-bold">$' + subtotal.toFixed(2) + '</span>';
        cartList.appendChild(div);
    });

    // ── Cost Calculations ──────────────────────────────────
    var costoEnvioInput = document.getElementById('costoEnvio');

    function updateCosts() {
        var delivery = parseFloat(costoEnvioInput.value) || 0;
        if (delivery < 1) delivery = 1;
        document.getElementById('cost-food').textContent = '$' + foodTotal.toFixed(2);
        document.getElementById('cost-delivery').textContent = '$' + delivery.toFixed(2);
        document.getElementById('cost-total').textContent = '$' + (foodTotal + delivery).toFixed(2);
    }

    costoEnvioInput.addEventListener('input', updateCosts);
    updateCosts();

    // ── Restore saved client info ──────────────────────────
    var savedName = localStorage.getItem('delivery_client_name');
    var savedPhone = localStorage.getItem('delivery_client_phone');
    if (savedName) document.getElementById('nombre').value = savedName;
    if (savedPhone) document.getElementById('telefono').value = savedPhone;

    // ── Map ────────────────────────────────────────────────
    var defaultLat = parseFloat(localStorage.getItem('delivery_lat')) || -0.1807;
    var defaultLng = parseFloat(localStorage.getItem('delivery_lng')) || -78.4678;

    document.getElementById('lat').value = defaultLat;
    document.getElementById('lng').value = defaultLng;

    map = L.map('map').setView([defaultLat, defaultLng], 16);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
        maxZoom: 19
    }).addTo(map);

    marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

    marker.on('dragend', function (e) {
        var pos = e.target.getLatLng();
        document.getElementById('lat').value = pos.lat;
        document.getElementById('lng').value = pos.lng;
        reverseGeocode(pos.lat, pos.lng);
    });

    map.on('click', function (e) {
        marker.setLatLng(e.latlng);
        document.getElementById('lat').value = e.latlng.lat;
        document.getElementById('lng').value = e.latlng.lng;
        reverseGeocode(e.latlng.lat, e.latlng.lng);
    });

    // Fix map rendering
    setTimeout(function () { map.invalidateSize(); }, 300);

    // Reverse geocode initial position
    reverseGeocode(defaultLat, defaultLng);

    // Also try to get current position
    if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(function (pos) {
            var lat = pos.coords.latitude;
            var lng = pos.coords.longitude;
            map.setView([lat, lng], 16);
            marker.setLatLng([lat, lng]);
            document.getElementById('lat').value = lat;
            document.getElementById('lng').value = lng;
            reverseGeocode(lat, lng);
        }, function () { /* Use default */ });
    }

    function reverseGeocode(lat, lng) {
        fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + lat + '&lon=' + lng + '&zoom=18&addressdetails=1')
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (data && data.display_name) {
                    document.getElementById('direccion').value = data.display_name;
                }
            })
            .catch(function () { /* ignore */ });
    }

    // ── Confirm Order ──────────────────────────────────────
    window.confirmarPedido = async function () {
        var nombre = document.getElementById('nombre').value.trim();
        var telefono = document.getElementById('telefono').value.trim();
        var direccion = document.getElementById('direccion').value.trim();
        var lat = parseFloat(document.getElementById('lat').value);
        var lng = parseFloat(document.getElementById('lng').value);
        var costoEnvio = parseFloat(costoEnvioInput.value);
        var notas = document.getElementById('notas').value.trim();

        // Validation
        if (!nombre) {
            Swal.fire('Campo requerido', 'Ingresa tu nombre', 'warning');
            document.getElementById('nombre').focus();
            return;
        }
        if (!telefono || telefono.length < 9) {
            Swal.fire('Campo requerido', 'Ingresa un numero de telefono valido', 'warning');
            document.getElementById('telefono').focus();
            return;
        }
        if (!direccion) {
            Swal.fire('Campo requerido', 'Selecciona tu ubicacion en el mapa', 'warning');
            return;
        }
        if (!costoEnvio || costoEnvio < 1) {
            Swal.fire('Costo de delivery', 'El costo minimo de delivery es $1.00', 'warning');
            costoEnvioInput.focus();
            return;
        }
        if (isNaN(lat) || isNaN(lng)) {
            Swal.fire('Ubicacion', 'No se pudo obtener tu ubicacion. Haz clic en el mapa.', 'warning');
            return;
        }

        // Format phone
        var fullPhone = telefono.startsWith('+593') ? telefono : '+593' + telefono.replace(/^0/, '');

        // Save client info for next time
        localStorage.setItem('delivery_client_name', nombre);
        localStorage.setItem('delivery_client_phone', telefono);

        var body = {
            negocioId: cart.negocioId,
            nombreCliente: nombre,
            telefonoCliente: fullPhone,
            direccionEntrega: direccion,
            latitudCliente: lat,
            longitudCliente: lng,
            costoEnvio: costoEnvio,
            notas: notas,
            items: cart.items.map(function (i) {
                return {
                    productoId: i.productoId,
                    nombreProducto: i.nombre,
                    cantidad: i.cantidad,
                    precioUnitario: i.precio
                };
            })
        };

        var btn = document.getElementById('btn-confirm');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creando pedido...';

        try {
            var res = await fetch('/Delivery/CrearPedido', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            var data = await res.json();

            if (data.success) {
                localStorage.removeItem(CART_KEY);
                toastr.success('Pedido creado exitosamente');
                window.location.href = '/Delivery/Esperando/' + data.pedidoId;
            } else {
                Swal.fire('Error', data.message || 'No se pudo crear el pedido', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Confirmar Pedido';
            }
        } catch (err) {
            console.error('Error creating order:', err);
            Swal.fire('Error', 'Error de conexion. Intenta de nuevo.', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Confirmar Pedido';
        }
    };

    // ── Helpers ─────────────────────────────────────────────
    function escHtml(s) {
        if (!s) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s));
        return d.innerHTML;
    }
})();
</script>
}
