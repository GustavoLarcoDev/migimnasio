@{
    ViewData["Title"] = "Menu";
    var negocioId = ViewBag.NegocioId ?? Guid.Empty;
}

@section Styles {
<style>
    /* ── Restaurant Header ─────────────────────────────── */
    .menu-header {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        padding: 1.5rem 0;
    }
    .menu-header .restaurant-name {
        font-weight: 800;
        font-size: 1.6rem;
        margin-bottom: .25rem;
    }
    .menu-header .restaurant-info {
        opacity: .85;
        font-size: .95rem;
    }
    .back-link { color: rgba(255,255,255,.8); text-decoration: none; }
    .back-link:hover { color: #fff; }

    /* ── Category Tabs ─────────────────────────────────── */
    .category-tabs {
        overflow-x: auto;
        white-space: nowrap;
        padding: .5rem 0;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
    .category-tabs::-webkit-scrollbar { display: none; }
    .cat-tab {
        display: inline-block;
        padding: .5rem 1rem;
        margin-right: .5rem;
        border-radius: 2rem;
        background: #f0f0f0;
        color: #333;
        font-weight: 600;
        font-size: .9rem;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
        border: none;
    }
    .cat-tab.active, .cat-tab:hover {
        background: #0d6efd;
        color: #fff;
    }

    /* ── Product Cards ─────────────────────────────────── */
    .product-card {
        border: none;
        border-radius: 1rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        transition: box-shadow .2s;
        overflow: hidden;
        height: 100%;
    }
    .product-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,.1);
    }
    .product-img {
        width: 80px;
        height: 80px;
        border-radius: .75rem;
        object-fit: cover;
        flex-shrink: 0;
        background: #f8f9fa;
    }
    .product-img-placeholder {
        width: 80px;
        height: 80px;
        border-radius: .75rem;
        background: #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #adb5bd;
        font-size: 1.8rem;
    }
    .product-name {
        font-weight: 700;
        font-size: .95rem;
        margin-bottom: .15rem;
        color: #212529;
    }
    .product-desc {
        font-size: .8rem;
        color: #6c757d;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .product-price {
        font-weight: 800;
        font-size: 1.05rem;
        color: #0d6efd;
    }
    .btn-add-cart {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

    /* ── Cart Bar ──────────────────────────────────────── */
    .cart-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #fff;
        box-shadow: 0 -4px 24px rgba(0,0,0,.12);
        padding: .75rem 1rem;
        z-index: 1040;
        transform: translateY(100%);
        transition: transform .3s;
    }
    .cart-bar.visible {
        transform: translateY(0);
    }
    .cart-badge {
        background: #0d6efd;
        color: #fff;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .85rem;
    }

    /* ── Loading / Empty ───────────────────────────────── */
    #menu-loading {
        padding: 4rem 0;
    }
    #menu-error {
        padding: 3rem 0;
    }

    /* Ensure body has bottom padding for cart bar */
    body { padding-bottom: 80px; }

    /* Section title */
    .section-title {
        font-weight: 700;
        font-size: 1.15rem;
        margin: 1.25rem 0 .75rem;
        padding-bottom: .5rem;
        border-bottom: 2px solid #f0f0f0;
    }
</style>
}

<!-- Restaurant Header -->
<div class="menu-header">
    <div class="container">
        <a href="/Delivery" class="back-link d-inline-flex align-items-center mb-2">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
        <div id="restaurant-header" style="display:none;">
            <div class="d-flex align-items-center gap-3">
                <div id="restaurant-logo-wrap"></div>
                <div>
                    <div class="restaurant-name" id="restaurant-name"></div>
                    <div class="restaurant-info">
                        <span id="restaurant-address"></span>
                        <span id="restaurant-phone" class="ms-2"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Loading -->
    <div id="menu-loading" class="text-center">
        <div class="spinner-grow text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="text-muted mt-3 fs-5">Cargando menu...</p>
    </div>

    <!-- Error -->
    <div id="menu-error" class="text-center" style="display:none;">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size:3rem;"></i>
        <h5 class="fw-bold mt-2">No se pudo cargar el menu</h5>
        <p class="text-muted">Intenta recargar la pagina</p>
        <a href="/Delivery" class="btn btn-outline-primary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Ver restaurantes
        </a>
    </div>

    <!-- Category Tabs -->
    <div class="category-tabs" id="category-tabs" style="display:none;"></div>

    <!-- Products Grid -->
    <div id="products-container" style="display:none;"></div>
</div>

<!-- Cart Bottom Bar -->
<div class="cart-bar" id="cart-bar">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3">
                <div class="cart-badge" id="cart-count">0</div>
                <div>
                    <div class="fw-bold" style="font-size:.9rem;">Tu pedido</div>
                    <div class="text-muted" style="font-size:.8rem;" id="cart-subtotal">$0.00</div>
                </div>
            </div>
            <a href="/Delivery/Checkout" class="btn btn-primary rounded-pill px-4 fw-bold" id="btn-checkout">
                Ir al checkout <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    var CART_KEY = 'delivery_cart';
    var currentNegocioId = '@negocioId';
    var menuData = null;

    // ── Cart Helpers ───────────────────────────────────────
    function getCart() {
        try {
            return JSON.parse(localStorage.getItem(CART_KEY)) || { items: [] };
        } catch (e) {
            return { items: [] };
        }
    }

    function saveCart(cart) {
        localStorage.setItem(CART_KEY, JSON.stringify(cart));
    }

    function clearCart() {
        localStorage.removeItem(CART_KEY);
    }

    function addItem(productoId, nombre, precio) {
        var cart = getCart();
        cart.negocioId = currentNegocioId;
        if (menuData && menuData.restaurante) {
            cart.restauranteNombre = menuData.restaurante.negocioNombre;
        }

        var existing = cart.items.find(function (i) { return i.productoId === productoId; });
        if (existing) {
            existing.cantidad++;
        } else {
            cart.items.push({ productoId: productoId, nombre: nombre, cantidad: 1, precio: precio });
        }
        saveCart(cart);
        updateCartUI();
        toastr.success(nombre + ' agregado al carrito');
    }

    function removeItem(productoId) {
        var cart = getCart();
        cart.items = cart.items.filter(function (i) { return i.productoId !== productoId; });
        if (cart.items.length === 0) {
            clearCart();
        } else {
            saveCart(cart);
        }
        updateCartUI();
    }

    function changeQuantity(productoId, delta) {
        var cart = getCart();
        var item = cart.items.find(function (i) { return i.productoId === productoId; });
        if (!item) return;
        item.cantidad += delta;
        if (item.cantidad <= 0) {
            cart.items = cart.items.filter(function (i) { return i.productoId !== productoId; });
        }
        if (cart.items.length === 0) {
            clearCart();
        } else {
            saveCart(cart);
        }
        updateCartUI();
    }

    function updateCartUI() {
        var cart = getCart();
        var totalItems = 0;
        var subtotal = 0;
        cart.items.forEach(function (i) {
            totalItems += i.cantidad;
            subtotal += i.cantidad * i.precio;
        });

        document.getElementById('cart-count').textContent = totalItems;
        document.getElementById('cart-subtotal').textContent = '$' + subtotal.toFixed(2);

        var cartBar = document.getElementById('cart-bar');
        if (totalItems > 0) {
            cartBar.classList.add('visible');
        } else {
            cartBar.classList.remove('visible');
        }

        // Update quantity badges on product cards
        document.querySelectorAll('[data-qty-badge]').forEach(function (badge) {
            var pid = badge.getAttribute('data-qty-badge');
            var item = cart.items.find(function (i) { return i.productoId === pid; });
            if (item && item.cantidad > 0) {
                badge.textContent = item.cantidad;
                badge.style.display = 'flex';
                badge.closest('.product-actions').querySelector('.btn-minus').style.display = 'flex';
            } else {
                badge.style.display = 'none';
                badge.closest('.product-actions').querySelector('.btn-minus').style.display = 'none';
            }
        });
    }

    // ── Add To Cart (with restaurant conflict check) ──────
    window.addToCart = function (productoId, nombre, precio) {
        var cart = getCart();
        if (cart.negocioId && cart.negocioId !== currentNegocioId && cart.items.length > 0) {
            Swal.fire({
                title: 'Cambiar de restaurante?',
                text: 'Tu carrito tiene productos de otro restaurante. Al continuar se vaciara.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Si, vaciar carrito',
                cancelButtonText: 'No',
                confirmButtonColor: '#0d6efd'
            }).then(function (r) {
                if (r.isConfirmed) {
                    clearCart();
                    addItem(productoId, nombre, precio);
                }
            });
            return;
        }
        addItem(productoId, nombre, precio);
    };

    window.changeQty = function (productoId, delta) {
        changeQuantity(productoId, delta);
    };

    // ── Escape Helpers ─────────────────────────────────────
    function esc(s) {
        if (!s) return '';
        var d = document.createElement('div');
        d.appendChild(document.createTextNode(s));
        return d.innerHTML;
    }

    // ── Load Menu ──────────────────────────────────────────
    async function loadMenu() {
        try {
            var res = await fetch('/Delivery/GetMenuRestaurante/' + currentNegocioId);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            menuData = await res.json();

            renderHeader(menuData.restaurante);
            renderCategories(menuData.categorias, menuData.productos);
            renderProducts(menuData.categorias, menuData.productos);

            document.getElementById('menu-loading').style.display = 'none';
            document.getElementById('restaurant-header').style.display = 'block';
            document.getElementById('category-tabs').style.display = 'block';
            document.getElementById('products-container').style.display = 'block';

            updateCartUI();
        } catch (err) {
            console.error('Error loading menu:', err);
            document.getElementById('menu-loading').style.display = 'none';
            document.getElementById('menu-error').style.display = 'block';
        }
    }

    function renderHeader(r) {
        document.getElementById('restaurant-name').textContent = r.negocioNombre || 'Restaurante';
        document.getElementById('restaurant-address').innerHTML =
            '<i class="bi bi-geo-alt me-1"></i>' + esc(r.direccion || '');
        if (r.telefono) {
            document.getElementById('restaurant-phone').innerHTML =
                '<i class="bi bi-telephone me-1"></i>' + esc(r.telefono);
        }
        var logoWrap = document.getElementById('restaurant-logo-wrap');
        if (r.logoUrl) {
            logoWrap.innerHTML = '<img src="' + esc(r.logoUrl) + '" style="width:56px;height:56px;border-radius:.75rem;object-fit:cover;" alt="">';
        } else {
            logoWrap.innerHTML = '<div style="width:56px;height:56px;border-radius:.75rem;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:1.5rem;"><i class="bi bi-shop"></i></div>';
        }
    }

    function renderCategories(categorias, productos) {
        var tabs = document.getElementById('category-tabs');
        tabs.innerHTML = '';

        // "Todos" tab
        var allTab = document.createElement('button');
        allTab.className = 'cat-tab active';
        allTab.textContent = 'Todos';
        allTab.setAttribute('data-cat', 'all');
        allTab.addEventListener('click', function () { filterCategory('all'); });
        tabs.appendChild(allTab);

        // Category tabs
        categorias.forEach(function (c) {
            // Only show if category has products
            var hasProducts = productos.some(function (p) { return p.categoriaProductoId === c.categoriaId; });
            if (!hasProducts) return;

            var tab = document.createElement('button');
            tab.className = 'cat-tab';
            tab.textContent = c.nombre;
            tab.setAttribute('data-cat', c.categoriaId);
            tab.addEventListener('click', function () { filterCategory(c.categoriaId); });
            tabs.appendChild(tab);
        });

        // "Sin categoria" tab if there are uncategorized products
        var uncategorized = productos.filter(function (p) { return !p.categoriaProductoId; });
        if (uncategorized.length > 0 && categorias.length > 0) {
            var otherTab = document.createElement('button');
            otherTab.className = 'cat-tab';
            otherTab.textContent = 'Otros';
            otherTab.setAttribute('data-cat', 'none');
            otherTab.addEventListener('click', function () { filterCategory('none'); });
            tabs.appendChild(otherTab);
        }
    }

    function filterCategory(catId) {
        // Update active tab
        document.querySelectorAll('.cat-tab').forEach(function (t) { t.classList.remove('active'); });
        document.querySelector('.cat-tab[data-cat="' + catId + '"]').classList.add('active');

        // Show/hide sections
        document.querySelectorAll('.product-section').forEach(function (section) {
            if (catId === 'all') {
                section.style.display = '';
            } else {
                section.style.display = section.getAttribute('data-section-cat') === catId ? '' : 'none';
            }
        });
    }

    function renderProducts(categorias, productos) {
        var container = document.getElementById('products-container');
        container.innerHTML = '';

        var cart = getCart();

        // Group products by category
        var groups = [];

        categorias.forEach(function (c) {
            var catProds = productos.filter(function (p) { return p.categoriaProductoId === c.categoriaId; });
            if (catProds.length > 0) {
                groups.push({ id: c.categoriaId, nombre: c.nombre, productos: catProds });
            }
        });

        // Uncategorized products
        var uncategorized = productos.filter(function (p) { return !p.categoriaProductoId; });
        if (uncategorized.length > 0) {
            groups.push({ id: 'none', nombre: categorias.length > 0 ? 'Otros' : '', productos: uncategorized });
        }

        groups.forEach(function (g) {
            var section = document.createElement('div');
            section.className = 'product-section';
            section.setAttribute('data-section-cat', g.id);

            if (g.nombre) {
                section.innerHTML = '<h6 class="section-title">' + esc(g.nombre) + '</h6>';
            }

            var row = document.createElement('div');
            row.className = 'row g-2';

            g.productos.forEach(function (p) {
                var cartItem = cart.items.find(function (i) { return i.productoId === p.productoId; });
                var qty = cartItem ? cartItem.cantidad : 0;

                var col = document.createElement('div');
                col.className = 'col-12';

                var imgHtml = '';
                if (p.imagenUrl) {
                    imgHtml = '<img src="' + esc(p.imagenUrl) + '" class="product-img" alt="">';
                } else {
                    imgHtml = '<div class="product-img-placeholder"><i class="bi bi-basket"></i></div>';
                }

                col.innerHTML =
                    '<div class="card product-card">' +
                    '  <div class="card-body d-flex align-items-center gap-3 p-3">' +
                    '    ' + imgHtml +
                    '    <div class="flex-grow-1 min-width-0">' +
                    '      <div class="product-name">' + esc(p.nombre) + '</div>' +
                    (p.receta ? '<div class="product-desc">' + esc(p.receta) + '</div>' : '') +
                    '      <div class="product-price mt-1">$' + p.precioVenta.toFixed(2) + '</div>' +
                    '    </div>' +
                    '    <div class="product-actions d-flex align-items-center gap-1">' +
                    '      <button class="btn btn-outline-secondary btn-add-cart btn-minus" ' +
                    '        style="width:32px;height:32px;font-size:.9rem;display:' + (qty > 0 ? 'flex' : 'none') + ';"' +
                    '        onclick="changeQty(\'' + p.productoId + '\', -1)">' +
                    '        <i class="bi bi-dash"></i>' +
                    '      </button>' +
                    '      <span class="fw-bold text-center" style="min-width:24px;display:' + (qty > 0 ? 'flex' : 'none') + ';justify-content:center;" ' +
                    '        data-qty-badge="' + p.productoId + '">' + qty + '</span>' +
                    '      <button class="btn btn-primary btn-add-cart" ' +
                    '        onclick="addToCart(\'' + p.productoId + '\', \'' + esc(p.nombre).replace(/'/g, "\\'") + '\', ' + p.precioVenta + ')">' +
                    '        <i class="bi bi-plus"></i>' +
                    '      </button>' +
                    '    </div>' +
                    '  </div>' +
                    '</div>';

                row.appendChild(col);
            });

            section.appendChild(row);
            container.appendChild(section);
        });

        if (productos.length === 0) {
            container.innerHTML =
                '<div class="text-center py-5">' +
                '  <i class="bi bi-basket text-muted" style="font-size:3rem;"></i>' +
                '  <p class="text-muted mt-2 fs-5">Este restaurante no tiene productos disponibles</p>' +
                '  <a href="/Delivery" class="btn btn-outline-primary rounded-pill mt-2">Ver otros restaurantes</a>' +
                '</div>';
        }
    }

    // ── Init ───────────────────────────────────────────────
    loadMenu();
})();
</script>
}
