    window.cancelarPedido = async function(pedidoId, btn) {
        var result = await Swal.fire({
            title: 'Cancelar pedido?',
            input: 'textarea',
            inputLabel: 'Razon de cancelacion (obligatoria)',
            inputPlaceholder: 'Ej: Se acabaron los ingredientes...',
            inputAttributes: { required: true },
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Si, cancelar pedido',
            cancelButtonText: 'No cancelar',
            inputValidator: function(value) {
                if (!value || !value.trim()) return 'Debes escribir una razon';
            }
        });
        if (!result.isConfirmed) return;

        setButtonLoading(btn, true);
        try {
            var res = await fetch('/Negocios/CancelarPedidoDelivery', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pedidoId: pedidoId, razon: result.value })
            });
            var data = await res.json();
            if (data.success) {
                toastr.info('Pedido cancelado');
                await cargarPedidos();
            } else {
                toastr.error(data.message);
                setButtonLoading(btn, false);
            }
        } catch(e) {
            toastr.error('Error de conexion');
            setButtonLoading(btn, false);
        }
    };

    // ═══════════════════════════════════════════
    // SIGNALR
    // ═══════════════════════════════════════════
    function initSignalR() {
        connection = new signalR.HubConnectionBuilder()
            .withUrl('/pedidoHub')
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .build();

        // New order received (motorizado took a pedido from our restaurant)
        connection.on('OrdenRecibida', function(data) {
            playNotifSound();
            toastr.info('Nuevo pedido de delivery recibido!');
            cargarPedidos();
        });

        // Order cancelled
        connection.on('PedidoCancelado', function(data) {
            toastr.warning('Un pedido fue cancelado' + (data && data.razon ? ': ' + data.razon : ''));
            cargarPedidos();
        });

        // Order picked up
        connection.on('ComidaRecogida', function(data) {
            toastr.success('El motorizado recogio la comida');
            cargarPedidos();
        });

        // Order delivered
        connection.on('PedidoEntregado', function(data) {
            toastr.success('Pedido entregado al cliente!');
            cargarPedidos();
        });

        connection.start()
            .then(function() {
                console.log('SignalR conectado (restaurante)');
                // Join restaurant group
                if (negocioId) {
                    connection.invoke('JoinRestauranteGroup', negocioId).catch(function(){});
                }
            })
            .catch(function(err) { console.error('SignalR error:', err); });

        connection.onreconnected(function() {
            if (negocioId) {
                connection.invoke('JoinRestauranteGroup', negocioId).catch(function(){});
            }
        });
    }

    // ═══════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════
    function esc(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function formatDateTime(dateStr) {
        if (!dateStr) return '';
        try {
            var d = new Date(dateStr);
            var hoy = new Date();
            var isToday = d.toDateString() === hoy.toDateString();
            var time = d.toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' });
            if (isToday) return 'Hoy ' + time;
            return d.toLocaleDateString('es-EC', { day: '2-digit', month: 'short' }) + ' ' + time;
        } catch(e) { return ''; }
    }

    function formatWhatsApp(phone) {
        if (!phone) return '';
        var clean = phone.replace(/[^0-9]/g, '');
        if (clean.startsWith('0')) clean = '593' + clean.substring(1);
        if (!clean.startsWith('593')) clean = '593' + clean;
        return clean;
    }

    function getEstadoInfo(estado) {
        var map = {
            'tomado':     { label: 'Confirmando items' },
            'confirmado': { label: 'Items confirmados' },
            'preparando': { label: 'Preparando' },
            'listo':      { label: 'Lista para recoger' },
            'recogido':   { label: 'Entregada al motorizado' },
            'en_camino':  { label: 'En camino al cliente' }
        };
        return map[estado] || { label: estado || 'Desconocido' };
    }

    function checkAllConfirmed(p) {
        if (!p.items || p.items.length === 0) return false;
        var pending = p.items.filter(function(i) { return !i.confirmado && !i.rechazado; });
        var notAllRejected = p.items.some(function(i) { return !i.rechazado; });
        return pending.length === 0 && notAllRejected;
    }

    function updateLocalItem(detallePedidoId, confirmado, rechazado) {
        for (var i = 0; i < pedidos.length; i++) {
            if (!pedidos[i].items) continue;
            for (var j = 0; j < pedidos[i].items.length; j++) {
                if (pedidos[i].items[j].detallePedidoId === detallePedidoId) {
                    pedidos[i].items[j].confirmado = confirmado;
                    pedidos[i].items[j].rechazado = rechazado;
                    return;
                }
            }
        }
    }

    function setButtonLoading(btn, loading) {
        if (!btn) return;
        btn.disabled = loading;
        var label = btn.querySelector('.btn-label');
        var spinner = btn.querySelector('.spinner-border');
        if (label) label.classList.toggle('d-none', loading);
        if (spinner) spinner.classList.toggle('d-none', !loading);
    }

    function playNotifSound() {
        try {
            var audio = document.getElementById('audioNotif');
            if (audio) { audio.currentTime = 0; audio.play().catch(function(){}); }
        } catch(e) {}
        if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
    }

})();
</script>
