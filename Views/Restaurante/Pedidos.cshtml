@{
    ViewData["Title"] = "Pedidos Delivery";
    Layout = "_Layout";
}

@section Styles {
<style>
    /* ═══════════════════════════════════════════
       RESTAURANT DELIVERY ORDERS MANAGEMENT
       ═══════════════════════════════════════════ */

    body { background: #f4f6f9; }

    .pedidos-header {
        background: linear-gradient(135deg, #dc3545, #fd7e14);
        padding: 1.25rem 1.5rem;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .pedidos-header h4 {
        font-weight: 800;
        margin: 0;
        font-size: 1.2rem;
    }
    .pedidos-header .badge-count {
        background: rgba(255,255,255,0.25);
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
    }
    .pedidos-header .back-link {
        color: rgba(255,255,255,0.85);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .pedidos-header .back-link:hover { color: #fff; }

    /* Order cards container */
    .pedidos-container {
        padding: 1rem;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Individual order card */
    .order-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        margin-bottom: 1rem;
        overflow: hidden;
        transition: box-shadow 0.2s;
    }
    .order-card:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.1); }
    .order-card-header {
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
        border-bottom: 1px solid #f0f0f0;
    }
    .order-card-body {
        padding: 1.25rem;
    }

    /* Order number and time */
    .order-number {
        font-weight: 800;
        font-size: 0.95rem;
        color: #1a1a2e;
    }
    .order-time {
        font-size: 0.8rem;
        color: #6c757d;
    }

    /* Estado badges */
    .estado-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.3rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .estado-tomado { background: #fff3cd; color: #856404; }
    .estado-confirmado { background: #cfe2ff; color: #084298; }
    .estado-preparando { background: #ffecb5; color: #664d03; }
    .estado-listo { background: #d1e7dd; color: #0f5132; }
    .estado-recogido { background: #e2d9f3; color: #6f42c1; }
    .estado-en_camino { background: #e2d9f3; color: #6f42c1; }

    /* People info section */
    .people-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    @@media (max-width: 576px) {
        .people-section { grid-template-columns: 1fr; }
    }
    .person-info {
        display: flex;
        gap: 0.6rem;
        align-items: flex-start;
    }
    .person-info .icon-box {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .person-info .label { font-size: 0.72rem; color: #6c757d; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
    .person-info .name { font-weight: 700; font-size: 0.9rem; color: #1a1a2e; }
    .person-info .contact-links {
        display: flex;
        gap: 0.35rem;
        margin-top: 0.25rem;
    }
    .person-info .contact-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        font-size: 0.85rem;
        text-decoration: none;
        transition: transform 0.1s;
    }
    .person-info .contact-link:hover { transform: scale(1.1); }
    .contact-link.call { background: #e3f2fd; color: #1565c0; }
    .contact-link.wa { background: #e8f5e9; color: #198754; }

    /* Items section */
    .items-section {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1rem;
    }
    .items-section .section-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 0.5rem;
    }

    /* Individual item row */
    .pedido-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.6rem 0.75rem;
        background: #fff;
        border-radius: 10px;
        margin-bottom: 0.4rem;
        transition: all 0.2s;
        border: 1.5px solid transparent;
    }
    .pedido-item.confirmed {
        background: #d1e7dd;
        border-color: #a3cfbb;
    }
    .pedido-item.confirmed .item-name { text-decoration: none; }
    .pedido-item.rejected {
        background: #f8d7da;
        border-color: #f1aeb5;
    }
    .pedido-item.rejected .item-name {
        text-decoration: line-through;
        color: #842029;
    }
    .item-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-grow: 1;
    }
    .item-qty {
        background: #e9ecef;
        padding: 0.15rem 0.55rem;
        border-radius: 6px;
        font-weight: 800;
        font-size: 0.82rem;
        min-width: 30px;
        text-align: center;
    }
    .pedido-item.confirmed .item-qty { background: #a3cfbb; color: #0f5132; }
    .pedido-item.rejected .item-qty { background: #f1aeb5; color: #842029; }
    .item-name { font-weight: 600; font-size: 0.88rem; color: #1a1a2e; }
    .item-price { font-weight: 700; font-size: 0.85rem; color: #495057; white-space: nowrap; }
    .item-status-icon {
        margin-left: 0.5rem;
        font-size: 1rem;
    }
    .item-actions {
        display: flex;
        gap: 0.35rem;
        margin-left: 0.5rem;
    }
    .item-actions .btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 0.9rem;
        transition: transform 0.1s;
    }
    .item-actions .btn:hover { transform: scale(1.1); }

    /* Action buttons */
    .order-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    .order-action-btn {
        flex: 1;
        min-width: 150px;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: transform 0.12s, box-shadow 0.12s;
    }
    .order-action-btn:hover { transform: translateY(-1px); }
    .order-action-btn:active { transform: translateY(0); }
    .order-action-btn:disabled { opacity: 0.5; transform: none; }
    .order-action-btn .spinner-border { width: 1rem; height: 1rem; }

    .btn-empezar { background: #198754; color: #fff; }
    .btn-empezar:hover { background: #157347; color: #fff; box-shadow: 0 4px 12px rgba(25,135,84,0.25); }
    .btn-listo { background: #0d6efd; color: #fff; }
    .btn-listo:hover { background: #0b5ed7; color: #fff; box-shadow: 0 4px 12px rgba(13,110,253,0.25); }
    .btn-entregado { background: #6f42c1; color: #fff; }
    .btn-entregado:hover { background: #59359a; color: #fff; box-shadow: 0 4px 12px rgba(111,66,193,0.25); }
    .btn-cancelar { background: #f8d7da; color: #842029; }
    .btn-cancelar:hover { background: #f1aeb5; color: #842029; }

    /* All items confirmed indicator */
    .all-confirmed-banner {
        background: linear-gradient(135deg, #d1e7dd, #badbcc);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
        color: #0f5132;
        font-size: 0.88rem;
    }

    /* Call client modal alert */
    .call-alert {
        background: #fff3cd;
        border: 1.5px solid #ffecb5;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #664d03;
    }
    .call-alert a {
        color: #664d03;
        font-weight: 700;
    }

    /* Cost summary */
    .cost-summary {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 0.85rem;
    }
    .cost-summary .total {
        font-weight: 800;
        font-size: 1rem;
        color: #1a1a2e;
    }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: #adb5bd;
    }
    .empty-state .bi { font-size: 4rem; display: block; margin-bottom: 0.75rem; }

    /* Notes section */
    .notes-section {
        background: #fff8e1;
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        color: #664d03;
    }

    /* Pulse animation */
    .pulse-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        display: inline-block;
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }
</style>
}

<!-- ═══════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════ -->
<div class="pedidos-header">
    <div class="d-flex align-items-center gap-2">
        <a href="/Negocios" class="back-link"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
        <h4><i class="bi bi-bicycle me-2"></i>Pedidos Delivery</h4>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge-count" id="orderCount">0 pedidos activos</span>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="autoRefresh" checked style="cursor:pointer;">
            <label class="form-check-label text-white small fw-bold" for="autoRefresh" style="cursor:pointer;">Auto-refresh</label>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     ORDERS CONTAINER
     ═══════════════════════════════════════════════════ -->
<div class="pedidos-container" id="pedidosContainer">
    <div class="empty-state" id="emptyState">
        <i class="bi bi-bag-x"></i>
        <div class="fw-bold fs-5">No hay pedidos de delivery activos</div>
        <div class="small mt-1">Los nuevos pedidos apareceran aqui automaticamente</div>
    </div>
</div>

<!-- Audio notification -->
<audio id="audioNotif" preload="auto">
    <source src="data:audio/mpeg;base64,//uQxAAAAAANIAAAAAExBTUUzLjEwMFVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV" type="audio/mpeg">
</audio>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
(function() {
    'use strict';

    // ═══════════════════════════════════════════
    // STATE
    // ═══════════════════════════════════════════
    var pedidos = [];
    var connection = null;
    var negocioId = '@(ViewData["NegocioId"] ?? "")';
    var refreshInterval = null;

    // ═══════════════════════════════════════════
    // INIT
    // ═══════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', function() {
        // Try to get negocioId from cookie/claims if not in ViewData
        cargarPedidos();
        initSignalR();
        startAutoRefresh();

        document.getElementById('autoRefresh').addEventListener('change', function() {
            if (this.checked) startAutoRefresh();
            else stopAutoRefresh();
        });
    });

    function startAutoRefresh() {
        stopAutoRefresh();
        refreshInterval = setInterval(cargarPedidos, 15000);
    }

    function stopAutoRefresh() {
        if (refreshInterval) { clearInterval(refreshInterval); refreshInterval = null; }
    }

    // ═══════════════════════════════════════════
    // LOAD ORDERS
    // ═══════════════════════════════════════════
    async function cargarPedidos() {
        try {
            var url = '/Negocios/GetPedidosDelivery';
            if (negocioId) url += '?negocioId=' + negocioId;
            var res = await fetch(url);
            if (!res.ok) {
                console.error('Error cargando pedidos:', res.status);
                return;
            }
            var data = await res.json();
            pedidos = Array.isArray(data) ? data : [];
            renderPedidos();
        } catch(e) {
            console.error('Error cargando pedidos:', e);
        }
    }

    // ═══════════════════════════════════════════
    // RENDER ALL ORDERS
    // ═══════════════════════════════════════════
    function renderPedidos() {
        var container = document.getElementById('pedidosContainer');
        var countEl = document.getElementById('orderCount');

        countEl.textContent = pedidos.length + ' pedido' + (pedidos.length !== 1 ? 's' : '') + ' activo' + (pedidos.length !== 1 ? 's' : '');

        if (pedidos.length === 0) {
            container.innerHTML = '<div class="empty-state" id="emptyState">' +
                '<i class="bi bi-bag-x"></i>' +
                '<div class="fw-bold fs-5">No hay pedidos de delivery activos</div>' +
                '<div class="small mt-1">Los nuevos pedidos apareceran aqui automaticamente</div>' +
                '</div>';
            return;
        }

        var html = '';
        pedidos.forEach(function(p) {
            html += renderOrderCard(p);
        });
        container.innerHTML = html;
    }

    function renderOrderCard(p) {
        var estadoInfo = getEstadoInfo(p.estado);
        var allConfirmed = checkAllConfirmed(p);
        var totalItems = 0;
        if (p.items) p.items.forEach(function(i) { totalItems += i.cantidad; });

        var html = '<div class="order-card" id="order-' + p.pedidoId + '">';

        // Header
        html += '<div class="order-card-header">';
        html += '  <div>';
        html += '    <span class="order-number"><i class="bi bi-receipt me-1"></i>Pedido #' + p.pedidoId.substring(0, 8).toUpperCase() + '</span>';
        html += '    <div class="order-time"><i class="bi bi-clock me-1"></i>' + formatDateTime(p.fechaCreacion) + '</div>';
        html += '  </div>';
        html += '  <span class="estado-badge estado-' + esc(p.estado) + '">';
        html += '    <span class="pulse-dot" style="background:currentColor;"></span>' + esc(estadoInfo.label);
        html += '  </span>';
        html += '</div>';

        html += '<div class="order-card-body">';

        // People info (client + motorizado)
        html += '<div class="people-section">';

        // Client info
        html += '<div class="person-info">';
        html += '  <div class="icon-box" style="background:#e8eaf6;color:#283593;"><i class="bi bi-person-fill"></i></div>';
        html += '  <div>';
        html += '    <div class="label">Cliente</div>';
        html += '    <div class="name">' + esc(p.nombreCliente) + '</div>';
        html += '    <div class="contact-links">';
        if (p.telefonoCliente) {
            html += '      <a href="tel:' + esc(p.telefonoCliente) + '" class="contact-link call" title="Llamar"><i class="bi bi-telephone-fill"></i></a>';
            html += '      <a href="https://wa.me/' + formatWhatsApp(p.telefonoCliente) + '" target="_blank" class="contact-link wa" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>';
        }
        html += '    </div>';
        html += '  </div>';
        html += '</div>';

        // Motorizado info
        html += '<div class="person-info">';
        html += '  <div class="icon-box" style="background:#e8f5e9;color:#2e7d32;"><i class="bi bi-bicycle"></i></div>';
        html += '  <div>';
        html += '    <div class="label">Motorizado</div>';
        if (p.motorizadoNombre) {
            html += '    <div class="name">' + esc(p.motorizadoNombre) + '</div>';
            html += '    <div class="contact-links">';
            if (p.motorizadoTelefono) {
                html += '      <a href="tel:' + esc(p.motorizadoTelefono) + '" class="contact-link call" title="Llamar"><i class="bi bi-telephone-fill"></i></a>';
            }
            html += '    </div>';
        } else {
            html += '    <div class="name text-muted fst-italic">Buscando motorizado...</div>';
        }
        html += '  </div>';
        html += '</div>';

        html += '</div>'; // end people-section

        // Delivery address
        if (p.direccionEntrega) {
            html += '<div class="d-flex align-items-center gap-2 text-muted small mb-2">';
            html += '  <i class="bi bi-geo-alt"></i><span>' + esc(p.direccionEntrega) + '</span>';
            html += '</div>';
        }

        // Notes
        if (p.notas) {
            html += '<div class="notes-section">';
            html += '  <i class="bi bi-sticky-fill me-1"></i><strong>Nota del cliente:</strong> ' + esc(p.notas);
            html += '</div>';
        }

        // Items section
        html += '<div class="items-section">';
        html += '  <div class="section-label"><i class="bi bi-bag me-1"></i>Items del pedido (' + totalItems + ')</div>';

        if (p.items && p.items.length > 0) {
            p.items.forEach(function(item) {
                var itemClass = '';
                var statusIcon = '';
                var actionsHtml = '';

                if (item.confirmado) {
                    itemClass = 'confirmed';
                    statusIcon = '<i class="bi bi-check-circle-fill text-success item-status-icon"></i>';
                } else if (item.rechazado) {
                    itemClass = 'rejected';
                    statusIcon = '<i class="bi bi-x-circle-fill text-danger item-status-icon"></i>';
                } else if (p.estado === 'tomado') {
                    // Show confirm/reject buttons only when in "tomado" state
                    actionsHtml = '<div class="item-actions">';
                    actionsHtml += '  <button class="btn btn-sm btn-outline-success" onclick="confirmarItem(\'' + item.detallePedidoId + '\', this)" title="Confirmar disponible">';
                    actionsHtml += '    <i class="bi bi-check-lg"></i>';
                    actionsHtml += '  </button>';
                    actionsHtml += '  <button class="btn btn-sm btn-outline-danger" onclick="rechazarItem(\'' + item.detallePedidoId + '\', \'' + esc(p.telefonoCliente || '') + '\', this)" title="No disponible">';
                    actionsHtml += '    <i class="bi bi-x-lg"></i>';
                    actionsHtml += '  </button>';
                    actionsHtml += '</div>';
                }

                html += '<div class="pedido-item ' + itemClass + '" id="item-' + item.detallePedidoId + '">';
                html += '  <div class="item-left">';
                html += '    <span class="item-qty">' + item.cantidad + '</span>';
                html += '    <span class="item-name">' + esc(item.nombreProducto) + '</span>';
                html += '    ' + statusIcon;
                html += '  </div>';
                html += '  <span class="item-price">$' + Number(item.subtotal).toFixed(2) + '</span>';
                html += '  ' + actionsHtml;
                html += '</div>';
            });
        }

        html += '</div>'; // end items-section

        // All confirmed banner
        if (allConfirmed && p.estado === 'tomado') {
            html += '<div class="all-confirmed-banner">';
            html += '  <i class="bi bi-check-circle-fill fs-5"></i>';
            html += '  <span>Todos los items estan confirmados. Puedes empezar la orden.</span>';
            html += '</div>';
        }

        // Cost summary
        html += '<div class="cost-summary">';
        html += '  <span>Comida:</span><span>$' + Number(p.costoComida).toFixed(2) + '</span>';
        html += '</div>';
        html += '<div class="cost-summary">';
        html += '  <span>Envio:</span><span>$' + Number(p.costoEnvio).toFixed(2) + '</span>';
        html += '</div>';
        html += '<div class="cost-summary" style="border-top:1.5px solid #dee2e6;padding-top:0.5rem;">';
        html += '  <span class="total">Total:</span><span class="total">$' + Number(p.total).toFixed(2) + '</span>';
        html += '</div>';

        // Action buttons based on state
        html += '<div class="order-actions mt-3">';

        if (p.estado === 'tomado') {
            if (allConfirmed) {
                html += '<button class="order-action-btn btn-empezar" onclick="empezarOrden(\'' + p.pedidoId + '\', this)">';
                html += '  <i class="bi bi-fire"></i>';
                html += '  <span class="btn-label">EMPEZAR ORDEN</span>';
                html += '  <span class="spinner-border d-none"></span>';
                html += '</button>';
            } else {
                html += '<button class="order-action-btn btn-empezar" disabled>';
                html += '  <i class="bi bi-hourglass-split"></i>';
                html += '  <span>Confirma todos los items primero</span>';
                html += '</button>';
            }
        }
        else if (p.estado === 'confirmado') {
            html += '<button class="order-action-btn btn-empezar" onclick="empezarOrden(\'' + p.pedidoId + '\', this)">';
            html += '  <i class="bi bi-fire"></i>';
            html += '  <span class="btn-label">EMPEZAR ORDEN</span>';
            html += '  <span class="spinner-border d-none"></span>';
            html += '</button>';
        }
        else if (p.estado === 'preparando') {
            html += '<button class="order-action-btn btn-listo" onclick="marcarListo(\'' + p.pedidoId + '\', this)">';
            html += '  <i class="bi bi-check-circle-fill"></i>';
            html += '  <span class="btn-label">LISTO - Orden Terminada</span>';
            html += '  <span class="spinner-border d-none"></span>';
            html += '</button>';
        }
        else if (p.estado === 'listo') {
            html += '<button class="order-action-btn btn-entregado" onclick="confirmarEntrega(\'' + p.pedidoId + '\', this)">';
            html += '  <i class="bi bi-bag-check-fill"></i>';
            html += '  <span class="btn-label">ENTREGUE AL MOTORIZADO</span>';
            html += '  <span class="spinner-border d-none"></span>';
            html += '</button>';

            if (p.restauranteConfirmoEntrega && !p.motorizadoConfirmoRecepcion) {
                html += '<div class="text-center w-100 mt-2">';
                html += '  <span class="text-muted small"><span class="spinner-grow spinner-grow-sm me-1"></span>Esperando confirmacion del motorizado...</span>';
                html += '</div>';
            }
        }
        else if (p.estado === 'recogido') {
            if (!p.restauranteConfirmoEntrega) {
                html += '<button class="order-action-btn btn-entregado" onclick="confirmarEntrega(\'' + p.pedidoId + '\', this)">';
                html += '  <i class="bi bi-bag-check-fill"></i>';
                html += '  <span class="btn-label">CONFIRMAR ENTREGA AL MOTORIZADO</span>';
                html += '  <span class="spinner-border d-none"></span>';
                html += '</button>';
            } else {
                html += '<div class="text-center w-100">';
                html += '  <span class="text-muted"><span class="spinner-grow spinner-grow-sm me-1"></span>Esperando que el motorizado confirme la recepcion...</span>';
                html += '</div>';
            }
        }
        else if (p.estado === 'en_camino') {
            html += '<div class="text-center w-100">';
            html += '  <i class="bi bi-bicycle text-primary fs-3"></i>';
            html += '  <div class="fw-bold mt-1">Motorizado en camino al cliente</div>';
            html += '  <div class="text-muted small">Entregada al motorizado exitosamente</div>';
            html += '</div>';
        }

        // Cancel button (always available)
        if (['tomado', 'confirmado', 'preparando', 'listo'].indexOf(p.estado) !== -1) {
            html += '<button class="order-action-btn btn-cancelar" onclick="cancelarPedido(\'' + p.pedidoId + '\', this)">';
            html += '  <i class="bi bi-x-circle"></i>';
            html += '  <span class="btn-label">Cancelar</span>';
            html += '</button>';
        }

        html += '</div>'; // end order-actions

        html += '</div>'; // end order-card-body
        html += '</div>'; // end order-card

        return html;
    }

    // ═══════════════════════════════════════════
    // ITEM ACTIONS
    // ═══════════════════════════════════════════
    window.confirmarItem = async function(detallePedidoId, btn) {
        btn.disabled = true;
        var origHtml = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
            var res = await fetch('/Negocios/ConfirmarItemPedido', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ detallePedidoId: detallePedidoId })
            });
            var data = await res.json();
            if (data.success) {
                toastr.success('Item confirmado');
                // Update item visual
                var itemEl = document.getElementById('item-' + detallePedidoId);
                if (itemEl) {
                    itemEl.classList.add('confirmed');
                    itemEl.classList.remove('rejected');
                    // Remove action buttons, add check icon
                    var actionsEl = itemEl.querySelector('.item-actions');
                    if (actionsEl) actionsEl.innerHTML = '';
                    var leftEl = itemEl.querySelector('.item-left');
                    if (leftEl && !leftEl.querySelector('.item-status-icon')) {
                        leftEl.insertAdjacentHTML('beforeend', '<i class="bi bi-check-circle-fill text-success item-status-icon"></i>');
                    }
                }

                // Update local data and check if all confirmed
                updateLocalItem(detallePedidoId, true, false);

                // Re-check all confirmed and reload if needed
                await cargarPedidos();
            } else {
                toastr.error(data.message || 'Error al confirmar');
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        } catch(e) {
            toastr.error('Error de conexion');
            btn.disabled = false;
            btn.innerHTML = origHtml;
        }
    };

    window.rechazarItem = async function(detallePedidoId, telefonoCliente, btn) {
        var result = await Swal.fire({
            title: 'Rechazar item?',
            text: 'Este producto no esta disponible?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Si, rechazar',
            cancelButtonText: 'Cancelar'
        });
        if (!result.isConfirmed) return;

        btn.disabled = true;
        var origHtml = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
            var res = await fetch('/Negocios/RechazarItemPedido', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ detallePedidoId: detallePedidoId })
            });
            var data = await res.json();
            if (data.success) {
                toastr.info('Item rechazado');

                // Update item visual
                var itemEl = document.getElementById('item-' + detallePedidoId);
                if (itemEl) {
                    itemEl.classList.add('rejected');
                    itemEl.classList.remove('confirmed');
                    var actionsEl = itemEl.querySelector('.item-actions');
                    if (actionsEl) actionsEl.innerHTML = '';
                    var leftEl = itemEl.querySelector('.item-left');
                    if (leftEl && !leftEl.querySelector('.item-status-icon')) {
                        leftEl.insertAdjacentHTML('beforeend', '<i class="bi bi-x-circle-fill text-danger item-status-icon"></i>');
                    }
                }

                // Show call client alert
                if (telefonoCliente) {
                    showCallClientAlert(telefonoCliente);
                }

                // Update local data
                updateLocalItem(detallePedidoId, false, true);

                // Reload to update totals
                await cargarPedidos();
            } else {
                toastr.error(data.message || 'Error al rechazar');
                btn.disabled = false;
                btn.innerHTML = origHtml;
            }
        } catch(e) {
            toastr.error('Error de conexion');
            btn.disabled = false;
            btn.innerHTML = origHtml;
        }
    };

    function showCallClientAlert(telefono) {
        Swal.fire({
            title: 'Llama al cliente',
            html: '<div style="text-align:left;">' +
                  '<p>Un item fue rechazado. Llama al cliente para confirmar si desea continuar sin este producto.</p>' +
                  '<div class="d-flex gap-2 justify-content-center mt-3">' +
                  '<a href="tel:' + esc(telefono) + '" class="btn btn-primary"><i class="bi bi-telephone-fill me-1"></i>Llamar</a>' +
                  '<a href="https://wa.me/' + formatWhatsApp(telefono) + '" target="_blank" class="btn btn-success"><i class="bi bi-whatsapp me-1"></i>WhatsApp</a>' +
                  '</div></div>',
            icon: 'info',
            showConfirmButton: true,
            confirmButtonText: 'Entendido'
        });
    }

    // ═══════════════════════════════════════════
    // ORDER ACTIONS
    // ═══════════════════════════════════════════
