                    + 'display:flex;align-items:center;gap:12px;padding:14px 16px;margin-bottom:10px;'
                    + 'border:2px solid var(--mg-border-color, #E4E6EF);border-radius:10px;cursor:pointer;'
                    + 'background:var(--mg-card-bg, #fff);transition:all 0.2s ease;'
                    + '">'
                    + '<div style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;'
                    + 'justify-content:center;background:' + iconBg + ';flex-shrink:0;">'
                    + '<i class="bi ' + iconClass + '" style="font-size:1.3rem;color:' + iconColor + ';"></i>'
                    + '</div>'
                    + '<div style="flex:1;min-width:0;">'
                    + '<div style="font-weight:600;color:var(--mg-text-color, #181C32);font-size:0.95rem;">'
                    + escHtml(mp.nombre) + qrBadge + '</div>'
                    + '<div style="font-size:0.8rem;color:var(--mg-text-muted, #A1A5B7);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">'
                    + escHtml(subtitulo) + '</div>'
                    + '</div>'
                    + '<i class="bi bi-chevron-right" style="color:var(--mg-text-muted, #A1A5B7);font-size:1.1rem;"></i>'
                    + '</div>';
            });

            var precio = $('#crearPrecio').val() || '0.00';

            swalMG.fire({
                title: '<i class="bi bi-credit-card-2-front me-2 text-primary"></i>Método de Pago',
                html: '<div style="text-align:left;">'
                    + '<div style="padding:10px 14px;margin-bottom:16px;border-radius:8px;'
                    + 'background:rgba(62,151,255,0.06);border:1px solid rgba(62,151,255,0.15);">'
                    + '<div style="font-size:0.82rem;color:var(--mg-text-muted, #A1A5B7);">Monto a cobrar</div>'
                    + '<div style="font-size:1.4rem;font-weight:700;color:var(--mg-primary, #3E97FF);">$' + escHtml(precio) + '</div>'
                    + '</div>'
                    + '<p style="font-size:0.85rem;color:var(--mg-text-muted, #A1A5B7);margin-bottom:12px;">'
                    + 'Selecciona cómo pagará el cliente:</p>'
                    + '<div id="mpSelectContainer">' + cardsHtml + '</div>'
                    + '</div>',
                showConfirmButton: false,
                showCancelButton: true,
                cancelButtonText: '<i class="bi bi-arrow-left me-1"></i>Volver',
                width: 480,
                didOpen: function() {
                    // Add hover + click effects to cards
                    var popup = Swal.getPopup();
                    $(popup).find('.mp-select-card').on('mouseenter', function() {
                        $(this).css({ 'border-color': 'var(--mg-primary, #3E97FF)', 'box-shadow': '0 2px 12px rgba(62,151,255,0.15)' });
                    }).on('mouseleave', function() {
                        $(this).css({ 'border-color': 'var(--mg-border-color, #E4E6EF)', 'box-shadow': 'none' });
                    }).on('click', function() {
                        var metodo = $(this).data('metodo');
                        var metodoId = $(this).data('id');

                        if (metodo === 'Efectivo' || !metodoId) {
                            // Efectivo: confirm directly
                            Swal.close();
                            callback({ metodoPago: 'Efectivo', numeroConfirmacion: '' });
                        } else {
                            // Bank method: show details step
                            mostrarDetallePagoAdmin(metodoId, metodo, precio, callback);
                        }
                    });
                }
            });
        }).fail(function() {
            // If can't load methods, still allow with Efectivo as fallback
            swalMG.fire({
                title: 'Error',
                html: 'No se pudieron cargar los métodos de pago.<br>¿Deseas registrar como <strong>Efectivo</strong>?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, Efectivo',
                cancelButtonText: 'Cancelar'
            }).then(function(result) {
                if (result.isConfirmed) {
                    callback({ metodoPago: 'Efectivo', numeroConfirmacion: '' });
                }
            });
        });
    }

    // Step 2: Show bank details for a specific admin payment method
    function mostrarDetallePagoAdmin(metodoPagoId, metodoNombre, precio, callback) {
        Swal.fire({
            title: '<i class="bi bi-bank me-2 text-primary"></i>' + escHtml(metodoNombre),
