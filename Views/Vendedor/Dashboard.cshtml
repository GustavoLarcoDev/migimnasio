                + '</div>';

            // Add bank/digital methods from admin
            metodos.forEach(function(mp) {
                var iconClass = 'bi-bank';
                var iconColor = '#3E97FF';
                var iconBg = 'rgba(62,151,255,0.12)';
                var nombreLower = mp.nombre.toLowerCase();

                if (nombreLower.indexOf('paypal') >= 0) {
                    iconClass = 'bi-paypal'; iconColor = '#009EF7'; iconBg = 'rgba(0,158,247,0.12)';
                } else if (nombreLower.indexOf('nequi') >= 0 || nombreLower.indexOf('movil') >= 0 || nombreLower.indexOf('billetera') >= 0) {
                    iconClass = 'bi-phone'; iconColor = '#50CD89'; iconBg = 'rgba(80,205,137,0.12)';
