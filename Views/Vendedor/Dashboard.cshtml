    <script>
    (function() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const toggle = document.getElementById('sidebarToggle');

        function openSidebar() { sidebar.classList.add('show'); overlay.classList.add('show'); document.body.style.overflow = 'hidden'; }
        function closeSidebar() { sidebar.classList.remove('show'); overlay.classList.remove('show'); document.body.style.overflow = ''; }
        if (toggle) toggle.addEventListener('click', openSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);

        const sidebarLinks = document.querySelectorAll('[data-mg-tab]');
        const tabPanes = document.querySelectorAll('.tab-pane');

        sidebarLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-mg-tab');
                sidebarLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');
                tabPanes.forEach(pane => {
                    if (pane.id === targetId) pane.classList.add('show', 'active');
                    else pane.classList.remove('show', 'active');
                });
                const event = new CustomEvent('mg-tab-shown', { detail: { tab: targetId } });
                document.dispatchEvent(event);
                closeSidebar();
            });
        });

        var currentTheme = localStorage.getItem('mg-theme') || '';
        function updateThemeUI() {
            document.querySelectorAll('.mg-theme-option').forEach(function(btn) {
                var val = btn.getAttribute('data-theme-value');
                var check = btn.querySelector('.bi-check2');
                if (val === currentTheme) { btn.classList.add('active'); if (check) check.classList.remove('d-none'); }
                else { btn.classList.remove('active'); if (check) check.classList.add('d-none'); }
            });
        }
        updateThemeUI();
        document.querySelectorAll('.mg-theme-option').forEach(function(btn) {
            btn.addEventListener('click', function() {
                currentTheme = this.getAttribute('data-theme-value');
                document.documentElement.setAttribute('data-theme', currentTheme);
                localStorage.setItem('mg-theme', currentTheme);
                updateThemeUI();
            });
        });
    })();
    </script>

    <script>
    const swalMG = Swal.mixin({ confirmButtonColor: '#3E97FF', cancelButtonColor: '#E4E6EF', cancelButtonText: 'Cancelar', reverseButtons: true });

    function escHtml(str) {
        if (!str) return '';
        return $('<span>').text(str).html();
    }

    let tablaNegocios = null;

    $(document).ready(function() {
        cargarStats();

        var h = new Date().getHours();
        $('#saludo').text(h < 12 ? 'Buenos días' : h < 18 ? 'Buenas tardes' : 'Buenas noches');
    });

    document.addEventListener('mg-tab-shown', function(e) {
        if (e.detail.tab === 'resumenTab') { cargarStats(); }
        else if (e.detail.tab === 'negociosTab') {
            if (!tablaNegocios) cargarTabla();
            else tablaNegocios.ajax.reload(null, false);
        }
        else if (e.detail.tab === 'comisionesTab') {
            cargarMisComisiones();
        }
        else if (e.detail.tab === 'metodosPagoTab') {
            cargarVendedorMetodosCobro();
            cargarMetodosPagoAdmin();
        }
    });

    function cargarStats() {
        $.get('/Negocios/GetVendedorStats', function(d) {
            $('#statNegocios').text(d.totalNegocios);
            $('#statActivos').text(d.activos);
            $('#statPrueba').text(d.enPrueba);
            $('#statClientes').text(d.totalClientes);
        }).fail(function() { toastr.error('Error al cargar estadísticas'); });
        cargarLeads();
    }

    // SEGURIDAD: Json.Serialize escapa correctamente para contexto JavaScript
    // (previene XSS por inyección de comillas o tags en el nombre del vendedor)
    const vendedorNombreActual = @Json.Serialize(vendedorNombre);

    var leadsCache = [];

    function verMensajeCompleto(leadId) {
        var lead = leadsCache.find(function(l) { return l.id === leadId; });
        if (!lead || !lead.mensaje) return;
        swalMG.fire({
            title: '<i class="bi bi-chat-text me-2"></i>' + escHtml(lead.nombre),
            html: '<div class="text-start"><p class="text-muted small mb-2">' + escHtml(lead.nombreNegocio) + ' &bull; ' + escHtml(lead.fechaCreacion) + '</p><div class="p-3 rounded" style="background: rgba(62,151,255,0.04); border: 1px solid rgba(62,151,255,0.15); white-space: pre-wrap; word-break: break-word;">' + escHtml(lead.mensaje) + '</div></div>',
            confirmButtonText: 'Cerrar',
            width: 500
        });
    }

    function cargarLeads() {
        $.get('/Negocios/GetVendedorLeads', function(leads) {
            leadsCache = leads;
            var sinAtender = leads.filter(l => !l.atendido).length;
            // Update badges
            if (sinAtender > 0) {
                $('#badgeLeads').text(sinAtender).removeClass('d-none');
                $('#leadsCountHeader').text(sinAtender + ' sin atender').removeClass('d-none');
            } else {
                $('#badgeLeads').addClass('d-none');
                $('#leadsCountHeader').addClass('d-none');
            }

            if (leads.length === 0) {
                $('#leadsBody').html('<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>No hay interesados aún</td></tr>');
                return;
            }

            var html = '';
            leads.forEach(function(l) {
                var atendidoClass = l.atendido ? 'opacity-50' : '';
                var nombreStyle = l.atendido ? 'text-decoration: line-through;' : '';

                // Badge de origen
                var origenBadge = l.origen === 'whatsapp'
                    ? ' <span class="badge bg-success bg-opacity-10 text-success ms-1"><i class="bi bi-whatsapp me-1"></i>WhatsApp</span>'
                    : '';

                // Contact buttons
                var telLimpio = l.telefono ? l.telefono.replace(/[^0-9+]/g, '') : '';
                var msgWa = encodeURIComponent('Hola ' + l.nombre + ', soy ' + vendedorNombreActual + ' de Mi Negocio. Vi que estás interesado en nuestra plataforma, ¿te puedo ayudar?');
                var waBtn = telLimpio
                    ? '<a href="https://wa.me/' + telLimpio + '?text=' + msgWa + '" target="_blank" class="btn btn-icon btn-sm" style="background:#25D366;color:#fff;" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>'
                    : '';
                var emailBtn = l.email
                    ? '<a href="mailto:' + escHtml(l.email) + '" class="btn btn-icon btn-bg-light btn-sm" title="Email"><i class="bi bi-envelope text-primary"></i></a>'
                    : '';

                var atendidoBtn = l.atendido
                    ? '<span class="badge bg-light-success text-success"><i class="bi bi-check-circle me-1"></i>' + escHtml(l.atendidoPorNombre) + '</span>'
                    : '<button class="btn btn-icon btn-bg-light btn-sm" onclick="marcarLeadAtendido(\'' + l.id + '\')" title="Marcar atendido"><i class="bi bi-check-lg text-success fs-5"></i></button>';

                // Contacto: teléfono siempre, email solo si existe
                var contactoHtml = '';
                if (l.email) contactoHtml += escHtml(l.email);
                if (l.telefono) {
                    if (contactoHtml) contactoHtml += '<br>';
                    contactoHtml += '<small class="text-muted">' + escHtml(l.telefono) + '</small>';
                }
                if (!contactoHtml) contactoHtml = '<span class="text-muted">-</span>';

                var mensajeTruncado = l.mensaje ? (l.mensaje.length > 60 ? escHtml(l.mensaje.substring(0, 60)) + '... <a href="javascript:void(0)" class="text-primary fw-semibold" onclick="verMensajeCompleto(\'' + l.id + '\')">Leer mas</a>' : escHtml(l.mensaje)) : '<span class="text-muted">-</span>';

                html += '<tr class="' + atendidoClass + '">'
                    + '<td style="' + nombreStyle + '"><strong>' + escHtml(l.nombre) + '</strong>' + origenBadge + '</td>'
                    + '<td style="' + nombreStyle + '">' + escHtml(l.nombreNegocio) + '</td>'
                    + '<td>' + contactoHtml + '</td>'
                    + '<td class="d-none d-md-table-cell"><small>' + mensajeTruncado + '</small></td>'
                    + '<td><small class="text-muted">' + escHtml(l.fechaCreacion) + '</small></td>'
                    + '<td class="text-end"><div class="d-flex justify-content-end gap-1">' + waBtn + emailBtn + atendidoBtn + '</div></td>'
                    + '</tr>';
            });
            $('#leadsBody').html(html);
        }).fail(function() {
            $('#leadsBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Error al cargar interesados</td></tr>');
        });
    }

    function marcarLeadAtendido(id) {
        swalMG.fire({
            title: '¿Marcar como atendido?',
            html: 'Se registrará que <strong>' + escHtml(vendedorNombreActual) + '</strong> atendió a este interesado.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, marcar'
        }).then(function(result) {
            if (result.isConfirmed) {
                $.post('/Negocios/MarcarLeadAtendido', { id: id }, function(r) {
                    if (r.success) {
                        toastr.success(r.message);
                        cargarLeads();
                    } else {
                        toastr.error(r.message);
                    }
                }).fail(function(xhr) {
                    toastr.error(xhr.responseJSON?.message || 'Error al marcar lead');
                });
            }
        });
    }

    // ================================================================
    // MIS COMISIONES: Cargar comisiones del vendedor
    // ================================================================
    var comisionesCargadas = false;

    function cargarMisComisiones() {
        $.get('/Negocios/GetVendedorMisComisiones', function(data) {
            // Actualizar stats
            $('#comTotalComisiones').text(data.resumen.totalComisiones);
            $('#comMontoPendiente').text('$' + data.resumen.totalPendiente.toFixed(2));
            $('#comMontoPagado').text('$' + data.resumen.totalPagado.toFixed(2));
            $('#comCantPendientes').text(data.resumen.cantidadPendientes);

            // Renderizar pendientes
            if (data.pendientes.length === 0) {
                $('#comPendientesBody').html('<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-check-circle fs-3 d-block mb-2"></i>No tienes comisiones pendientes</td></tr>');
            } else {
                var html = '';
                data.pendientes.forEach(function(c) {
                    var tipoBadge = c.tipoComision === 'nueva'
