    function cargarTabla() {
        tablaNegocios = $('#vendedorNegociosTable').DataTable({
            ajax: { url: '/Negocios/GetVendedorNegocios', dataSrc: '' },
            columns: [
                { data: 'negocioNombre', render: d => '<strong>' + escHtml(d) + '</strong>' },
                { data: 'duenoNegocio', render: d => escHtml(d) },
                { data: null, render: function(d, t, r) {
                    return escHtml(r.email) + '<br><small class="text-muted">' + escHtml(r.telefono) + '</small>';
                }},
                { data: 'totalClientes', render: function(d) { return '<span class="badge badge-light-info fs-7 fw-bold">' + d + '</span>'; } },
                { data: null, render: function(d, t, r) {
                    var badges = '';
                    if (r.negocioBloqueado) badges += '<span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Bloqueado</span> ';
                    if (r.esPrueba) badges += '<span class="badge bg-warning text-dark">Prueba</span>';
                    else if (r.isActive) badges += '<span class="badge bg-success">Activo</span>';
                    else badges += '<span class="badge bg-danger">Inactivo</span>';
                    return badges;
                }},
                { data: null, render: function(d, t, r) {
                    var tipo = r.esPrueba ? '<span class="badge badge-light-warning">Prueba</span>' : '<span class="badge badge-light-primary">Pago</span>';
                    var dias = r.diasPagados ? '<small class="text-muted d-block">' + r.diasPagados + ' días</small>' : '';
                    var precio = r.precioSuscripcion > 0 ? '<small class="text-muted d-block">$' + r.precioSuscripcion.toFixed(2) + '</small>' : '';
                    return tipo + dias + precio;
                }},
                { data: 'diasRestantesSuscripcion', render: function(d, t, r) {
                    if (!r.fechaExpiracion) return '<span class="text-muted">Sin fecha</span>';
                    var fecha = new Date(r.fechaExpiracion).toLocaleDateString('es-ES');
                    if (d === null || d === undefined) return '<span class="text-muted">' + fecha + '</span>';
                    if (r.porEmpezar) return '<span class="badge bg-secondary">Por empezar</span>';
                    if (d < 0) return '<span class="badge bg-danger">Expirado</span><br><small class="text-muted">' + fecha + '</small>';
                    if (d <= 3) return '<span class="badge bg-warning text-dark">' + d + 'd</span><br><small class="text-muted">' + fecha + '</small>';
                    if (d <= 7) return '<span class="badge bg-info">' + d + 'd</span><br><small class="text-muted">' + fecha + '</small>';
                    return '<span class="badge bg-success">' + d + 'd</span><br><small class="text-muted">' + fecha + '</small>';
                }},
                { data: null, orderable: false, className: 'text-end', render: function(d, t, r) {
                    var csrfToken = $('input[name="__RequestVerificationToken"]').val();
                    var impersonateBtn = '<form method="post" action="/Negocios/VendedorImpersonate/' + r.negocioId + '" style="display:inline;"><input type="hidden" name="__RequestVerificationToken" value="' + csrfToken + '"><button type="submit" class="btn btn-icon btn-bg-light btn-sm" title="Ver negocio"><i class="bi bi-eye text-primary fs-5"></i></button></form>';
                    var estadoBtn = r.isActive
                        ? '<button class="btn btn-icon btn-bg-light btn-sm" onclick="vendedorCambiarEstado(\'' + r.negocioId + '\')" title="Cambiar a Prueba"><i class="bi bi-toggle-on text-success fs-4"></i></button>'
                        : '<button class="btn btn-icon btn-bg-light btn-sm" onclick="vendedorCambiarEstado(\'' + r.negocioId + '\')" title="Cambiar a Activo"><i class="bi bi-toggle-off text-danger fs-4"></i></button>';
                    var bloqueoBtn = r.negocioBloqueado
                        ? '<button class="btn btn-icon btn-bg-light btn-sm" onclick="vendedorDesbloquearNegocio(\'' + r.negocioId + '\')" title="Desbloquear negocio"><i class="bi bi-unlock-fill text-success fs-5"></i></button>'
                        : '<button class="btn btn-icon btn-bg-light btn-sm" onclick="vendedorBloquearNegocio(\'' + r.negocioId + '\')" title="Bloquear negocio"><i class="bi bi-lock-fill text-danger fs-5"></i></button>';
                    var editBtn = '<button class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm" onclick="vendedorEditarNegocio(\'' + r.negocioId + '\')" title="Editar"><i class="bi bi-pencil fs-5"></i></button>';
                    var deleteBtn = '<button class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" onclick="vendedorEliminarNegocio(\'' + r.negocioId + '\', \'' + escHtml(r.negocioNombre).replace(/'/g, "\\'") + '\')" title="Eliminar"><i class="bi bi-trash fs-5"></i></button>';
                    return '<div class="d-flex justify-content-end gap-1">' + impersonateBtn + estadoBtn + bloqueoBtn + editBtn + deleteBtn + '</div>';
                }}
            ],
            order: [[0, 'asc']]
        });
    }

    // ================================================================
