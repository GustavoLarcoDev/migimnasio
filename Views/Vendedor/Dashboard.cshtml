                    // QR image
                    if (data.imagenQR) {
                        var qrSrc = data.imagenQR.startsWith('data:') ? data.imagenQR : 'data:image/png;base64,' + data.imagenQR;
                        detailHtml += '<div style="text-align:center;margin-bottom:16px;">'
                            + '<div style="font-size:0.75rem;color:var(--mg-text-muted, #A1A5B7);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px;">'
                            + '<i class="bi bi-qr-code me-1"></i>Código QR</div>'
                            + '<img src="' + qrSrc + '" alt="QR" class="qr-zoomable" style="max-height:220px;border-radius:8px;border:1px solid var(--mg-border-color, #E4E6EF);" title="Click para ampliar" />'
                            + '</div>';
                    }

                    // Confirmation number input (optional)
                    detailHtml += '<div style="margin-bottom:8px;">'
                        + '<label style="font-size:0.82rem;font-weight:600;color:var(--mg-text-color, #181C32);display:block;margin-bottom:6px;">'
                        + '<i class="bi bi-hash me-1"></i>Número de Confirmación <span style="font-weight:400;color:var(--mg-text-muted, #A1A5B7);">(opcional)</span></label>'
                        + '<input type="text" id="swalNumConfirmacion" class="form-control" placeholder="Ej: 12345678" '
                        + 'style="font-size:0.95rem;" />'
                        + '</div>';

                    detailHtml += '</div>'; // close container

                    Swal.update({
                        html: detailHtml,
                        showConfirmButton: true,
                        showCancelButton: true,
                        confirmButtonText: '<i class="bi bi-check-circle me-1"></i>Confirmar Pago',
                        cancelButtonText: '<i class="bi bi-arrow-left me-1"></i>Volver',
                        allowOutsideClick: true
                    });

                }).fail(function() {
                    Swal.update({
                        html: '<div style="text-align:center;color:#F1416C;"><i class="bi bi-exclamation-triangle fs-3 d-block mb-2"></i>'
                            + 'Error al cargar los detalles del método de pago.</div>',
                        showConfirmButton: false,
                        showCancelButton: true,
                        cancelButtonText: 'Volver',
                        allowOutsideClick: true
                    });
                });
            }
        }).then(function(result) {
            if (result.isConfirmed) {
                var numConf = $('#swalNumConfirmacion').val() || '';
                callback({ metodoPago: metodoNombre, numeroConfirmacion: numConf.trim() });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                // Go back to method selection
                mostrarMetodosPagoAdmin(callback);
            }
        });
    }

    // ================================================================
    // CREAR NEGOCIO: Enviar formulario al servidor
    // ================================================================
    function enviarCreacionVendedor(formData) {
        var btn = $('#btnCrear');
        var originalHtml = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Creando...');

        $.post('/Negocios/VendedorCrearNegocio', formData, function(r) {
            if (r.success) {
                swalMG.fire('Negocio creado', r.message, 'success');
                $('#crearNegocioForm')[0].reset();
                // Re-enable select after reset
                $('#crearDiasPagados').prop('disabled', false);
                $('#crearDiasCustomContainer').addClass('d-none');
                $('#crearDiasCustom').prop('required', false);
                resetCrearSuscripcion();
                cargarStats();
                if (tablaNegocios) tablaNegocios.ajax.reload();
            } else {
                toastr.error(r.message || 'Error al crear negocio');
            }
        }).fail(function(xhr) {
            toastr.error(xhr.responseJSON?.message || 'Error al crear negocio');
        }).always(function() {
            btn.prop('disabled', false).html(originalHtml);
        });
    }

    $('#crearNegocioForm').on('submit', function(e) {
        e.preventDefault();

        // Validate subscription selection when "De Pago" is chosen
        var esPrueba = $('input[name="esPrueba"]:checked').val() === 'true';
        if (!esPrueba && !$('#crearDias').val()) {
            toastr.warning('Por favor selecciona la duración de la suscripción.');
            $('#crearDiasPagados').focus();
            return;
        }

        if (!esPrueba) {
            // Paid business: show admin payment methods first
            mostrarMetodosPagoAdmin(function(pagoInfo) {
                var formDataStr = $('#crearNegocioForm').serialize()
                    + '&metodoPago=' + encodeURIComponent(pagoInfo.metodoPago)
                    + '&numeroConfirmacion=' + encodeURIComponent(pagoInfo.numeroConfirmacion || '');
                enviarCreacionVendedor(formDataStr);
            });
        } else {
            // Trial business: submit directly
            enviarCreacionVendedor($('#crearNegocioForm').serialize() + '&metodoPago=N/A');
        }
    });

    $('#btnCancelar').click(function() {
        document.querySelector('[data-mg-tab="resumenTab"]').click();
    });

    // ================================================================
    // MÉTODOS DE COBRO DEL VENDEDOR: Tarjetas con stats de comisiones
    // ================================================================
    var vendedorMetodosCobroCargados = false;

    function cargarVendedorMetodosCobro() {
        if (vendedorMetodosCobroCargados) return;

        // Load both: vendor bank info AND commission history (to compute stats per method)
        var bankPromise = $.get('/Negocios/GetVendedorDatosBancarios');
        var comisionesPromise = $.get('/Negocios/GetVendedorMisComisiones');

        $.when(bankPromise, comisionesPromise).done(function(bankResp, comResp) {
            var bankData = bankResp[0];
            var comData = comResp[0];
            var container = $('#vendedorMetodosCobro');
            container.empty();
            $('#vendedorMetodosCobroLoading').remove();

            // Build commission stats grouped by MetodoPagoPago
            var statsByMethod = {};
            var now = new Date();
            var todayStr = now.toISOString().split('T')[0];

            // Calculate start of week (Monday)
            var weekStart = new Date(now);
            var dayOfWeek = weekStart.getDay();
            var diff = dayOfWeek === 0 ? 6 : dayOfWeek - 1;
            weekStart.setDate(weekStart.getDate() - diff);
            weekStart.setHours(0, 0, 0, 0);

            // Calculate start of month
            var monthStart = new Date(now.getFullYear(), now.getMonth(), 1);

            if (comData && comData.pagadas) {
                comData.pagadas.forEach(function(c) {
                    var metodo = c.metodoPagoPago || 'Sin método';
                    if (!statsByMethod[metodo]) {
                        statsByMethod[metodo] = { total: 0, hoy: 0, semana: 0, mes: 0, count: 0 };
                    }
                    statsByMethod[metodo].total += c.montoComision;
                    statsByMethod[metodo].count++;

                    // Parse the date from "dd/MM/yyyy HH:mm" format
                    if (c.fechaPago) {
                        var parts = c.fechaPago.split(' ')[0].split('/');
                        if (parts.length === 3) {
                            var fechaPago = new Date(parseInt(parts[2]), parseInt(parts[1]) - 1, parseInt(parts[0]));

                            if (fechaPago.toISOString().split('T')[0] === todayStr) {
                                statsByMethod[metodo].hoy += c.montoComision;
                            }
                            if (fechaPago >= weekStart) {
                                statsByMethod[metodo].semana += c.montoComision;
                            }
                            if (fechaPago >= monthStart) {
                                statsByMethod[metodo].mes += c.montoComision;
                            }
                        }
                    }
                });
            }

            // 1) Efectivo card (always present)
            var efectivoStats = statsByMethod['Efectivo'] || { total: 0, hoy: 0, semana: 0, mes: 0, count: 0 };
            container.append(buildVendedorMetodoCard(
                'Efectivo',
                'bi-cash-stack',
                'rgba(80,205,137,0.1)',
                '#50CD89',
                'Comisiones pagadas en efectivo',
                null, null, null,
                efectivoStats
            ));

            // 2) Bank account card (from vendor profile)
            var hasBankData = bankData.nombreBanco || bankData.numeroCuenta || bankData.numeroCedula;
            if (hasBankData) {
                // Find stats for this bank method (could match various names)
                var bankStats = { total: 0, hoy: 0, semana: 0, mes: 0, count: 0 };
                // Accumulate stats for any method that is NOT "Efectivo" and NOT empty
                Object.keys(statsByMethod).forEach(function(key) {
                    if (key !== 'Efectivo' && key !== 'Sin método') {
                        bankStats.total += statsByMethod[key].total;
                        bankStats.hoy += statsByMethod[key].hoy;
                        bankStats.semana += statsByMethod[key].semana;
                        bankStats.mes += statsByMethod[key].mes;
                        bankStats.count += statsByMethod[key].count;
                    }
                });

                container.append(buildVendedorMetodoCard(
                    bankData.nombreBanco || 'Cuenta Bancaria',
                    'bi-bank',
                    'rgba(62,151,255,0.1)',
                    '#3E97FF',
                    bankData.nombreCompleto || 'Titular no registrado',
                    bankData.numeroCuenta,
                    bankData.numeroCedula,
                    null,
                    bankStats
                ));
            }

            // 3) If no bank data, show add bank account card with inline form
            if (!hasBankData) {
                container.append(
                    '<div class="col-md-6 col-lg-4">'
                    + '<div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--mg-card-bg); border: 2px dashed var(--mg-border-color, #E4E6EF) !important;">'
                    + '<div class="card-body text-center p-4 d-flex flex-column justify-content-center">'
                    + '<div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"'
                    + ' style="width: 60px; height: 60px; background: rgba(62,151,255,0.08);">'
                    + '<i class="bi bi-plus-lg fs-4" style="color: var(--mg-primary, #3E97FF);"></i>'
                    + '</div>'
                    + '<h6 class="fw-bold mb-2" style="color: var(--mg-text-color);">Agrega tu cuenta bancaria</h6>'
                    + '<p class="text-muted small mb-3">Registra tus datos bancarios para recibir comisiones por transferencia.</p>'
                    + '<button class="btn btn-sm px-4" onclick="abrirModalDatosBancarios()" style="background: var(--mg-primary); color: white; border-radius: 10px;">'
                    + '<i class="bi bi-plus-lg me-1"></i>Agregar datos</button>'
                    + '</div></div></div>'
                );
            } else {
                // Add edit button to existing bank card
                container.find('.col-md-6.col-lg-4:last .card-body').append(
                    '<div class="mt-2 text-end">'
                    + '<button class="btn btn-sm btn-outline-primary" onclick="abrirModalDatosBancarios(\'' + escHtml(bankData.nombreBanco || '') + '\',\'' + escHtml(bankData.numeroCuenta || '') + '\',\'' + escHtml(bankData.numeroCedula || '') + '\')" style="border-radius: 8px; font-size: 0.75rem;">'
                    + '<i class="bi bi-pencil me-1"></i>Editar</button></div>'
                );
            }

            // 4) Info note
            if ($('#vendedorMetodosCobroNote').length === 0) {
                container.after(
                    '<div class="p-3 rounded-3 mb-4" id="vendedorMetodosCobroNote" style="background: rgba(62,151,255,0.04); border: 1px solid rgba(62,151,255,0.15);">'
                    + '<div class="d-flex align-items-start">'
                    + '<i class="bi bi-info-circle text-primary me-2 mt-1"></i>'
                    + '<small style="color: var(--mg-text-color);">Las estadísticas se calculan a partir de tus comisiones pagadas. '
                    + 'Puedes editar tus datos bancarios en cualquier momento.</small>'
                    + '</div></div>'
                );
            }

            vendedorMetodosCobroCargados = true;
        }).fail(function() {
            var container = $('#vendedorMetodosCobro');
            container.empty();
            $('#vendedorMetodosCobroLoading').remove();
            container.html(
                '<div class="col-12 text-center text-danger py-4">'
                + '<i class="bi bi-exclamation-triangle fs-3 d-block mb-2"></i>'
                + 'Error al cargar métodos de cobro'
                + '</div>'
            );
        });
    }

    /**
     * Builds a unified payment method card with commission stats.
     * Pattern matches the DashboardTienda stats+card approach.
     */
    function buildVendedorMetodoCard(nombre, iconClass, iconBg, iconColor, subtitulo, cuenta, cedula, instrucciones, stats) {
        var card = '<div class="col-md-6 col-lg-4">'
            + '<div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--mg-card-bg);">'
            + '<div class="card-body p-4">';

        // Header: icon + name
        card += '<div class="d-flex align-items-center mb-3">'
            + '<div class="rounded-circle d-flex align-items-center justify-content-center me-3 flex-shrink-0"'
            + ' style="width: 52px; height: 52px; background: ' + iconBg + ';">'
            + '<i class="bi ' + iconClass + ' fs-4" style="color: ' + iconColor + ';"></i>'
            + '</div>'
            + '<div class="flex-grow-1 min-width-0">'
            + '<h6 class="fw-bold mb-0" style="color: var(--mg-text-color);">' + escHtml(nombre) + '</h6>'
            + '<small class="text-muted text-truncate d-block">' + escHtml(subtitulo) + '</small>'
            + '</div>'
            + '</div>';

        // Bank details (if any)
        if (cuenta || cedula) {
            card += '<div class="mb-3 p-2 rounded-2" style="background: var(--mg-body-bg, #f5f8fa);">';
            if (cuenta) {
                card += '<div class="d-flex align-items-center justify-content-between mb-1">'
                    + '<small class="text-muted">Cuenta:</small>'
                    + '<div class="d-flex align-items-center gap-1">'
                    + '<span class="fw-semibold small" style="color: var(--mg-text-color); font-family: monospace;">' + escHtml(cuenta) + '</span>'
                    + '<button type="button" class="btn btn-sm p-0 border-0" onclick="copiarTexto(\'' + escHtml(cuenta).replace(/'/g, "\\'") + '\')" title="Copiar" style="line-height:1;">'
                    + '<i class="bi bi-clipboard text-muted" style="font-size: 0.75rem;"></i>'
                    + '</button>'
                    + '</div>'
                    + '</div>';
            }
            if (cedula) {
                card += '<div class="d-flex align-items-center justify-content-between">'
                    + '<small class="text-muted">Cedula:</small>'
                    + '<div class="d-flex align-items-center gap-1">'
                    + '<span class="fw-semibold small" style="color: var(--mg-text-color); font-family: monospace;">' + escHtml(cedula) + '</span>'
                    + '<button type="button" class="btn btn-sm p-0 border-0" onclick="copiarTexto(\'' + escHtml(cedula).replace(/'/g, "\\'") + '\')" title="Copiar" style="line-height:1;">'
                    + '<i class="bi bi-clipboard text-muted" style="font-size: 0.75rem;"></i>'
                    + '</button>'
                    + '</div>'
                    + '</div>';
            }
            card += '</div>';
        }

        // Commission stats (hoy / semana / mes)
        if (stats && stats.total > 0) {
            card += '<div class="border-top pt-3 mt-2" style="border-color: var(--mg-border-color, #E4E6EF) !important;">'
                + '<div class="row text-center g-0">'
                + '<div class="col-4">'
                + '<small class="text-muted d-block mb-1" style="font-size: 0.72rem;">Hoy</small>'
                + '<strong style="color: var(--mg-success, #50CD89); font-size: 0.95rem;">$' + stats.hoy.toFixed(2) + '</strong>'
                + '</div>'
                + '<div class="col-4">'
                + '<small class="text-muted d-block mb-1" style="font-size: 0.72rem;">Semana</small>'
                + '<strong style="color: var(--mg-info, #009EF7); font-size: 0.95rem;">$' + stats.semana.toFixed(2) + '</strong>'
                + '</div>'
                + '<div class="col-4">'
                + '<small class="text-muted d-block mb-1" style="font-size: 0.72rem;">Mes</small>'
                + '<strong style="color: var(--mg-primary, #3E97FF); font-size: 0.95rem;">$' + stats.mes.toFixed(2) + '</strong>'
                + '</div>'
                + '</div>'
                + '<div class="text-center mt-2">'
                + '<small class="text-muted" style="font-size: 0.72rem;">' + stats.count + ' comision' + (stats.count !== 1 ? 'es' : '') + ' pagada' + (stats.count !== 1 ? 's' : '') + ' | Total: $' + stats.total.toFixed(2) + '</small>'
                + '</div>'
                + '</div>';
        } else {
            card += '<div class="border-top pt-3 mt-2 text-center" style="border-color: var(--mg-border-color, #E4E6EF) !important;">'
                + '<small class="text-muted"><i class="bi bi-graph-up me-1"></i>Sin comisiones pagadas por este medio</small>'
                + '</div>';
        }

        card += '</div></div></div>';
        return card;
    }

    // ================================================================
    // MÉTODOS DE PAGO: Cargar métodos de pago del admin (referencia)
    // ================================================================
    var metodosPagoCargados = false;

    function cargarMetodosPagoAdmin() {
        if (metodosPagoCargados) return;

        $.get('/Negocios/GetAdminMetodosPagoParaVendedor', function(data) {
            var grid = $('#adminMetodosPagoGrid');
            // Quitar tarjetas dinámicas anteriores (mantener la de efectivo)
            grid.children('.mp-dynamic').remove();

            if (data.length === 0) {
                $('#adminMetodosPagoEmpty').removeClass('d-none');
            } else {
                $('#adminMetodosPagoEmpty').addClass('d-none');
            }

            data.forEach(function(mp) {
                var iconClass = 'bi-bank';
                var iconColor = 'text-primary';
                var iconBg = 'rgba(62,151,255,0.1)';
                var nombre = escHtml(mp.nombre);
                var nombreLower = mp.nombre.toLowerCase();

                if (nombreLower.indexOf('transferencia') >= 0 || nombreLower.indexOf('banco') >= 0) {
                    iconClass = 'bi-bank'; iconColor = 'text-primary'; iconBg = 'rgba(62,151,255,0.1)';
                } else if (nombreLower.indexOf('paypal') >= 0) {
                    iconClass = 'bi-paypal'; iconColor = 'text-info'; iconBg = 'rgba(0,158,247,0.1)';
                } else if (nombreLower.indexOf('nequi') >= 0 || nombreLower.indexOf('movil') >= 0 || nombreLower.indexOf('billetera') >= 0) {
                    iconClass = 'bi-phone'; iconColor = 'text-success'; iconBg = 'rgba(80,205,137,0.1)';
                } else if (nombreLower.indexOf('tarjeta') >= 0) {
                    iconClass = 'bi-credit-card-2-front'; iconColor = 'text-warning'; iconBg = 'rgba(255,199,0,0.1)';
                }

                var qrBadge = mp.imagenQR ? '<span class="badge bg-light-info text-info ms-2"><i class="bi bi-qr-code me-1"></i>QR</span>' : '';

                var cuentaInfo = '';
                if (mp.numeroCuenta) {
                    cuentaInfo = '<div class="mt-2"><small class="text-muted">Cuenta:</small> <span class="fw-semibold" style="color: var(--mg-text-color);">' + escHtml(mp.numeroCuenta) + '</span></div>';
                }
                if (mp.nombreTitular) {
                    cuentaInfo += '<div><small class="text-muted">Titular:</small> <span class="fw-semibold" style="color: var(--mg-text-color);">' + escHtml(mp.nombreTitular) + '</span></div>';
                }

                var card = '<div class="col-md-6 col-lg-4 mp-dynamic">'
                    + '<div class="border rounded-3 p-3 h-100" style="background: var(--mg-card-bg); border-color: var(--mg-border-color) !important;">'
                    + '<div class="d-flex align-items-center mb-2">'
                    + '<div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;background:' + iconBg + ';">'
                    + '<i class="bi ' + iconClass + ' ' + iconColor + ' fs-5"></i>'
                    + '</div>'
                    + '<div class="flex-grow-1">'
                    + '<h6 class="fw-bold mb-0" style="color: var(--mg-text-color);">' + nombre + qrBadge + '</h6>'
                    + (mp.esPredeterminado ? '<small class="text-success"><i class="bi bi-star-fill me-1"></i>Predeterminado</small>' : '')
                    + '</div>'
                    + '</div>'
                    + cuentaInfo
                    + '<div class="mt-3 text-end">'
                    + '<button class="btn btn-sm btn-light-primary" onclick="verDetalleMetodoPago(\'' + mp.metodoPagoId + '\')">'
                    + '<i class="bi bi-eye me-1"></i>Ver Detalles'
                    + '</button>'
                    + '</div>'
                    + '</div>'
                    + '</div>';
                grid.append(card);
            });

            metodosPagoCargados = true;
        }).fail(function() {
            toastr.error('Error al cargar métodos de pago del admin');
        });
    }

    // ================================================================
    // MÉTODOS DE PAGO: Ver detalle de un método de pago del admin
    // ================================================================
    function verDetalleMetodoPago(id) {
        $('#detalleMP_Loading').removeClass('d-none');
        $('#detalleMP_Content').addClass('d-none');
        $('#detalleMetodoPagoModal').modal('show');

        $.get('/Negocios/GetAdminMetodoPagoDetalle', { metodoPagoId: id }, function(data) {
            $('#detalleMP_Nombre').text(data.nombre);

            // Cuenta
            if (data.numeroCuenta) {
                $('#detalleMP_Cuenta').text(data.numeroCuenta);
                $('#detalleMP_CuentaWrap').show();
            } else {
                $('#detalleMP_CuentaWrap').hide();
            }

            // Titular
            if (data.nombreTitular) {
                $('#detalleMP_Titular').text(data.nombreTitular);
                $('#detalleMP_TitularWrap').show();
            } else {
                $('#detalleMP_TitularWrap').hide();
            }

            // Cédula
            if (data.cedula) {
                $('#detalleMP_Cedula').text(data.cedula);
                $('#detalleMP_CedulaWrap').show();
            } else {
                $('#detalleMP_CedulaWrap').hide();
            }

            // Instrucciones
            if (data.instrucciones) {
                $('#detalleMP_Instrucciones').text(data.instrucciones);
                $('#detalleMP_InstruccionesWrap').show();
            } else {
                $('#detalleMP_InstruccionesWrap').hide();
            }

            // QR
            if (data.imagenQR) {
                var src = data.imagenQR.startsWith('data:') ? data.imagenQR : 'data:image/png;base64,' + data.imagenQR;
                $('#detalleMP_QR').attr('src', src);
                $('#detalleMP_QRWrap').show();
            } else {
                $('#detalleMP_QRWrap').hide();
            }

            $('#detalleMP_Loading').addClass('d-none');
            $('#detalleMP_Content').removeClass('d-none');
        }).fail(function() {
            $('#detalleMP_Loading').html('<div class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Error al cargar detalles</div>');
        });
    }

    function copiarTexto(texto) {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(texto).then(function() {
                toastr.success('Copiado al portapapeles');
            });
        } else {
            // Fallback para navegadores sin clipboard API
            var temp = $('<textarea>').val(texto).appendTo('body').select();
            document.execCommand('copy');
            temp.remove();
            toastr.success('Copiado al portapapeles');
        }
    }
    // ================================================================
    // MODAL DATOS BANCARIOS DEL VENDEDOR
    // ================================================================
    function abrirModalDatosBancarios(banco, cuenta, cedula) {
        $('#dbNombreBanco').val(banco || '');
        $('#dbNumeroCuenta').val(cuenta || '');
        $('#dbNumeroCedula').val(cedula || '');
        var modal = new bootstrap.Modal(document.getElementById('modalDatosBancarios'));
        modal.show();
    }

    function guardarDatosBancarios() {
        var banco = $('#dbNombreBanco').val().trim();
        var cuenta = $('#dbNumeroCuenta').val().trim();
        var cedula = $('#dbNumeroCedula').val().trim();

        if (!banco && !cuenta) {
            toastr.warning('Ingresa al menos el nombre del banco y numero de cuenta');
            return;
        }

        $.post('/Negocios/ActualizarDatosBancarios', {
            nombreBanco: banco,
            numeroCuenta: cuenta,
            numeroCedula: cedula
        }, function(r) {
            if (r.success) {
                toastr.success(r.message);
                bootstrap.Modal.getInstance(document.getElementById('modalDatosBancarios')).hide();
                vendedorMetodosCobroCargados = false;
                cargarVendedorMetodosCobro();
            } else {
                toastr.error(r.message);
            }
        }).fail(function() {
            toastr.error('Error al guardar datos bancarios');
        });
    }
    </script>

<!-- Modal: Datos Bancarios del Vendedor -->
<div class="modal fade" id="modalDatosBancarios" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content border-0" style="border-radius: 20px; background: var(--mg-card-bg);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" style="color: var(--mg-text-color);">
                    <i class="bi bi-bank me-2"></i>Datos Bancarios
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Ingresa tus datos bancarios para que el administrador pueda pagarte comisiones por transferencia.</p>
                <div class="mb-3">
                    <label class="form-label small fw-bold" style="color: var(--mg-text-color);">Nombre del Banco</label>
                    <input type="text" class="form-control" id="dbNombreBanco" placeholder="Ej: Banco Pichincha"
                           style="border-radius: 10px; background: var(--mg-body-bg); border-color: var(--mg-border-color); color: var(--mg-text-color);">
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold" style="color: var(--mg-text-color);">Numero de Cuenta</label>
                    <input type="text" class="form-control" id="dbNumeroCuenta" placeholder="Ej: 2200123456"
                           style="border-radius: 10px; background: var(--mg-body-bg); border-color: var(--mg-border-color); color: var(--mg-text-color);">
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold" style="color: var(--mg-text-color);">Numero de Cedula</label>
                    <input type="text" class="form-control" id="dbNumeroCedula" placeholder="Ej: 1712345678"
                           style="border-radius: 10px; background: var(--mg-body-bg); border-color: var(--mg-border-color); color: var(--mg-text-color);">
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 10px;">Cancelar</button>
                <button type="button" class="btn px-4" onclick="guardarDatosBancarios()"
                        style="background: var(--mg-primary); color: white; border-radius: 10px;">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@if (ViewBag.TerminosPendientes == true)
{
    <!-- Overlay de Términos y Condiciones del Vendedor — No se puede cerrar -->
    <div id="terminosVendedorOverlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:99998;display:flex;align-items:center;justify-content:center;backdrop-filter:blur(8px);overflow-y:auto;padding:1rem;">
        <div style="background:#fff;border-radius:16px;padding:2rem;max-width:680px;width:95%;box-shadow:0 20px 60px rgba(0,0,0,0.3);max-height:95vh;overflow-y:auto;">
            <div style="text-align:center;margin-bottom:1.5rem;">
                <div style="width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,#7239EA,#9B59B6);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
                    <i class="bi bi-file-earmark-text" style="font-size:2rem;color:#fff;"></i>
                </div>
                <h3 style="font-weight:700;color:#181C32;margin-bottom:0.5rem;">Términos y Condiciones del Vendedor</h3>
                <p style="color:#7E8299;font-size:0.9rem;">Para continuar usando el panel de vendedores de <strong>My-Negocio</strong>, debes leer y aceptar los siguientes términos.</p>
            </div>

            <div style="background:#F9FAFB;border-radius:12px;padding:1.25rem;margin-bottom:1.5rem;font-size:0.88rem;color:#3F4254;">
                <ol style="padding-left:1.2rem;margin:0;line-height:1.7;">
                    <li style="margin-bottom:0.5rem;">El vendedor <strong>no debe realizar cobros directos</strong> a los dueños de negocios. Todos los pagos deben dirigirse exclusivamente a las cuentas del administrador de My-Negocio.</li>
                    <li style="margin-bottom:0.5rem;">El vendedor no debe faltar el respeto a los dueños de negocios ni a ningún miembro del equipo de My-Negocio.</li>
                    <li style="margin-bottom:0.5rem;">El vendedor se compromete a aprender el funcionamiento del sistema para poder brindar soporte básico a sus clientes.</li>
                    <li style="margin-bottom:0.5rem;">Las comisiones se pagan <strong>cada 15 días del mes</strong> (quincena y fin de mes).</li>
                    <li style="margin-bottom:0.5rem;">Los pagos de comisiones se realizan exclusivamente vía <strong>transferencia bancaria</strong> a la cuenta registrada por el vendedor.</li>
                    <li style="margin-bottom:0.5rem;">La comisión por negocio vendido es de <strong>$5.00 USD</strong>, pagada <strong>una sola vez</strong> por negocio.</li>
                    <li style="margin-bottom:0.5rem;">Ejemplo: si vendes 10 negocios = $50, si vendes 20 negocios = $100.</li>
                    <li style="margin-bottom:0.5rem;">Las comisiones se basan en <strong>negocios nuevos vendidos</strong>, no en renovaciones de suscripciones existentes.</li>
                    <li style="margin-bottom:0.5rem;">Los períodos de prueba gratuita <strong>no generan comisión</strong>. La comisión se genera únicamente cuando el negocio realiza su primer pago.</li>
                    <li style="margin-bottom:0.5rem;">La comisión se genera automáticamente cuando el negocio paga su suscripción (mínimo $15, mínimo 30 días).</li>
                    <li style="margin-bottom:0.5rem;"><strong>Bono especial:</strong> $1,000 USD por cada 100 negocios vendidos que estén activos y pagando.</li>
                    <li>El incumplimiento de estos términos resultará en la <strong>terminación inmediata</strong> de la relación comercial bajo las leyes vigentes de Ecuador, con pago de comisiones pendientes hasta la fecha de terminación y <strong>pérdida permanente de acceso</strong> al panel de vendedores.</li>
                </ol>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:flex;align-items:flex-start;gap:0.6rem;cursor:pointer;font-size:0.9rem;color:#3F4254;">
                    <input type="checkbox" id="chkAceptoTerminosVendedor" style="margin-top:3px;width:18px;height:18px;accent-color:#7239EA;flex-shrink:0;">
                    <span>Leí, entendí y acepto los <strong>Términos y Condiciones</strong> de vendedor de My-Negocio.</span>
                </label>
            </div>

            <button id="btnAceptarTerminosVendedor" class="btn btn-lg w-100" style="font-weight:600;border-radius:10px;background:linear-gradient(135deg,#7239EA,#9B59B6);color:#fff;" disabled>
                <i class="bi bi-check-circle me-2"></i>Aceptar y Continuar
            </button>
        </div>
    </div>
    <style>
        #terminosVendedorOverlay ~ *, .mg-sidebar, .mg-topbar, .mg-content { pointer-events: none !important; }
        #terminosVendedorOverlay, #terminosVendedorOverlay * { pointer-events: auto !important; }
    </style>
    <script>
    (function() {
        var chk = document.getElementById('chkAceptoTerminosVendedor');
        var btn = document.getElementById('btnAceptarTerminosVendedor');
        chk.addEventListener('change', function() { btn.disabled = !this.checked; });
        btn.addEventListener('click', function() {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Procesando...';
            $.post('/Negocios/AceptarTerminosVendedor', function(res) {
                if (res.success) {
                    // Remover overlay sin reload (la vista tiene Layout = null)
                    document.getElementById('terminosVendedorOverlay').remove();
                    // Restaurar pointer-events
                    document.querySelectorAll('.mg-sidebar, .mg-topbar, .mg-content').forEach(function(el) {
                        el.style.pointerEvents = '';
                    });
                    toastr.success('Términos aceptados correctamente');
                } else {
                    toastr.error(res.message || 'Error al aceptar términos');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Aceptar y Continuar';
                }
            }).fail(function() {
                toastr.error('Error de conexión. Intenta nuevamente.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Aceptar y Continuar';
            });
        });
    })();
    </script>
}

</body>
</html>
