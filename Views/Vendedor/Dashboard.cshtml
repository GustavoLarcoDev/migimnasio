                        : '<span class="badge bg-info bg-opacity-10" style="color: var(--mg-info, #009EF7);">Renovación</span>';
                    html += '<tr>'
                        + '<td><strong>' + escHtml(c.nombreNegocio) + '</strong></td>'
                        + '<td><span class="fw-bold" style="color: var(--mg-warning, #FFC700);">$' + c.montoComision.toFixed(2) + '</span></td>'
                        + '<td>' + tipoBadge + '</td>'
                        + '<td class="d-none d-md-table-cell">' + c.diasContratados + ' días</td>'
                        + '<td class="d-none d-md-table-cell">$' + c.precioNegocio.toFixed(2) + '</td>'
                        + '<td><small class="text-muted">' + escHtml(c.fechaCreacion) + '</small></td>'
                        + '</tr>';
                });
                $('#comPendientesBody').html(html);
