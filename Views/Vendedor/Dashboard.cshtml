                + '<span class="spinner-border spinner-border-sm text-primary me-2"></span>'
                + '<span style="color:var(--mg-text-muted, #A1A5B7);">Cargando detalles...</span>'
                + '</div>',
            showConfirmButton: false,
            showCancelButton: false,
            allowOutsideClick: false,
            width: 520,
            didOpen: function() {
                $.get('/Negocios/GetAdminMetodoPagoDetalle', { metodoPagoId: metodoPagoId }, function(data) {
                    var detailHtml = '<div style="text-align:left;">';

                    // Amount reminder
                    detailHtml += '<div style="padding:10px 14px;margin-bottom:16px;border-radius:8px;'
                        + 'background:rgba(62,151,255,0.06);border:1px solid rgba(62,151,255,0.15);">'
                        + '<div style="font-size:0.82rem;color:var(--mg-text-muted, #A1A5B7);">Monto a transferir</div>'
                        + '<div style="font-size:1.4rem;font-weight:700;color:var(--mg-primary, #3E97FF);">$' + escHtml(precio) + '</div>'
                        + '</div>';

                    // Bank details grid
                    detailHtml += '<div style="border:1px solid var(--mg-border-color, #E4E6EF);border-radius:10px;overflow:hidden;margin-bottom:16px;">';

                    if (data.numeroCuenta) {
                        detailHtml += '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;'
                            + 'border-bottom:1px solid var(--mg-border-color, #E4E6EF);">'
                            + '<div>'
                            + '<div style="font-size:0.75rem;color:var(--mg-text-muted, #A1A5B7);text-transform:uppercase;letter-spacing:0.5px;">Número de Cuenta</div>'
                            + '<div style="font-weight:600;font-size:1rem;color:var(--mg-text-color, #181C32);font-family:monospace;" id="swalCuenta">'
                            + escHtml(data.numeroCuenta) + '</div>'
                            + '</div>'
                            + '<button type="button" class="btn btn-sm btn-light" onclick="copiarTexto(\'' + escHtml(data.numeroCuenta).replace(/'/g, "\\'") + '\')" '
                            + 'style="flex-shrink:0;" title="Copiar">'
                            + '<i class="bi bi-clipboard"></i>'
                            + '</button>'
                            + '</div>';
                    }

                    if (data.nombreTitular) {
                        detailHtml += '<div style="padding:12px 16px;border-bottom:1px solid var(--mg-border-color, #E4E6EF);">'
                            + '<div style="font-size:0.75rem;color:var(--mg-text-muted, #A1A5B7);text-transform:uppercase;letter-spacing:0.5px;">Titular</div>'
                            + '<div style="font-weight:600;color:var(--mg-text-color, #181C32);">' + escHtml(data.nombreTitular) + '</div>'
                            + '</div>';
                    }

                    if (data.cedula) {
                        detailHtml += '<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;'
                            + 'border-bottom:1px solid var(--mg-border-color, #E4E6EF);">'
                            + '<div>'
                            + '<div style="font-size:0.75rem;color:var(--mg-text-muted, #A1A5B7);text-transform:uppercase;letter-spacing:0.5px;">Cédula</div>'
                            + '<div style="font-weight:600;color:var(--mg-text-color, #181C32);font-family:monospace;" id="swalCedula">'
                            + escHtml(data.cedula) + '</div>'
                            + '</div>'
                            + '<button type="button" class="btn btn-sm btn-light" onclick="copiarTexto(\'' + escHtml(data.cedula).replace(/'/g, "\\'") + '\')" '
                            + 'style="flex-shrink:0;" title="Copiar">'
                            + '<i class="bi bi-clipboard"></i>'
                            + '</button>'
                            + '</div>';
                    }

                    detailHtml += '</div>'; // close details grid

                    // Instructions
                    if (data.instrucciones) {
                        detailHtml += '<div style="padding:12px 14px;border-radius:8px;margin-bottom:16px;'
                            + 'background:var(--mg-body-bg, #f5f8fa);border:1px solid var(--mg-border-color, #E4E6EF);">'
                            + '<div style="font-size:0.75rem;color:var(--mg-text-muted, #A1A5B7);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">'
                            + '<i class="bi bi-info-circle me-1"></i>Instrucciones</div>'
                            + '<div style="font-size:0.88rem;color:var(--mg-text-color, #181C32);white-space:pre-wrap;">'
                            + escHtml(data.instrucciones) + '</div>'
                            + '</div>';
