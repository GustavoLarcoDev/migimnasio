@{
    Layout = null;
    var vendedorNombre = User.Identity?.Name ?? "Vendedor";
    var isAdminImpersonating = User.Claims.Any(c => c.Type == "AdminImpersonating" && c.Value == "true");
}

<!DOCTYPE html>
<html lang="es" data-theme="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Panel Vendedor - Mi Negocio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/metronic-style.css" />
    <style>
    .mg-modelo-card { border: 2px solid var(--mg-gray-300, #E4E6EF) !important; transition: all 0.3s ease; }
    .mg-modelo-card:hover { border-color: var(--mg-primary, #3E97FF) !important; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .mg-modelo-card:has(input:checked) { border-color: var(--mg-primary, #3E97FF) !important; background-color: var(--mg-primary-light, rgba(62, 151, 255, 0.08)); }
    </style>
    <script>
    (function() {
        var t = localStorage.getItem('mg-theme') || '';
        if (t) document.documentElement.setAttribute('data-theme', t);
    })();
    </script>
</head>
<body class="mg-dashboard @(isAdminImpersonating ? "is-impersonating" : "")">

    @if (isAdminImpersonating)
    {
        <div class="mg-impersonation-banner">
            <i class="bi bi-eye-fill me-2"></i>
            Estás viendo como vendedor: <strong>@vendedorNombre</strong>
            <form method="post" action="/Negocios/AdminStopImpersonateVendedor" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-light ms-3 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i>Volver al Panel Admin
                </button>
            </form>
        </div>
    }

    <div class="mg-sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="mg-sidebar" id="sidebar">
        <div class="mg-sidebar-brand">
            <i class="bi bi-shop"></i>
            <h4>Mi Negocio</h4>
        </div>

        <nav class="mg-sidebar-menu">
            <a href="#resumenTab" class="nav-link active" data-mg-tab="resumenTab">
                <i class="bi bi-speedometer2"></i>
                <span>Resumen</span>
                <span class="badge bg-danger rounded-pill ms-auto d-none" id="badgeLeads">0</span>
            </a>
            <a href="#negociosTab" class="nav-link" data-mg-tab="negociosTab">
                <i class="bi bi-building"></i>
                <span>Mis Negocios</span>
            </a>
            <a href="#crearTab" class="nav-link" data-mg-tab="crearTab">
                <i class="bi bi-plus-circle"></i>
                <span>Crear Negocio</span>
            </a>
            <a href="#comisionesTab" class="nav-link" data-mg-tab="comisionesTab">
                <i class="bi bi-cash-coin"></i>
                <span>Mis Comisiones</span>
            </a>
            <a href="#metodosPagoTab" class="nav-link" data-mg-tab="metodosPagoTab">
                <i class="bi bi-wallet2"></i>
                <span>Métodos de Pago</span>
            </a>
        </nav>

        <div class="mg-sidebar-footer">
            <form method="post" action="@Url.Action("Logout", "Auth")">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link" style="border:none;background:none;width:100%;text-align:left;cursor:pointer;">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Cerrar Sesión</span>
                </button>
            </form>
        </div>
    </aside>

    <header class="mg-topbar">
        <div class="mg-topbar-left">
            <button class="mg-hamburger" id="sidebarToggle" type="button">
                <i class="bi bi-list"></i>
            </button>
            <div>
                <h5 class="mb-0 fw-bold">@vendedorNombre</h5>
                <small class="text-muted">Panel Vendedor</small>
            </div>
        </div>
        <div class="mg-topbar-right">
            <div class="dropdown">
                <button class="mg-theme-btn" data-bs-toggle="dropdown" data-bs-auto-close="true" title="Cambiar tema">
                    <i class="bi bi-palette fs-5"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end mg-theme-dropdown">
                    <button class="mg-theme-option" data-theme-value="">
                        <span class="theme-swatch" style="background: linear-gradient(135deg, #F5F8FA 50%, #3E97FF 50%);"></span>
                        <span>Claro</span>
                        <i class="bi bi-check2 d-none"></i>
                    </button>
                    <button class="mg-theme-option" data-theme-value="dark">
                        <span class="theme-swatch" style="background: linear-gradient(135deg, #1E1E2D 50%, #5BA7FF 50%);"></span>
                        <span>Oscuro</span>
                        <i class="bi bi-check2 d-none"></i>
                    </button>
                    <button class="mg-theme-option" data-theme-value="ocean">
                        <span class="theme-swatch" style="background: linear-gradient(135deg, #F0F9FF 50%, #0EA5E9 50%);"></span>
                        <span>Océano</span>
                        <i class="bi bi-check2 d-none"></i>
                    </button>
                    <button class="mg-theme-option" data-theme-value="sunset">
                        <span class="theme-swatch" style="background: linear-gradient(135deg, #FFF7ED 50%, #F97316 50%);"></span>
                        <span>Atardecer</span>
                        <i class="bi bi-check2 d-none"></i>
                    </button>
                </div>
            </div>
            <div class="d-none d-md-flex align-items-center ms-2">
                <div class="bg-light-primary rounded-circle d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                    <i class="bi bi-person-badge-fill text-primary"></i>
                </div>
            </div>
        </div>
    </header>

    <main class="mg-content">
        <div class="tab-content" id="vendedorTabsContent">

            <!-- TAB RESUMEN -->
            <div class="tab-pane fade show active" id="resumenTab" role="tabpanel">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-0" id="saludo">Buen día</h3>
                        <p class="text-muted mb-0">Tu resumen de ventas</p>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);">
                            <div class="card-body text-white">
                                <span class="d-block mb-1 opacity-75 small">Negocios Creados</span>
                                <span class="fs-2x fw-bolder" id="statNegocios">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-stat-card">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="stat-label">Activos</div>
                                    <div class="stat-value" id="statActivos">0</div>
                                </div>
                                <div class="stat-icon bg-light-success">
                                    <i class="bi bi-check-circle text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-stat-card">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="stat-label">En Prueba</div>
                                    <div class="stat-value" id="statPrueba">0</div>
                                </div>
                                <div class="stat-icon bg-light-warning">
                                    <i class="bi bi-clock-history text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-stat-card">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="stat-label">Total Clientes</div>
                                    <div class="stat-value" id="statClientes">0</div>
                                </div>
                                <div class="stat-icon bg-light-info">
                                    <i class="bi bi-people text-info"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECCIÓN INTERESADOS (LEADS) -->
                <div class="mg-card">
                    <div class="card-header border-0 d-flex align-items-center justify-content-between">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-people-fill text-primary me-2"></i>Interesados
                            <span class="badge bg-danger rounded-pill ms-2 d-none" id="leadsCountHeader">0</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-row-bordered align-middle gs-0 gy-3 mb-0" id="leadsTable">
                                <thead>
                                    <tr class="fw-bold text-muted">
                                        <th>Nombre</th>
                                        <th>Negocio</th>
                                        <th>Contacto</th>
                                        <th class="d-none d-md-table-cell">Mensaje</th>
                                        <th>Fecha</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="leadsBody">
                                    <tr><td colspan="6" class="text-center text-muted py-4">Cargando...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB NEGOCIOS -->
            <div class="tab-pane fade" id="negociosTab" role="tabpanel">
                <div class="mg-card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="vendedorNegociosTable" class="table table-row-bordered align-middle gs-0 gy-3">
                                <thead>
                                    <tr class="fw-bold text-muted">
                                        <th>Negocio</th>
                                        <th>Dueño</th>
                                        <th>Contacto</th>
                                        <th>Clientes</th>
                                        <th>Estado</th>
                                        <th>Suscripción</th>
                                        <th>Expira</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB MIS COMISIONES -->
            <div class="tab-pane fade" id="comisionesTab" role="tabpanel">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-0"><i class="bi bi-cash-coin text-primary me-2"></i>Mis Comisiones</h3>
                        <p class="text-muted mb-0">Historial de comisiones generadas y pagadas</p>
                    </div>
                </div>

                <!-- Resumen de comisiones -->
                <div class="row g-3 mb-4">
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);">
                            <div class="card-body text-white">
                                <span class="d-block mb-1 opacity-75 small">Negocios con Comision</span>
                                <span class="fs-2x fw-bolder" id="comTotalComisiones">0</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-stat-card">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="stat-label">Pendiente</div>
                                    <div class="stat-value" id="comMontoPendiente" style="color: var(--mg-warning, #FFC700);">$0.00</div>
                                </div>
                                <div class="stat-icon bg-light-warning">
                                    <i class="bi bi-clock-history text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-stat-card">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="stat-label">Pagado</div>
                                    <div class="stat-value" id="comMontoPagado" style="color: var(--mg-success, #50CD89);">$0.00</div>
                                </div>
                                <div class="stat-icon bg-light-success">
                                    <i class="bi bi-check-circle text-success"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6 col-6">
                        <div class="mg-stat-card">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="stat-label">Pendientes</div>
                                    <div class="stat-value" id="comCantPendientes">0</div>
                                </div>
                                <div class="stat-icon bg-light-info">
                                    <i class="bi bi-hourglass-split text-info"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Comisiones Pendientes -->
                <div class="mg-card mb-4">
                    <div class="card-header border-0">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-clock-history text-warning me-2"></i>Comisiones Pendientes
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-row-bordered align-middle gs-0 gy-3 mb-0" id="comisionesPendientesTable">
                                <thead>
                                    <tr class="fw-bold text-muted">
                                        <th>Negocio</th>
                                        <th>Monto</th>
                                        <th>Tipo</th>
                                        <th class="d-none d-md-table-cell">Días</th>
                                        <th class="d-none d-md-table-cell">Precio Negocio</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody id="comPendientesBody">
                                    <tr><td colspan="6" class="text-center text-muted py-4">
                                        <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                                    </td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Comisiones Pagadas (Historial) -->
                <div class="mg-card">
                    <div class="card-header border-0">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-check-circle text-success me-2"></i>Comisiones Pagadas
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-row-bordered align-middle gs-0 gy-3 mb-0" id="comisionesPagadasTable">
                                <thead>
                                    <tr class="fw-bold text-muted">
                                        <th>Negocio</th>
                                        <th>Monto</th>
                                        <th>Método de Pago</th>
                                        <th class="d-none d-md-table-cell">Tipo</th>
                                        <th class="d-none d-md-table-cell">Días</th>
                                        <th>Fecha Pago</th>
                                    </tr>
                                </thead>
                                <tbody id="comPagadasBody">
                                    <tr><td colspan="6" class="text-center text-muted py-4">
                                        <span class="spinner-border spinner-border-sm me-2"></span>Cargando...
                                    </td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB MÉTODOS DE PAGO -->
            <div class="tab-pane fade" id="metodosPagoTab" role="tabpanel">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-0"><i class="bi bi-wallet2 text-primary me-2"></i>Mis Métodos de Cobro</h3>
                        <p class="text-muted mb-0">Cuentas donde recibes tus comisiones</p>
                    </div>
                </div>

                <!-- Sección 1: Métodos de cobro del vendedor (donde recibe comisiones) -->
                <div class="row g-3 mb-4" id="vendedorMetodosCobro">
                    <div class="text-center py-4" id="vendedorMetodosCobroLoading">
                        <span class="spinner-border spinner-border-sm text-primary me-2"></span>Cargando métodos de cobro...
                    </div>
                </div>

                <!-- Separador visual -->
                <hr class="my-4" style="border-color: var(--mg-border-color, #E4E6EF);" />

                <!-- Sección 2: Métodos de pago del Admin (referencia para el vendedor) -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold mb-0"><i class="bi bi-bank text-info me-2"></i>Métodos de Pago del Admin</h4>
                        <p class="text-muted mb-0 small">Comparte estos datos con los dueños de negocio para que paguen sus suscripciones</p>
                    </div>
                </div>

                <div class="row g-3" id="adminMetodosPagoGrid">
                    <!-- Tarjeta de Efectivo (siempre visible) -->
                    <div class="col-md-6 col-lg-4">
                        <div class="border rounded-3 p-3 h-100" style="background: var(--mg-card-bg); border-color: var(--mg-border-color) !important;">
                            <div class="d-flex align-items-center mb-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;background:rgba(80,205,137,0.1);">
                                    <i class="bi bi-cash-stack text-success fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0" style="color: var(--mg-text-color);">Efectivo</h6>
                                    <small class="text-muted">Siempre aceptado</small>
                                </div>
                            </div>
                            <p class="text-muted small mb-0">El pago en efectivo siempre es una opción disponible para las suscripciones.</p>
                        </div>
                    </div>
                    <!-- Las tarjetas dinámicas se insertan aquí por JS -->
                </div>
                <div class="text-center py-3 d-none" id="adminMetodosPagoEmpty">
                    <i class="bi bi-credit-card-2-front fs-1 text-muted d-block mb-2"></i>
                    <p class="text-muted mb-0">No hay métodos de pago adicionales configurados</p>
                </div>
            </div>

            <!-- Modal Detalle Método de Pago Admin -->
            <div class="modal fade" id="detalleMetodoPagoModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
                    <div class="modal-content">
                        <div class="modal-header bg-light">
                            <h5 class="modal-title fw-bolder">
                                <i class="bi bi-credit-card text-primary me-2"></i><span id="detalleMP_Nombre">Detalle</span>
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div id="detalleMP_Loading" class="text-center py-4">
                                <span class="spinner-border spinner-border-sm text-primary me-2"></span>Cargando...
                            </div>
                            <div id="detalleMP_Content" class="d-none">
                                <div class="mb-3" id="detalleMP_CuentaWrap">
                                    <label class="form-label text-muted small fw-semibold">Número de Cuenta</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold fs-6" id="detalleMP_Cuenta" style="color: var(--mg-text-color);"></span>
                                        <button type="button" class="btn btn-sm btn-light" onclick="copiarTexto(document.getElementById('detalleMP_Cuenta').textContent)" title="Copiar">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-3" id="detalleMP_TitularWrap">
                                    <label class="form-label text-muted small fw-semibold">Nombre del Titular</label>
                                    <div class="fw-bold" id="detalleMP_Titular" style="color: var(--mg-text-color);"></div>
                                </div>
                                <div class="mb-3" id="detalleMP_CedulaWrap">
                                    <label class="form-label text-muted small fw-semibold">Cédula</label>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold" id="detalleMP_Cedula" style="color: var(--mg-text-color);"></span>
                                        <button type="button" class="btn btn-sm btn-light" onclick="copiarTexto(document.getElementById('detalleMP_Cedula').textContent)" title="Copiar">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="mb-3" id="detalleMP_InstruccionesWrap">
                                    <label class="form-label text-muted small fw-semibold">Instrucciones</label>
                                    <div class="p-3 rounded-3" id="detalleMP_Instrucciones" style="background: var(--mg-body-bg); color: var(--mg-text-color); white-space: pre-wrap;"></div>
                                </div>
                                <div class="text-center" id="detalleMP_QRWrap">
                                    <label class="form-label text-muted small fw-semibold d-block">Código QR</label>
                                    <img id="detalleMP_QR" src="" alt="QR" class="img-fluid rounded-3 qr-zoomable" style="max-height:280px;" title="Click para ampliar" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB CREAR NEGOCIO -->
            <div class="tab-pane fade" id="crearTab" role="tabpanel">
                <div class="row justify-content-center">
                    <div class="col-xl-10 col-lg-12">
                        <div class="mg-card">
                            <div class="card-header border-0">
                                <h5 class="fw-bold mb-0">
                                    <i class="bi bi-building text-primary me-2"></i>Crear Nuevo Negocio
                                </h5>
                            </div>
                            <div class="card-body">
                                <form id="crearNegocioForm">
                                    <div class="row">
                                        <div class="col-lg-6">
                                            <div class="mb-4">
                                                <label class="form-label fw-semibold required">Nombre del Negocio</label>
                                                <input type="text" class="form-control form-control-lg" name="NombreNegocio" id="crearNombre" placeholder="Ej: Fitness Plus" required />
                                            </div>
                                            <div class="mb-4">
                                                <label class="form-label fw-semibold required">Nombre del Dueño</label>
                                                <input type="text" class="form-control form-control-lg" name="duenoNegocio" id="crearDueno" placeholder="Ej: Juan Pérez" required />
                                            </div>
                                            <div class="mb-4">
                                                <label class="form-label fw-semibold required">Teléfono</label>
                                                <input type="tel" class="form-control form-control-lg" name="telefono" id="crearTelefono" placeholder="Ej: +1 234 567 8900" required />
                                            </div>
                                        </div>
                                        <div class="col-lg-6">
                                            <div class="mb-4">
                                                <label class="form-label fw-semibold required">Email</label>
