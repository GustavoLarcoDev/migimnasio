    // ================================================================
    // BIDIRECTIONAL DATE HANDLERS (Edit modal)
    // ================================================================
    $('#editFechaPago, #editFechaExpiracion').on('change', function() {
        var inicio = $('#editFechaPago').val();
        var fin = $('#editFechaExpiracion').val();
        if (inicio && fin) {
            var diff = Math.ceil((new Date(fin) - new Date(inicio)) / (1000 * 60 * 60 * 24));
            $('#editDiasPagados').val(diff > 0 ? diff : 0);
        }
    });

    $('#editDiasPagados').on('change input', function() {
        var inicio = $('#editFechaPago').val();
        var dias = parseInt($(this).val());
        if (inicio && dias > 0) {
            var fecha = new Date(inicio);
            fecha.setDate(fecha.getDate() + dias);
            $('#editFechaExpiracion').val(fecha.toISOString().split('T')[0]);
        }
    });

    // ================================================================
    // CREAR NEGOCIO: Duración y precios sugeridos
    // ================================================================

    // Suggested prices per preset (in USD). Vendedor can freely edit.
    var preciosSugeridos = {
        '30':  25,
        '60':  45,
        '90':  60,
        '180': 100,
        '365': 180
    };

    function aplicarDiasCrear(dias) {
        if (!dias || dias < 1) return;

        var hoy = new Date();
        var expiracion = new Date(hoy.getTime() + dias * 24 * 60 * 60 * 1000);

        var hoyStr = hoy.toISOString().split('T')[0];
        var expStr = expiracion.toISOString().split('T')[0];

        // Store in hidden fields
        $('#crearDias').val(dias);
        $('#crearFechaPago').val(hoyStr);
        $('#crearFechaExpiracion').val(expStr);

        // Resumen visual
        var diasKey = String(dias);
        var labelMeses = '';
        if (dias === 30) labelMeses = '1 mes';
        else if (dias === 60) labelMeses = '2 meses';
        else if (dias === 90) labelMeses = '3 meses';
        else if (dias === 180) labelMeses = '6 meses';
        else if (dias === 365) labelMeses = '1 año';

        var labelDias = dias + ' días' + (labelMeses ? ' (' + labelMeses + ')' : '');
        var fechaHoyFmt = hoy.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });
        var fechaExpFmt = expiracion.toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' });

        $('#crearResumenDias').text(labelDias);
        $('#crearResumenFechas').text('Inicio: ' + fechaHoyFmt + ' — Vence: ' + fechaExpFmt);
        $('#crearResumenWrap').show();

        // Suggested price
        if (preciosSugeridos[diasKey]) {
            var sugerido = preciosSugeridos[diasKey];
            // Only pre-fill price if it's empty (don't overwrite vendedor's custom value)
            if (!$('#crearPrecio').val()) {
                $('#crearPrecio').val(sugerido.toFixed(2));
            }
            $('#crearPrecioSugeridoVal').text('$' + sugerido.toFixed(2));
            $('#crearPrecioSugerido').show();
        } else {
            $('#crearPrecioSugerido').hide();
        }
    }

    function resetCrearSuscripcion() {
        $('#crearDias').val('');
        $('#crearFechaPago').val('');
        $('#crearFechaExpiracion').val('');
        $('#crearResumenWrap').hide();
        $('#crearPrecioSugerido').hide();
    }

    $('#crearDiasPagados').on('change', function() {
        var val = $(this).val();

        if (val === 'custom') {
            $('#crearDiasCustomContainer').removeClass('d-none');
            $('#crearDiasCustom').val('').prop('required', true).focus();
            resetCrearSuscripcion();
        } else if (val) {
            $('#crearDiasCustomContainer').addClass('d-none');
            $('#crearDiasCustom').prop('required', false);
            aplicarDiasCrear(parseInt(val));
        } else {
            $('#crearDiasCustomContainer').addClass('d-none');
            $('#crearDiasCustom').prop('required', false);
            resetCrearSuscripcion();
        }
    });

    $('#crearDiasCustom').on('input change', function() {
        var dias = parseInt($(this).val());
        if (dias > 0) {
            aplicarDiasCrear(dias);
        } else {
            resetCrearSuscripcion();
        }
    });

    // When "Prueba" is selected, lock to 7 days; when "Pago" restore dropdown
    $('input[name="esPrueba"]').on('change', function() {
        var esPrueba = $(this).val() === 'true';
        if (esPrueba) {
            // Override subscription to 7-day trial, price = 0
            $('#crearDiasPagados').val('').prop('disabled', true);
            $('#crearDiasCustomContainer').addClass('d-none');
            $('#crearDiasCustom').prop('required', false);
            $('#crearPrecio').val('0.00');
            $('#crearPrecioSugerido').hide();
            aplicarDiasCrear(7);
            $('#crearResumenDias').text('7 días (prueba)');
        } else {
            $('#crearDiasPagados').prop('disabled', false).val('');
            resetCrearSuscripcion();
            $('#crearPrecio').val('');
        }
    });

