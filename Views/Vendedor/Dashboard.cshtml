            comisionesCargadas = true;
        }).fail(function() {
            $('#comPendientesBody').html('<tr><td colspan="6" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-2"></i>Error al cargar comisiones</td></tr>');
            $('#comPagadasBody').html('<tr><td colspan="6" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-2"></i>Error al cargar comisiones</td></tr>');
        });
