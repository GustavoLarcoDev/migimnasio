            // Renderizar pagadas
            if (data.pagadas.length === 0) {
                $('#comPagadasBody').html('<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-2"></i>Aún no tienes comisiones pagadas</td></tr>');
            } else {
                var html2 = '';
                data.pagadas.forEach(function(c) {
                    var tipoBadge = c.tipoComision === 'nueva'
                        ? '<span class="badge bg-primary bg-opacity-10" style="color: var(--mg-primary, #3E97FF);">Nueva</span>'
                        : '<span class="badge bg-info bg-opacity-10" style="color: var(--mg-info, #009EF7);">Renovación</span>';

                    var metodoPago = c.metodoPagoPago
                        ? '<span class="badge bg-info bg-opacity-10" style="color: var(--mg-info, #009EF7);"><i class="bi bi-credit-card me-1"></i>' + escHtml(c.metodoPagoPago) + '</span>'
                        : '<span class="text-muted fst-italic small">No registrado</span>';

                    html2 += '<tr>'
                        + '<td><strong>' + escHtml(c.nombreNegocio) + '</strong></td>'
                        + '<td><span class="fw-bold" style="color: var(--mg-success, #50CD89);">$' + c.montoComision.toFixed(2) + '</span></td>'
                        + '<td>' + metodoPago + '</td>'
                        + '<td class="d-none d-md-table-cell">' + tipoBadge + '</td>'
                        + '<td class="d-none d-md-table-cell">' + c.diasContratados + ' días</td>'
                        + '<td><small class="text-muted">' + escHtml(c.fechaPago) + '</small></td>'
                        + '</tr>';
                });
                $('#comPagadasBody').html(html2);
