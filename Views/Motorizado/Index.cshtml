@{
    ViewData["Title"] = "Dashboard Motorizado";
    Layout = "_Layout";
}

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
<style>
    /* ═══════════════════════════════════════════
       MOTORIZADO DASHBOARD — Mobile-first
       ═══════════════════════════════════════════ */

    body { background: #f4f6f9; }

    /* Header bar */
    .moto-header {
        background: #fff;
        padding: 1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        position: sticky;
        top: 0;
        z-index: 100;
    }
    .moto-header .nombre {
        font-weight: 700;
        font-size: 1.1rem;
        color: #1a1a2e;
    }
    .moto-header .sub {
        font-size: 0.8rem;
        color: #6c757d;
    }

    /* Toggle switch */
    .disponible-switch {
        width: 52px;
        height: 28px;
        cursor: pointer;
    }
    .disponible-switch:checked {
        background-color: #198754;
        border-color: #198754;
    }
    .disponible-label {
        font-size: 0.8rem;
        font-weight: 600;
    }

    /* Stats mini-row */
    .moto-stats {
        display: flex;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        overflow-x: auto;
    }
    .moto-stat-pill {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: #fff;
        border-radius: 20px;
        padding: 0.4rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 600;
        white-space: nowrap;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .moto-stat-pill .bi { font-size: 1rem; }

    /* Section titles */
    .section-title {
        font-weight: 700;
        font-size: 1rem;
        color: #1a1a2e;
        padding: 0.75rem 1rem 0.5rem;
    }

    /* Active order panel */
    .pedido-activo-panel {
        margin: 0.75rem 1rem;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        overflow: hidden;
    }
    .pedido-activo-header {
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .pedido-activo-body {
        padding: 0 1.25rem 1.25rem;
    }

    /* Estado badge */
    .estado-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.85rem;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .estado-tomado { background: #fff3cd; color: #856404; }
    .estado-confirmado { background: #cfe2ff; color: #084298; }
    .estado-preparando { background: #fff3cd; color: #856404; }
    .estado-listo { background: #d1e7dd; color: #0f5132; }
    .estado-recogido { background: #e2d9f3; color: #6f42c1; }
    .estado-en_camino { background: #e2d9f3; color: #6f42c1; }

    /* Info row inside active order */
    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.65rem 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .info-row:last-child { border-bottom: none; }
    .info-row .icon-box {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1rem;
    }
    .info-row .label { font-size: 0.75rem; color: #6c757d; font-weight: 500; }
    .info-row .value { font-size: 0.9rem; font-weight: 600; color: #1a1a2e; }
    .info-row a.value { color: #0d6efd; text-decoration: none; }

    /* Items list */
    .items-list {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 0.75rem;
        margin: 0.75rem 0;
    }
    .items-list .item-row {
        display: flex;
        justify-content: space-between;
        padding: 0.3rem 0;
        font-size: 0.85rem;
    }
    .items-list .item-row .qty { font-weight: 700; color: #198754; }

    /* Action buttons */
    .moto-action-btn {
        width: 100%;
        padding: 0.9rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        border: none;
        transition: transform 0.12s, box-shadow 0.12s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }
    .moto-action-btn:hover { transform: translateY(-1px); }
    .moto-action-btn:active { transform: translateY(0); }
    .moto-action-btn:disabled { opacity: 0.6; transform: none; }

    .btn-recoger { background: #0d6efd; color: #fff; }
    .btn-recoger:hover { background: #0b5ed7; color: #fff; box-shadow: 0 4px 16px rgba(13,110,253,0.3); }
    .btn-entregar { background: #198754; color: #fff; }
    .btn-entregar:hover { background: #157347; color: #fff; box-shadow: 0 4px 16px rgba(25,135,84,0.3); }

    /* Waiting state */
    .waiting-state {
        text-align: center;
        padding: 1.5rem;
        color: #6c757d;
    }
    .waiting-state .spinner-grow { width: 0.6rem; height: 0.6rem; }

    /* Quick-action links */
    .quick-links {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
    }
    .quick-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.5rem 0.85rem;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.15s;
    }
    .quick-link.maps { background: #e8f5e9; color: #2e7d32; }
    .quick-link.maps:hover { background: #c8e6c9; }
    .quick-link.call { background: #e3f2fd; color: #1565c0; }
    .quick-link.call:hover { background: #bbdefb; }
    .quick-link.whatsapp { background: #e8f5e9; color: #198754; }
    .quick-link.whatsapp:hover { background: #c8e6c9; }

    /* Available order cards */
    .pedido-card {
        background: #fff;
        border-radius: 14px;
        margin: 0 1rem 0.75rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
        transition: transform 0.15s;
    }
    .pedido-card:hover { transform: translateY(-2px); }
    .pedido-card-header {
        padding: 1rem 1.25rem 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .pedido-card-body { padding: 0 1.25rem 1rem; }
    .pedido-card .restaurante-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #1a1a2e;
    }
    .pedido-card .delivery-fee {
        font-weight: 800;
        font-size: 1.3rem;
        color: #198754;
    }
    .pedido-card .detail {
        font-size: 0.82rem;
        color: #6c757d;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.25rem;
    }
    .btn-aceptar {
        width: 100%;
        padding: 0.75rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.95rem;
        background: #198754;
        color: #fff;
        border: none;
        margin-top: 0.75rem;
        transition: all 0.15s;
    }
    .btn-aceptar:hover { background: #157347; color: #fff; box-shadow: 0 4px 12px rgba(25,135,84,0.25); }
    .btn-aceptar:disabled { opacity: 0.5; }

    /* Empty state */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #adb5bd;
    }
    .empty-state .bi { font-size: 3rem; margin-bottom: 0.5rem; display: block; }

    /* Money highlight */
    .money-highlight {
        background: linear-gradient(135deg, #d1e7dd, #badbcc);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        margin-top: 0.75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .money-highlight .label { font-size: 0.8rem; color: #0f5132; font-weight: 600; }
    .money-highlight .amount { font-size: 1.3rem; font-weight: 800; color: #0f5132; }

    /* Map container */
    #miniMap {
        height: 180px;
        border-radius: 10px;
        margin: 0.75rem 0;
        z-index: 1;
    }

    /* Pulse animation for waiting */
    .pulse-dot {
        width: 8px; height: 8px;
        border-radius: 50%;
        display: inline-block;
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.4; transform: scale(0.8); }
    }
</style>
}

<!-- ═══════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════ -->
<div class="moto-header">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <div class="nombre" id="motoNombre">Cargando...</div>
            <div class="sub" id="motoSub">My-Negocio Delivery</div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex flex-column align-items-center">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input disponible-switch" type="checkbox" id="switchDisponible" checked>
                </div>
                <span class="disponible-label text-success" id="disponibleLabel">Disponible</span>
            </div>
            <button class="btn btn-sm btn-outline-secondary rounded-circle" onclick="cerrarSesion()" title="Cerrar sesion">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     OVERLAY DE BLOQUEO POR DEUDA
     Se muestra cuando el motorizado tiene comisiones pendientes
     o suscripción vencida. Solo puede ver métodos de pago y enviar
     comprobante. El admin confirma y lo desbloquea.
     ═══════════════════════════════════════════════════ -->
<div id="overlayBloqueado" style="display:none;">
    <div style="background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(0,0,0,0.12);margin:1rem;padding:1.5rem;text-align:center;">
        <div style="width:64px;height:64px;border-radius:50%;background:rgba(241,65,108,0.12);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
            <i class="bi bi-lock-fill" style="font-size:1.8rem;color:#F1416C;"></i>
        </div>
        <h5 class="fw-bold">Cuenta Bloqueada</h5>
        <p class="text-muted mb-3" id="bloqueoMotivo">Tienes un saldo pendiente. Realiza el pago para continuar.</p>

        <div class="card border-0 bg-light mb-3">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Plan:</span>
                    <strong id="bloqueoPlan">-</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Monto adeudado:</span>
                    <strong class="text-danger" id="bloqueoMonto">$0.00</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Estado:</span>
                    <span class="badge bg-danger">Bloqueado</span>
                </div>
            </div>
        </div>

        <h6 class="fw-bold text-start mb-2"><i class="bi bi-credit-card me-1"></i>Métodos de Pago</h6>
        <div id="bloqueoMetodosPago" class="mb-3">
            <div class="text-muted small">Cargando métodos de pago...</div>
        </div>

        <hr>
        <h6 class="fw-bold text-start mb-2"><i class="bi bi-receipt me-1"></i>Enviar Comprobante</h6>
        <div class="mb-2">
            <input type="text" class="form-control" id="bloqueoNumConfirmacion" placeholder="Número de confirmación / referencia">
        </div>
        <div class="mb-3">
            <input type="number" class="form-control" id="bloqueoMontoPago" placeholder="Monto pagado" step="0.01" min="0">
        </div>
        <button class="btn btn-success w-100" onclick="enviarComprobantePago(event)">
            <i class="bi bi-send me-1"></i>He Pagado — Enviar Comprobante
        </button>
        <div class="alert alert-info mt-3 mb-0 small" style="border-radius:12px;">
            <i class="bi bi-info-circle me-1"></i>
            Tu pago será revisado por el administrador. Una vez confirmado, tu cuenta se desbloqueará automáticamente.
        </div>
    </div>
</div>

<!-- Stats mini-row -->
<div class="moto-stats" id="motoStats" style="display:none;">
    <div class="moto-stat-pill">
        <i class="bi bi-check-circle text-success"></i>
        <span id="statEntregas">0 entregas</span>
    </div>
    <div class="moto-stat-pill">
        <i class="bi bi-cash-stack text-primary"></i>
        <span id="statGanancia">$0.00 hoy</span>
    </div>
    <div class="moto-stat-pill">
        <i class="bi bi-star-fill text-warning"></i>
        <span id="statRating">--</span>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     ACTIVE ORDER SECTION
     ═══════════════════════════════════════════════════ -->
<div id="seccionActivo" style="display:none;">
    <div class="section-title">
        <i class="bi bi-geo-alt-fill text-primary me-1"></i>Pedido Activo
    </div>
    <div class="pedido-activo-panel" id="panelActivo">
        <!-- Dynamically filled by JS -->
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     AVAILABLE ORDERS SECTION
     ═══════════════════════════════════════════════════ -->
<div id="seccionDisponibles">
    <div class="section-title">
        <i class="bi bi-bag-check text-success me-1"></i>Pedidos Disponibles
        <span class="badge bg-success ms-1" id="contadorDisponibles">0</span>
    </div>
    <div id="listaDisponibles">
        <div class="empty-state" id="emptyDisponibles">
            <i class="bi bi-inbox"></i>
            <div class="fw-bold">No hay pedidos disponibles</div>
            <div class="small mt-1">Los nuevos pedidos apareceran aqui automaticamente</div>
        </div>
    </div>
</div>

<!-- Audio notification -->
<audio id="audioNotif" preload="auto">
    <source src="data:audio/mpeg;base64,//uQxAAAAAANIAAAAAExBTUUzLjEwMFVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVVV" type="audio/mpeg">
</audio>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function() {
    'use strict';

    // ═══════════════════════════════════════════
    // STATE
    // ═══════════════════════════════════════════
    var pedidoActivo = null;
    var pedidosDisponibles = [];
    var connection = null;
    var watchId = null;
    var miniMap = null;
    var motorizadoMarker = null;

    // ═══════════════════════════════════════════
    // INIT
    // ═══════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', function() {
        cargarNombre();
        verificarBloqueo();
        cargarPedidoActivo();
        cargarPedidosDisponibles();
        initSignalR();
        cargarStats();

        document.getElementById('switchDisponible').addEventListener('change', function() {
            var label = document.getElementById('disponibleLabel');
            if (this.checked) {
                label.textContent = 'Disponible';
                label.className = 'disponible-label text-success';
                if (connection) connection.invoke('JoinMotorizadosDisponibles').catch(function(){});
            } else {
                label.textContent = 'No disponible';
                label.className = 'disponible-label text-muted';
                if (connection) connection.invoke('LeaveMotorizadosDisponibles').catch(function(){});
            }
        });
    });

    function cargarNombre() {
        var name = @Json.Serialize(User.Identity?.Name ?? "Motorizado");
        document.getElementById('motoNombre').textContent = 'Hola, ' + name;
    }

    // ═══════════════════════════════════════════
    // BLOQUEO POR DEUDA
    // ═══════════════════════════════════════════
    function verificarBloqueo() {
        fetch('/Motorizado/GetEstadoSuscripcion')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.bloqueado) {
                    mostrarOverlayBloqueado(data);
                }
            })
            .catch(function() {});
    }

    function mostrarOverlayBloqueado(data) {
        var overlay = document.getElementById('overlayBloqueado');
        if (!overlay) return;

        var plan = data.tipoPlan === 'mensual' ? 'Mensual ($10/mes)' : 'Por comisión ($0.20/entrega)';
        document.getElementById('bloqueoPlan').textContent = plan;
        document.getElementById('bloqueoMonto').textContent = '$' + (data.montoAdeudado || 0).toFixed(2);

        if (data.tipoPlan === 'mensual' && data.fechaExpiracion) {
            document.getElementById('bloqueoMotivo').textContent =
                'Tu suscripción mensual venció el ' + new Date(data.fechaExpiracion).toLocaleDateString('es-ES') + '. Renueva para continuar.';
        }

        // Cargar métodos de pago del admin
        fetch('/Motorizado/GetMetodosPagoAdmin')
            .then(function(r) { return r.json(); })
            .then(function(metodos) {
                var container = document.getElementById('bloqueoMetodosPago');
                if (!metodos || metodos.length === 0) {
                    container.innerHTML = '<div class="text-muted small">No hay métodos de pago configurados</div>';
                    return;
                }
                var html = '';
                metodos.forEach(function(m) {
                    html += '<div class="card border mb-2"><div class="card-body p-2">' +
                        '<div class="fw-bold small">' + escapeHtml(m.nombre) + '</div>';
                    if (m.numeroCuenta) html += '<div class="text-muted small"><i class="bi bi-credit-card me-1"></i>' + escapeHtml(m.numeroCuenta) + '</div>';
                    if (m.nombreTitular) html += '<div class="text-muted small"><i class="bi bi-person me-1"></i>' + escapeHtml(m.nombreTitular) + '</div>';
                    if (m.cedula) html += '<div class="text-muted small"><i class="bi bi-card-text me-1"></i>' + escapeHtml(m.cedula) + '</div>';
                    if (m.instrucciones) html += '<div class="text-muted small mt-1"><em>' + escapeHtml(m.instrucciones) + '</em></div>';
                    if (m.imagenQR) html += '<div class="text-center mt-1"><img src="' + escapeHtml(m.imagenQR) + '" style="max-height:120px;border-radius:8px;" /></div>';
                    html += '</div></div>';
                });
                container.innerHTML = html;
            })
            .catch(function() {
                document.getElementById('bloqueoMetodosPago').innerHTML = '<div class="text-danger small">Error al cargar métodos de pago</div>';
            });

        // Ocultar contenido normal y mostrar overlay
        overlay.style.display = 'block';
        var header = document.querySelector('.moto-header');
        var statsEl = document.getElementById('motoStats');
        var activo = document.getElementById('seccionActivo');
        var disponibles = document.getElementById('seccionDisponibles');
        if (statsEl) statsEl.style.display = 'none';
        if (activo) activo.style.display = 'none';
        if (disponibles) disponibles.style.display = 'none';
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ═══════════════════════════════════════════
    // STATS
    // ═══════════════════════════════════════════
    async function cargarStats() {
        // Stats are optional, show if endpoint exists
        try {
            // Stats row is visible only as UI placeholder for now
            document.getElementById('motoStats').style.display = 'flex';
        } catch(e) {}
    }

    // ═══════════════════════════════════════════
    // LOAD ACTIVE ORDER
    // ═══════════════════════════════════════════
    async function cargarPedidoActivo() {
        try {
            var res = await fetch('/Motorizado/GetPedidoActivo');
            var data = await res.json();
            if (data.hayPedidoActivo && data.pedido) {
                pedidoActivo = data.pedido;
                renderPedidoActivo();
                // Join pedido SignalR group
                if (connection && connection.state === 'Connected') {
                    connection.invoke('JoinPedidoGroup', pedidoActivo.pedidoId).catch(function(){});
                }
                // Start GPS if en_camino or recogido
                if (['recogido', 'en_camino'].indexOf(pedidoActivo.estado) !== -1) {
                    startGPS();
                }
            } else {
                pedidoActivo = null;
                document.getElementById('seccionActivo').style.display = 'none';
            }
        } catch(e) {
            console.error('Error cargando pedido activo:', e);
        }
    }

    // ═══════════════════════════════════════════
    // LOAD AVAILABLE ORDERS
    // ═══════════════════════════════════════════
    async function cargarPedidosDisponibles() {
        try {
            var res = await fetch('/Motorizado/GetPedidosDisponibles');
            var data = await res.json();
            pedidosDisponibles = Array.isArray(data) ? data : [];
            renderPedidosDisponibles();
        } catch(e) {
            console.error('Error cargando pedidos:', e);
        }
    }

    // ═══════════════════════════════════════════
    // RENDER ACTIVE ORDER
    // ═══════════════════════════════════════════
    function renderPedidoActivo() {
        if (!pedidoActivo) {
            document.getElementById('seccionActivo').style.display = 'none';
            return;
        }

        document.getElementById('seccionActivo').style.display = 'block';
        var p = pedidoActivo;
        var estadoInfo = getEstadoInfo(p.estado);
        var totalItems = 0;
        if (p.items) p.items.forEach(function(i) { totalItems += i.cantidad; });

        var html = '';

        // Header with estado badge
        html += '<div class="pedido-activo-header">';
        html += '  <div><span class="fw-bold">Pedido</span><br><span class="text-muted small">' + formatTime(p.fechaCreacion) + '</span></div>';
        html += '  <span class="estado-badge estado-' + esc(p.estado) + '">';
        html += '    <span class="pulse-dot" style="background:currentColor;"></span>' + esc(estadoInfo.label);
        html += '  </span>';
        html += '</div>';

        html += '<div class="pedido-activo-body">';

        // Restaurant info
        html += '<div class="info-row">';
        html += '  <div class="icon-box" style="background:#fff3e0;color:#e65100;"><i class="bi bi-shop"></i></div>';
        html += '  <div class="flex-grow-1">';
        html += '    <div class="label">Restaurante</div>';
        html += '    <div class="value">' + esc(p.restauranteNombre || 'Restaurante') + '</div>';
        html += '    <div class="label">' + esc(p.restauranteDireccion || '') + '</div>';
        html += '  </div>';
        html += '</div>';

        // Client info (only visible from recogido state)
        if (['recogido', 'en_camino'].indexOf(p.estado) !== -1) {
            html += '<div class="info-row">';
            html += '  <div class="icon-box" style="background:#e8eaf6;color:#283593;"><i class="bi bi-person-fill"></i></div>';
            html += '  <div class="flex-grow-1">';
            html += '    <div class="label">Cliente</div>';
            html += '    <div class="value">' + esc(p.nombreCliente || '') + '</div>';
            html += '    <div class="label">' + esc(p.direccionEntrega || '') + '</div>';
            html += '  </div>';
            html += '</div>';
        }

        // Items summary
        html += '<div class="items-list">';
        html += '  <div class="small fw-bold text-muted mb-1"><i class="bi bi-bag me-1"></i>' + totalItems + ' item' + (totalItems !== 1 ? 's' : '') + '</div>';
        if (p.items) {
            p.items.forEach(function(item) {
                if (!item.rechazado) {
                    html += '<div class="item-row">';
                    html += '  <span><span class="qty">' + item.cantidad + 'x</span> ' + esc(item.nombreProducto) + '</span>';
                    html += '  <span>$' + Number(item.subtotal).toFixed(2) + '</span>';
                    html += '</div>';
                }
            });
        }
        html += '</div>';

        // Money highlight
        html += '<div class="money-highlight">';
        html += '  <div><div class="label">Tu ganancia por delivery</div><div class="label">Costo de la comida</div></div>';
        html += '  <div class="text-end"><div class="amount">$' + Number(p.costoEnvio).toFixed(2) + '</div><div class="label">$' + Number(p.costoComida).toFixed(2) + '</div></div>';
        html += '</div>';

        // Quick links for navigation
        if (p.estado === 'preparando' || p.estado === 'listo' || p.estado === 'confirmado') {
            // Navigate to restaurant
            html += '<div class="quick-links">';
            if (p.latitudRestaurante && p.longitudRestaurante) {
                html += '<a href="https://www.google.com/maps/dir/?api=1&destination=' + p.latitudRestaurante + ',' + p.longitudRestaurante + '" target="_blank" class="quick-link maps">';
                html += '  <i class="bi bi-geo-alt-fill"></i>Ir al restaurante';
                html += '</a>';
            }
            if (p.restauranteTelefono) {
                html += '<a href="tel:' + esc(p.restauranteTelefono) + '" class="quick-link call">';
                html += '  <i class="bi bi-telephone-fill"></i>Llamar';
                html += '</a>';
            }
            html += '</div>';
        }

        if (['recogido', 'en_camino'].indexOf(p.estado) !== -1) {
            // Navigate to client
            html += '<div class="quick-links">';
            if (p.latitudCliente && p.longitudCliente) {
                html += '<a href="https://www.google.com/maps/dir/?api=1&destination=' + p.latitudCliente + ',' + p.longitudCliente + '" target="_blank" class="quick-link maps">';
                html += '  <i class="bi bi-geo-alt-fill"></i>Ir al cliente';
                html += '</a>';
            }
            if (p.telefonoCliente) {
                html += '<a href="tel:' + esc(p.telefonoCliente) + '" class="quick-link call">';
                html += '  <i class="bi bi-telephone-fill"></i>Llamar cliente';
                html += '</a>';
                html += '<a href="https://wa.me/' + formatWhatsApp(p.telefonoCliente) + '" target="_blank" class="quick-link whatsapp">';
                html += '  <i class="bi bi-whatsapp"></i>WhatsApp';
                html += '</a>';
            }
            html += '</div>';

            // Mini map
            html += '<div id="miniMap"></div>';
        }

        // Notas
        if (p.notas) {
            html += '<div class="mt-2 p-2 rounded" style="background:#fff8e1;font-size:0.82rem;">';
            html += '  <i class="bi bi-sticky text-warning me-1"></i><strong>Nota:</strong> ' + esc(p.notas);
            html += '</div>';
        }

        // ACTION BUTTONS by state
        html += '<div class="mt-3">';

        if (p.estado === 'tomado') {
            html += '<div class="waiting-state">';
            html += '  <span class="spinner-grow spinner-grow-sm text-warning me-1"></span>';
            html += '  <span class="spinner-grow spinner-grow-sm text-warning me-1" style="animation-delay:0.15s;"></span>';
            html += '  <span class="spinner-grow spinner-grow-sm text-warning me-1" style="animation-delay:0.3s;"></span>';
            html += '  <div class="mt-2 fw-bold">Esperando que el restaurante confirme los items...</div>';
            html += '  <div class="small text-muted mt-1">Recibiras una notificacion cuando confirmen</div>';
            html += '</div>';
        }
        else if (p.estado === 'confirmado') {
            html += '<div class="text-center p-3">';
            html += '  <i class="bi bi-check-circle-fill text-primary fs-2"></i>';
            html += '  <div class="fw-bold mt-1">El restaurante confirmo la orden</div>';
            html += '  <div class="small text-muted">Esperando que comiencen a preparar...</div>';
            html += '</div>';
        }
        else if (p.estado === 'preparando') {
            html += '<div class="text-center p-3">';
            html += '  <i class="bi bi-fire text-warning fs-2"></i>';
            html += '  <div class="fw-bold mt-1">Preparando tu orden</div>';
            html += '  <div class="small text-muted">Dirigete al restaurante mientras se prepara</div>';
            html += '</div>';
        }
        else if (p.estado === 'listo') {
            html += '<div class="text-center mb-3">';
            html += '  <i class="bi bi-check-circle-fill text-success fs-2"></i>';
            html += '  <div class="fw-bold mt-1">La orden esta lista para recoger</div>';
            html += '</div>';
            html += '<button class="moto-action-btn btn-recoger" onclick="confirmarRecogida(\'' + p.pedidoId + '\')">';
            html += '  <i class="bi bi-bag-check-fill"></i>';
            html += '  <span class="btn-label">Confirmar Recogida</span>';
            html += '  <span class="spinner-border spinner-border-sm d-none"></span>';
            html += '</button>';
        }
        else if (p.estado === 'recogido' && !p.motorizadoConfirmoRecepcion) {
            html += '<button class="moto-action-btn btn-recoger" onclick="confirmarRecogida(\'' + p.pedidoId + '\')">';
            html += '  <i class="bi bi-bag-check-fill"></i>';
            html += '  <span class="btn-label">Confirmar Recogida</span>';
            html += '  <span class="spinner-border spinner-border-sm d-none"></span>';
            html += '</button>';
        }
        else if (p.estado === 'recogido' && p.motorizadoConfirmoRecepcion) {
            html += '<div class="waiting-state">';
            html += '  <span class="spinner-grow spinner-grow-sm text-info me-1"></span>';
            html += '  <div class="mt-1 fw-bold">Esperando confirmacion del restaurante...</div>';
            html += '  <div class="small text-muted">Ambos deben confirmar la entrega</div>';
            html += '</div>';
        }
        else if (p.estado === 'en_camino') {
            html += '<button class="moto-action-btn btn-entregar" onclick="marcarEntregado(\'' + p.pedidoId + '\')">';
            html += '  <i class="bi bi-check2-all"></i>';
            html += '  <span class="btn-label">Marcar como Entregado</span>';
            html += '  <span class="spinner-border spinner-border-sm d-none"></span>';
            html += '</button>';
        }

        html += '</div>';
        html += '</div>';

        document.getElementById('panelActivo').innerHTML = html;

        // Initialize mini map if visible
        if (['recogido', 'en_camino'].indexOf(p.estado) !== -1) {
            setTimeout(initMiniMap, 100);
        }
    }

    // ═══════════════════════════════════════════
    // RENDER AVAILABLE ORDERS
    // ═══════════════════════════════════════════
    function renderPedidosDisponibles() {
        var container = document.getElementById('listaDisponibles');
        var counter = document.getElementById('contadorDisponibles');

        // Filter out taken orders
        var disponibles = pedidosDisponibles.filter(function(p) {
            return !pedidoActivo || p.pedidoId !== pedidoActivo.pedidoId;
        });

        counter.textContent = disponibles.length;

        if (disponibles.length === 0) {
            container.innerHTML = '<div class="empty-state" id="emptyDisponibles">' +
                '<i class="bi bi-inbox"></i>' +
                '<div class="fw-bold">No hay pedidos disponibles</div>' +
                '<div class="small mt-1">Los nuevos pedidos apareceran aqui automaticamente</div>' +
                '</div>';
            return;
        }

        var html = '';
        disponibles.forEach(function(p) {
            var totalItems = 0;
            if (p.items) p.items.forEach(function(i) { totalItems += i.cantidad; });

            html += '<div class="pedido-card" id="pedido-card-' + p.pedidoId + '">';
            html += '  <div class="pedido-card-header">';
            html += '    <div>';
            html += '      <div class="restaurante-name"><i class="bi bi-shop me-1"></i>' + esc(p.restauranteNombre || 'Restaurante') + '</div>';
            html += '      <div class="detail"><i class="bi bi-geo-alt"></i>' + esc(p.restauranteDireccion || 'Sin direccion') + '</div>';
            html += '      <div class="detail"><i class="bi bi-clock"></i>' + formatTime(p.fechaCreacion) + '</div>';
            html += '    </div>';
            html += '    <div class="text-end">';
            html += '      <div class="delivery-fee">$' + Number(p.costoEnvio).toFixed(2) + '</div>';
            html += '      <div class="small text-muted fw-bold">delivery</div>';
            html += '    </div>';
            html += '  </div>';
            html += '  <div class="pedido-card-body">';

            // Items compact
            html += '    <div class="d-flex align-items-center gap-2 text-muted small mb-1">';
            html += '      <i class="bi bi-bag"></i><span>' + totalItems + ' item' + (totalItems !== 1 ? 's' : '') + '</span>';
            html += '      <span class="mx-1">|</span>';
            html += '      <span>Comida: $' + Number(p.costoComida).toFixed(2) + '</span>';
            html += '    </div>';

            // Distance info if we have coords
            if (p.latitudRestaurante && p.latitudCliente) {
                var dist = haversineKm(p.latitudRestaurante, p.longitudRestaurante, p.latitudCliente, p.longitudCliente);
                html += '    <div class="d-flex align-items-center gap-2 text-muted small">';
                html += '      <i class="bi bi-signpost-2"></i><span>Distancia cliente: ~' + dist.toFixed(1) + ' km</span>';
                html += '    </div>';
            }

            // Notas
            if (p.notas) {
                html += '    <div class="small mt-1" style="color:#856404;"><i class="bi bi-sticky me-1"></i>' + esc(p.notas) + '</div>';
            }

            html += '    <button class="btn-aceptar" onclick="aceptarPedido(\'' + p.pedidoId + '\', this)" ' + (pedidoActivo ? 'disabled title="Ya tienes un pedido activo"' : '') + '>';
            html += '      <i class="bi bi-check-circle-fill me-1"></i>ACEPTAR PEDIDO';
            html += '    </button>';
            html += '  </div>';
            html += '</div>';
        });

        container.innerHTML = html;
    }

    // ═══════════════════════════════════════════
    // ACTIONS
    // ═══════════════════════════════════════════
    window.aceptarPedido = async function(pedidoId, btn) {
        if (pedidoActivo) {
            toastr.warning('Ya tienes un pedido activo. Completa la entrega primero.');
            return;
        }

        var result = await Swal.fire({
            title: 'Aceptar pedido?',
            text: 'Se te asignara este pedido de delivery',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            confirmButtonText: 'Si, aceptar',
            cancelButtonText: 'No'
        });

        if (!result.isConfirmed) return;

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Aceptando...';

        try {
            var res = await fetch('/Motorizado/AceptarPedido', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pedidoId: pedidoId })
            });
            var data = await res.json();
            if (data.success) {
                toastr.success('Pedido aceptado');
                await cargarPedidoActivo();
                cargarPedidosDisponibles();
            } else {
                toastr.error(data.message || 'No se pudo aceptar');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>ACEPTAR PEDIDO';
            }
        } catch(e) {
            toastr.error('Error de conexion');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>ACEPTAR PEDIDO';
        }
    };

    window.confirmarRecogida = async function(pedidoId) {
        var result = await Swal.fire({
            title: 'Confirmar recogida?',
            text: 'Confirmas que recogiste la comida del restaurante?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            confirmButtonText: 'Si, ya la tengo',
            cancelButtonText: 'No'
        });

        if (!result.isConfirmed) return;

        var btn = document.querySelector('.btn-recoger');
        if (btn) setButtonLoading(btn, true);

        try {
            var res = await fetch('/Motorizado/ConfirmarRecogida', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pedidoId: pedidoId })
            });
            var data = await res.json();
            if (data.success) {
                toastr.success(data.message || 'Recogida confirmada');
                await cargarPedidoActivo();
            } else {
                toastr.error(data.message);
                if (btn) setButtonLoading(btn, false);
            }
        } catch(e) {
            toastr.error('Error de conexion');
            if (btn) setButtonLoading(btn, false);
        }
    };

    window.marcarEntregado = async function(pedidoId) {
        var costoEnvio = pedidoActivo ? Number(pedidoActivo.costoEnvio).toFixed(2) : '0.00';
        var costoComida = pedidoActivo ? Number(pedidoActivo.costoComida).toFixed(2) : '0.00';

        var result = await Swal.fire({
            title: 'Entrega completada?',
            html: '<div style="text-align:left;">' +
                  '<p>Confirmas que entregaste el pedido al cliente?</p>' +
                  '<div style="background:#d1e7dd;padding:12px;border-radius:10px;margin-top:8px;">' +
                  '<div style="font-size:0.85rem;color:#0f5132;font-weight:600;">Resumen de cobro:</div>' +
                  '<div style="display:flex;justify-content:space-between;margin-top:4px;">' +
                  '<span>Comida (para el restaurante):</span><strong>$' + costoComida + '</strong></div>' +
                  '<div style="display:flex;justify-content:space-between;margin-top:4px;">' +
                  '<span>Tu ganancia por delivery:</span><strong style="color:#198754;font-size:1.1rem;">$' + costoEnvio + '</strong></div>' +
                  '<hr style="margin:8px 0;">' +
                  '<div style="display:flex;justify-content:space-between;font-weight:800;">' +
                  '<span>TOTAL COBRADO AL CLIENTE:</span><span>$' + (Number(costoComida) + Number(costoEnvio)).toFixed(2) + '</span></div>' +
                  '</div></div>',
            icon: 'success',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            confirmButtonText: 'Si, entregado',
            cancelButtonText: 'Aun no'
        });

        if (!result.isConfirmed) return;

        var btn = document.querySelector('.btn-entregar');
        if (btn) setButtonLoading(btn, true);

        try {
            var res = await fetch('/Motorizado/MarcarEntregado', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pedidoId: pedidoId })
            });
            var data = await res.json();
            if (data.success) {
                stopGPS();
                pedidoActivo = null;
                document.getElementById('seccionActivo').style.display = 'none';
                cargarPedidosDisponibles();

                await Swal.fire({
                    title: 'Entrega exitosa!',
                    html: '<div style="font-size:1.1rem;">Ganaste <strong style="color:#198754;font-size:1.4rem;">$' + costoEnvio + '</strong> por este delivery</div>',
                    icon: 'success',
                    confirmButtonColor: '#198754',
                    confirmButtonText: 'Excelente!'
                });
            } else {
                toastr.error(data.message);
                if (btn) setButtonLoading(btn, false);
            }
        } catch(e) {
            toastr.error('Error de conexion');
            if (btn) setButtonLoading(btn, false);
        }
    };

    // ═══════════════════════════════════════════
    // GPS TRACKING
    // ═══════════════════════════════════════════
    function startGPS() {
        if (watchId !== null) return;
        if (!navigator.geolocation) { console.warn('GPS no disponible'); return; }

        watchId = navigator.geolocation.watchPosition(
            function(pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;

                // Send to server
                fetch('/Motorizado/ActualizarUbicacion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ latitud: lat, longitud: lng })
                }).catch(function(){});

                // Update mini map marker
                if (miniMap && motorizadoMarker) {
                    motorizadoMarker.setLatLng([lat, lng]);
                }
            },
            function(err) { console.warn('GPS error:', err.message); },
            { enableHighAccuracy: true, maximumAge: 10000, timeout: 15000 }
        );
    }

    function stopGPS() {
        if (watchId !== null) {
            navigator.geolocation.clearWatch(watchId);
            watchId = null;
        }
    }

    function initMiniMap() {
        var mapEl = document.getElementById('miniMap');
        if (!mapEl || !pedidoActivo) return;

        if (miniMap) { miniMap.remove(); miniMap = null; }

        var lat = pedidoActivo.latitudCliente || -2.1894;
        var lng = pedidoActivo.longitudCliente || -79.8891;

        miniMap = L.map('miniMap', { zoomControl: false, attributionControl: false }).setView([lat, lng], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18
        }).addTo(miniMap);

        // Client marker (red)
        L.marker([lat, lng], {
            icon: L.divIcon({
                className: '',
                html: '<div style="background:#dc3545;width:14px;height:14px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.3);"></div>',
                iconSize: [14, 14],
                iconAnchor: [7, 7]
            })
        }).addTo(miniMap).bindPopup('Cliente: ' + esc(pedidoActivo.nombreCliente || ''));

        // Motorizado marker (blue)
        motorizadoMarker = L.marker([lat, lng], {
            icon: L.divIcon({
                className: '',
                html: '<div style="background:#0d6efd;width:16px;height:16px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.3);"></div>',
                iconSize: [16, 16],
                iconAnchor: [8, 8]
            })
        }).addTo(miniMap).bindPopup('Tu ubicacion');

        // Restaurant marker (orange)
        if (pedidoActivo.latitudRestaurante && pedidoActivo.longitudRestaurante) {
            L.marker([pedidoActivo.latitudRestaurante, pedidoActivo.longitudRestaurante], {
                icon: L.divIcon({
                    className: '',
                    html: '<div style="background:#fd7e14;width:14px;height:14px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.3);"></div>',
                    iconSize: [14, 14],
                    iconAnchor: [7, 7]
                })
            }).addTo(miniMap).bindPopup('Restaurante');
        }
    }

    // ═══════════════════════════════════════════
    // SIGNALR
    // ═══════════════════════════════════════════
    function initSignalR() {
        connection = new signalR.HubConnectionBuilder()
            .withUrl('/pedidoHub')
            .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
            .build();

        // New order available
        connection.on('NuevoPedido', function(data) {
            playNotifSound();
            toastr.info('Nuevo pedido disponible!');
            cargarPedidosDisponibles();
        });

        // Order already taken by another driver
        connection.on('PedidoYaTomado', function(data) {
            if (data && data.pedidoId) {
                pedidosDisponibles = pedidosDisponibles.filter(function(p) { return p.pedidoId !== data.pedidoId; });
                renderPedidosDisponibles();
                var card = document.getElementById('pedido-card-' + data.pedidoId);
                if (card) card.remove();
            }
        });

        // Items confirmed by restaurant
        connection.on('ItemsConfirmados', function(data) {
            toastr.success('El restaurante confirmo los items');
            cargarPedidoActivo();
        });

        // Restaurant started cooking
        connection.on('OrdenIniciada', function(data) {
            playNotifSound();
            toastr.info('El restaurante empezo a preparar tu orden');
            cargarPedidoActivo();
        });

        // Food is ready
        connection.on('ComidaLista', function(data) {
            playNotifSound();
            Swal.fire({
                title: 'Orden lista!',
                text: 'La comida esta lista para recoger. Dirigete al restaurante.',
                icon: 'info',
                confirmButtonColor: '#0d6efd',
                confirmButtonText: 'OK'
            });
            cargarPedidoActivo();
        });

        // Food picked up (both confirmed)
        connection.on('ComidaRecogida', function(data) {
            toastr.success('Comida recogida! Dirigete al cliente.');
            cargarPedidoActivo();
            startGPS();
        });

        // Order cancelled
        connection.on('PedidoCancelado', function(data) {
            var razon = data && data.razon ? data.razon : 'Sin razon especificada';
            var canceladoPor = data && data.canceladoPor ? data.canceladoPor : 'desconocido';
            stopGPS();
            pedidoActivo = null;
            document.getElementById('seccionActivo').style.display = 'none';

            Swal.fire({
                title: 'Pedido cancelado',
                html: '<div><strong>Cancelado por:</strong> ' + esc(canceladoPor) + '</div>' +
                      '<div class="mt-1"><strong>Razon:</strong> ' + esc(razon) + '</div>',
                icon: 'warning',
                confirmButtonText: 'Entendido'
            });

            cargarPedidosDisponibles();
        });

        // Delivery order complete
        connection.on('PedidoEntregado', function(data) {
            // Handled by marcarEntregado response
        });

        // Client is near (proximity alert)
        connection.on('PedidoCerca', function(data) {
            toastr.info('Estas cerca del cliente!');
        });

        connection.start()
            .then(function() {
                console.log('SignalR conectado');
                connection.invoke('JoinMotorizadosDisponibles').catch(function(){});
                if (pedidoActivo) {
                    connection.invoke('JoinPedidoGroup', pedidoActivo.pedidoId).catch(function(){});
                }
            })
            .catch(function(err) { console.error('SignalR error:', err); });

        connection.onreconnected(function() {
            connection.invoke('JoinMotorizadosDisponibles').catch(function(){});
            if (pedidoActivo) {
                connection.invoke('JoinPedidoGroup', pedidoActivo.pedidoId).catch(function(){});
            }
        });
    }

    // ═══════════════════════════════════════════
    // LOGOUT
    // ═══════════════════════════════════════════
    window.cerrarSesion = async function() {
        var result = await Swal.fire({
            title: 'Cerrar sesion?',
            text: 'Se cerrara tu sesion de motorizado',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Si, salir',
            cancelButtonText: 'Cancelar'
        });
        if (!result.isConfirmed) return;

        stopGPS();
        try {
            await fetch('/Motorizado/Logout', { method: 'POST' });
        } catch(e) {}
        window.location.href = '/Motorizado/Login';
    };

    // ═══════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════
    function esc(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function formatTime(dateStr) {
        if (!dateStr) return '';
        try {
            var d = new Date(dateStr);
            return d.toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' });
        } catch(e) { return ''; }
    }

    function formatWhatsApp(phone) {
        if (!phone) return '';
        var clean = phone.replace(/[^0-9]/g, '');
        if (clean.startsWith('0')) clean = '593' + clean.substring(1);
        if (!clean.startsWith('593')) clean = '593' + clean;
        return clean;
    }

    function haversineKm(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon/2) * Math.sin(dLon/2);
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    function getEstadoInfo(estado) {
        var map = {
            'tomado':     { label: 'Confirmando items', color: '#856404' },
            'confirmado': { label: 'Items confirmados', color: '#084298' },
            'preparando': { label: 'Preparando', color: '#856404' },
            'listo':      { label: 'Lista para recoger', color: '#0f5132' },
            'recogido':   { label: 'Recogida', color: '#6f42c1' },
            'en_camino':  { label: 'En camino al cliente', color: '#6f42c1' }
        };
        return map[estado] || { label: estado, color: '#6c757d' };
    }

    function setButtonLoading(btn, loading) {
        btn.disabled = loading;
        var label = btn.querySelector('.btn-label');
        var spinner = btn.querySelector('.spinner-border');
        if (label) label.classList.toggle('d-none', loading);
        if (spinner) spinner.classList.toggle('d-none', !loading);
    }

    function playNotifSound() {
        try {
            var audio = document.getElementById('audioNotif');
            if (audio) { audio.currentTime = 0; audio.play().catch(function(){}); }
        } catch(e) {}

        // Also try vibrate for mobile
        if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
    }

})();

// ═══════════════════════════════════════════
// GLOBAL: Enviar comprobante de pago (fuera del IIFE para onclick)
// ═══════════════════════════════════════════
function enviarComprobantePago(e) {
    var numConf = document.getElementById('bloqueoNumConfirmacion').value.trim();
    var monto = parseFloat(document.getElementById('bloqueoMontoPago').value) || 0;

    if (!numConf) {
        alert('Ingresa el número de confirmación o referencia del pago');
        return;
    }
    if (monto <= 0) {
        alert('Ingresa el monto pagado');
        return;
    }

    var btn = (e || window.event).target.closest('button');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Enviando...';

    fetch('/Motorizado/EnviarConfirmacionPago', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ numConfirmacion: numConf, monto: monto })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Comprobante Enviado';
            btn.className = 'btn btn-outline-success w-100';
            document.getElementById('bloqueoNumConfirmacion').disabled = true;
            document.getElementById('bloqueoMontoPago').disabled = true;
            alert('Tu comprobante fue enviado. El administrador lo revisará y desbloqueará tu cuenta.');
        } else {
            alert(data.message || 'Error al enviar comprobante');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send me-1"></i>He Pagado — Enviar Comprobante';
        }
    })
    .catch(function() {
        alert('Error de conexión. Intenta de nuevo.');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send me-1"></i>He Pagado — Enviar Comprobante';
    });
}
</script>
}
