@{
    ViewData["Title"] = "Crear Negocio";
}

<div class="container-fluid px-5 mb-5 pb-5">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="fw-bolder text-dark mb-1 fs-3">Nuevo Negocio</h1>
            <p class="text-muted mb-0 small">Registra un nuevo negocio en el sistema</p>
        </div>
        <a href="/Negocios" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left me-2"></i>
            Volver
        </a>
    </div>

    <!-- Formulario -->
    <div class="mg-card">
        <div class="card-header">
            <h3 class="card-title fw-bold text-dark mb-0">
                <i class="bi bi-building text-primary me-2"></i>
                Información del Negocio
            </h3>
        </div>
        <div class="card-body">
            <form id="createNegocioForm" action="/Negocios/Create" method="post">
                <div class="row">
                    <!-- Columna Izquierda -->
                    <div class="col-lg-6">
                        <div class="mb-4">
                            <label class="form-label fw-semibold required">Nombre del Negocio</label>
                            <input type="text" class="form-control form-control-lg" name="NombreNegocio" id="nombreNegocio" placeholder="Ej: Fitness Plus" required />
                            <div class="form-text">El nombre comercial del negocio</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold required">Nombre del Dueño</label>
                            <input type="text" class="form-control form-control-lg" name="duenoNegocio" id="duenoNegocio" placeholder="Ej: Juan Pérez" required />
                            <div class="form-text">Nombre completo del propietario</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold required">Teléfono</label>
                            <input type="tel" class="form-control form-control-lg" name="telefono" id="telefono" placeholder="Ej: +1 234 567 8900" required />
                            <div class="form-text">Número de contacto principal</div>
                        </div>
                    </div>

                    <!-- Columna Derecha -->
                    <div class="col-lg-6">
                        <div class="mb-4">
                            <label class="form-label fw-semibold required">Email</label>
                            <input type="email" class="form-control form-control-lg" name="EmailNegocio" id="emailNegocio" placeholder="Ej: contacto@negocio.com" required />
                            <div class="form-text">Correo electrónico para acceso al sistema</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold required">Contraseña</label>
                            <div class="input-group">
                                <input type="password" class="form-control form-control-lg" name="passwordNegocio" id="passwordNegocio" placeholder="Mínimo 6 caracteres" required />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <div class="form-text">Contraseña para acceder al sistema</div>
                        </div>

                        <div class="row">
                            <div class="col-12 mb-4">
                                <label class="form-label fw-semibold required">Tipo de Negocio</label>
                                <div class="d-flex gap-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="tipoNegocio"
                                               id="tipoPago" value="pago" checked />
                                        <label class="form-check-label fw-semibold" for="tipoPago">
                                            <i class="bi bi-credit-card text-primary me-2"></i>
                                            Negocio de Pago (Activo)
                                        </label>
                                        <div class="form-text">El negocio realizará pagos regulares</div>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="tipoNegocio"
                                               id="tipoPrueba" value="prueba" />
                                        <label class="form-check-label fw-semibold" for="tipoPrueba">
                                            <i class="bi bi-clock-history text-warning me-2"></i>
                                            Negocio de Prueba
                                        </label>
                                        <div class="form-text">7 días de prueba gratis, sin costo</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Seccion de Suscripcion -->
                <hr class="my-4" />
                <h5 class="fw-bold mb-4">
                    <i class="bi bi-calendar-check text-primary me-2"></i>
                    Datos de Suscripción
                </h5>
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <label class="form-label fw-semibold">Fecha de Inicio</label>
                        <input type="date" class="form-control form-control-lg" name="fechaPago" id="fechaPago" />
                        <div class="form-text">Fecha de inicio de la suscripción</div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <label class="form-label fw-semibold">Fecha de Expiración</label>
                        <input type="date" class="form-control form-control-lg" name="fechaExpiracion" id="fechaExpiracion" />
                        <div class="form-text">Fecha en que expira la suscripción</div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <label class="form-label fw-semibold">Precio de Suscripción ($)</label>
                        <input type="number" step="0.01" min="0" class="form-control form-control-lg" name="precioSuscripcion" id="precioSuscripcion" placeholder="0.00" />
                        <div class="form-text">Monto mensual a cobrar</div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <label class="form-label fw-semibold">Días Pagados</label>
                        <input type="number" min="1" class="form-control form-control-lg" name="diasPagados" id="diasPagados" placeholder="30" readonly />
                        <div class="form-text">Calculado automáticamente</div>
                    </div>
                </div>

                <!-- Botones de accion -->
                <div class="d-flex justify-content-end gap-3 mt-5 pt-5 border-top">
                    <a href="/Negocios" class="btn btn-light btn-lg">
                        <i class="bi bi-x-circle me-2"></i>
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg" id="btnCrearNegocio">
                        <i class="bi bi-check-circle me-2"></i>
                        Crear Negocio
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <!-- Script del formulario de creacion -->
<script>
// Mixin de SweetAlert2 con estilo consistente

$(document).ready(function () {
    // Inicializar fechas segun tipo seleccionado por defecto
    actualizarCamposSuscripcion();

    // Toggle password visibility
    $('#togglePassword').click(function () {
        const passwordInput = $('#passwordNegocio');
        const icon = $('#togglePasswordIcon');

        if (passwordInput.attr('type') === 'password') {
            passwordInput.attr('type', 'text');
            icon.removeClass('bi-eye').addClass('bi-eye-slash');
        } else {
            passwordInput.attr('type', 'password');
            icon.removeClass('bi-eye-slash').addClass('bi-eye');
        }
    });

    // Cambiar tipo de negocio: actualizar campos de suscripcion
    $('input[name="tipoNegocio"]').on('change', function () {
        actualizarCamposSuscripcion();
    });

    // Calcular dias pagados al cambiar fechas
    $('#fechaPago, #fechaExpiracion').on('change', function () {
        calcularDiasPagados();
    });

    // Envio del formulario con AJAX y confirmacion SweetAlert2
    $('#createNegocioForm').on('submit', function(e) {
        e.preventDefault();

        const tipoNegocio = $('input[name="tipoNegocio"]:checked').val();
        const nombre = $('#nombreNegocio').val();
        const tipoTexto = tipoNegocio === 'pago' ? 'Pago (Activo)' : 'Prueba (7 días gratis)';

        swalMG.fire({
            title: '¿Crear negocio?',
            text: `Se creará "${nombre}" como ${tipoTexto}.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Sí, crear'
        }).then((result) => {
            if (result.isConfirmed) {
                ejecutarCreacion();
            }
        });
    });
});

// Actualizar campos de suscripcion segun el tipo seleccionado
function actualizarCamposSuscripcion() {
    const tipo = $('input[name="tipoNegocio"]:checked').val();
    const hoy = new Date().toISOString().split('T')[0];

    if (tipo === 'prueba') {
        // Prueba: 7 dias gratis, precio 0
        $('#fechaPago').val(hoy);
        const expiracion = new Date();
        expiracion.setDate(expiracion.getDate() + 7);
        $('#fechaExpiracion').val(expiracion.toISOString().split('T')[0]);
        $('#diasPagados').val(7);
        $('#precioSuscripcion').val('0.00');

        // Deshabilitar edicion de precio y fechas para prueba
        $('#precioSuscripcion').prop('readonly', true);
        $('#fechaPago').prop('readonly', true);
        $('#fechaExpiracion').prop('readonly', true);
    } else {
        // Pago: dejar que el admin configure
        $('#fechaPago').val(hoy);
        const expiracion = new Date();
        expiracion.setDate(expiracion.getDate() + 30);
        $('#fechaExpiracion').val(expiracion.toISOString().split('T')[0]);
        $('#diasPagados').val(30);
        $('#precioSuscripcion').val('');

        // Habilitar edicion
        $('#precioSuscripcion').prop('readonly', false);
        $('#fechaPago').prop('readonly', false);
        $('#fechaExpiracion').prop('readonly', false);
    }
}

// Calcular dias pagados a partir de las fechas
function calcularDiasPagados() {
    const inicio = $('#fechaPago').val();
    const fin = $('#fechaExpiracion').val();

    if (inicio && fin) {
        const fechaInicio = new Date(inicio);
        const fechaFin = new Date(fin);
        const diff = Math.ceil((fechaFin - fechaInicio) / (1000 * 60 * 60 * 24));
        $('#diasPagados').val(diff > 0 ? diff : 0);
    }
}

// Ejecutar la creacion del negocio via AJAX
function ejecutarCreacion() {
    const btn = $('#btnCrearNegocio');
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Creando...');

    // Obtener el tipo seleccionado
    const tipoNegocio = $('input[name="tipoNegocio"]:checked').val();

    // Crear FormData con todos los valores
    const formData = {
        NombreNegocio: $('#nombreNegocio').val(),
        duenoNegocio: $('#duenoNegocio').val(),
        telefono: $('#telefono').val(),
        EmailNegocio: $('#emailNegocio').val(),
        passwordNegocio: $('#passwordNegocio').val(),
        isActive: tipoNegocio === 'pago',
        esPrueba: tipoNegocio === 'prueba',
        fechaPago: $('#fechaPago').val() || null,
        fechaExpiracion: $('#fechaExpiracion').val() || null,
        precioSuscripcion: $('#precioSuscripcion').val() || null,
        diasPagados: $('#diasPagados').val() || null
    };

    $.ajax({
        url: '/Negocios/Create',
        type: 'POST',
        data: formData,
        success: function(response) {
            swalMG.fire({
                title: 'Negocio creado',
                text: 'El negocio se ha creado exitosamente.',
                icon: 'success',
                showCancelButton: false,
                confirmButtonText: 'Ir al listado'
            }).then(() => {
                window.location.href = '/Negocios';
            });
        },
        error: function(xhr) {
            swalMG.fire('Error', 'Error al crear el negocio', 'error');
            btn.prop('disabled', false).html('<i class="bi bi-check-circle me-2"></i>Crear Negocio');
        }
    });
}
</script>

<style>
/* .required esta definido en metronic-style.css */
.form-check {
    padding: 1rem;
    border: 2px solid var(--mg-gray-300, #E4E6EF);
    border-radius: 0.5rem;
    transition: all 0.3s ease;
}

.form-check:has(input:checked) {
    border-color: var(--mg-primary, #3E97FF);
    background-color: var(--mg-primary-light, rgba(62, 151, 255, 0.1));
}

.form-check-input:checked {
    background-color: var(--mg-primary, #3E97FF);
    border-color: var(--mg-primary, #3E97FF);
}

.form-control-lg {
    border-radius: 0.5rem;
    min-height: 48px;
}

.btn-lg {
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    min-height: 48px;
}
</style>
}
