function cargarSugerencias() {
    $.get('/Negocios/GetSugerencias', function (data) {
        $('#totalSugerencias').text(data.length);
        const sinLeer = data.filter(s => !s.leida).length;
        $('#sinLeer').text(sinLeer);

        // Actualizar badge del sidebar
        if (sinLeer > 0) {
            $('#sidebarSugerenciasBadge').text(sinLeer).removeClass('d-none');
        } else {
            $('#sidebarSugerenciasBadge').addClass('d-none');
        }

        if (data.length === 0) {
            $('#sugerenciasList').html('<div class="text-center py-5 text-muted"><i class="bi bi-chat-left-text fs-1 d-block mb-3"></i><p>No hay sugerencias todavía.</p></div>');
            return;
        }

        let html = '';
        data.forEach(function (s) {
            const fecha = new Date(s.fechaCreacion).toLocaleString('es-MX');
            const unreadClass = s.leida ? '' : 'border-start border-3 border-primary';
            const btnLeida = !s.leida
                ? '<button class="btn btn-sm btn-light-primary" onclick="marcarSugerenciaLeida(\'' + s.id + '\')"><i class="bi bi-check me-1"></i>Leída</button>'
                : '<span class="badge bg-light text-muted">Leída</span>';
            html += '<div class="mg-card ' + unreadClass + '">' +
                '<div class="card-body">' +
                '<div class="d-flex justify-content-between align-items-start mb-2">' +
                '<div><h6 class="fw-bold mb-0"><i class="bi bi-building me-1 text-primary"></i>' + escHtml(s.negocioNombre) + '</h6>' +
                '<small class="text-muted">' + fecha + '</small></div>' +
                btnLeida + '</div>' +
                '<p class="mb-0 mt-2">' + escHtml(s.mensaje) + '</p>' +
                '</div></div>';
        });
        $('#sugerenciasList').html(html);
    }).fail(function () {
        $('#sugerenciasList').html('<div class="text-center py-5 text-muted"><i class="bi bi-exclamation-triangle fs-1 d-block mb-3 text-warning"></i><p>Error al cargar sugerencias</p></div>');
    });
}

function marcarSugerenciaLeida(id) {
    $.post('/Negocios/MarcarSugerenciaLeida', { id: id }, function (r) {
        if (r.success) cargarSugerencias();
    }).fail(function () {
        toastr.error('Error al marcar sugerencia como leída');
    });
}

// Cargar badge de sugerencias sin leer en el sidebar al iniciar
function cargarSugerenciasBadge() {
    $.get('/Negocios/GetSugerencias', function (data) {
        const sinLeer = data.filter(s => !s.leida).length;
        if (sinLeer > 0) {
            $('#sidebarSugerenciasBadge').text(sinLeer).removeClass('d-none');
        } else {
            $('#sidebarSugerenciasBadge').addClass('d-none');
        }
    }).fail(function () {
        console.warn('No se pudo cargar conteo de sugerencias');
    });
}

// ================================================================
// ACTUALIZACIONES (CHANGELOG)
// ================================================================
var changelogCargado = false;

function cargarActualizaciones() {
    if (changelogCargado) return;

    $.getJSON('/data/changelog.json?_=' + Date.now(), function (data) {
        changelogCargado = true;
        if (!data || !data.length) {
            $('#changelogContainer').html('<div class="text-center py-5"><i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i><p class="text-muted">No hay actualizaciones registradas.</p></div>');
            return;
        }

        var tipoBadge = {
            'feature': 'bg-primary',
            'fix': 'bg-danger',
            'mejora': 'bg-success',
            'eliminado': 'bg-warning text-dark'
        };
        var tipoLabel = {
            'feature': 'Nueva función',
            'fix': 'Corrección',
            'mejora': 'Mejora',
            'eliminado': 'Eliminado'
        };

        var html = '<div class="accordion" id="changelogAccordion">';
        data.forEach(function (release, idx) {
            var collapseId = 'changelog_' + idx;
            var show = idx === 0 ? ' show' : '';
            var collapsed = idx === 0 ? '' : ' collapsed';

            html += '<div class="accordion-item border-0 mb-3" style="border-radius:0.75rem;overflow:hidden;">';
            html += '<h2 class="accordion-header">';
            html += '<button class="accordion-button' + collapsed + ' fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#' + collapseId + '" style="background:var(--mg-gray-100,#F5F8FA);color:var(--mg-text,#181C32);">';
            html += '<span class="badge bg-primary me-2">v' + escHtml(release.version) + '</span> ';
            html += escHtml(release.titulo);
            html += '<small class="text-muted ms-auto me-3">' + escHtml(release.fecha) + '</small>';
            html += '</button></h2>';
            html += '<div id="' + collapseId + '" class="accordion-collapse collapse' + show + '" data-bs-parent="#changelogAccordion">';
            html += '<div class="accordion-body" style="background:var(--mg-card-bg,#fff);">';

            if (release.cambios && release.cambios.length) {
                html += '<ul class="list-unstyled mb-0">';
                release.cambios.forEach(function (c) {
                    var badge = tipoBadge[c.tipo] || 'bg-secondary';
                    var label = tipoLabel[c.tipo] || c.tipo;
                    html += '<li class="d-flex align-items-start mb-2">';
                    html += '<span class="badge ' + badge + ' me-2" style="min-width:100px;font-size:0.75rem;">' + escHtml(label) + '</span>';
                    html += '<span>' + escHtml(c.descripcion) + '</span>';
                    html += '</li>';
                });
                html += '</ul>';
            } else {
                html += '<p class="text-muted mb-0">Sin cambios detallados.</p>';
            }

            html += '</div></div></div>';
        });
        html += '</div>';

        $('#changelogContainer').html(html);
    }).fail(function () {
        changelogCargado = false;
        $('#changelogContainer').html('<div class="text-center py-5"><i class="bi bi-exclamation-triangle fs-1 text-warning d-block mb-3"></i><p class="text-muted">No se pudieron cargar las actualizaciones.</p></div>');
    });
}

