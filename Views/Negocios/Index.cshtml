$('#btnCrearVendedor').click(function() {
    modoEdicionVendedor = false;
    $('#vendedorModalTitle').html('<i class="bi bi-person-badge text-primary me-2"></i>Nuevo Vendedor');
    $('#vendedorForm')[0].reset();
    $('#vendedorId').val('');
    $('#vendedorPassword').prop('required', true);
    $('#vendedorPasswordLabel').addClass('required');
    $('#vendedorPasswordHelp').text('Mínimo 6 caracteres');
    $('#vendedorNombreBanco').val('');
    $('#vendedorNumeroCedula').val('');
    $('#vendedorNumeroCuenta').val('');
    $('#vendedorModal').modal('show');
});

function editarVendedor(id) {
    $.get('/Negocios/GetVendedor', { id }, function(data) {
        modoEdicionVendedor = true;
        $('#vendedorModalTitle').html('<i class="bi bi-person-badge text-primary me-2"></i>Editar Vendedor');
        $('#vendedorId').val(data.vendedorId);
        $('#vendedorNombre').val(data.nombre);
        $('#vendedorApellido').val(data.apellido);
        $('#vendedorCorreo').val(data.correo);
        $('#vendedorTelefono').val(data.telefono);
        $('#vendedorPassword').val('').prop('required', false);
        $('#vendedorPasswordLabel').removeClass('required');
        $('#vendedorPasswordHelp').text('Dejar en blanco para mantener la actual');
        $('#vendedorNombreBanco').val(data.nombreBanco || '');
        $('#vendedorNumeroCedula').val(data.numeroCedula || '');
        $('#vendedorNumeroCuenta').val(data.numeroCuenta || '');
        $('#vendedorModal').modal('show');
    }).fail(function() { toastr.error('Error al cargar vendedor'); });
}

$('#btnGuardarVendedor').click(function() {
    var nombre = $('#vendedorNombre').val().trim();
    var apellido = $('#vendedorApellido').val().trim();
    var correo = $('#vendedorCorreo').val().trim();
    var telefono = $('#vendedorTelefono').val().trim();
    var password = $('#vendedorPassword').val();
    var nombreBanco = $('#vendedorNombreBanco').val().trim();
    var numeroCedula = $('#vendedorNumeroCedula').val().trim();
    var numeroCuenta = $('#vendedorNumeroCuenta').val().trim();

    if (!nombre || !apellido || !correo || !telefono) {
        toastr.error('Todos los campos son obligatorios');
        return;
    }
    if (!modoEdicionVendedor && (!password || password.length < 6)) {
        toastr.error('La contraseña debe tener al menos 6 caracteres');
        return;
    }

    var btn = $(this);
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');

    var url = modoEdicionVendedor ? '/Negocios/EditarVendedor' : '/Negocios/CrearVendedor';
    var data = { nombre, apellido, correo, telefono, password, nombreBanco, numeroCedula, numeroCuenta };
    if (modoEdicionVendedor) data.id = $('#vendedorId').val();

    $.post(url, data, function(r) {
        if (r.success) {
            $('#vendedorModal').modal('hide');
            if (tablaVendedores) tablaVendedores.ajax.reload();
            toastr.success(r.message);
        } else {
            toastr.error(r.message || 'Error al guardar');
        }
    }).fail(function(xhr) {
        toastr.error(xhr.responseJSON?.message || 'Error al guardar vendedor');
    }).always(function() {
        btn.prop('disabled', false).html(originalHtml);
    });
});

function eliminarVendedor(id, nombre) {
    swalMG.fire({
        title: '¿Eliminar vendedor?',
        text: 'Se eliminará a "' + nombre + '" del sistema.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#F1416C',
        confirmButtonText: 'Sí, eliminar'
    }).then(function(result) {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarVendedor', { id }, function(r) {
                if (r.success) {
                    tablaVendedores.ajax.reload();
                    swalMG.fire('Eliminado', r.message, 'success');
                } else {
                    swalMG.fire('Error', r.message, 'error');
                }
            }).fail(function(xhr) {
                swalMG.fire('Error', xhr.responseJSON?.message || 'Error', 'error');
            });
        }
    });
}

function impersonarVendedor(id, nombre) {
    swalMG.fire({
        title: '¿Impersonar vendedor?',
        text: 'Vas a ver el dashboard como si fueras "' + nombre + '".',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí, impersonar'
    }).then(function(result) {
        if (result.isConfirmed) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '/Negocios/AdminImpersonateVendedor/' + id;
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = $('input[name="__RequestVerificationToken"]').val();
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }
    });
}

// ================================================================
// BIDIRECTIONAL DATE HANDLERS (Create)
// ================================================================
$('#crearDiasPagados').on('change input', function() {
    var tipo = $('input[name="tipoNegocio"]:checked').val();
    if (tipo === 'prueba') return;
    var inicio = $('#crearFechaPago').val();
    var dias = parseInt($(this).val());
    if (inicio && dias > 0) {
        var fecha = new Date(inicio);
        fecha.setDate(fecha.getDate() + dias);
        $('#crearFechaExpiracion').val(fecha.toISOString().split('T')[0]);
    }
});

// ================================================================
// BIDIRECTIONAL DATE HANDLERS (Edit)
// ================================================================
$('#editFechaPago, #editFechaExpiracion').on('change', function() {
    var inicio = $('#editFechaPago').val();
    var fin = $('#editFechaExpiracion').val();
    if (inicio && fin) {
        var diff = Math.ceil((new Date(fin) - new Date(inicio)) / (1000 * 60 * 60 * 24));
        $('#editDiasPagados').val(diff > 0 ? diff : 0);
    }
});

$('#editDiasPagados').on('change input', function() {
    var inicio = $('#editFechaPago').val();
    var dias = parseInt($(this).val());
    if (inicio && dias > 0) {
        var fecha = new Date(inicio);
        fecha.setDate(fecha.getDate() + dias);
        $('#editFechaExpiracion').val(fecha.toISOString().split('T')[0]);
    }
});

// ================================================================
// TAB COMISIONES
// ================================================================
function cargarComisiones() {
    // Load summary
    mgGet('/Negocios/GetResumenComisiones', null, function(data) {
        var totalPendiente = 0, totalPagado = 0, vendedoresActivos = 0, totalNegocios = 0;
        if (data && data.length) {
            data.forEach(function(v) {
                totalPendiente += v.montoPendiente || 0;
                totalPagado += v.montoPagado || 0;
                totalNegocios += v.totalNegocios || 0;
                if (v.montoPendiente > 0) vendedoresActivos++;
            });
        }
        $('#comTotalPendiente').text('$' + totalPendiente.toFixed(2));
        $('#comTotalPagado').text('$' + totalPagado.toFixed(2));
        $('#comVendedoresActivos').text(vendedoresActivos);
        $('#comTotalNegocios').text(totalNegocios);
        // Update badge
        if (totalPendiente > 0) {
            $('#sidebarComisionesBadge').text('$' + totalPendiente.toFixed(0)).removeClass('d-none');
        } else {
            $('#sidebarComisionesBadge').addClass('d-none');
        }
    });
    // Load pending
    mgGet('/Negocios/GetComisionesPendientes', null, function(data) {
        var html = '';
        if (!data || !data.length) {
            html = '<div class="text-center py-4 text-muted"><i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>No hay comisiones pendientes</div>';
        } else {
            data.forEach(function(g) {
                html += '<div class="mg-card p-3">';
                html += '<div class="d-flex justify-content-between align-items-center mb-2">';
                html += '<div><h6 class="fw-bold mb-0">' + escHtml(g.nombreVendedor) + '</h6>';
                if (g.nombreBanco) html += '<small class="text-muted"><i class="bi bi-bank me-1"></i>' + escHtml(g.nombreBanco) + ' - ' + escHtml(g.numeroCuenta || '') + '</small>';
                html += '</div>';
                html += '<div class="text-end"><span class="fs-4 fw-bolder text-warning">$' + (g.totalPendiente || 0).toFixed(2) + '</span>';
                html += '<br><small class="text-muted">' + (g.cantidadPendientes || 0) + ' negocio(s)</small></div></div>';
                // Detail table
                if (g.comisiones && g.comisiones.length) {
                    html += '<div class="table-responsive"><table class="table table-sm mb-2"><thead><tr><th>Negocio</th><th>Tipo</th><th>Días</th><th>Precio</th><th>Comisión</th><th>Fecha</th></tr></thead><tbody>';
                    g.comisiones.forEach(function(c) {
                        html += '<tr><td>' + escHtml(c.nombreNegocio) + '</td><td><span class="badge bg-' + (c.tipoComision === 'nueva' ? 'primary' : 'info') + '">' + c.tipoComision + '</span></td>';
                        html += '<td>' + c.diasContratados + 'd</td><td>$' + (c.precioNegocio || 0).toFixed(2) + '</td>';
                        html += '<td class="fw-bold">$' + (c.montoComision || 0).toFixed(2) + '</td>';
                        html += '<td>' + new Date(c.fechaCreacion).toLocaleDateString('es-MX') + '</td></tr>';
                    });
                    html += '</tbody></table></div>';
                }
                html += '<button class="btn btn-success btn-sm" onclick="pagarComision(\'' + g.vendedorId + '\', \'' + escHtml(g.nombreVendedor) + '\', ' + (g.totalPendiente || 0).toFixed(2) + ', \'' + escHtml(g.nombreBanco || '') + '\', \'' + escHtml(g.numeroCedula || '') + '\', \'' + escHtml(g.numeroCuenta || '') + '\')"><i class="bi bi-cash-stack me-2"></i>Marcar como Pagado ($' + (g.totalPendiente || 0).toFixed(2) + ')</button>';
                html += '</div>';
            });
        }
        $('#comisionesPendientesList').html(html);
    });
    // Load history
    mgGet('/Negocios/GetHistorialComisiones', null, function(data) {
        var html = '';
        if (!data || !data.length) {
            html = '<div class="text-center py-4 text-muted">Sin historial de pagos</div>';
        } else {
            data.forEach(function(c) {
                html += '<div class="mg-card p-2 d-flex justify-content-between align-items-center">';
                html += '<div><span class="fw-semibold">' + escHtml(c.nombreVendedor) + '</span> — ' + escHtml(c.nombreNegocio);
                html += ' <span class="badge bg-success">$' + (c.montoComision || 0).toFixed(2) + '</span>';
                if (c.metodoPagoPago) {
                    html += ' <span class="badge bg-info"><i class="bi bi-bank me-1"></i>' + escHtml(c.metodoPagoPago) + '</span>';
                }
                html += '</div>';
                html += '<small class="text-muted">' + (c.fechaPago ? new Date(c.fechaPago).toLocaleDateString('es-MX') : '') + '</small>';
                html += '</div>';
            });
        }
        $('#comisionesHistorialList').html(html);
    });
}

function pagarComision(vendedorId, nombre, monto, nombreBanco, numeroCedula, numeroCuenta) {
    var bancoHtml = '';
    var metodoPagoLabel = '';
    if (nombreBanco) {
        metodoPagoLabel = 'Transferencia a ' + nombreBanco;
        bancoHtml = '<div class="alert alert-info text-start mt-3 mb-0">' +
            '<h6 class="fw-bold mb-2"><i class="bi bi-bank me-2"></i>Datos Bancarios</h6>' +
            '<p class="mb-1"><strong>Banco:</strong> ' + nombreBanco + '</p>' +
            (numeroCedula ? '<p class="mb-1"><strong>Cedula:</strong> ' + numeroCedula + '</p>' : '') +
            (numeroCuenta ? '<p class="mb-0"><strong>Cuenta:</strong> ' + numeroCuenta + '</p>' : '') +
            '</div>';
    } else {
        metodoPagoLabel = 'Efectivo';
        bancoHtml = '<div class="alert alert-warning text-start mt-3 mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Este vendedor no tiene datos bancarios registrados.</div>';
    }
    var transferInfo = '<div class="mt-3 p-2 rounded text-start" style="background: var(--mg-card-bg); border: 1px solid var(--mg-border-color);">' +
        '<small class="text-muted d-block mb-1">Metodo de pago</small>' +
        '<span class="fw-semibold"><i class="bi bi-' + (nombreBanco ? 'bank' : 'cash-stack') + ' me-1"></i>' + metodoPagoLabel + (numeroCuenta ? ' - Cta: ' + numeroCuenta : '') + '</span>' +
        '</div>';
    var confirmInput = '<div class="mt-3">' +
        '<label class="form-label text-start d-block small text-muted">Numero de transaccion (opcional)</label>' +
        '<input type="text" class="form-control" id="comisionNumConfirmacion" placeholder="Ej: TRX-12345">' +
        '</div>';
    swalMG.fire({
        title: 'Confirmar Pago',
        html: '<p>Vas a marcar como pagadas las comisiones de <strong>' + nombre + '</strong> por un total de <strong>$' + monto.toFixed(2) + '</strong>.</p>' +
            bancoHtml + transferInfo + confirmInput +
            '<p class="text-muted small mt-3">Asegurate de haber realizado la transferencia antes de confirmar.</p>',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Si, ya pague'
    }).then(function(result) {
        if (result.isConfirmed) {
            var numConfirmacion = document.getElementById('comisionNumConfirmacion')?.value || '';
            $.post('/Negocios/PagarComisionesVendedor', {
                vendedorId: vendedorId,
                metodoPago: metodoPagoLabel,
                numeroConfirmacion: numConfirmacion
            }, function(r) {
                if (r.success) {
                    toastr.success(r.message);
                    cargarComisiones();
                } else {
                    toastr.error(r.message || 'Error al procesar pago');
                }
            }).fail(function() { toastr.error('Error de conexion'); });
        }
    });
}

