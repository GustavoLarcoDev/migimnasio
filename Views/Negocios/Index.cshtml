let promoPreviewTable = null;
let promoResultTable = null;
let promoContactosValidos = [];

function actualizarArchivoPromo() {
    const input = document.getElementById('promoFileInput');
    if (input.files.length > 0) {
        $('#promoFileName').text(input.files[0].name);
        $('#promoFileInfo').removeClass('d-none');
        $('#btnProcesarPromo').prop('disabled', false);
    }
}

function limpiarPromoArchivo() {
    $('#promoFileInput').val('');
    $('#promoFileInfo').addClass('d-none');
    $('#btnProcesarPromo').prop('disabled', true);
}

function procesarExcelPromocion() {
    const input = document.getElementById('promoFileInput');
    if (!input.files.length) {
        toastr.warning('Selecciona un archivo Excel');
        return;
    }

    const formData = new FormData();
    formData.append('archivo', input.files[0]);

    $('#btnProcesarPromo').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Procesando...');

    $.ajax({
        url: '/Negocios/ProcesarExcelPromocion',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (data) {
            if (!data.success) {
                toastr.error(data.message);
                $('#btnProcesarPromo').prop('disabled', false).html('<i class="bi bi-search me-2"></i>Procesar y Previsualizar');
                return;
            }

            $('#promoTotalContactos').text(data.totalFilas);
            $('#promoValidos').text(data.validos);
            $('#promoInvalidos').text(data.invalidos);

            promoContactosValidos = data.contactos.filter(c => c.valido);

            if (promoPreviewTable) {
                promoPreviewTable.destroy();
                $('#promoPreviewTable').empty();
            }

            promoPreviewTable = $('#promoPreviewTable').DataTable({
                data: data.contactos,
                columns: [
                    { data: 'fila', className: 'ps-4' },
                    { data: 'nombre', render: function (d) { return escHtml(d); } },
                    { data: 'telefonoOriginal', render: function (d) { return escHtml(d); } },
                    { data: 'telefonoNormalizado', render: function (d) { return escHtml(d); } },
                    {
                        data: 'valido',
                        render: function (d) {
                            return d
                                ? '<span class="badge bg-light-success text-success">Válido</span>'
                                : '<span class="badge bg-light-danger text-danger">Inválido</span>';
                        }
                    }
                ],
                pageLength: 25,
                ordering: true,
                searching: true
            });

            $('#btnEnviarPromo').prop('disabled', data.validos === 0);

            $('#promoFaseUpload').addClass('d-none');
            $('#promoFasePreview').removeClass('d-none');

            $('#btnProcesarPromo').prop('disabled', false).html('<i class="bi bi-search me-2"></i>Procesar y Previsualizar');
        },
        error: function (xhr) {
            var msg = xhr.responseJSON?.message || 'Error al procesar el archivo';
            toastr.error(msg);
            $('#btnProcesarPromo').prop('disabled', false).html('<i class="bi bi-search me-2"></i>Procesar y Previsualizar');
        }
    });
}

function volverUploadPromo() {
    $('#promoFasePreview').addClass('d-none');
    $('#promoFaseUpload').removeClass('d-none');
}

function confirmarEnvioPromocion() {
    if (promoContactosValidos.length === 0) {
        toastr.warning('No hay contactos válidos para enviar');
        return;
    }

    var tiempoEstimado = Math.ceil(promoContactosValidos.length * 1.5 / 60);
    swalMG.fire({
        title: 'Confirmar envío',
        html: '<p>Se enviarán <b>' + promoContactosValidos.length + '</b> mensajes de WhatsApp.</p>' +
              '<p class="text-muted">Tiempo estimado: ~' + tiempoEstimado + ' minuto(s)</p>' +
              '<p class="text-muted small">Cada mensaje incluye promoción de 50% de descuento con link de contacto.</p>',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Enviar',
        cancelButtonText: 'Cancelar'
    }).then(function (result) {
        if (result.isConfirmed) {
            enviarPromocion();
        }
    });
}

function enviarPromocion() {
    var contactos = promoContactosValidos.map(function (c) {
        return { nombre: c.nombre, telefono: c.telefonoNormalizado };
    });

    var total = contactos.length;

    $('#promoFasePreview').addClass('d-none');
    $('#promoFaseProgreso').removeClass('d-none');
    $('#promoProgressBar').css('width', '0%').text('0%');
    $('#promoProgressText').text('0 / ' + total + ' enviados');

    // Simular progreso durante el envío (1 por segundo aproximadamente)
    var progreso = 0;
    var promoInterval = setInterval(function () {
        progreso++;
        if (progreso >= total) {
            clearInterval(promoInterval);
            return;
        }
        var pct = Math.round((progreso / total) * 100);
        $('#promoProgressBar').css('width', pct + '%').text(pct + '%');
        $('#promoProgressText').text(progreso + ' / ' + total + ' enviados');
    }, 1100);

    $.ajax({
        url: '/Negocios/EnviarPromocion',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(contactos),
        success: function (data) {
            clearInterval(promoInterval);

            $('#promoProgressBar').css('width', '100%').text('100%');
            $('#promoProgressText').text(total + ' / ' + total + ' completados');

            setTimeout(function () {
                $('#promoResultEnviados').text(data.totalEnviados);
                $('#promoResultFallidos').text(data.totalFallidos);
                $('#promoResultTotal').text(data.total);

                if (promoResultTable) {
                    promoResultTable.destroy();
                    $('#promoResultTable').empty();
                }

                promoResultTable = $('#promoResultTable').DataTable({
                    data: data.resultados,
                    columns: [
                        { data: 'nombre', className: 'ps-4 fw-semibold', render: function (d) { return escHtml(d); } },
                        { data: 'telefono', render: function (d) { return escHtml(d); } },
                        {
                            data: 'estado',
                            render: function (d) {
                                return d === 'enviado'
                                    ? '<span class="badge bg-light-success text-success">Enviado</span>'
                                    : '<span class="badge bg-light-danger text-danger">Fallido</span>';
                            }
                        },
                        { data: 'detalle', render: function (d) { return '<span class="text-muted small">' + escHtml(d) + '</span>'; } }
                    ],
                    pageLength: 25,
                    ordering: true,
                    searching: true
                });

                $('#promoFaseProgreso').addClass('d-none');
                $('#promoFaseResultados').removeClass('d-none');

                if (data.totalFallidos === 0)
                    toastr.success('Todos los mensajes fueron enviados exitosamente');
                else
                    toastr.warning(data.totalEnviados + ' enviados, ' + data.totalFallidos + ' fallidos');
            }, 500);
        },
        error: function (xhr) {
            clearInterval(promoInterval);
            var msg = xhr.responseJSON?.message || 'Error al enviar promociones';
            toastr.error(msg);
            $('#promoFaseProgreso').addClass('d-none');
            $('#promoFasePreview').removeClass('d-none');
        }
    });
}

function reiniciarPromocion() {
    promoContactosValidos = [];
    limpiarPromoArchivo();
    $('#promoFaseResultados').addClass('d-none');
    $('#promoFaseUpload').removeClass('d-none');
}

// Drag and drop para la zona de upload
(function () {
    var dropZone = document.getElementById('promoDropZone');
    var fileInput = document.getElementById('promoFileInput');
    if (!dropZone || !fileInput) return;

    dropZone.addEventListener('click', function () { fileInput.click(); });
    fileInput.addEventListener('change', actualizarArchivoPromo);

    dropZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        dropZone.style.borderColor = 'var(--mg-primary, #3E97FF)';
        dropZone.style.backgroundColor = 'var(--mg-primary-light, rgba(62,151,255,0.05))';
    });
    dropZone.addEventListener('dragleave', function (e) {
        e.preventDefault();
        dropZone.style.borderColor = '';
        dropZone.style.backgroundColor = '';
    });
    dropZone.addEventListener('drop', function (e) {
        e.preventDefault();
        dropZone.style.borderColor = '';
        dropZone.style.backgroundColor = '';
        if (e.dataTransfer.files.length > 0) {
            fileInput.files = e.dataTransfer.files;
            actualizarArchivoPromo();
        }
    });
})();

</script>

