@section Styles {
<style>
.propaganda-canvas-wrapper { background: #e9ecef; border-radius: 8px; padding: 16px; text-center; overflow: auto; }
</style>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>
<script src="~/js/propaganda-editor.js" asp-append-version="true"></script>
<script>
// ================================================================
// Variables globales
// ================================================================
let tablaNegocios = null;
let tablaLogs = null;
let tablaVentasNegocios = null;
let tablaVendedores = null;
let resumenRevenueChart = null;
let ventasRevenueChart = null;
let ventasDonutChart = null;
let negociosData = null; // Caché de datos de /GetNegocios para la pestaña Ventas

// ================================================================
// Inicialización
// ================================================================
$(document).ready(function () {
    cargarResumen();
    cargarSugerenciasBadge();
    // Inicializar campos de creación
    actualizarCamposSuscripcion();
});

// ================================================================
// Navegación por pestañas con mg-tab-shown
// ================================================================
document.addEventListener('mg-tab-shown', function (e) {
    const tab = e.detail.tab;
    if (tab === 'resumenTab') {
        cargarResumen();
    } else if (tab === 'negociosTab') {
        if (!tablaNegocios) cargarTablaNegocios();
        else tablaNegocios.ajax.reload(null, false);
    } else if (tab === 'crearTab') {
        // No hay carga especial, el formulario ya está listo
    } else if (tab === 'ventasTab') {
        cargarVentasTab();
    } else if (tab === 'logsTab') {
        if (!tablaLogs) cargarTablaLogs();
        else tablaLogs.ajax.reload(null, false);
    } else if (tab === 'vendedoresTab') {
        if (!tablaVendedores) cargarTablaVendedores();
        else tablaVendedores.ajax.reload(null, false);
    } else if (tab === 'sugerenciasTab') {
        cargarSugerencias();
    } else if (e.detail.tab === 'comisionesTab') {
        cargarComisiones();
    } else if (tab === 'metodosPagoTab') {
        cargarAdminMetodosPago();
    } else if (tab === 'recibosTab') {
        cargarRecibosAdmin();
    } else if (tab === 'promocionarTab') {
        // Sin carga automática — el usuario sube el archivo manualmente
    } else if (tab === 'actualizacionesTab') {
        cargarActualizaciones();
    } else if (tab === 'propagandaTab') {
        PropagandaEditor.init();
    }
});

// ================================================================
// Función auxiliar: navegar a una pestaña programáticamente
// ================================================================
function navegarATab(tabId) {
    const link = document.querySelector('[data-mg-tab="' + tabId + '"]');
    if (link) link.click();
}

// ================================================================
// TAB RESUMEN
// ================================================================
function cargarResumen() {
    $('#resumenSaludo').text(saludoHora());

    // Cargar estadísticas del admin dashboard
    $.get('/Negocios/GetAdminDashboardStats', function (data) {
        $('#resumenMrr').text('$' + data.mrr.toFixed(2));
        $('#resumenTotalNegocios').text(data.totalNegocios);
        $('#resumenActivos').text(data.activos);
        $('#resumenPrueba').text(data.prueba);
        $('#resumenTotalClientes').text(data.totalClientes);

        // Renderizar gráfico de ingresos mensuales
        renderizarGraficoResumen(data.revenuePorMes);
    }).fail(function () {
        toastr.error('Error al cargar estadísticas del dashboard');
    });

    // Cargar datos de negocios para calcular estadísticas derivadas
    $.get('/Negocios/GetNegocios', function (data) {
        negociosData = data;
        const ingresos = data.filter(g => g.isActive && g.precioSuscripcion > 0).reduce((sum, g) => sum + g.precioSuscripcion, 0);
        const porVencer = data.filter(g => g.diasRestantesSuscripcion !== null && g.diasRestantesSuscripcion >= 0 && g.diasRestantesSuscripcion <= 7 && !g.porEmpezar).length;
        const expirados = data.filter(g => g.diasRestantesSuscripcion !== null && g.diasRestantesSuscripcion < 0 && !g.porEmpezar).length;
        const bloqueados = data.filter(g => g.negocioBloqueado).length;

        $('#resumenIngresosMensuales').text('$' + ingresos.toFixed(2));
        $('#resumenPorVencer').text(porVencer);
        $('#resumenExpirados').text(expirados);
        $('#resumenBloqueados').text(bloqueados);
    }).fail(function () {
        console.warn('Error al cargar negocios para estadísticas de resumen');
    });
}

function renderizarGraficoResumen(revenuePorMes) {
    const categorias = revenuePorMes.map(r => r.mes);
    const valores = revenuePorMes.map(r => r.total);

    if (resumenRevenueChart) resumenRevenueChart.destroy();
    resumenRevenueChart = new ApexCharts(document.querySelector('#resumenRevenueChart'), {
        series: [{ name: 'Ingresos', data: valores }],
        chart: { type: 'bar', height: 300, toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
        plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } },
        dataLabels: { enabled: false },
        xaxis: {
            categories: categorias,
            labels: { style: { colors: '#A1A5B7', fontSize: '11px' } }
        },
        yaxis: {
            labels: {
                formatter: function (val) { return '$' + val.toFixed(0); },
                style: { colors: '#A1A5B7', fontSize: '11px' }
            }
        },
        fill: {
            type: 'gradient',
            gradient: {
                shade: 'light', type: 'vertical', shadeIntensity: 0.3,
                opacityFrom: 1, opacityTo: 0.8,
                colorStops: [
                    { offset: 0, color: '#3E97FF', opacity: 1 },
                    { offset: 100, color: '#1B74E4', opacity: 0.8 }
                ]
            }
        },
        tooltip: { y: { formatter: function (val) { return '$' + val.toFixed(2); } } },
        grid: { borderColor: '#E4E6EF', strokeDashArray: 4 }
    });
    resumenRevenueChart.render();
}

// ================================================================
// TAB NEGOCIOS
// ================================================================
function cargarTablaNegocios() {
    tablaNegocios = $('#negociosTable').DataTable({
        ajax: {
            url: '/Negocios/GetNegocios',
            type: 'GET',
            dataSrc: function (data) {
                negociosData = data;
                return data;
            },
            error: function (xhr) {
                console.error('Error al cargar negocios:');
                toastr.error('Error al cargar la lista de negocios');
            }
        },
        columns: [
            {
                data: 'negocioNombre',
                render: function (data, type, row) {
                    return '<div class="d-flex align-items-center">' +
                        '<div class="symbol symbol-45px me-3"><div class="symbol-label bg-light-primary"><i class="bi bi-building text-primary fs-3"></i></div></div>' +
                        '<div class="d-flex justify-content-start flex-column">' +
                        '<a href="#" onclick="impersonarNegocio(\'' + row.negocioId + '\'); return false;" class="text-dark fw-bold fs-6 text-hover-primary" title="Ver como este negocio">' + escHtml(data) + '</a>' +
                        '<span class="text-muted fw-semibold d-block fs-7">ID: ' + escHtml(row.negocioId.substring(0, 8)) + '</span>' +
                        '</div></div>';
                }
            },
            {
                data: 'duenoNegocio',
                render: function (data) { return '<span class="text-dark fw-semibold">' + escHtml(data || 'N/A') + '</span>'; }
            },
            {
                data: null,
                render: function (data, type, row) {
                    return '<div class="d-flex flex-column">' +
                        '<span class="text-dark fw-semibold mb-1"><i class="bi bi-envelope me-1 text-muted"></i>' + escHtml(row.email) + '</span>' +
                        '<span class="text-muted fw-semibold"><i class="bi bi-telephone me-1"></i>' + escHtml(row.telefono) + '</span>' +
                        '</div>';
                }
            },
            {
                data: 'totalClientes',
                render: function (data) { return '<span class="badge badge-light-info fs-7 fw-bold">' + data + ' cliente' + (data !== 1 ? 's' : '') + '</span>'; }
            },
            {
                data: 'vendedorNombre',
                render: function (data) {
                    if (!data) return '<span class="text-muted">Admin</span>';
                    return '<span class="badge bg-light-primary text-primary">' + escHtml(data) + '</span>';
                }
            },
            {
                data: 'isActive',
                render: function (data, type, row) {
                    let badge = data ? '<span class="badge badge-light-success">Activo</span>' : '<span class="badge badge-light-danger">Inactivo</span>';
                    if (row.negocioBloqueado) {
                        badge += '<br><span class="badge bg-danger mt-1">Bloqueado</span>';
                    }
                    return badge;
                }
            },
            {
                data: null,
                render: function (data, type, row) {
                    const tipo = row.esPrueba ? '<span class="badge badge-light-warning">Prueba</span>' : '<span class="badge badge-light-primary">Pago</span>';
                    const dias = row.diasPagados ? '<small class="text-muted d-block">' + row.diasPagados + ' días</small>' : '';
                    const precio = row.precioSuscripcion > 0 ? '<small class="text-muted d-block">$' + row.precioSuscripcion.toFixed(2) + '</small>' : '';
                    return tipo + dias + precio;
                }
            },
            {
                data: 'diasRestantesSuscripcion',
                render: function (data, type, row) {
                    if (!row.fechaExpiracion) return '<span class="text-muted">Sin fecha</span>';
                    const fecha = new Date(row.fechaExpiracion);
                    const fechaStr = fecha.toLocaleDateString('es-ES');
                    if (data === null || data === undefined) return '<span class="text-muted">' + fechaStr + '</span>';
                    if (row.porEmpezar) {
                        const inicioStr = new Date(row.fechaPago).toLocaleDateString('es-ES');
                        return '<span class="badge bg-secondary">Por empezar</span><br><small class="text-muted">Inicia: ' + inicioStr + '</small>';
                    }
                    if (data < 0) return '<span class="badge bg-danger">Expirado</span><br><small class="text-muted">' + fechaStr + '</small>';
                    if (data <= 3) return '<span class="badge bg-warning text-dark">' + data + 'd</span><br><small class="text-muted">' + fechaStr + '</small>';
                    if (data <= 7) return '<span class="badge bg-info">' + data + 'd</span><br><small class="text-muted">' + fechaStr + '</small>';
                    return '<span class="badge bg-success">' + data + 'd</span><br><small class="text-muted">' + fechaStr + '</small>';
                }
            },
            {
                data: null, orderable: false, className: 'text-end',
                render: function (data, type, row) {
                    const cleanPhone = (row.telefono || '').replace(/[\s\-\+\(\)]/g, '');
                    const waMessage = encodeURIComponent('Hola ' + (row.duenoNegocio || '') + ', mi nombre es Gustavo Larco el dueño de My-Negocio.com y quería saber cómo iba todo, si había algún feedback o algo que mencionar.');
                    const whatsappBtn = cleanPhone
                        ? '<a href="https://wa.me/' + escHtml(cleanPhone) + '?text=' + waMessage + '" target="_blank" rel="noopener" class="btn btn-icon btn-bg-light btn-sm me-1" title="WhatsApp"><i class="bi bi-whatsapp text-success fs-5"></i></a>'
                        : '';
                    const impersonateBtn = '<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="impersonarNegocio(\'' + row.negocioId + '\')" title="Ver como negocio"><i class="bi bi-eye text-primary fs-5"></i></button>';
                    const estadoBtn = row.isActive
                        ? '<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="cambiarEstado(\'' + row.negocioId + '\')" title="Desactivar"><i class="bi bi-toggle-on text-success fs-4"></i></button>'
                        : '<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="cambiarEstado(\'' + row.negocioId + '\')" title="Activar"><i class="bi bi-toggle-off text-danger fs-4"></i></button>';
                    const bloqueoBtn = row.negocioBloqueado
                        ? '<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="desbloquearNegocio(\'' + row.negocioId + '\')" title="Desbloquear"><i class="bi bi-unlock-fill text-success fs-4"></i></button>'
                        : '<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="bloquearNegocio(\'' + row.negocioId + '\')" title="Bloquear"><i class="bi bi-lock-fill text-danger fs-4"></i></button>';

                    return '<div class="d-flex justify-content-end gap-1">' +
                        whatsappBtn + impersonateBtn + estadoBtn + bloqueoBtn +
                        '<button class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" onclick="editarNegocio(\'' + row.negocioId + '\')" title="Editar"><i class="bi bi-pencil fs-5"></i></button>' +
                        '<button class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" onclick="confirmarEliminar(\'' + row.negocioId + '\', \'' + escHtml(row.negocioNombre).replace(/'/g, "\\'") + '\')" title="Eliminar"><i class="bi bi-trash fs-5"></i></button>' +
                        '</div>';
                }
            }
        ],
        order: [[0, 'asc']],
        responsive: true,
        pageLength: 10
    });
}

// Editar Negocio — abrir modal y cargar datos
function editarNegocio(id) {
    $.ajax({
        url: '/Negocios/GetNegocio/' + id,
        type: 'GET',
        success: function (data) {
            $('#editNegocioId').val(data.negocioId);
            $('#editNegocioNombre').val(data.negocioNombre);
            $('#editDuenoNegocio').val(data.duenoNegocio);
            $('#editEmail').val(data.email);
            $('#editTelefono').val(data.telefono);
            $('#editPassword').val('');

            if (data.isActive) {
                $('#editTipoPago').prop('checked', true);
            } else {
                $('#editTipoPrueba').prop('checked', true);
            }

            $('#editDiasPagados').val(data.diasPagados || 30);
            $('#editPrecioSuscripcion').val(data.precioSuscripcion || 0);
            if (data.fechaPago) {
                $('#editFechaPago').val(data.fechaPago.split('T')[0]);
            } else {
                $('#editFechaPago').val('');
            }
            if (data.fechaExpiracion) {
                $('#editFechaExpiracion').val(data.fechaExpiracion.split('T')[0]);
            } else {
                $('#editFechaExpiracion').val('');
            }

            $('#editarNegocioModal').modal('show');
        },
        error: function () {
            toastr.error('Error al cargar los datos del negocio');
        }
    });
}

// Guardar edición de negocio
$('#btnGuardarEdicion').click(function () {
    if (!$('#editarNegocioForm')[0].checkValidity()) {
        $('#editarNegocioForm')[0].reportValidity();
        return;
    }

    const btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');

    const tipoNegocio = $('input[name="tipoNegocioEdit"]:checked').val();

    const formData = {
        NegocioId: $('#editNegocioId').val(),
        NegocioNombre: $('#editNegocioNombre').val(),
        DuenoNegocio: $('#editDuenoNegocio').val(),
        Email: $('#editEmail').val(),
        Telefono: $('#editTelefono').val(),
        Password: $('#editPassword').val(),
        IsActive: tipoNegocio === 'pago',
        EsPrueba: tipoNegocio === 'prueba',
        DiasPagados: $('#editDiasPagados').val() || 30,
        PrecioSuscripcion: $('#editPrecioSuscripcion').val() || 0,
        FechaPago: $('#editFechaPago').val() || null,
        FechaExpiracion: $('#editFechaExpiracion').val() || null
    };

    $.ajax({
        url: '/Negocios/Editar',
        type: 'POST',
        data: formData,
        success: function (response) {
            if (response.success) {
                $('#editarNegocioModal').modal('hide');
                if (tablaNegocios) tablaNegocios.ajax.reload(null, false);
                toastr.success(response.message);
                if (tablaLogs) tablaLogs.ajax.reload(null, false);
            } else {
                toastr.error(response.message);
            }
            btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Guardar Cambios');
        },
        error: function (xhr) {
            toastr.error(xhr.responseJSON?.message || 'Error al guardar el negocio');
            btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Guardar Cambios');
        }
    });
});

