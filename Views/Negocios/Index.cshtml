// Actualizar campos de suscripción según el tipo seleccionado
function actualizarCamposSuscripcion() {
    const tipo = $('input[name="tipoNegocio"]:checked').val();
    const hoy = new Date().toISOString().split('T')[0];

    if (tipo === 'prueba') {
        $('#crearFechaPago').val(hoy);
        const expiracion = new Date();
        expiracion.setDate(expiracion.getDate() + 7);
        $('#crearFechaExpiracion').val(expiracion.toISOString().split('T')[0]);
        $('#crearDiasPagados').val(7);
        $('#crearPrecioSuscripcion').val('0.00');
        $('#crearPrecioSuscripcion').prop('readonly', true);
        $('#crearFechaPago').prop('readonly', true);
        $('#crearFechaExpiracion').prop('readonly', true);
        $('#crearDiasPagados').prop('readonly', true);
    } else {
        $('#crearFechaPago').val(hoy);
        const expiracion = new Date();
        expiracion.setDate(expiracion.getDate() + 30);
        $('#crearFechaExpiracion').val(expiracion.toISOString().split('T')[0]);
        $('#crearDiasPagados').val(30);
        $('#crearPrecioSuscripcion').val('');
        $('#crearPrecioSuscripcion').prop('readonly', false);
        $('#crearFechaPago').prop('readonly', false);
        $('#crearFechaExpiracion').prop('readonly', false);
        $('#crearDiasPagados').prop('readonly', false);
    }
}

function calcularDiasPagadosCrear() {
    const inicio = $('#crearFechaPago').val();
    const fin = $('#crearFechaExpiracion').val();
    if (inicio && fin) {
        const diff = Math.ceil((new Date(fin) - new Date(inicio)) / (1000 * 60 * 60 * 24));
        $('#crearDiasPagados').val(diff > 0 ? diff : 0);
    }
}

