// ================================================================
// TAB VENTAS
// ================================================================
function cargarVentasTab() {
    // Cargar estadísticas del admin
    $.get('/Negocios/GetAdminDashboardStats', function (stats) {
        $('#ventasMrr').text('$' + stats.mrr.toFixed(2));

        // Renderizar gráfico de ingresos en ventas
        renderizarGraficoVentas(stats.revenuePorMes);

        // Datos de distribución para donut
        renderizarDonutVentas(stats.activos, stats.prueba, stats.totalNegocios);
    }).fail(function () {
        toastr.error('Error al cargar estadísticas de ventas');
    });

    // Cargar datos de negocios para la tabla y estadísticas derivadas
    $.get('/Negocios/GetNegocios', function (data) {
        negociosData = data;

        // Total Revenue (todos los pagos históricos con precio > 0)
        const totalRevenue = data.filter(g => g.precioSuscripcion > 0).reduce((sum, g) => sum + g.precioSuscripcion, 0);
        $('#ventasTotalRevenue').text('$' + totalRevenue.toFixed(2));

        // Negocios que están pagando (activos con precio > 0)
        const pagando = data.filter(g => g.isActive && !g.esPrueba && g.precioSuscripcion > 0);
        $('#ventasPagando').text(pagando.length);

        // ARPU (Average Revenue Per User/Business)
        const arpu = pagando.length > 0 ? totalRevenue / pagando.length : 0;
        $('#ventasArpu').text('$' + arpu.toFixed(2));

        // Cargar tabla de negocios con suscripción
        cargarTablaVentasNegocios(data);
    }).fail(function () {
        toastr.error('Error al cargar datos de negocios para ventas');
    });
}

function renderizarGraficoVentas(revenuePorMes) {
    const categorias = revenuePorMes.map(r => r.mes);
    const valores = revenuePorMes.map(r => r.total);

    if (ventasRevenueChart) ventasRevenueChart.destroy();
    ventasRevenueChart = new ApexCharts(document.querySelector('#ventasRevenueChart'), {
        series: [{ name: 'Ingresos', data: valores }],
        chart: { type: 'bar', height: 300, toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
        plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } },
        dataLabels: { enabled: false },
        colors: ['#50CD89'],
        xaxis: {
            categories: categorias,
            labels: { style: { colors: '#A1A5B7', fontSize: '11px' } },
            axisBorder: { show: false }, axisTicks: { show: false }
        },
        yaxis: {
            labels: {
                formatter: function (val) { return '$' + val.toFixed(0); },
                style: { colors: '#A1A5B7', fontSize: '11px' }
            }
        },
        grid: { borderColor: '#EFF2F5', strokeDashArray: 4 },
        tooltip: { y: { formatter: function (val) { return '$' + val.toFixed(2); } } }
    });
    ventasRevenueChart.render();
}

function renderizarDonutVentas(activos, prueba, total) {
    const inactivos = total - activos - prueba;
    const el = document.querySelector('#ventasDonutChart');

    if (total === 0) {
        el.innerHTML = '<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-3 opacity-50"></i><p class="mb-0">Sin datos todavía</p></div>';
        return;
    }

    if (ventasDonutChart) ventasDonutChart.destroy();
    el.innerHTML = '';

    ventasDonutChart = new ApexCharts(el, {
        series: [activos, prueba, inactivos > 0 ? inactivos : 0],
        chart: { type: 'donut', height: 300, fontFamily: 'Inter, sans-serif' },
        labels: ['De Pago', 'En Prueba', 'Inactivos'],
        colors: ['#50CD89', '#FFC700', '#F1416C'],
        plotOptions: {
            pie: {
                donut: {
                    size: '70%',
                    labels: {
                        show: true,
                        name: { show: true, fontSize: '14px', fontWeight: 600, color: '#A1A5B7', offsetY: -10 },
                        value: { show: true, fontSize: '22px', fontWeight: 700, offsetY: 4 },
                        total: { show: true, showAlways: true, label: 'Total', fontSize: '13px', fontWeight: 500, color: '#A1A5B7' }
                    }
                }
            }
        },
        dataLabels: { enabled: true, formatter: function (val) { return val.toFixed(1) + '%'; } },
        legend: { position: 'bottom', labels: { colors: '#5E6278' }, fontSize: '13px', fontWeight: 500, markers: { width: 12, height: 12, radius: 6 } },
        stroke: { show: true, width: 3, colors: ['#fff'] },
        responsive: [{ breakpoint: 576, options: { chart: { height: 260 } } }]
    });
    ventasDonutChart.render();
}

function cargarTablaVentasNegocios(data) {
    // Filtrar solo negocios con suscripción (precio > 0 o con fecha de expiración)
    const negociosSuscripcion = data.filter(g => g.precioSuscripcion > 0 || g.fechaExpiracion);

    if (tablaVentasNegocios) {
        tablaVentasNegocios.destroy();
        $('#ventasNegociosTable tbody').empty();
    }

    tablaVentasNegocios = $('#ventasNegociosTable').DataTable({
        data: negociosSuscripcion,
        columns: [
            {
                data: 'negocioNombre',
                render: function (data) { return '<strong>' + escHtml(data) + '</strong>'; }
            },
            {
                data: 'esPrueba',
                render: function (data) {
                    return data ? '<span class="badge badge-light-warning">Prueba</span>' : '<span class="badge badge-light-primary">Pago</span>';
                }
            },
            {
                data: 'precioSuscripcion',
                render: function (data) { return '$' + (data || 0).toFixed(2); }
            },
            {
                data: 'fechaPago',
                render: function (data) { return data ? new Date(data).toLocaleDateString('es-ES') : '-'; }
            },
            {
                data: 'fechaExpiracion',
                render: function (data) { return data ? new Date(data).toLocaleDateString('es-ES') : '-'; }
            },
            {
                data: 'diasRestantes',
                render: function (data, type, row) {
                    if (data === null || data === undefined) return '<span class="text-muted">-</span>';
                    if (row.porEmpezar) return '<span class="badge bg-secondary">Por empezar</span>';
                    if (data < 0) return '<span class="badge bg-danger">Expirado</span>';
                    if (data <= 3) return '<span class="badge bg-warning text-dark">' + data + ' días</span>';
                    if (data <= 7) return '<span class="badge bg-info">' + data + ' días</span>';
                    return '<span class="badge bg-success">' + data + ' días</span>';
                }
            }
        ],
        order: [[5, 'asc']],
        responsive: true,
        pageLength: 10
    });
}

