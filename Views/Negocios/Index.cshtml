        confirmButtonColor: '#F1416C',
        confirmButtonText: 'Si, eliminar'
    }).then(function (result) {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarAdminImagenQR', { metodoPagoId: id }, function (r) {
                if (r.success) {
