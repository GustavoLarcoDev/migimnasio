function cargarAdminMetodosPago() {
    Promise.all([
        $.get('/Negocios/GetAdminPaymentStats'),
        $.get('/Negocios/GetAdminMetodosPago')
    ]).then(function(results) {
        var statsData = results[0];
        var methods = results[1];

        // Build stats map
        var statsMap = {};
        if (statsData) {
            statsData.forEach(function(s) {
                statsMap[s.metodoPago.toLowerCase()] = s;
            });
        }

        // Render earnings summary cards
        var statsRow = $('#adminPaymentStatsRow');
        statsRow.empty();
        var allNames = ['Efectivo'];
        if (methods) methods.forEach(function(m) { allNames.push(m.nombre); });
        var colors = ['#50CD89', '#3E97FF', '#7239EA', '#F1416C', '#FFC700'];
        allNames.forEach(function(name, idx) {
            var s = statsMap[name.toLowerCase()] || { totalHoy: 0, totalSemana: 0, totalMes: 0 };
            var color = colors[idx % colors.length];
            statsRow.append(
                '<div class="col-md-4 col-sm-6">' +
                '<div class="card border-0 shadow-sm" style="border-radius: 16px; background: linear-gradient(135deg, ' + color + ', ' + color + 'cc);">' +
                '<div class="card-body p-3">' +
                '<div class="d-flex align-items-center gap-2 mb-2">' +
                '<i class="bi ' + (name === 'Efectivo' ? 'bi-cash-stack' : 'bi-bank') + ' text-white"></i>' +
                '<h6 class="mb-0 text-white fw-bold">' + escHtml(name) + '</h6>' +
                '</div>' +
                '<div class="d-flex justify-content-between">' +
                '<div class="text-center"><small class="text-white-50 d-block" style="font-size:0.65rem;">Hoy</small>' +
                '<span class="text-white fw-bold" style="font-size:0.9rem;">$' + (s.totalHoy || 0).toFixed(2) + '</span></div>' +
                '<div class="text-center"><small class="text-white-50 d-block" style="font-size:0.65rem;">Semana</small>' +
                '<span class="text-white fw-bold" style="font-size:0.9rem;">$' + (s.totalSemana || 0).toFixed(2) + '</span></div>' +
                '<div class="text-center"><small class="text-white-50 d-block" style="font-size:0.65rem;">Mes</small>' +
                '<span class="text-white fw-bold" style="font-size:0.9rem;">$' + (s.totalMes || 0).toFixed(2) + '</span></div>' +
                '</div></div></div></div>'
            );
        });

        // Render method cards
        var grid = $('#adminMetodosPagoGrid');
        grid.empty();

        // Efectivo card
        var efStats = statsMap['efectivo'] || { totalHoy: 0, totalSemana: 0, totalMes: 0, cantidadMes: 0 };
        grid.append(renderAdminMpCard(null, 'Efectivo', null, null, true, false, efStats));

        if (methods && methods.length > 0) {
            methods.forEach(function (m) {
                var mpStats = statsMap[m.nombre.toLowerCase()] || { totalHoy: 0, totalSemana: 0, totalMes: 0, cantidadMes: 0 };
                grid.append(renderAdminMpCard(m.metodoPagoId, m.nombre, m.numeroCuenta, m.nombreTitular,
                    false, m.esPredeterminado, mpStats, m.imagenQR, m.cedula, m.instrucciones, m.fechaCreacion));
            });
        }
    }).catch(function () {
        toastr.error('Error al cargar metodos de pago');
    });
}

function renderAdminMpCard(id, nombre, numeroCuenta, nombreTitular, isEfectivo, esPredeterminado, stats, imagenQR, cedula, instrucciones, fechaCreacion) {
    var icon = isEfectivo ? 'bi-cash-stack' : 'bi-bank';
    var qrIndicator = imagenQR ? '<i class="bi bi-qr-code ms-1 text-success" style="font-size:0.85rem;"></i>' : '';
    var defaultBadge = (isEfectivo || esPredeterminado) ? '<span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem;">Predeterminado</span>' : '';

    var menuHtml = '';
    if (!isEfectivo) {
        menuHtml = '<div class="dropdown position-absolute" style="top:12px;right:12px;">' +
            '<button class="btn btn-sm btn-light" data-bs-toggle="dropdown" style="border-radius:8px;padding:2px 8px;">' +
            '<i class="bi bi-three-dots-vertical"></i></button>' +
            '<ul class="dropdown-menu dropdown-menu-end" style="border-radius:12px;background:var(--mg-card-bg);border:1px solid var(--mg-border-color);">';
        if (imagenQR) {
            menuHtml += '<li><a class="dropdown-item" href="#" onclick="verAdminQR(\'' + id + '\',\'' + escHtml(nombre).replace(/'/g,"\\'") + '\')">' +
                '<i class="bi bi-qr-code me-2"></i>Ver QR</a></li>';
        }
        menuHtml += '<li><a class="dropdown-item" href="#" onclick="editarAdminMetodoPago(\'' + id + '\')">' +
            '<i class="bi bi-pencil me-2"></i>Editar</a></li>';
        if (!esPredeterminado) {
            menuHtml += '<li><a class="dropdown-item" href="#" onclick="setAdminPredeterminado(\'' + id + '\')">' +
                '<i class="bi bi-star me-2"></i>Predeterminado</a></li>';
        }
        menuHtml += '<li><hr class="dropdown-divider"></li>' +
            '<li><a class="dropdown-item text-danger" href="#" onclick="eliminarAdminMetodoPago(\'' + id + '\',\'' + escHtml(nombre).replace(/'/g,"\\'") + '\')">' +
            '<i class="bi bi-trash me-2"></i>Eliminar</a></li></ul></div>';
    }

    var infoHtml = '';
    if (numeroCuenta) infoHtml += '<div class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-credit-card-2-front text-muted" style="font-size:0.8rem;width:16px;"></i><small style="color:var(--mg-text-color);">' + escHtml(numeroCuenta) + '</small></div>';
    if (nombreTitular) infoHtml += '<div class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-person text-muted" style="font-size:0.8rem;width:16px;"></i><small style="color:var(--mg-text-color);">' + escHtml(nombreTitular) + '</small></div>';
    if (cedula) infoHtml += '<div class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-card-text text-muted" style="font-size:0.8rem;width:16px;"></i><small style="color:var(--mg-text-color);">' + escHtml(cedula) + '</small></div>';

    // Earnings row
    var earningsHtml = '<div class="d-flex justify-content-between mt-2 pt-2" style="border-top:1px dashed var(--mg-border-color);">' +
        '<div class="text-center"><small class="text-muted d-block" style="font-size:0.65rem;">Hoy</small><span class="fw-bold" style="font-size:0.85rem;color:var(--mg-text-color);">$' + (stats.totalHoy || 0).toFixed(2) + '</span></div>' +
        '<div class="text-center"><small class="text-muted d-block" style="font-size:0.65rem;">Semana</small><span class="fw-bold" style="font-size:0.85rem;color:var(--mg-text-color);">$' + (stats.totalSemana || 0).toFixed(2) + '</span></div>' +
        '<div class="text-center"><small class="text-muted d-block" style="font-size:0.65rem;">Mes</small><span class="fw-bold" style="font-size:0.85rem;color:var(--mg-text-color);">$' + (stats.totalMes || 0).toFixed(2) + '</span></div>' +
        '</div>';

    return '<div class="col-md-4 col-sm-6">' +
        '<div class="card border-0 shadow-sm h-100" style="border-radius:16px;background:var(--mg-card-bg);">' +
        '<div class="card-body p-4 position-relative">' +
        menuHtml +
        '<div class="d-flex align-items-start gap-3">' +
        '<div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:' + (isEfectivo ? 'rgba(80,205,137,0.12)' : 'var(--mg-primary-light, rgba(62,151,255,0.1))') + ';">' +
        '<i class="bi ' + icon + ' fs-4" style="color:' + (isEfectivo ? '#50CD89' : 'var(--mg-primary)') + ';"></i></div>' +
        '<div class="flex-grow-1 min-width-0">' +
        '<h6 class="mb-1 fw-bold" style="color:var(--mg-text-color);">' + escHtml(nombre) + qrIndicator + '</h6>' +
        defaultBadge + '</div></div>' +
        (infoHtml ? '<hr class="my-3" style="border-color:var(--mg-border-color);opacity:0.3;">' + infoHtml : '') +
        earningsHtml +
        '</div></div></div>';
}

