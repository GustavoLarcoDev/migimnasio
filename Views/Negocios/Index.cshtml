function guardarAdminMetodoPago() {
    var nombre = $('#adminMpNombre').val().trim();
    if (!nombre) {
        toastr.error('El nombre del metodo es obligatorio');
        return;
    }

    var id = $('#adminMpId').val();
    var isEdit = id && id.length > 0;
    var url = isEdit ? '/Negocios/EditarAdminMetodoPago' : '/Negocios/CrearAdminMetodoPago';

    var formData = new FormData();
    formData.append('Nombre', nombre);
    formData.append('NumeroCuenta', $('#adminMpNumeroCuenta').val());
    formData.append('Cedula', $('#adminMpCedula').val());
    formData.append('NombreTitular', $('#adminMpNombreTitular').val());
    formData.append('Instrucciones', $('#adminMpInstrucciones').val());
    formData.append('EsPredeterminado', $('#adminMpPredeterminado').is(':checked'));
    if (isEdit) formData.append('MetodoPagoId', id);

    $.ajax({
        url: url,
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        success: function (response) {
            if (response.success) {
                bootstrap.Modal.getInstance(document.getElementById('adminModalMetodoPago')).hide();
                toastr.success(response.message);

                // If there is a QR file to upload after create
                var qrFile = document.getElementById('adminMpQrFile').files[0];
                var metodoPagoId = isEdit ? id : response.metodoPagoId;
                if (qrFile && metodoPagoId) {
                    var qrData = new FormData();
                    qrData.append('metodoPagoId', metodoPagoId);
                    qrData.append('imagen', qrFile);
                    $.ajax({
                        url: '/Negocios/SubirAdminImagenQR',
                        type: 'POST',
                        data: qrData,
                        processData: false,
                        contentType: false,
                        success: function (qrRes) {
                            if (qrRes.success) toastr.success('Imagen QR subida');
                            cargarAdminMetodosPago();
                        },
                        error: function () {
                            toastr.error('Error al subir imagen QR');
                            cargarAdminMetodosPago();
                        }
                    });
                } else {
                    cargarAdminMetodosPago();
                }
            } else {
                toastr.error(response.message);
            }
        },
        error: function (xhr) {
            toastr.error(xhr.responseJSON?.message || 'Error al guardar metodo de pago');
        }
    });
}

function eliminarAdminMetodoPago(id, nombre) {
    swalMG.fire({
        title: 'Eliminar metodo?',
        html: 'Se eliminara <strong>' + nombre + '</strong> como metodo de pago.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#F1416C',
        confirmButtonText: 'Si, eliminar'
    }).then(function (result) {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarAdminMetodoPago', { metodoPagoId: id }, function (r) {
                if (r.success) {
                    toastr.success(r.message);
                    cargarAdminMetodosPago();
                } else {
                    toastr.error(r.message);
                }
            }).fail(function (xhr) {
                toastr.error(xhr.responseJSON?.message || 'Error al eliminar');
            });
        }
    });
}

function eliminarAdminQR() {
    var id = $('#adminMpId').val();
    if (!id) return;

    swalMG.fire({
        title: 'Eliminar QR?',
        text: 'Se eliminara la imagen QR de este metodo de pago.',
