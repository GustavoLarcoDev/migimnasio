@{
ViewData["Title"] = "Gestión de Negocios";
}

<div class="container-fluid px-2 px-sm-3 px-md-5 mb-5 pb-5">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 mb-md-5">
        <div>
            <h1 class="fw-bolder text-dark mb-1 fs-3 fs-md-1">Negocios</h1>
            <p class="text-muted mb-0 small">Gestiona todos los negocios registrados</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Logout", "Auth")" class="btn btn-danger btn-sm">
                <i class="bi bi-box-arrow-left"></i>
                <span class="d-none d-sm-inline ms-1">Cerrar Sesión</span>
            </a>
            <button id="btnExportExcel" class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i>
                <span class="d-none d-sm-inline ms-1">Exportar</span>
            </button>
            <a href="/Negocios/Sugerencias" class="btn btn-outline-warning btn-sm">
                <i class="bi bi-chat-left-text"></i>
                <span class="d-none d-sm-inline ms-1">Sugerencias</span>
            </a>
            <a href="/Negocios/Crear" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i>
                <span class="d-none d-sm-inline ms-1">Nuevo</span>
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Total Negocios</div>
                        <div class="stat-value" id="totalNegocios">0</div>
                    </div>
                    <div class="stat-icon bg-light-primary">
                        <i class="bi bi-building text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Negocios Activos</div>
                        <div class="stat-value" id="negociosActivos">0</div>
                    </div>
                    <div class="stat-icon bg-light-success">
                        <i class="bi bi-check-circle text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">En Prueba</div>
                        <div class="stat-value" id="negociosPrueba">0</div>
                    </div>
                    <div class="stat-icon bg-light-warning">
                        <i class="bi bi-clock-history text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Total Clientes</div>
                        <div class="stat-value" id="totalClientes">0</div>
                    </div>
                    <div class="stat-icon bg-light-info">
                        <i class="bi bi-people text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Income Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-4 col-6">
            <div class="mg-stat-card" style="background: linear-gradient(135deg, #50CD89 0%, #0BB783 100%);">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label text-white opacity-75">Ingresos Mensuales</div>
                        <div class="stat-value text-white" id="ingresosMensuales">$0</div>
                    </div>
                    <i class="bi bi-arrow-up-circle text-white fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Por Vencer (7 días)</div>
                        <div class="stat-value" id="porVencer">0</div>
                    </div>
                    <div class="stat-icon bg-light-danger">
                        <i class="bi bi-exclamation-triangle text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Expirados</div>
                        <div class="stat-value" id="expirados">0</div>
                    </div>
                    <div class="stat-icon bg-light-danger">
                        <i class="bi bi-x-circle text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="mg-card">
        <div class="card-header">
            <h3 class="card-title fw-bold text-dark mb-0">Listado de Negocios</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
            <table id="negociosTable" class="table table-row-bordered table-row-gray-100 align-middle gs-0 gy-3">
                <thead>
                <tr class="fw-bold text-muted">
                    <th>Negocio</th>
                    <th>Dueño</th>
                    <th>Contacto</th>
                    <th>Clientes</th>
                    <th>Estado</th>
                    <th>Suscripción</th>
                    <th>Expira</th>
                    <th class="text-end">Acciones</th>
                </tr>
                </thead>
                <tbody class="text-gray-600 fw-semibold">
                </tbody>
            </table>
            </div>
        </div>
    </div>

</div>

<!-- Modal Editar Negocio -->
<div class="modal fade" id="editarNegocioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h3 class="modal-title fw-bolder">
                    <i class="bi bi-pencil-square text-primary me-2"></i>
                    Editar Negocio
                </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="editarNegocioForm">
                    <input type="hidden" id="editNegocioId" name="NegocioId" />

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-semibold required">Nombre del Negocio</label>
                            <input type="text" class="form-control form-control-lg" name="NegocioNombre" id="editNegocioNombre" required />
                        </div>

                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-semibold required">Nombre del Dueño</label>
                            <input type="text" class="form-control form-control-lg" name="DuenoNegocio" id="editDuenoNegocio" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-semibold required">Email</label>
                            <input type="email" class="form-control form-control-lg" name="Email" id="editEmail" required />
                        </div>

                        <div class="col-md-6 mb-4">
                            <label class="form-label fw-semibold required">Teléfono</label>
                            <input type="tel" class="form-control form-control-lg" name="Telefono" id="editTelefono" required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Contraseña</label>
                        <input type="password" class="form-control form-control-lg" name="Password" id="editPassword" />
                        <div class="form-text">Dejar en blanco para mantener la contraseña actual</div>
                    </div>

                    <!-- Tipo de Negocio -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold required">Tipo de Negocio</label>
                        <div class="d-flex gap-3 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoNegocioEdit"
                                       id="editTipoPago" value="pago" />
                                <label class="form-check-label" for="editTipoPago">
                                    <i class="bi bi-credit-card text-primary me-1"></i>
                                    De Pago (Activo)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipoNegocioEdit"
                                       id="editTipoPrueba" value="prueba" />
                                <label class="form-check-label" for="editTipoPrueba">
                                    <i class="bi bi-clock-history text-warning me-1"></i>
                                    De Prueba
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Suscripción -->
                    <hr class="my-3"/>
                    <h6 class="fw-bold mb-3"><i class="bi bi-calendar-check text-primary me-2"></i>Suscripción</h6>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <label class="form-label fw-semibold">Días pagados</label>
                            <input type="number" class="form-control form-control-lg" name="DiasPagados" id="editDiasPagados" min="1" />
                        </div>
                        <div class="col-md-4 mb-4">
                            <label class="form-label fw-semibold">Precio suscripción ($)</label>
                            <input type="number" step="0.01" class="form-control form-control-lg" name="PrecioSuscripcion" id="editPrecioSuscripcion" min="0" />
                        </div>
                        <div class="col-md-4 mb-4">
                            <label class="form-label fw-semibold">Fecha expiración</label>
                            <input type="date" class="form-control form-control-lg" name="FechaExpiracion" id="editFechaExpiracion" />
                        </div>
                    </div>

                </form>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" id="btnGuardarEdicion" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>
                    Guardar Cambios
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Modal Confirmar Eliminación -->
<div class="modal fade" id="eliminarNegocioModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bolder">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-trash text-danger" style="font-size: 4rem;"></i>
                <h4 class="mt-3">¿Estás seguro?</h4>
                <p class="text-muted mb-0">
                    Vas a eliminar el negocio <strong id="deleteNegocioNombre"></strong>
                </p>
                <p class="text-danger fw-semibold">Esta acción no se puede deshacer.</p>
                <input type="hidden" id="deleteNegocioId" />
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button type="button" id="btnConfirmarEliminar" class="btn btn-danger">
                    <i class="bi bi-trash me-2"></i>
                    Sí, Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let tablaNegocios;

    $(document).ready(function () {
        cargarTabla();
    });

    function cargarTabla() {
        tablaNegocios = $('#negociosTable').DataTable({
            ajax: {
                url: '/Negocios/GetNegocios',
                type: 'GET',
                dataSrc: function(data) {
                    actualizarEstadisticas(data);
                    return data;
                }
            },
            columns: [
                {
                    data: 'negocioNombre',
                    render: function(data, type, row) {
                        return `
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-45px me-3">
                                        <div class="symbol-label bg-light-primary">
                                            <i class="bi bi-building text-primary fs-3"></i>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-start flex-column">
                                        <a href="#" onclick="impersonarNegocio('${row.negocioId}'); return false;"
                                           class="text-dark fw-bold fs-6 text-hover-primary" title="Ver como este negocio">${data}</a>
                                        <span class="text-muted fw-semibold d-block fs-7">ID: ${row.negocioId.substring(0, 8)}</span>
                                    </div>
                                </div>
                            `;
                    }
                },
                {
                    data: 'duenoNegocio',
                    render: function(data) {
                        return `<span class="text-dark fw-semibold">${data || 'N/A'}</span>`;
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        return `
                                <div class="d-flex flex-column">
                                    <span class="text-dark fw-semibold mb-1">
                                        <i class="bi bi-envelope me-1 text-muted"></i>${row.email}
                                    </span>
                                    <span class="text-muted fw-semibold">
                                        <i class="bi bi-telephone me-1"></i>${row.telefono}
                                    </span>
                                </div>
                            `;
                    }
                },
                {
                    data: 'totalClientes',
                    render: function(data) {
                        return `<span class="badge badge-light-info fs-7 fw-bold">${data} cliente${data !== 1 ? 's' : ''}</span>`;
                    }
                },
                {
                    data: 'isActive',
                    render: function(data, type, row) {
                        if(data) {
                            return '<span class="badge badge-light-success">Activo</span>';
                        } else {
                            return '<span class="badge badge-light-danger">Inactivo</span>';
                        }
                    }
                },
                {
                    data: null,
                    render: function(data, type, row) {
                        const tipo = row.esPrueba ? '<span class="badge badge-light-warning">Prueba</span>' : '<span class="badge badge-light-primary">Pago</span>';
                        const dias = row.diasPagados ? `<small class="text-muted d-block">${row.diasPagados} días</small>` : '';
                        const precio = row.precioSuscripcion > 0 ? `<small class="text-muted d-block">$${row.precioSuscripcion.toFixed(2)}</small>` : '';
                        return tipo + dias + precio;
                    }
                },
                {
                    data: 'diasRestantesSuscripcion',
                    render: function(data, type, row) {
                        if (!row.fechaExpiracion) return '<span class="text-muted">Sin fecha</span>';
                        const fecha = new Date(row.fechaExpiracion);
                        const fechaStr = fecha.toLocaleDateString('es-ES');
                        if (data === null || data === undefined) return `<span class="text-muted">${fechaStr}</span>`;
                        if (data < 0) return `<span class="badge bg-danger">Expirado</span><br><small class="text-muted">${fechaStr}</small>`;
                        if (data <= 3) return `<span class="badge bg-warning text-dark">${data}d</span><br><small class="text-muted">${fechaStr}</small>`;
                        if (data <= 7) return `<span class="badge bg-info">${data}d</span><br><small class="text-muted">${fechaStr}</small>`;
                        return `<span class="badge bg-success">${data}d</span><br><small class="text-muted">${fechaStr}</small>`;
                    }
                },
                {
                    data: null,
                    orderable: false,
                    className: 'text-end',
                    render: function(data, type, row) {
                        // WhatsApp button
                        const cleanPhone = (row.telefono || '').replace(/[\s\-\+\(\)]/g, '');
                        const waMessage = encodeURIComponent(
                            `Hola ${row.duenoNegocio || ''}, mi nombre es Gustavo Larco el dueño de MiNegocio.com y quería saber cómo iba todo, si había algún feedback o algo que mencionar.`
                        );
                        const whatsappBtn = cleanPhone
                            ? `<a href="https://wa.me/${cleanPhone}?text=${waMessage}" target="_blank" rel="noopener"
                                  class="btn btn-icon btn-bg-light btn-sm me-1" title="WhatsApp">
                                  <i class="bi bi-whatsapp text-success fs-5"></i>
                               </a>`
                            : '';

                        // Impersonate button
                        const impersonateBtn = `<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="impersonarNegocio('${row.negocioId}')" title="Ver como negocio">
                            <i class="bi bi-eye text-primary fs-5"></i>
                        </button>`;

                        const estadoBtn = row.isActive
                            ? `<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="cambiarEstado('${row.negocioId}')" title="Desactivar">
                                     <i class="bi bi-toggle-on text-success fs-4"></i>
                                   </button>`
                            : `<button class="btn btn-icon btn-bg-light btn-sm me-1" onclick="cambiarEstado('${row.negocioId}')" title="Activar">
                                     <i class="bi bi-toggle-off text-danger fs-4"></i>
                                   </button>`;

                        return `
                                <div class="d-flex justify-content-end gap-1">
                                    ${whatsappBtn}
                                    ${impersonateBtn}
                                    ${estadoBtn}
                                    <button class="btn btn-icon btn-bg-light btn-active-color-primary btn-sm me-1" onclick="editarNegocio('${row.negocioId}')" title="Editar">
                                        <i class="bi bi-pencil fs-5"></i>
                                    </button>
                                    <button class="btn btn-icon btn-bg-light btn-active-color-danger btn-sm" onclick="confirmarEliminar('${row.negocioId}', '${row.negocioNombre}')" title="Eliminar">
                                        <i class="bi bi-trash fs-5"></i>
                                    </button>
                                </div>
                            `;
                    }
                }
            ],
            order: [[0, 'asc']],
            responsive: true,
            pageLength: 10
        });
    }

    function actualizarEstadisticas(data) {
        const total = data.length;
        const activos = data.filter(g => g.isActive).length;
        const prueba = data.filter(g => g.esPrueba).length;
        const totalClientesSum = data.reduce((sum, g) => sum + g.totalClientes, 0);

        // Subscription stats
        const ingresos = data.filter(g => g.isActive && g.precioSuscripcion > 0).reduce((sum, g) => sum + g.precioSuscripcion, 0);
        const porVencer = data.filter(g => g.diasRestantesSuscripcion !== null && g.diasRestantesSuscripcion >= 0 && g.diasRestantesSuscripcion <= 7).length;
        const expirados = data.filter(g => g.diasRestantesSuscripcion !== null && g.diasRestantesSuscripcion < 0).length;

        $('#totalNegocios').text(total);
        $('#negociosActivos').text(activos);
        $('#negociosPrueba').text(prueba);
        $('#totalClientes').text(totalClientesSum);
        $('#ingresosMensuales').text('$' + ingresos.toFixed(2));
        $('#porVencer').text(porVencer);
        $('#expirados').text(expirados);
    }

    // Editar Negocio
    function editarNegocio(id) {
        $.ajax({
            url: '/Negocios/GetNegocio/' + id,
            type: 'GET',
            success: function (data) {
                $('#editNegocioId').val(data.negocioId);
                $('#editNegocioNombre').val(data.negocioNombre);
                $('#editDuenoNegocio').val(data.duenoNegocio);
                $('#editEmail').val(data.email);
                $('#editTelefono').val(data.telefono);
                $('#editPassword').val('');

                // Seleccionar el radio correcto según la lógica de negocio
                if (data.isActive) {
                    $('#editTipoPago').prop('checked', true);
                } else {
                    $('#editTipoPrueba').prop('checked', true);
                }

                // Subscription fields
                $('#editDiasPagados').val(data.diasPagados || 30);
                $('#editPrecioSuscripcion').val(data.precioSuscripcion || 0);
                if (data.fechaExpiracion) {
                    $('#editFechaExpiracion').val(data.fechaExpiracion.split('T')[0]);
                } else {
                    $('#editFechaExpiracion').val('');
                }

                $('#editarNegocioModal').modal('show');
            },
            error: function () {
                toastr.error('Error al cargar los datos del negocio');
            }
        });
    }

    // Guardar Edición - SOLO UNA VEZ
    $('#btnGuardarEdicion').click(function () {
        if (!$('#editarNegocioForm')[0].checkValidity()) {
            $('#editarNegocioForm')[0].reportValidity();
            return;
        }

        const btn = $(this);
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');

        const tipoNegocio = $('input[name="tipoNegocioEdit"]:checked').val();

        const formData = {
            NegocioId: $('#editNegocioId').val(),
            NegocioNombre: $('#editNegocioNombre').val(),
            DuenoNegocio: $('#editDuenoNegocio').val(),
            Email: $('#editEmail').val(),
            Telefono: $('#editTelefono').val(),
            Password: $('#editPassword').val(),
            IsActive: tipoNegocio === 'pago',
            EsPrueba: tipoNegocio === 'prueba',
            DiasPagados: $('#editDiasPagados').val() || 30,
            PrecioSuscripcion: $('#editPrecioSuscripcion').val() || 0,
            FechaExpiracion: $('#editFechaExpiracion').val() || null
        };

        $.ajax({
            url: '/Negocios/Editar',
            type: 'POST',
            data: formData,
            success: function (response) {
                if (response.success) {
                    $('#editarNegocioModal').modal('hide');
                    tablaNegocios.ajax.reload(null, false);
                    toastr.success(response.message);
                } else {
                    toastr.error(response.message);
                }
                btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Guardar Cambios');
            },
            error: function (xhr) {
                const response = xhr.responseJSON;
                toastr.error(response?.message || 'Error al guardar el negocio');
                btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Guardar Cambios');
            }
        });
    });

    // Confirmar Eliminar (abrir modal)
    function confirmarEliminar(id, nombre) {
        $('#deleteNegocioId').val(id);
        $('#deleteNegocioNombre').text(nombre);
        $('#eliminarNegocioModal').modal('show');
    }

    // Ejecutar Eliminación
    $('#btnConfirmarEliminar').click(function() {
        const id = $('#deleteNegocioId').val();
        const btn = $(this);

        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Eliminando...');

        $.ajax({
            url: '/Negocios/Eliminar',
            type: 'POST',
            data: { id: id },
            success: function (response) {
                if (response.success) {
                    $('#eliminarNegocioModal').modal('hide');
                    tablaNegocios.ajax.reload(null, false);
                    toastr.success(response.message);
                } else {
                    toastr.error(response.message);
                }
                btn.prop('disabled', false).html('<i class="bi bi-trash me-2"></i>Sí, Eliminar');
            },
            error: function (xhr) {
                const response = xhr.responseJSON;
                toastr.error(response?.message || 'Error al eliminar el negocio');
                btn.prop('disabled', false).html('<i class="bi bi-trash me-2"></i>Sí, Eliminar');
            }
        });
    });

    // Cambiar Estado
    function cambiarEstado(id) {
        $.ajax({
            url: '/Negocios/CambiarEstado',
            type: 'POST',
            data: { id: id },
            success: function (response) {
                if (response.success) {
                    tablaNegocios.ajax.reload(null, false);
                    toastr.success(response.message);
                }
            },
            error: function () {
                toastr.error('Error al cambiar el estado');
            }
        });
    }

    // Exportar Excel
    $('#btnExportExcel').click(function () {
        window.location.href = '/Negocios/ExportExcel';
    });

    // Impersonar Negocio
    function impersonarNegocio(id) {
        Swal.fire({
            title: '¿Impersonar negocio?',
            text: 'Vas a ver el dashboard como si fueras este negocio.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3E97FF',
            cancelButtonColor: '#E4E6EF',
            confirmButtonText: 'Sí, impersonar',
            cancelButtonText: 'Cancelar',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/Negocios/Impersonate/${id}`;
                document.body.appendChild(form);
                form.submit();
            }
        });
    }
</script>

