var modoEdicionVendedor = false;

function cargarTablaVendedores() {
    if (tablaVendedores) tablaVendedores.destroy();
    tablaVendedores = $('#vendedoresTable').DataTable({
        ajax: { url: '/Negocios/GetVendedores', dataSrc: '' },
        columns: [
            { data: null, render: function(d, t, r) {
                return '<strong>' + escHtml(r.nombreCompleto) + '</strong>';
            }},
            { data: 'correo', render: d => escHtml(d) },
            { data: 'telefono', render: d => escHtml(d) },
            { data: 'negociosCreados', render: function(d) {
                return '<span class="badge bg-primary">' + d + '</span>';
            }},
            { data: 'fechaCreacion', render: d => d ? new Date(d).toLocaleDateString('es-MX') : '-' },
