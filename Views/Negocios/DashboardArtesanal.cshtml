const tipoMovBadges = { 'venta': 'bg-success', 'devolucion': 'bg-warning text-dark', 'restock': 'bg-info', 'ajuste': 'bg-danger' };
const tipoMovLabels = { 'venta': 'Venta', 'devolucion': 'Devolución', 'restock': 'Restock', 'ajuste': 'Ajuste' };

function cargarProductosGrid() {
    $.get('/Negocios/GetProductos', { negocioId }, function(productos) {
        productosCache = productos;
        var grid = $('#productosGrid');
        grid.empty();

        if (!productos.length) {
            grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-box-seam fs-1 d-block mb-3 opacity-50"></i><p class="fs-5">No hay productos en el inventario</p><p>Haz clic en <strong>"Nuevo Producto"</strong> para agregar el primero</p></div>');
            return;
        }

        productos.forEach(function(p) {
            var stockClass = p.stockBajo ? 'text-danger' : 'text-success';
            var card = '<div class="col-xl-2 col-lg-3 col-md-4 col-6">' +
                '<div class="inv-card" data-id="' + p.productoId + '">' +
                    '<div class="inv-card-actions">' +
                        '<button class="inv-card-action-btn" onclick="editarProducto(\'' + p.productoId + '\')" title="Editar"><i class="bi bi-pencil"></i></button>' +
                        '<button class="inv-card-action-btn inv-card-action-delete" onclick="eliminarProducto(\'' + p.productoId + '\',\'' + escAttr(p.nombre) + '\')" title="Eliminar"><i class="bi bi-trash"></i></button>' +
                    '</div>' +
                    '<div class="inv-card-name">' + escHtml(p.nombre) + '</div>' +
                    '<div class="inv-card-price">$' + p.precioVenta.toFixed(2) + '</div>' +
                    '<div class="inv-card-stock-row">' +
                        '<button class="inv-arrow inv-arrow-up" onclick="accionSubir(\'' + p.productoId + '\',\'' + escAttr(p.nombre) + '\',' + p.precioVenta + ',' + p.stock + ')" title="Devolver o actualizar"><i class="bi bi-caret-up-fill"></i></button>' +
                        '<span class="inv-card-stock ' + stockClass + '" id="stock-' + p.productoId + '">' + p.stock + '</span>' +
                        '<button class="inv-arrow inv-arrow-down' + (p.stock <= 0 ? ' disabled' : '') + '" onclick="venderRapido(\'' + p.productoId + '\')" title="Vender 1 unidad"><i class="bi bi-caret-down-fill"></i></button>' +
                    '</div>' +
                    (p.stockBajo ? '<small class="inv-card-alert"><i class="bi bi-exclamation-triangle-fill me-1"></i>Stock bajo</small>' : '') +
                '</div>' +
            '</div>';
            grid.append(card);
        });
    }).fail(function() {
        toastr.error('Error al cargar productos');
    });
}

function venderRapido(productoId) {
    var stockEl = $('#stock-' + productoId);
    var stockActual = parseInt(stockEl.text());
    if (stockActual <= 0) { toastr.warning('No hay stock disponible'); return; }
    var cardEl = stockEl.closest('.inv-card');
    cardEl.addClass('inv-card-selling');
    stockEl.text(parseInt(stockEl.text()) - 1);
    $.post('/Negocios/VenderProducto', { productoId, negocioId, cantidad: 1 }, function(r) {
        if (r.success) {
            toastr.success(r.message);
            cargarInventarioStats();
            if (tablaMovimientos) tablaMovimientos.ajax.reload();
            if (tablaLogs) tablaLogs.ajax.reload();
            setTimeout(function() { cargarProductosGrid(); }, 300);
        } else { toastr.error(r.message); cargarProductosGrid(); }
    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al vender'); cargarProductosGrid(); })
      .always(function() { setTimeout(function() { cardEl.removeClass('inv-card-selling'); }, 300); });
}

function accionSubir(productoId, nombre, precio, stockActual) {
    swalMG.fire({
        title: escHtml(nombre),
        html: '<p class="text-muted mb-0">Stock actual: <strong>' + stockActual + '</strong> | Precio: <strong>$' + precio.toFixed(2) + '</strong></p>',
        icon: 'question', showCancelButton: true, showDenyButton: true,
        confirmButtonText: '<i class="bi bi-arrow-return-left me-1"></i>Devolver Producto',
        denyButtonText: '<i class="bi bi-pencil-square me-1"></i>Actualizar Inventario',
        confirmButtonColor: '#FFC700', denyButtonColor: '#3E97FF'
    }).then(function(result) {
        if (result.isConfirmed) {
            swalMG.fire({
                title: 'Devolver: ' + escHtml(nombre),
                html: '<div class="text-start"><div class="mb-3"><label class="form-label fw-semibold">Cantidad a devolver</label><input type="number" id="swalDevCant" class="form-control" value="1" min="1"></div><div class="mb-3"><label class="form-label fw-semibold">Razon de la devolucion</label><textarea id="swalDevNota" class="form-control" rows="2" placeholder="Ej: Cliente cambio de opinion"></textarea></div><p class="text-warning small"><i class="bi bi-info-circle me-1"></i>Se reembolsara el dinero al cliente</p></div>',
                showCancelButton: true, confirmButtonText: '<i class="bi bi-check-lg me-1"></i>Confirmar Devolucion', confirmButtonColor: '#FFC700',
                preConfirm: function() {
                    var cant = parseInt(document.getElementById('swalDevCant').value);
                    var nota = document.getElementById('swalDevNota').value.trim();
                    if (!cant || cant <= 0) { Swal.showValidationMessage('Cantidad invalida'); return false; }
                    if (!nota) { Swal.showValidationMessage('La razon es obligatoria'); return false; }
                    return { cantidad: cant, nota: nota };
                }
            }).then(function(res) {
                if (res.isConfirmed) {
                    $.post('/Negocios/DevolverProducto', { productoId, negocioId, cantidad: res.value.cantidad, nota: res.value.nota }, function(r) {
                        if (r.success) { toastr.success(r.message); cargarProductosGrid(); cargarInventarioStats(); if (tablaMovimientos) tablaMovimientos.ajax.reload(); if (tablaLogs) tablaLogs.ajax.reload(); }
                        else { toastr.error(r.message); }
                    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al devolver'); });
                }
            });
        } else if (result.isDenied) {
            swalMG.fire({
                title: 'Actualizar: ' + escHtml(nombre),
                html: '<div class="text-start"><p class="text-muted">Stock en sistema: <strong>' + stockActual + '</strong></p><div class="mb-3"><label class="form-label fw-semibold">Stock real (contado)</label><input type="number" id="swalAjusteStock" class="form-control" min="0" placeholder="¿Cuantos tienes realmente?"></div><div class="mb-3"><label class="form-label fw-semibold">Nota</label><textarea id="swalAjusteNota" class="form-control" rows="2" placeholder="Ej: Reabastecimiento, conteo fisico"></textarea></div><div id="swalAjusteDiff"></div></div>',
                showCancelButton: true, confirmButtonText: '<i class="bi bi-check-lg me-1"></i>Actualizar Stock',
                didOpen: function() {
                    document.getElementById('swalAjusteStock').addEventListener('input', function() {
                        var real = parseInt(this.value), diffDiv = document.getElementById('swalAjusteDiff');
                        if (isNaN(real)) { diffDiv.innerHTML = ''; return; }
                        var diff = real - stockActual;
                        if (diff === 0) diffDiv.innerHTML = '<div class="p-2 rounded bg-light text-center"><span class="text-muted fw-bold">Sin cambio</span></div>';
                        else if (diff > 0) diffDiv.innerHTML = '<div class="p-2 rounded text-center" style="background:#E8FFF3"><span class="text-success fw-bold">+' + diff + ' unidades</span></div>';
                        else diffDiv.innerHTML = '<div class="p-2 rounded text-center" style="background:#FFF5F8"><span class="text-danger fw-bold">' + diff + ' unidades (posible perdida)</span></div>';
                    });
                },
                preConfirm: function() {
                    var stockReal = parseInt(document.getElementById('swalAjusteStock').value);
                    var nota = document.getElementById('swalAjusteNota').value.trim();
                    if (isNaN(stockReal) || stockReal < 0) { Swal.showValidationMessage('Ingrese un stock valido'); return false; }
                    if (!nota) { Swal.showValidationMessage('La nota es obligatoria'); return false; }
                    if (stockReal === stockActual) { Swal.showValidationMessage('El stock es igual, no hay cambio'); return false; }
                    return { stockReal: stockReal, nota: nota };
                }
            }).then(function(res) {
                if (res.isConfirmed) {
                    $.post('/Negocios/AjustarStock', { productoId, negocioId, stockReal: res.value.stockReal, nota: res.value.nota }, function(r) {
                        if (r.success) { toastr.success(r.message); cargarProductosGrid(); cargarInventarioStats(); if (tablaMovimientos) tablaMovimientos.ajax.reload(); if (tablaLogs) tablaLogs.ajax.reload(); }
                        else { toastr.error(r.message); }
                    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al ajustar'); });
                }
            });
        }
    });
}

function cargarTablaMovimientos() {
    if (tablaMovimientos) tablaMovimientos.destroy();
    tablaMovimientos = $('#movimientosTable').DataTable({
        ajax: { url: '/Negocios/GetMovimientos', data: { negocioId }, dataSrc: '' },
        columns: [
            { data: 'fecha', render: function(d, type) { if (type === 'sort') return d; return new Date(d).toLocaleString('es-MX'); } },
            { data: 'nombreProducto', render: d => escHtml(d) },
            { data: 'tipo', render: function(d) { return '<span class="badge ' + (tipoMovBadges[d] || 'bg-secondary') + '">' + (tipoMovLabels[d] || d) + '</span>'; } },
            { data: 'cantidad' },
            { data: 'total', render: d => '$' + d.toFixed(2) },
            { data: null, render: function(d, t, r) { return r.stockAnterior + ' → ' + r.stockNuevo; } },
            { data: 'nota', render: d => d ? '<small>' + escHtml(d) + '</small>' : '<span class="text-muted">-</span>' }
        ],
        order: [[0, 'desc']]
    });
}

$('#btnToggleMovimientos').click(function() {
    var section = $('#movimientosSection');
    if (section.hasClass('d-none')) {
        section.removeClass('d-none');
        $(this).html('<i class="bi bi-clock-history me-2"></i>Ocultar Historial').removeClass('btn-outline-primary').addClass('btn-primary');
        if (!tablaMovimientos) cargarTablaMovimientos();
        else tablaMovimientos.ajax.reload();
    } else {
        section.addClass('d-none');
        $(this).html('<i class="bi bi-clock-history me-2"></i>Historial').removeClass('btn-primary').addClass('btn-outline-primary');
    }
});

$('#btnExportInventarioExcel').click(function() {
    window.location.href = '/Negocios/ExportInventarioExcel?negocioId=' + negocioId;
});

$('#btnCrearProducto').click(function() {
    modoEdicionProducto = false;
    $('#productoModalTitle').text('Nuevo Producto');
    $('#productoForm')[0].reset();
    $('#prodId').val('');
    $('#prodStockMinimo').val(5);
    $('#prodStock').prop('readonly', false);
    $('#prodMargenText').text('');
    $('#productoModal').modal('show');
});

$('#prodPrecioVenta, #prodCostoCompra').on('input', function() {
    var venta = parseFloat($('#prodPrecioVenta').val()) || 0;
    var costo = parseFloat($('#prodCostoCompra').val()) || 0;
    if (venta > 0 && costo > 0) {
        var margen = venta - costo;
        $('#prodMargenText').html('Margen por unidad: <strong class="' + (margen > 0 ? 'text-success' : 'text-danger') + '">$' + margen.toFixed(2) + '</strong>');
    } else { $('#prodMargenText').text(''); }
});

function editarProducto(id) {
    $.get('/Negocios/GetProducto', { id, negocioId }, function(data) {
        modoEdicionProducto = true;
        $('#productoModalTitle').text('Editar Producto');
        $('#prodId').val(data.productoId);
        $('#prodNombre').val(data.nombre);
        $('#prodPrecioVenta').val(data.precioVenta);
        $('#prodCostoCompra').val(data.costoCompra);
        $('#prodStock').val(data.stock).prop('readonly', true);
        $('#prodStockMinimo').val(data.stockMinimo);
        $('#prodPrecioVenta').trigger('input');
        $('#productoModal').modal('show');
    }).fail(() => toastr.error('Error al cargar producto'));
}

$('#btnGuardarProducto').click(function() {
    if (!$('#productoForm')[0].checkValidity()) { $('#productoForm')[0].reportValidity(); return; }
    var url = modoEdicionProducto ? '/Negocios/EditarProducto' : '/Negocios/CrearProducto';
    var btn = $(this);
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');
    $.post(url, $('#productoForm').serialize(), function(r) {
        if (r.success) {
            $('#productoModal').modal('hide');
            cargarProductosGrid();
            cargarInventarioStats();
            if (tablaLogs) tablaLogs.ajax.reload();
            toastr.success(r.message);
        } else { toastr.error(r.message || 'Error al guardar'); }
    }).fail(xhr => toastr.error(xhr.responseJSON?.message || 'Error al guardar producto'))
      .always(() => btn.prop('disabled', false).html(originalHtml));
});

function eliminarProducto(id, nombre) {
    swalMG.fire({
        title: '¿Eliminar producto?', text: 'Se eliminara "' + nombre + '" del inventario.',
        icon: 'warning', showCancelButton: true, confirmButtonColor: '#F1416C', confirmButtonText: 'Si, eliminar'
    }).then(result => {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarProducto', { id, negocioId }, function(r) {
                if (r.success) { cargarProductosGrid(); cargarInventarioStats(); if (tablaLogs) tablaLogs.ajax.reload(); swalMG.fire('Eliminado', r.message, 'success'); }
                else { swalMG.fire('Error', r.message, 'error'); }
            }).fail(xhr => swalMG.fire('Error', xhr.responseJSON?.message || 'Error', 'error'));
        }
    });
}

// ═══════════════ NOTIFICACIONES ═══════════════
function cargarNotificacionesCount() {
    $.get('/Negocios/GetNotificacionesCount', { negocioId }, function(d) {
        var count = d.count || d;
        if (count > 0) { $('#sidebarNotifBadge, #topbarNotifBadge').text(count).removeClass('d-none'); }
        else { $('#sidebarNotifBadge, #topbarNotifBadge').addClass('d-none'); }
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

function cargarNotificacionesTab() {
    $.get('/Negocios/GetNotificaciones', { negocioId }, function(data) {
        var list = $('#notificacionesList');
        list.empty();
        if (!data.length) { list.html('<div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i><p>No hay notificaciones</p></div>'); return; }
        data.forEach(n => {
            list.append(`<div class="mg-card ${n.leida ? 'opacity-50' : ''}"><div class="card-body py-2 d-flex align-items-center gap-3">
                <i class="bi bi-bell${n.leida ? '' : '-fill'} ${n.leida ? 'text-muted' : 'text-warning'}"></i>
                <div class="flex-grow-1"><p class="mb-0 small">${escHtml(n.mensaje)}</p><small class="text-muted">${new Date(n.fechaCreacion).toLocaleDateString('es-MX')}</small></div>
                ${!n.leida ? '<button class="btn btn-sm btn-outline-primary" onclick="marcarLeida(\'' + n.id + '\')"><i class="bi bi-check"></i></button>' : ''}
            </div></div>`);
        });
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

function marcarLeida(id) {
    $.post('/Negocios/MarcarNotificacionLeida', { id, negocioId }, function() { cargarNotificacionesTab(); cargarNotificacionesCount(); }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

$('#btnMarcarTodasLeidasTab').on('click', function() {
    $.post('/Negocios/MarcarTodasNotificacionesLeidas', { negocioId }, function() { cargarNotificacionesTab(); cargarNotificacionesCount(); toastr.success('Todas marcadas como leidas'); }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
});

// ═══════════════ SUGERENCIAS ═══════════════
$('#sugerenciaTexto').on('input', function() { $('#sugerenciaCount').text($(this).val().length); });
$('#btnEnviarSugerencia').on('click', function() {
    var texto = $('#sugerenciaTexto').val();
    if (!texto) { toastr.warning('Escribe una sugerencia'); return; }
    $.post('/Negocios/EnviarSugerencia', { negocioId, mensaje: texto }, function(r) {
        if (r.success) { toastr.success('Sugerencia enviada'); $('#sugerenciaTexto').val(''); $('#sugerenciaCount').text('0'); }
        else toastr.error(r.message);
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
});

// ═══════════════ TAB SWITCHING ═══════════════
document.addEventListener('mg-tab-shown', function(e) {
    var tab = e.detail.tab;
    if (tab === 'agendaTab') { if (calendar) { calendar.refetchEvents(); } cargarAgendaStats(); refreshEmployeeTabsAvailability(); }
    else if (tab === 'clientesTab') { cargarClientesArt(); }
    else if (tab === 'serviciosTab') { cargarServicios(); }
    else if (tab === 'empleadosTab') { cargarEmpleados(); }
    else if (tab === 'logsTab') { if (!tablaLogs) cargarTablaLogs(); }
    else if (tab === 'ventasTab') { cargarVentasStats(); cargarCharts(); }
    else if (tab === 'inventarioTab') { cargarProductosGrid(); cargarInventarioStats(); }
    else if (tab === 'notificacionesTab') { cargarNotificacionesTab(); }
    else if (tab === 'recibosTab') { cargarRecibos(); verificarCleanupRecibos(); }
});

// ═══════════════════════════════════════════════════════════
// RECIBOS
// ═══════════════════════════════════════════════════════════
let tablaRecibos = null;
function cargarRecibos() {
    if (tablaRecibos) { tablaRecibos.ajax.reload(); return; }
    tablaRecibos = $('#tablaRecibos').DataTable({
        ajax: { url: '/Negocios/GetRecibos', data: { negocioId }, dataSrc: '' },
        columns: [
            { data: 'numeroRecibo', render: d => `<span class="badge bg-primary">#${d}</span>` },
            { data: 'destinatarioNombre' },
            { data: 'concepto', render: d => d && d.length > 40 ? d.substring(0,40)+'...' : d },
            { data: 'monto', render: d => `$${parseFloat(d).toFixed(2)}` },
            { data: 'fechaCreacion', render: d => new Date(d).toLocaleDateString('es-EC') },
            { data: null, orderable: false, render: (d,t,r) => `<button class="btn btn-sm btn-outline-primary" onclick="verRecibo('${r.reciboId}')"><i class="bi bi-eye"></i></button>` }
        ],
        order: [[4, 'desc']],
        language: { emptyTable: 'No hay recibos', info: 'Mostrando _START_ a _END_ de _TOTAL_ recibos', infoEmpty: 'Sin recibos', search: 'Buscar:', lengthMenu: 'Mostrar _MENU_ recibos', paginate: { first: 'Primero', last: 'Ultimo', next: 'Sig.', previous: 'Ant.' } },
        responsive: true
    });
}

function verRecibo(reciboId) {
    $.get('/Negocios/GetRecibo', { reciboId, negocioId }, function(r) {
        if (r) {
            $('#reciboModalNumero').text(r.numeroRecibo);
            document.getElementById('reciboIframe').srcdoc = r.contenidoHtml;
            new bootstrap.Modal('#reciboModal').show();
        }
    });
}

$('#buscarReciboInput').on('keypress', function(e) {
    if (e.which === 13) {
        var num = parseInt($(this).val());
        if (!num || num < 1) return;
        $.get('/Negocios/BuscarRecibo', { numero: num, negocioId }, function(r) {
            if (r) {
                $('#reciboModalNumero').text(r.numeroRecibo);
                document.getElementById('reciboIframe').srcdoc = r.contenidoHtml;
                new bootstrap.Modal('#reciboModal').show();
            } else {
                toastr.warning('No se encontro el recibo #' + num);
            }
        });
    }
});

$('#btnExportRecibos').on('click', function() {
    var now = new Date();
    window.location.href = `/Negocios/ExportRecibosExcel?negocioId=${negocioId}&anio=${now.getFullYear()}&mes=${now.getMonth()+1}`;
});

function verificarCleanupRecibos() {
    $.get('/Negocios/GetFechaReciboMasAntiguo', { negocioId }, function(r) {
        if (r.fecha) {
            var dias = Math.floor((new Date() - new Date(r.fecha)) / (1000*60*60*24));
            if (dias > 30) { $('#recibosCleanupBanner').removeClass('d-none'); }
            else { $('#recibosCleanupBanner').addClass('d-none'); }
        }
    });
}

$('#btnExportarYLimpiar').on('click', function() {
    swalMG.fire({
        title: 'Exportar y limpiar recibos',
        text: 'Se exportaran los recibos del mes y se eliminaran los mayores a 30 dias.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Si, exportar y limpiar'
    }).then(result => {
        if (result.isConfirmed) {
            var now = new Date();
            window.location.href = `/Negocios/ExportRecibosExcel?negocioId=${negocioId}&anio=${now.getFullYear()}&mes=${now.getMonth()+1}`;
            var hace30 = new Date();
            hace30.setDate(hace30.getDate() - 30);
            setTimeout(() => {
                $.post('/Negocios/EliminarRecibosAntiguos', { negocioId, anteriorA: hace30.toISOString() }, function(r) {
                    if (r.success) {
                        toastr.success(`${r.eliminados} recibos antiguos eliminados`);
                        if (tablaRecibos) tablaRecibos.ajax.reload();
                        $('#recibosCleanupBanner').addClass('d-none');
                    }
                });
            }, 2000);
        }
    });
});

</script>
}
