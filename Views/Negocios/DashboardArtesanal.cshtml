}
.mg-autocomplete-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    transition: background 0.15s ease;
    border-bottom: 1px solid var(--mg-gray-100);
}
.mg-autocomplete-item:last-child { border-bottom: none; }
.mg-autocomplete-item:hover {
    background: var(--mg-primary-light);
}
.mg-autocomplete-item .autocomplete-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--mg-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 0.8rem;
    color: var(--mg-gray-600);
}
.mg-autocomplete-item .autocomplete-info { flex-grow: 1; line-height: 1.3; }
.mg-autocomplete-item .autocomplete-name { font-weight: 600; font-size: 0.875rem; color: var(--mg-text-color); }
.mg-autocomplete-item .autocomplete-phone { font-size: 0.75rem; color: var(--mg-text-muted); }
.mg-autocomplete-empty {
    padding: 1rem;
    text-align: center;
    color: var(--mg-text-muted);
    font-size: 0.85rem;
}

/* ---- Selected Client Card ---- */
.mg-selected-client {
    background: var(--mg-primary-light);
    border-radius: var(--mg-border-radius);
