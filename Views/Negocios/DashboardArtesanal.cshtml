    border: 1px solid var(--mg-primary);
}

/* ---- Employee Color Coding on Calendar ---- */
.fc-event.mg-emp-event {
    border: none !important;
    border-radius: 4px !important;
    font-size: 0.8rem !important;
}

/* ---- Responsive tweaks ---- */
