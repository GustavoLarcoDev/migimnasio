@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/core@6.1.11/locales/es.global.min.js"></script>
<script>
// SEGURIDAD: Json.Serialize escapa correctamente para contexto JavaScript
const negocioId = @Json.Serialize(negocioId.ToString());
let calendar, tablaLogs, tablaClientesArt, tablaMovimientos;
let serviciosCache = [], empleadosCache = [], clientesCache = [];
var modoEdicionProducto = false;
var productosCache = [];
let empleadosDisponibilidad = [];
let activeEmpTabId = '';
const empColors = ['#3E97FF','#50CD89','#F1416C','#FFC700','#7239EA','#009EF7','#E4E6EF','#181C32'];
let empColorMap = {};

const swalMG = Swal.mixin({ confirmButtonColor: '#3E97FF', cancelButtonColor: '#E4E6EF', cancelButtonText: 'Cancelar', reverseButtons: true });
const diasNombres = ['Domingo','Lunes','Martes','Miercoles','Jueves','Viernes','Sabado'];

function escHtml(str) { if (!str) return ''; return $('<span>').text(str).html(); }
function escAttr(str) { if (!str) return ''; return escHtml(str).replace(/'/g, '&#39;'); }

function getEmpColor(empleadoId) {
    return empColorMap[empleadoId] || '#3E97FF';
}

function buildEmpColorMap(empleados) {
    empColorMap = {};
    empleados.forEach(function(e, i) {
        empColorMap[e.empleadoId] = empColors[i % empColors.length];
    });
}

// ═══════════════ INIT ═══════════════
$(document).ready(function() {
    cargarEmpleadosTabs(function() {
        initCalendario();
    });
    cargarAgendaStats();
    verificarSuscripcion();
    cargarNotificacionesCount();
});

function verificarSuscripcion() {
    $.get('/Negocios/GetSuscripcionStatus', { negocioId }, function(d) {
        var t = document.getElementById('trialDaysText');
        if (t && d.diasRestantes !== null) {
            if (d.porEmpezar) t.innerHTML = '- <span class="badge bg-secondary">Por empezar</span>';
            else if (d.diasRestantes <= 0) t.innerHTML = '<span class="badge bg-danger">Expirado</span>';
            else t.innerHTML = '- Te quedan <strong>' + d.diasRestantes + ' dias</strong>';
        }
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

// ═══════════════ EMPLOYEE TABS ═══════════════
function cargarEmpleadosTabs(callback) {
    $.get('/Negocios/GetEmpleados', { negocioId }, function(data) {
        empleadosCache = data;
        buildEmpColorMap(data);
        refreshEmployeeTabsAvailability(callback);
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

function refreshEmployeeTabsAvailability(callback) {
    var fecha = calendar ? calendar.getDate().toISOString().split('T')[0] : new Date().toISOString().split('T')[0];
    $.get('/Negocios/GetEmpleadosConDisponibilidad', { negocioId, fecha: fecha }, function(data) {
        empleadosDisponibilidad = data;
        renderEmployeeTabs(data);
        if (typeof callback === 'function') callback();
    }).fail(function() {
        // Fallback: build tabs from cache without availability info
        var fallbackData = empleadosCache.map(function(e) {
            return { empleadoId: e.empleadoId, nombre: e.nombre, apellido: e.apellido, nombreCompleto: e.nombreCompleto, especialidad: e.especialidad, trabaja: true, citasHoy: 0 };
        });
        empleadosDisponibilidad = fallbackData;
        renderEmployeeTabs(fallbackData);
        if (typeof callback === 'function') callback();
    });
}

function renderEmployeeTabs(empleados) {
    var tabsUl = $('#employeeTabs');
    // Keep "Todos" tab, remove the rest
    tabsUl.find('li:not(:first)').remove();

    empleados.forEach(function(e, i) {
        var color = getEmpColor(e.empleadoId);
        var disabled = !e.trabaja;
        var badgeText = e.citasHoy || 0;
        var tooltipAttr = disabled ? 'title="No trabaja hoy" data-bs-toggle="tooltip"' : '';
        var disabledCls = disabled ? ' disabled' : '';
        var activeCls = (activeEmpTabId === e.empleadoId) ? ' active' : '';

        var specialtyHtml = e.especialidad ? '<span class="mg-emp-tab-specialty">' + escHtml(e.especialidad) + '</span>' : '';

        var tabHtml = '<li class="nav-item" role="presentation">' +
            '<button class="nav-link mg-emp-tab' + disabledCls + activeCls + '" ' +
            'id="empTab-' + e.empleadoId + '" data-emp-id="' + e.empleadoId + '" ' +
            'type="button" role="tab" ' + tooltipAttr + '>' +
            '<span class="mg-emp-color-dot" style="background:' + color + '"></span>' +
            '<div class="text-start">' +
            '<span class="mg-emp-tab-name">' + escHtml(e.nombreCompleto) + '</span>' +
            specialtyHtml +
            '</div>' +
            '<span class="badge bg-light text-dark">' + badgeText + '</span>' +
            '</button></li>';
        tabsUl.append(tabHtml);
    });

    // Re-check active state
    if (activeEmpTabId) {
        var activeBtn = tabsUl.find('[data-emp-id="' + activeEmpTabId + '"]');
        if (activeBtn.length && !activeBtn.hasClass('disabled')) {
            tabsUl.find('.mg-emp-tab').removeClass('active');
            activeBtn.addClass('active');
        } else {
            // Fallback to Todos
            activeEmpTabId = '';
            tabsUl.find('.mg-emp-tab').removeClass('active');
            $('#empTab-todos').addClass('active');
        }
    }

    // Init Bootstrap tooltips
    tabsUl.find('[data-bs-toggle="tooltip"]').each(function() {
        new bootstrap.Tooltip(this);
    });
}

// Employee tab click
$(document).on('click', '.mg-emp-tab', function(e) {
    e.preventDefault();
    if ($(this).hasClass('disabled')) return;

    $('.mg-emp-tab').removeClass('active');
    $(this).addClass('active');
    activeEmpTabId = $(this).data('emp-id') || '';

    // Refetch calendar events with new filter
    if (calendar) calendar.refetchEvents();
});

// ═══════════════ CALENDARIO ═══════════════
function initCalendario() {
    var calEl = document.getElementById('calendario-citas');
    calendar = new FullCalendar.Calendar(calEl, {
        locale: 'es',
        initialView: window.innerWidth < 576 ? 'timeGridDay' : 'timeGridWeek',
        headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
        slotMinTime: '07:00:00',
        slotMaxTime: '22:00:00',
        slotDuration: window.innerWidth < 576 ? '00:30:00' : '00:15:00',
        allDaySlot: false,
        editable: window.innerWidth >= 576,
        selectable: true,
        nowIndicator: true,
        height: window.innerWidth < 576 ? 'auto' : 'auto',
        scrollTime: new Date().getHours().toString().padStart(2, '0') + ':00:00',
        events: function(info, successCallback, failureCallback) {
            $.get('/Negocios/GetCitasCalendario', {
                negocioId, start: info.startStr, end: info.endStr
            }, function(data) {
                // Apply employee color coding
                data.forEach(function(ev) {
                    var eid = ev.extendedProps ? ev.extendedProps.empleadoId : null;
                    if (eid && empColorMap[eid]) {
                        ev.backgroundColor = empColorMap[eid];
                        ev.borderColor = empColorMap[eid];
                    }
                    ev.classNames = ['mg-emp-event'];
                });

                // Filter by active employee tab
                if (activeEmpTabId) {
                    data = data.filter(function(ev) {
                        return ev.extendedProps && ev.extendedProps.empleadoId === activeEmpTabId;
                    });
                }
                successCallback(data);
            }).fail(failureCallback);
        },
        eventClick: function(info) {
            abrirDetalleCita(info.event.extendedProps.citaId);
        },
        eventDrop: function(info) {
            $.post('/Negocios/MoverCita', {
                CitaId: info.event.extendedProps.citaId,
                NegocioId: negocioId,
                NuevaFechaHoraInicio: info.event.start.toISOString()
            }, function(r) {
                if (r.success) { toastr.success(r.message); cargarAgendaStats(); refreshEmployeeTabsAvailability(); }
                else { toastr.error(r.message); info.revert(); }
            }).fail(function() { toastr.error('Error al mover cita'); info.revert(); });
        },
        select: function(info) {
            abrirModalCitaRapida(info.start, activeEmpTabId);
            calendar.unselect();
        },
        datesSet: function(info) {
            // When calendar navigates to a new date range, refresh tab availability
            refreshEmployeeTabsAvailability();
        }
    });
    calendar.render();

    // Set pill active state to match initial view
    var initialView = window.innerWidth < 576 ? 'timeGridDay' : 'timeGridWeek';
    $('.mg-pill[data-vista]').removeClass('active');
    $('.mg-pill[data-vista="' + initialView + '"]').addClass('active');
}

$('.mg-pill[data-vista]').on('click', function() {
    $('.mg-pill[data-vista]').removeClass('active');
    $(this).addClass('active');
    calendar.changeView($(this).data('vista'));
});

function cargarAgendaStats() {
    $.get('/Negocios/GetCitasDashboardStats', { negocioId }, function(d) {
        $('#statCitasHoy').text(d.citasHoy);
        $('#statIngresosHoy').text('$' + (d.ingresosHoy || 0).toFixed(2));
        $('#statCompletadas').text(d.completadas);
        $('#statCanceladas').text(d.canceladas);
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

// ═══════════════ CREAR CITA RAPIDA ═══════════════
function abrirModalCitaRapida(fechaHora, empleadoId) {
    var form = $('#citaRapidaForm')[0];
    form.reset();
    $('#crClienteId').val('');
    $('#crFechaHoraInicio').val('');
    $('#crResumen').addClass('d-none');
    $('#crSelectedClient').addClass('d-none');
    $('#crClienteSearch').val('');
    $('#crClienteResults').addClass('d-none').empty();

    // Reset client mode to search
    switchClientMode('search');

    // Pre-fill fecha
    if (fechaHora) {
        var dateStr = fechaHora.toISOString().split('T')[0];
        $('#crFecha').val(dateStr);
    }

    // Handle employee pre-selection
    if (empleadoId) {
        $('#crEmpleadoId').val(empleadoId);
        $('#crEmpleadoGroup').addClass('d-none');
        var emp = empleadosDisponibilidad.find(function(e) { return e.empleadoId === empleadoId; });
        if (emp) {
            $('#citaRapidaSubtitle').text(emp.nombreCompleto + (emp.especialidad ? ' - ' + emp.especialidad : ''));
        }
    } else {
        $('#crEmpleadoId').val('');
        $('#crEmpleadoGroup').removeClass('d-none');
        $('#citaRapidaSubtitle').text('');
        // Populate employee dropdown for the appointment date
        actualizarEmpleadosParaFecha($('#crFecha').val());
    }

    // Load services
    $.get('/Negocios/GetServicios', { negocioId }, function(data) {
        serviciosCache = data;
        var sel = $('#crServicio');
        sel.find('option:not(:first)').remove();
        data.forEach(function(s) {
            sel.append('<option value="' + s.servicioId + '" data-duracion="' + s.duracionMinutos + '" data-precio="' + s.precio + '">' + escHtml(s.nombre) + ' - $' + s.precio.toFixed(2) + ' (' + s.duracionMinutos + 'min)</option>');
        });
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });

    // Load slots if we have enough info
    cargarSlotsRapida();

    new bootstrap.Modal('#citaRapidaModal').show();
}

$('#btnNuevaCita').on('click', function() {
    var preDate = new Date();
    abrirModalCitaRapida(preDate, activeEmpTabId || '');
});

// Employee dropdown change in modal
$('#crEmpleadoSelect').on('change', function() {
    $('#crEmpleadoId').val($(this).val());
    cargarSlotsRapida();
});

// Client mode switching
function switchClientMode(mode) {
    if (mode === 'search') {
        $('#crClienteSearchMode').removeClass('d-none');
        $('#crClienteCreateMode').addClass('d-none');
        $('#crModoSearchBtn').removeClass('btn-outline-primary').addClass('btn-primary');
        $('#crModoCreateBtn').removeClass('btn-primary').addClass('btn-outline-primary');
        // Clear create fields
        $('#crNombre, #crApellido, #crTelefono, #crEmail').val('');
    } else {
        $('#crClienteSearchMode').addClass('d-none');
        $('#crClienteCreateMode').removeClass('d-none');
        $('#crModoCreateBtn').removeClass('btn-outline-primary').addClass('btn-primary');
        $('#crModoSearchBtn').removeClass('btn-primary').addClass('btn-outline-primary');
        // Clear search state
        $('#crClienteId').val('');
        $('#crClienteSearch').val('');
        $('#crClienteResults').addClass('d-none').empty();
        $('#crSelectedClient').addClass('d-none');
    }
    updateResumenRapida();
}

$('#crModoSearchBtn').on('click', function() { switchClientMode('search'); });
$('#crModoCreateBtn').on('click', function() { switchClientMode('create'); });

// Client search with debounce
var searchTimeout = null;
$('#crClienteSearch').on('input', function() {
    var q = $(this).val().trim();
    if (searchTimeout) clearTimeout(searchTimeout);
    if (q.length < 2) {
        $('#crClienteResults').addClass('d-none').empty();
        return;
    }
    searchTimeout = setTimeout(function() {
        $.get('/Negocios/BuscarClientes', { negocioId, q: q }, function(data) {
            var container = $('#crClienteResults');
            container.empty();
            if (!data || !data.length) {
                container.html('<div class="mg-autocomplete-empty"><i class="bi bi-search me-1"></i>No se encontraron clientes</div>');
            } else {
                data.forEach(function(c) {
                    var initials = ((c.nombre || '').charAt(0) + (c.apellido || '').charAt(0)).toUpperCase();
                    container.append(
                        '<div class="mg-autocomplete-item" data-id="' + c.clienteId + '" data-nombre="' + escAttr(c.nombreCompleto) + '" data-telefono="' + escAttr(c.telefono || '') + '" data-email="' + escAttr(c.email || '') + '">' +
                        '<div class="autocomplete-avatar">' + escHtml(initials) + '</div>' +
                        '<div class="autocomplete-info">' +
                        '<div class="autocomplete-name">' + escHtml(c.nombreCompleto) + '</div>' +
                        '<div class="autocomplete-phone">' + escHtml(c.telefono || 'Sin telefono') + '</div>' +
                        '</div></div>'
                    );
                });
            }
            container.removeClass('d-none');
        }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
    }, 300);
});

// Select client from autocomplete
$(document).on('click', '.mg-autocomplete-item', function() {
    var id = $(this).data('id');
    var nombre = $(this).data('nombre');
    var telefono = $(this).data('telefono');

    $('#crClienteId').val(id);
    $('#crSelectedName').text(nombre);
    $('#crSelectedPhone').text(telefono || 'Sin telefono');
    $('#crSelectedClient').removeClass('d-none');
    $('#crClienteSearch').val('');
    $('#crClienteResults').addClass('d-none').empty();
    updateResumenRapida();
});

// Clear selected client
$('#crClearClient').on('click', function() {
    $('#crClienteId').val('');
    $('#crSelectedClient').addClass('d-none');
    $('#crClienteSearch').val('').focus();
    updateResumenRapida();
});

// Hide autocomplete on click outside
$(document).on('mousedown', function(e) {
    if (!$(e.target).closest('#crClienteSearch, #crClienteResults').length) {
        $('#crClienteResults').addClass('d-none');
    }
});

// Slots loading
function cargarSlotsRapida() {
    var empId = $('#crEmpleadoId').val();
    var fecha = $('#crFecha').val();
    var serv = $('#crServicio option:selected');
    var dur = serv.data('duracion') || 30;

    if (!empId || !fecha) {
        $('#crSlotsContainer').html('<p class="text-muted">Selecciona empleado, servicio y fecha para ver horarios</p>');
        return;
    }

    $.get('/Negocios/GetSlotsDisponibles', { negocioId, empleadoId: empId, fecha: fecha, duracionMinutos: dur }, function(d) {
        var container = $('#crSlotsContainer');
        container.empty();
        if (d.mensaje) { container.html('<p class="text-warning">' + escHtml(d.mensaje) + '</p>'); return; }
        if (!d.slots || d.slots.length === 0) { container.html('<p class="text-muted">No hay horarios disponibles</p>'); return; }
        d.slots.forEach(function(s) {
            container.append('<button type="button" class="mg-slot-btn" data-inicio="' + s.inicio + '">' + escHtml(s.hora) + '</button>');
        });
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

$('#crServicio').on('change', cargarSlotsRapida);
$('#crFecha').on('change', function() {
    // Recargar empleados disponibles para la nueva fecha
    if (!$('#crEmpleadoGroup').hasClass('d-none')) {
        actualizarEmpleadosParaFecha($(this).val());
    }
    cargarSlotsRapida();
});

function actualizarEmpleadosParaFecha(fecha) {
    if (!fecha) fecha = new Date().toISOString().split('T')[0];
    var sel = $('#crEmpleadoSelect');
    var prevVal = sel.val();
    sel.find('option:not(:first)').remove();
    $.get('/Negocios/GetEmpleadosConDisponibilidad', { negocioId, fecha: fecha }, function(data) {
        data.forEach(function(e) {
            if (e.trabaja) {
                sel.append('<option value="' + e.empleadoId + '">' + escHtml(e.nombreCompleto) + '</option>');
            }
        });
        // Restore selection if still available
        if (prevVal && sel.find('option[value="' + prevVal + '"]').length) {
            sel.val(prevVal);
        } else {
            sel.val('');
            $('#crEmpleadoId').val('');
        }
    });
}

// Slot selection
$(document).on('click', '#crSlotsContainer .mg-slot-btn', function() {
    $('#crSlotsContainer .mg-slot-btn').removeClass('active');
    $(this).addClass('active');
    $('#crFechaHoraInicio').val($(this).data('inicio'));
    updateResumenRapida();
});

function updateResumenRapida() {
    var servText = $('#crServicio option:selected').text();
    var empName = '';
    if ($('#crEmpleadoId').val()) {
        if ($('#crEmpleadoGroup').hasClass('d-none')) {
            empName = $('#citaRapidaSubtitle').text().split(' - ')[0];
        } else {
            empName = $('#crEmpleadoSelect option:selected').text();
        }
    }
    var clientName = '';
    if ($('#crClienteId').val()) {
        clientName = $('#crSelectedName').text();
    } else if (!$('#crClienteCreateMode').hasClass('d-none')) {
        var n = $('#crNombre').val(), a = $('#crApellido').val();
        if (n || a) clientName = ((n || '') + ' ' + (a || '')).trim() + ' (nuevo)';
    }
    var slotText = $('#crSlotsContainer .mg-slot-btn.active').text();

    if (servText && servText !== 'Seleccionar servicio...' && (empName || clientName || slotText)) {
        var html = '<strong>' + escHtml(servText) + '</strong>';
        if (empName) html += ' con ' + escHtml(empName);
        if (clientName) html += ' para ' + escHtml(clientName);
        if (slotText) html += ' a las <strong>' + escHtml(slotText) + '</strong>';
        $('#crResumen').removeClass('d-none').html(html);
    } else {
        $('#crResumen').addClass('d-none');
    }
}

// Update resumen when typing in create fields
$('#crNombre, #crApellido').on('input', updateResumenRapida);

// Submit cita rapida
$('#btnGuardarCitaRapida').on('click', function() {
    var empId = $('#crEmpleadoId').val();
    var servId = $('#crServicio').val();
    var fechaHora = $('#crFechaHoraInicio').val();
    var clienteId = $('#crClienteId').val();
    var isCreateMode = !$('#crClienteCreateMode').hasClass('d-none');

    if (!empId) { toastr.warning('Selecciona un empleado'); return; }
    if (!servId) { toastr.warning('Selecciona un servicio'); return; }
    if (!fechaHora) { toastr.warning('Selecciona un horario'); return; }

    if (!isCreateMode && !clienteId) {
        toastr.warning('Busca y selecciona un cliente, o cambia a modo "Crear nuevo"');
        return;
    }
    if (isCreateMode) {
        var nombre = $('#crNombre').val().trim();
        var telefono = $('#crTelefono').val().trim();
        if (!nombre) { toastr.warning('El nombre del cliente es obligatorio'); return; }
        if (!telefono) { toastr.warning('El telefono del cliente es obligatorio'); return; }
    }

    var btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Agendando...');

    $.post('/Negocios/CrearCitaRapida', $('#citaRapidaForm').serialize(), function(r) {
        btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Agendar Cita');
        if (r.success) {
            toastr.success(r.message);
            bootstrap.Modal.getInstance('#citaRapidaModal').hide();
            calendar.refetchEvents();
            cargarAgendaStats();
            refreshEmployeeTabsAvailability();
        } else {
            toastr.error(r.message);
        }
    }).fail(function(xhr) {
        btn.prop('disabled', false).html('<i class="bi bi-save me-2"></i>Agendar Cita');
        toastr.error(xhr.responseJSON?.message || 'Error al crear cita');
    });
});

// ═══════════════ DETALLE CITA ═══════════════
function abrirDetalleCita(citaId) {
    $.get('/Negocios/GetCita', { citaId, negocioId }, function(d) {
        // SEGURIDAD: Escapar d.estado y d.pago.metodoPago para prevenir XSS
        var estadoSafe = escHtml(d.estado);
        var body = `
            <div class="mb-3"><span class="mg-estado-badge mg-estado-${estadoSafe}">${estadoSafe.replace('_',' ')}</span></div>
            <p><strong>Servicio:</strong> ${escHtml(d.nombreServicio)}</p>
            <p><strong>Cliente:</strong> ${escHtml(d.nombreCliente)}</p>
            <p><strong>Empleado:</strong> ${escHtml(d.nombreEmpleado)}</p>
            <p><strong>Fecha:</strong> ${new Date(d.fechaHoraInicio).toLocaleDateString('es-MX')} ${new Date(d.fechaHoraInicio).toLocaleTimeString('es-MX', {hour:'2-digit',minute:'2-digit'})} - ${new Date(d.fechaHoraFin).toLocaleTimeString('es-MX', {hour:'2-digit',minute:'2-digit'})}</p>
            <p><strong>Precio:</strong> $${d.precioServicio.toFixed(2)}</p>`;
        if (d.motivoCancelacion) body += `<p class="text-danger"><strong>Motivo cancelacion:</strong> ${escHtml(d.motivoCancelacion)}</p>`;
        if (d.tienePago && d.pago) {
            body += `<hr><h6 class="fw-bold">Pago</h6><p>Total: <strong>$${d.pago.total.toFixed(2)}</strong> (${escHtml(d.pago.metodoPago)})</p>`;
            if (d.pago.esRegalo) body += `<p class="text-info">Regalo: ${escHtml(d.pago.motivoRegalo)}</p>`;
        }
        $('#citaDetalleBody').html(body);

        // Botones de accion segun estado
        var footer = '';
        if (d.estado === 'pendiente') {
            footer = `<button class="btn btn-primary btn-sm" onclick="cambiarEstado('${d.citaId}','confirmada')"><i class="bi bi-check me-1"></i>Confirmar</button>`;
            footer += `<button class="btn btn-danger btn-sm" onclick="abrirCancelar('${d.citaId}')"><i class="bi bi-x me-1"></i>Cancelar</button>`;
        } else if (d.estado === 'confirmada') {
            footer += `<button class="btn btn-info btn-sm text-white" onclick="cambiarEstado('${d.citaId}','en_progreso')"><i class="bi bi-play me-1"></i>En Progreso</button>`;
            footer += `<button class="btn btn-danger btn-sm" onclick="abrirCancelar('${d.citaId}')"><i class="bi bi-x me-1"></i>Cancelar</button>`;
        } else if (d.estado === 'en_progreso') {
            footer += `<button class="btn btn-success btn-sm" onclick="completarCita('${d.citaId}', ${d.precioServicio})"><i class="bi bi-check-all me-1"></i>Completar</button>`;
        }
        if (footer === '') footer = '<button class="btn btn-light btn-sm" data-bs-dismiss="modal">Cerrar</button>';
        $('#citaDetalleFooter').html(footer);
        new bootstrap.Modal('#citaDetalleModal').show();
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

function cambiarEstado(citaId, nuevoEstado) {
    $.post('/Negocios/CambiarEstadoCita', { citaId, negocioId, nuevoEstado }, function(r) {
        if (r.success) {
            toastr.success(r.message);
            bootstrap.Modal.getInstance('#citaDetalleModal').hide();
            calendar.refetchEvents(); cargarAgendaStats(); refreshEmployeeTabsAvailability();
        } else toastr.error(r.message);
    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error'); });
}

function completarCita(citaId, precioServicio) {
    cambiarEstado(citaId, 'completada');
    setTimeout(function() {
        bootstrap.Modal.getInstance('#citaDetalleModal')?.hide();
        $('#pagoCitaId').val(citaId);
        $('#pagoMonto').val('$' + precioServicio.toFixed(2));
        $('#pagoExtra').val(0); $('#pagoPropina').val(0);
        $('#pagoEsRegalo').prop('checked', false);
        $('#pagoRegaloGroup, #pagoDetalleExtraGroup').addClass('d-none');
        actualizarTotalPago(precioServicio);
        new bootstrap.Modal('#pagoModal').show();
    }, 500);
}

function abrirCancelar(citaId) {
    bootstrap.Modal.getInstance('#citaDetalleModal')?.hide();
    $('#cancelarCitaId').val(citaId);
    $('#cancelarMotivo').val('');
    new bootstrap.Modal('#cancelarCitaModal').show();
}

$('#btnConfirmarCancelar').on('click', function() {
    var citaId = $('#cancelarCitaId').val(), motivo = $('#cancelarMotivo').val();
    if (!motivo) { toastr.warning('El motivo es obligatorio'); return; }
    $.post('/Negocios/CambiarEstadoCita', { citaId, negocioId, nuevoEstado: 'cancelada', motivoCancelacion: motivo }, function(r) {
        if (r.success) { toastr.success('Cita cancelada'); bootstrap.Modal.getInstance('#cancelarCitaModal').hide(); calendar.refetchEvents(); cargarAgendaStats(); refreshEmployeeTabsAvailability(); }
        else toastr.error(r.message);
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
});

// ═══════════════ PAGO ═══════════════
function actualizarTotalPago(base) {
    var extra = parseFloat($('#pagoExtra').val()) || 0;
    var propina = parseFloat($('#pagoPropina').val()) || 0;
    var esRegalo = $('#pagoEsRegalo').is(':checked');
    var total = esRegalo ? 0 : (base + extra + propina);
    $('#pagoTotal').text('$' + total.toFixed(2));
}

$('#pagoExtra, #pagoPropina').on('input', function() {
    var base = parseFloat($('#pagoMonto').val().replace('$','')) || 0;
    actualizarTotalPago(base);
});
$('#pagoExtra').on('input', function() {
    $('#pagoDetalleExtraGroup').toggleClass('d-none', parseFloat($(this).val()) <= 0);
});
$('#pagoEsRegalo').on('change', function() {
    var checked = $(this).is(':checked');
    $('#pagoRegaloGroup').toggleClass('d-none', !checked);
    $('#pagoMetodo').prop('disabled', checked);
    var base = parseFloat($('#pagoMonto').val().replace('$','')) || 0;
    actualizarTotalPago(base);
});

$('#btnConfirmarPago').on('click', function() {
    if ($('#pagoEsRegalo').is(':checked') && !$('#pagoMotivoRegalo').val()) { toastr.warning('El motivo del regalo es obligatorio'); return; }
    $.post('/Negocios/RegistrarPagoCita', $('#pagoForm').serialize(), function(r) {
        if (r.success) { toastr.success(r.message); bootstrap.Modal.getInstance('#pagoModal').hide(); calendar.refetchEvents(); cargarAgendaStats(); if (tablaRecibos) tablaRecibos.ajax.reload(); }
        else toastr.error(r.message);
    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al registrar pago'); });
});

// ═══════════════ SERVICIOS ═══════════════
function cargarServicios() {
    $.get('/Negocios/GetServicios', { negocioId }, function(data) {
        serviciosCache = data;
        var grid = $('#serviciosGrid');
        grid.empty();
        if (!data.length) { grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-scissors fs-1 d-block mb-2"></i>No hay servicios. Crea el primero.</div>'); return; }
        data.forEach(s => {
            var items = s.itemsIncluidos ? s.itemsIncluidos.split('|').map(i => `<span class="badge bg-light-primary text-primary">${escHtml(i.trim())}</span>`).join('') : '';
            grid.append(`<div class="col-xl-4 col-md-6"><div class="mg-service-card">
                <div class="d-flex justify-content-between align-items-start mb-2"><h6 class="fw-bold mb-0">${escHtml(s.nombre)}</h6><div class="dropdown"><button class="btn btn-sm btn-light" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu"><li><a class="dropdown-item" href="#" onclick="editarServicio('${s.servicioId}')"><i class="bi bi-pencil me-2"></i>Editar</a></li><li><a class="dropdown-item text-danger" href="#" onclick="eliminarServicio('${s.servicioId}','${escAttr(s.nombre)}')"><i class="bi bi-trash me-2"></i>Eliminar</a></li></ul></div></div>
                ${s.descripcion ? '<p class="text-muted small mb-2">' + escHtml(s.descripcion) + '</p>' : ''}
                <div class="d-flex justify-content-between align-items-center"><span class="mg-price">$${s.precio.toFixed(2)}</span><span class="mg-duration"><i class="bi bi-clock me-1"></i>${s.duracionMinutos} min</span></div>
                ${items ? '<div class="mg-items mt-2">' + items + '</div>' : ''}
                ${s.esCombo ? '<span class="badge bg-info mt-2">Combo</span>' : ''}
            </div></div>`);
        });
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

$('#btnNuevoServicio').on('click', function() { $('#servicioForm')[0].reset(); $('#servId').val(''); $('#servicioModalTitle').text('Nuevo Servicio'); new bootstrap.Modal('#servicioModal').show(); });

function editarServicio(id) {
    $.get('/Negocios/GetServicio', { servicioId: id, negocioId }, function(s) {
        $('#servId').val(s.servicioId); $('#servNombre').val(s.nombre); $('#servDescripcion').val(s.descripcion);
        $('#servPrecio').val(s.precio); $('#servDuracion').val(s.duracionMinutos); $('#servItems').val(s.itemsIncluidos);
        $('#servEsCombo').prop('checked', s.esCombo); $('#servicioModalTitle').text('Editar Servicio');
        new bootstrap.Modal('#servicioModal').show();
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

$('#btnGuardarServicio').on('click', function() {
    var url = $('#servId').val() ? '/Negocios/EditarServicio' : '/Negocios/CrearServicio';
    $.post(url, $('#servicioForm').serialize(), function(r) {
        if (r.success) { toastr.success(r.message); bootstrap.Modal.getInstance('#servicioModal').hide(); cargarServicios(); }
        else toastr.error(r.message);
    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error'); });
});

function eliminarServicio(id, nombre) {
    swalMG.fire({ title: 'Eliminar servicio', text: 'Se eliminara "' + nombre + '"', icon: 'warning', showCancelButton: true, confirmButtonText: 'Eliminar', confirmButtonColor: '#F1416C' }).then(r => {
        if (r.isConfirmed) $.post('/Negocios/EliminarServicio', { servicioId: id, negocioId }, function(r) { if (r.success) { toastr.success(r.message); cargarServicios(); } else toastr.error(r.message); }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
    });
}

// ═══════════════ EMPLEADOS ═══════════════
function cargarEmpleados() {
    $.get('/Negocios/GetEmpleados', { negocioId }, function(data) {
        empleadosCache = data;
        buildEmpColorMap(data);
        var grid = $('#empleadosGrid');
        grid.empty();
