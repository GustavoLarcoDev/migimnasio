@section Styles {
<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
<style>
/* ---- Employee Tabs ---- */
.mg-emp-tabs-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
}
.mg-emp-tabs-wrapper::-webkit-scrollbar { height: 4px; }
.mg-emp-tabs-wrapper::-webkit-scrollbar-thumb { background: var(--mg-gray-300); border-radius: 4px; }

.mg-emp-tabs {
    border-bottom: 2px solid var(--mg-gray-200);
    flex-wrap: nowrap;
    min-width: max-content;
    gap: 2px;
}

.mg-emp-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: none !important;
    border-bottom: 3px solid transparent !important;
    background: transparent;
    color: var(--mg-gray-600);
    font-weight: 600;
    font-size: 0.85rem;
    border-radius: 0.5rem 0.5rem 0 0;
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: pointer;
}
.mg-emp-tab:hover:not(.disabled) {
    color: var(--mg-gray-800);
    background: var(--mg-gray-100);
}
.mg-emp-tab.active {
    color: var(--mg-primary) !important;
    border-bottom-color: var(--mg-primary) !important;
    background: var(--mg-primary-light);
}
.mg-emp-tab.disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: auto;
}
.mg-emp-tab .mg-emp-tab-name {
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
}
.mg-emp-tab .mg-emp-tab-specialty {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--mg-gray-500);
    display: block;
    line-height: 1;
}
.mg-emp-tab .mg-emp-color-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
}
.mg-emp-tab .badge {
    font-size: 0.65rem;
    padding: 0.2em 0.5em;
    min-width: 18px;
}

/* ---- Client Search Autocomplete ---- */
.mg-autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 1055;
    background: var(--mg-card-bg);
    border: 1px solid var(--mg-border-color);
    border-radius: 0 0 var(--mg-border-radius) var(--mg-border-radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
