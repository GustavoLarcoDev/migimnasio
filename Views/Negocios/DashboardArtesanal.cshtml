let chartBarVentas, chartResumen;

function cargarVentasStats() {
    $.get('/Negocios/GetLogs', { negocioId }, function(logs) {
        var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo');
        var now = new Date(), filtered;
        if (periodo === 'dia') { filtered = logs.filter(l => new Date(l.fecha).toDateString() === now.toDateString()); }
        else if (periodo === 'semana') { var w = new Date(now); w.setDate(w.getDate() - 7); filtered = logs.filter(l => new Date(l.fecha) >= w); }
        else { filtered = logs.filter(l => new Date(l.fecha).getMonth() === now.getMonth() && new Date(l.fecha).getFullYear() === now.getFullYear()); }

        var ingresos = filtered.filter(l => l.monto > 0).reduce((s,l) => s + l.monto, 0);
        var gastos = Math.abs(filtered.filter(l => l.monto < 0).reduce((s,l) => s + l.monto, 0));
        $('#ventasIngresos').text('$' + ingresos.toFixed(2));
        $('#ventasGastos').text('$' + gastos.toFixed(2));
        $('#ventasGanancia').text('$' + (ingresos - gastos).toFixed(2));

        var labels = {dia:'del Dia', semana:'de la Semana', mes:'del Mes'};
        $('#ventasIngresosLabel').text('Ingresos ' + labels[periodo]);
        $('#ventasGastosLabel').text('Gastos ' + labels[periodo]);
        $('#ventasGananciaLabel').text('Ganancia ' + labels[periodo]);
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

function cargarCharts() {
    $.get('/Negocios/GetLogs', { negocioId }, function(logs) {
        // Bar chart — últimos 6 meses
        var meses = [], ingArr = [], gasArr = [];
        for (var i = 5; i >= 0; i--) {
            var d = new Date(); d.setMonth(d.getMonth() - i);
            var m = d.toLocaleDateString('es-MX', {month:'short'}); meses.push(m);
            var ml = logs.filter(l => { var ld = new Date(l.fecha); return ld.getMonth() === d.getMonth() && ld.getFullYear() === d.getFullYear(); });
            ingArr.push(ml.filter(l => l.monto > 0).reduce((s,l) => s + l.monto, 0));
            gasArr.push(Math.abs(ml.filter(l => l.monto < 0).reduce((s,l) => s + l.monto, 0)));
        }
        if (chartBarVentas) chartBarVentas.destroy();
        chartBarVentas = new ApexCharts(document.querySelector('#chartBarVentas'), {
            chart: { type: 'bar', height: 300 }, series: [{ name: 'Ingresos', data: ingArr },{ name: 'Gastos', data: gasArr }],
            xaxis: { categories: meses }, colors: ['#50CD89','#F1416C'], plotOptions: { bar: { borderRadius: 4 } }
        });
        chartBarVentas.render();

        // Donut — sincronizado con el periodo seleccionado
        actualizarDonut(logs);
    }).fail(function() { toastr.error('Error de conexión. Intente de nuevo.'); });
}

function actualizarDonut(logs) {
    var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo');
    var now = new Date(), filtered;
    if (periodo === 'dia') { filtered = logs.filter(l => new Date(l.fecha).toDateString() === now.toDateString()); }
    else if (periodo === 'semana') { var w = new Date(now); w.setDate(w.getDate() - 7); filtered = logs.filter(l => new Date(l.fecha) >= w); }
    else { filtered = logs.filter(l => new Date(l.fecha).getMonth() === now.getMonth() && new Date(l.fecha).getFullYear() === now.getFullYear()); }

    var ing = filtered.filter(l => l.monto > 0).reduce((s,l) => s + l.monto, 0);
    var gas = Math.abs(filtered.filter(l => l.monto < 0).reduce((s,l) => s + l.monto, 0));
    var labels = {dia:'del Dia', semana:'de la Semana', mes:'del Mes'};
    $('#chartResumenTitle').text('Resumen ' + labels[periodo]);

    if (chartResumen) chartResumen.destroy();
    $('#chartResumen').empty();
    if (ing === 0 && gas === 0) {
        $('#chartResumen').html('<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i>Sin datos para este periodo</div>');
        chartResumen = null;
        return;
    }
    chartResumen = new ApexCharts(document.querySelector('#chartResumen'), {
        chart: { type: 'donut', height: 300 },
        series: [ing, gas],
        labels: ['Ingresos','Gastos'],
        colors: ['#50CD89','#F1416C'],
        plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Ganancia', formatter: function() { return '$' + (ing - gas).toFixed(2); } } } } } }
    });
    chartResumen.render();
}

$('#ventasPeriodPills').on('click', '.mg-pill', function() {
    $('#ventasPeriodPills .mg-pill').removeClass('active');
    $(this).addClass('active');
    cargarVentasStats();
