@model Gimnasio.Models.Gym

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard - " + Model.NegocioNombre;
    ViewData["NegocioId"] = Model.NegocioId;
    ViewData["NegocioNombre"] = Model.NegocioNombre;
    ViewData["DuenoNombre"] = Model.DuenoNegocio;
    ViewData["TipoNegocio"] = "artesanal";
    var negocioId = Model.NegocioId;
}

@if (Model.EsPrueba)
{
    <div class="alert border-0 d-flex align-items-center gap-3 mb-4 shadow-sm" id="trialBanner"
         style="background: linear-gradient(135deg, #FFF8DD 0%, #FFF3CD 100%); border-left: 4px solid #FFC700 !important;">
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 42px; height: 42px; background: rgba(255, 199, 0, 0.2);">
            <i class="bi bi-hourglass-split text-warning fs-5"></i>
        </div>
        <div class="flex-grow-1">
            <strong class="text-dark">Periodo de prueba</strong>
            <span class="d-block d-sm-inline text-muted ms-sm-1" id="trialDaysText">Cargando...</span>
        </div>
        <a href="https://wa.me/593997143142?text=Hola%2C%20quiero%20activar%20mi%20plan%20de%20pago%20en%20Mi%20Negocio" target="_blank" rel="noopener"
           class="btn btn-warning btn-sm fw-bold flex-shrink-0">
            <i class="bi bi-whatsapp me-1"></i>Activar Plan
        </a>
    </div>
}

<div class="tab-content" id="dashboardTabsContent">

    <!-- ═══════════════ TAB AGENDA ═══════════════ -->
    <div class="tab-pane fade show active" id="agendaTab" role="tabpanel">
        <!-- Stats -->
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Citas Hoy</div><div class="stat-value" id="statCitasHoy">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-calendar-check text-primary"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Hoy</div><div class="stat-value text-success" id="statIngresosHoy">$0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-currency-dollar text-success"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Completadas</div><div class="stat-value" id="statCompletadas">0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-check-circle text-info"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Canceladas</div><div class="stat-value text-danger" id="statCanceladas">0</div></div><div class="stat-icon bg-light-danger"><i class="bi bi-x-circle text-danger"></i></div></div></div>
            </div>
        </div>

        <!-- Employee Tabs -->
        <div class="mg-emp-tabs-wrapper mb-3">
            <ul class="nav nav-tabs mg-emp-tabs" id="employeeTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active mg-emp-tab" id="empTab-todos" data-emp-id="" type="button" role="tab">
                        <i class="bi bi-people-fill me-1"></i>
                        <span class="mg-emp-tab-name">Todos</span>
                    </button>
                </li>
                <!-- Employee tabs generated dynamically -->
            </ul>
        </div>

        <!-- Controles -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <button class="btn btn-primary" id="btnNuevaCita"><i class="bi bi-plus-circle me-2"></i>Nueva Cita</button>
            <div class="mg-period-pills" id="calendarViewPills">
                <button class="mg-pill" data-vista="timeGridDay">Dia</button>
                <button class="mg-pill" data-vista="timeGridWeek">Semana</button>
                <button class="mg-pill" data-vista="dayGridMonth">Mes</button>
            </div>
        </div>

        <!-- FullCalendar -->
        <div class="mg-card">
            <div class="card-body p-2 p-md-3">
                <div id="calendario-citas"></div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB CLIENTES ═══════════════ -->
    <div class="tab-pane fade" id="clientesTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="fw-bold mb-0">Clientes</h4>
            <button class="btn btn-primary" id="btnNuevoClienteArt"><i class="bi bi-plus-circle me-2"></i>Nuevo Cliente</button>
        </div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive">
            <table id="clientesArtTable" class="table table-row-bordered align-middle gs-0 gy-3">
                <thead><tr class="fw-bold text-muted"><th>Cliente</th><th>Telefono</th><th>Email</th><th>Citas</th><th class="text-end">Acciones</th></tr></thead>
                <tbody></tbody>
            </table>
        </div></div></div>
    </div>

    <!-- ═══════════════ TAB SERVICIOS ═══════════════ -->
    <div class="tab-pane fade" id="serviciosTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="fw-bold mb-0">Servicios</h4>
            <button class="btn btn-primary" id="btnNuevoServicio"><i class="bi bi-plus-circle me-2"></i>Nuevo Servicio</button>
        </div>
        <div class="row g-3" id="serviciosGrid"></div>
    </div>

    <!-- ═══════════════ TAB EMPLEADOS ═══════════════ -->
    <div class="tab-pane fade" id="empleadosTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="fw-bold mb-0">Empleados</h4>
            <button class="btn btn-primary" id="btnNuevoEmpleado"><i class="bi bi-plus-circle me-2"></i>Nuevo Empleado</button>
        </div>
        <div class="row g-3" id="empleadosGrid"></div>
    </div>

    <!-- ═══════════════ TAB MOVIMIENTOS (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="logsTab" role="tabpanel">
        <div class="mg-card mb-4"><div class="card-body"><h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Registrar Movimiento</h5><div class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label">Descripcion</label><input type="text" class="form-control form-control-lg" id="logDescripcion" placeholder="Ej: Compra de esmaltes"></div><div class="col-md-3"><label class="form-label">Monto ($)</label><input type="number" step="0.01" class="form-control form-control-lg" id="logMonto" placeholder="4 o -15"></div><div class="col-md-3"><button id="btnRegistrarLog" class="btn btn-primary btn-lg w-100"><i class="bi bi-check-lg me-2"></i>Registrar</button></div></div><small class="text-muted mt-2 d-block">Usa valores positivos para ingresos y negativos para gastos</small></div></div>
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center"><small class="text-muted"><i class="bi bi-shield-lock me-1"></i>Los registros son inmutables</small><div class="ms-auto d-flex gap-2"><button id="btnExportLogsExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button></div></div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="logsTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Descripcion</th><th>Tipo</th><th>Cliente</th><th>Monto</th><th>Fecha</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    <!-- ═══════════════ TAB REPORTES (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="ventasTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2"><div class="mg-period-pills" id="ventasPeriodPills"><button class="mg-pill active" data-periodo="dia">Dia</button><button class="mg-pill" data-periodo="semana">Semana</button><button class="mg-pill" data-periodo="mes">Mes</button></div></div>
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasIngresosLabel">Ingresos del Dia</span><span class="fs-2x fw-bolder" id="ventasIngresos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-danger) 0%, var(--mg-gradient-danger-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGastosLabel">Gastos del Dia</span><span class="fs-2x fw-bolder" id="ventasGastos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-success) 0%, var(--mg-gradient-success-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGananciaLabel">Ganancia Neta</span><span class="fs-2x fw-bolder" id="ventasGanancia">$0</span></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0">Ingresos vs Gastos</h5></div><div class="card-body"><div id="chartBarVentas"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0" id="chartResumenTitle">Resumen del Dia</h5></div><div class="card-body"><div id="chartResumen"></div></div></div></div>
        </div>
    </div>

    <!-- ═══════════════ TAB INVENTARIO ═══════════════ -->
    <div class="tab-pane fade" id="inventarioTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button id="btnCrearProducto" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo Producto</button>
            <button id="btnExportInventarioExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button>
            <button id="btnToggleMovimientos" class="btn btn-outline-primary"><i class="bi bi-clock-history me-2"></i>Historial</button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Total Productos</div><div class="stat-value" id="invTotalProductos">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-box-seam text-primary"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Stock Bajo</div><div class="stat-value text-warning" id="invStockBajo">0</div></div><div class="stat-icon bg-light-warning"><i class="bi bi-exclamation-triangle-fill text-warning"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ventas Hoy</div><div class="stat-value" id="invVentasHoy">0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-cart-check-fill text-success"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Hoy</div><div class="stat-value text-success" id="invIngresosHoy">$0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-currency-dollar text-info"></i></div></div></div></div>
        </div>
        <div class="row g-3 mb-4" id="productosGrid"></div>
        <div id="movimientosSection" class="d-none">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Historial de Movimientos</h5>
            <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="movimientosTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cant.</th><th>Total</th><th>Stock</th><th>Nota</th></tr></thead><tbody></tbody></table></div></div></div>
        </div>
    </div>

    <!-- Modal Crear/Editar Producto -->
    <div class="modal fade" id="productoModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h3 class="modal-title fw-bolder" id="productoModalTitle">Nuevo Producto</h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="productoForm">
                        <input type="hidden" id="prodId" name="ProductoId" />
                        <input type="hidden" name="NegocioId" value="@negocioId" />
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label fw-semibold required">Nombre del Producto</label>
                                <input type="text" class="form-control" name="Nombre" id="prodNombre" placeholder="Ej: Botella de Agua" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold required">Precio de Venta ($)</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" name="PrecioVenta" id="prodPrecioVenta" placeholder="1.00" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold required">Costo de Compra ($)</label>
                                <input type="number" step="0.01" min="0.01" class="form-control" name="CostoCompra" id="prodCostoCompra" placeholder="0.50" required />
                                <div class="form-text" id="prodMargenText"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold required">Stock Inicial</label>
                                <input type="number" min="0" class="form-control" name="Stock" id="prodStock" placeholder="50" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Stock Minimo (alerta)</label>
                                <input type="number" min="0" class="form-control" name="StockMinimo" id="prodStockMinimo" value="5" />
                                <div class="form-text">Se alerta cuando el stock baje de este numero</div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnGuardarProducto" class="btn btn-primary"><i class="bi bi-save me-2"></i>Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB NOTIFICACIONES (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="notificacionesTab" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-4"><h4 class="fw-bold mb-0">Notificaciones</h4><div class="d-flex gap-2"><button id="btnMarcarTodasLeidasTab" class="btn btn-outline-primary"><i class="bi bi-check-all me-2"></i>Marcar todas leidas</button></div></div>
        <div id="notificacionesList" class="d-flex flex-column gap-2"><div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i><p>No hay notificaciones.</p></div></div>
    </div>

    <!-- ═══════════════ TAB RECIBOS ═══════════════ -->
    <div class="tab-pane fade" id="recibosTab" role="tabpanel">
        <div id="recibosCleanupBanner" class="alert alert-warning d-none mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Tienes recibos con más de 30 días. <button class="btn btn-sm btn-warning ms-2" id="btnExportarYLimpiar">Exportar y Limpiar</button>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Recibos</h4>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group input-group-sm" style="width: 200px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="buscarReciboInput" placeholder="# Recibo...">
                </div>
                <button id="btnExportRecibos" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Exportar</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="tablaRecibos" class="table table-row-bordered align-middle gs-0 gy-3">
                <thead><tr class="fw-bold text-muted"><th>#Recibo</th><th>Destinatario</th><th>Concepto</th><th>Monto</th><th>Fecha</th><th>Acciones</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- ═══════════════ TAB SUGERENCIAS (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="sugerenciasTab" role="tabpanel">
        <div class="row justify-content-center"><div class="col-lg-8"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0"><i class="bi bi-chat-left-text me-2"></i>Enviar Sugerencia</h5></div><div class="card-body"><p class="text-muted mb-3">Ayudanos a mejorar. Escribe tu sugerencia, idea o comentario.</p><div class="mb-3"><textarea class="form-control form-control-lg" id="sugerenciaTexto" rows="5" maxlength="1000" placeholder="Escribe tu sugerencia aqui..."></textarea><div class="d-flex justify-content-between mt-1"><small class="text-muted">Maximo 1000 caracteres</small><small class="text-muted"><span id="sugerenciaCount">0</span>/1000</small></div></div><button id="btnEnviarSugerencia" class="btn btn-primary"><i class="bi bi-send me-2"></i>Enviar Sugerencia</button></div></div></div></div>
    </div>

</div><!-- /tab-content -->

<!-- Modal Ver Recibo -->
<div class="modal fade" id="reciboModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down"><div class="modal-content"><div class="modal-header bg-light"><h3 class="modal-title fw-bolder"><i class="bi bi-receipt me-2"></i>Recibo #<span id="reciboModalNumero"></span></h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body p-0"><iframe id="reciboIframe" sandbox style="width:100%;height:500px;border:none;"></iframe></div><div class="modal-footer bg-light"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button></div></div></div></div>

<!-- ═══════════════ MODALES ═══════════════ -->

<!-- Modal Crear Cita Rapida -->
<div class="modal fade" id="citaRapidaModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down"><div class="modal-content">
    <div class="modal-header bg-light">
        <div>
            <h3 class="modal-title fw-bolder mb-0">Nueva Cita</h3>
            <small class="text-muted" id="citaRapidaSubtitle"></small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <form id="citaRapidaForm">
            <input type="hidden" name="NegocioId" value="@negocioId" />
            <input type="hidden" name="EmpleadoId" id="crEmpleadoId" />
            <input type="hidden" name="ClienteId" id="crClienteId" />
            <input type="hidden" name="FechaHoraInicio" id="crFechaHoraInicio" />

            <!-- Empleado selector (shown when "Todos" tab is active) -->
            <div class="mb-3" id="crEmpleadoGroup">
                <label class="form-label fw-semibold required">Empleado</label>
                <select class="form-select" id="crEmpleadoSelect">
                    <option value="">Seleccionar empleado...</option>
                </select>
            </div>

            <!-- Servicio -->
            <div class="mb-3">
                <label class="form-label fw-semibold required">Servicio</label>
                <select class="form-select" name="ServicioId" id="crServicio" required>
                    <option value="">Seleccionar servicio...</option>
                </select>
            </div>

            <!-- Cliente section -->
            <div class="mb-3">
                <label class="form-label fw-semibold required">Cliente</label>
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-primary" id="crModoSearchBtn"><i class="bi bi-search me-1"></i>Buscar existente</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="crModoCreateBtn"><i class="bi bi-person-plus me-1"></i>Crear nuevo</button>
                </div>
                <!-- Search mode -->
                <div id="crClienteSearchMode">
                    <div class="position-relative">
                        <input type="text" class="form-control" id="crClienteSearch" placeholder="Buscar por nombre o telefono..." autocomplete="off" />
                        <div class="mg-autocomplete-dropdown d-none" id="crClienteResults"></div>
                    </div>
                    <div class="mg-selected-client d-none mt-2" id="crSelectedClient">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-light-primary rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                <i class="bi bi-person-fill text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <strong id="crSelectedName"></strong>
                                <small class="d-block text-muted" id="crSelectedPhone"></small>
                            </div>
                            <button type="button" class="btn btn-sm btn-light" id="crClearClient"><i class="bi bi-x-lg"></i></button>
                        </div>
                    </div>
                </div>
                <!-- Create mode -->
                <div id="crClienteCreateMode" class="d-none">
                    <div class="row g-2">
                        <div class="col-md-6"><input type="text" class="form-control" name="Nombre" id="crNombre" placeholder="Nombre" /></div>
                        <div class="col-md-6"><input type="text" class="form-control" name="Apellido" id="crApellido" placeholder="Apellido" /></div>
                        <div class="col-md-6"><input type="tel" class="form-control" name="Telefono" id="crTelefono" placeholder="Telefono" /></div>
                        <div class="col-md-6"><input type="email" class="form-control" name="Email" id="crEmail" placeholder="Email (opcional)" /></div>
                    </div>
                </div>
            </div>

            <!-- Fecha + Slots -->
            <div class="mb-3">
                <label class="form-label fw-semibold required">Fecha</label>
                <input type="date" class="form-control" id="crFecha" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold required">Horario Disponible</label>
                <div class="mg-slot-grid" id="crSlotsContainer">
                    <p class="text-muted col-span-full">Selecciona empleado, servicio y fecha para ver horarios</p>
                </div>
