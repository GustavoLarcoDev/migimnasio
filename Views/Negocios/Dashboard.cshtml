// ═══════════════════════════════════════════════════════════
// WHATSAPP CLIENTES DIARIOS — Modal paso a paso
// Abre wa.me links desde el número del negocio, uno por uno.
// Al finalizar, limpia la lista (EsDiario = false).
// ═══════════════════════════════════════════════════════════
var waDiariosData = [];
var waDiariosIndex = 0;

function limpiarTelefonoWA(tel) {
    if (!tel) return '';
    var limpio = tel.replace(/[\s\-\(\)\+]/g, '');
    if (limpio.startsWith('0')) limpio = '593' + limpio.substring(1);
    return limpio;
}

function mostrarClienteDiarioWA() {
    if (waDiariosIndex >= waDiariosData.length) {
        // Todos enviados — mostrar pantalla final
        $('#waDiariosContent').addClass('d-none');
        $('#waDiariosFinished').removeClass('d-none');
        $('#waResumen').text(waDiariosData.length + ' cliente(s) procesado(s)');
        $('#waSiguienteBtn').addClass('d-none');
        $('#waFinalizarBtn').removeClass('d-none');
        $('#waCerrarBtn').text('Cerrar');
        return;
    }
    var c = waDiariosData[waDiariosIndex];
    var nombre = c.nombreCompleto || (c.nombre + ' ' + c.apellido);
    var tel = c.telefono || '';
    var telLimpio = limpiarTelefonoWA(tel);
    var mensaje = '✅ Hola ' + nombre + ', gracias por tu visita de hoy a *' + negocioNombre + '*. ¡Te esperamos pronto!';
    var waUrl = telLimpio ? 'https://wa.me/' + telLimpio + '?text=' + encodeURIComponent(mensaje) : '';

    $('#waContador').text((waDiariosIndex + 1) + ' / ' + waDiariosData.length);
    $('#waClienteNombre').text(nombre);
    $('#waClienteTelefono').text(tel || 'Sin teléfono');
    $('#waMensajePreview').text(mensaje);

    if (waUrl) {
        $('#waEnviarLink').attr('href', waUrl).removeClass('disabled btn-secondary').addClass('btn-success').html('<i class="bi bi-whatsapp me-2"></i>Abrir WhatsApp y enviar');
    } else {
        $('#waEnviarLink').attr('href', '#').addClass('disabled btn-secondary').removeClass('btn-success').html('<i class="bi bi-exclamation-triangle me-2"></i>Sin teléfono registrado');
    }

    // Mostrar "Siguiente" o "Terminar" según si es el último
    if (waDiariosIndex < waDiariosData.length - 1) {
        $('#waSiguienteBtn').html('<i class="bi bi-arrow-right me-2"></i>Siguiente').show();
    } else {
        $('#waSiguienteBtn').html('<i class="bi bi-check-lg me-2"></i>Terminar').show();
    }
}

$('#btnEnviarMensajesMasivos').off().click(function() {
    if (!tablaUsuariosDiarios || tablaUsuariosDiarios.rows().count() === 0) {
        toastr.warning('No hay clientes diarios para notificar.');
        return;
    }
    // Obtener datos de la tabla
    waDiariosData = tablaUsuariosDiarios.rows().data().toArray();
    waDiariosIndex = 0;
    // Reset modal
    $('#waDiariosContent').removeClass('d-none');
    $('#waDiariosFinished').addClass('d-none');
    $('#waSiguienteBtn').removeClass('d-none');
    $('#waFinalizarBtn').addClass('d-none');
    $('#waCerrarBtn').text('Cancelar');
    mostrarClienteDiarioWA();
    new bootstrap.Modal('#whatsappDiariosModal').show();
});

$('#waSiguienteBtn').click(function() {
    waDiariosIndex++;
    mostrarClienteDiarioWA();
});

$('#waFinalizarBtn').click(function() {
    var btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Limpiando...');
    $.post('/Negocios/LimpiarClientesDiarios', { negocioId: negocioId }, function(d) {
        btn.prop('disabled', false).html('<i class="bi bi-check-lg me-2"></i>Listo');
        if (d.success) {
            bootstrap.Modal.getInstance(document.getElementById('whatsappDiariosModal')).hide();
            swalMG.fire({ title: 'Listo', text: d.limpiados + ' cliente(s) removido(s) de la lista diaria', icon: 'success' });
            tablaUsuariosDiarios.ajax.reload();
            cargarEstadisticas();
        } else {
            toastr.error(d.message || 'Error al limpiar lista');
        }
    }).fail(function() {
        btn.prop('disabled', false).html('<i class="bi bi-check-lg me-2"></i>Finalizar y limpiar lista');
        toastr.error('Error de conexión');
    });
});

// Cargar conteo de notificaciones con manejo de errores
function cargarNotificacionesCount() {
    $.get('/Negocios/GetNotificacionesCount', { negocioId: negocioId }, function(d) {
        var count = d.count || 0;
        if (count > 0) {
            $('#topbarNotifBadge').text(count).removeClass('d-none');
            $('#sidebarNotifBadge').text(count).removeClass('d-none');
        } else {
            $('#topbarNotifBadge').addClass('d-none');
            $('#sidebarNotifBadge').addClass('d-none');
        }
    }).fail(function() {
