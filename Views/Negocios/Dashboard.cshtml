@model Gimnasio.Models.Gym

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard - " + Model.NegocioNombre;
    ViewData["NegocioId"] = Model.NegocioId;
    ViewData["NegocioNombre"] = Model.NegocioNombre;
    ViewData["DuenoNombre"] = Model.DuenoNegocio;
    var negocioId = Model.NegocioId;
}

<div class="tab-content" id="dashboardTabsContent">
    <!-- TAB RESUMEN -->
    <div class="tab-pane fade show active" id="resumenTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-0" id="resumenSaludo">Buen día</h3>
                <p class="text-muted mb-0">Resumen de tu negocio</p>
            </div>
            <div class="mg-period-pills" id="resumenPeriodPills">
                <button class="mg-pill active" data-periodo="dia">Hoy</button>
                <button class="mg-pill" data-periodo="semana">Semana</button>
                <button class="mg-pill" data-periodo="mes">Mes</button>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-4 col-12">
                <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-success) 0%, var(--mg-gradient-success-end) 100%);">
                    <div class="card-body text-white">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="d-block mb-1 opacity-75 small">Ingresos</span>
                                <span class="fs-2x fw-bolder" id="resumenIngresos">$0</span>
                            </div>
                            <i class="bi bi-arrow-up-circle fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-4 col-12">
                <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-danger) 0%, var(--mg-gradient-danger-end) 100%);">
                    <div class="card-body text-white">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="d-block mb-1 opacity-75 small">Gastos</span>
                                <span class="fs-2x fw-bolder" id="resumenGastos">$0</span>
                            </div>
                            <i class="bi bi-arrow-down-circle fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-md-4 col-12">
                <div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);">
                    <div class="card-body text-white">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="d-block mb-1 opacity-75 small">Ganancia Neta</span>
                                <span class="fs-2x fw-bolder" id="resumenGanancia">$0</span>
                            </div>
                            <i class="bi bi-cash-stack fs-1 opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Total Clientes</div><div class="stat-value" id="resumenTotalClientes">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-people-fill text-primary"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Activos</div><div class="stat-value" id="resumenActivos">0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-check-circle-fill text-success"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Vencidos</div><div class="stat-value" id="resumenVencidos">0</div></div><div class="stat-icon bg-light-danger"><i class="bi bi-x-circle-fill text-danger"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Nuevos Hoy</div><div class="stat-value" id="resumenNuevosHoy">0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-person-plus-fill text-info"></i></div></div></div></div>
        </div>
        <div class="row g-3">
            <div class="col-lg-7">
                <div class="mg-card">
                    <div class="card-header border-0"><h5 class="fw-bold mb-0">Ingresos vs Gastos</h5></div>
                    <div class="card-body"><div id="chartResumenOverview"></div></div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="mg-card h-100">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Próximos a Vencer</h5>
                        <span class="badge bg-warning text-dark" id="resumenProximosCount">0</span>
                    </div>
                    <div class="card-body p-0" style="max-height: 320px; overflow-y: auto;" id="proximosVencerList">
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                            <p class="mb-0">Sin membresías próximas a vencer</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB CLIENTES -->
    <div class="tab-pane fade" id="clientesTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button id="btnCrearCliente" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo Cliente</button>
            <button id="btnExportClientesExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button>
            <button id="btnImportarExcel" class="btn btn-outline-primary"><i class="bi bi-upload me-2"></i>Importar Excel</button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Total Clientes</div><div class="stat-value" id="totalClientes">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-people-fill text-primary"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Activos</div><div class="stat-value" id="clientesActivos">0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-check-circle-fill text-success"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Vencidos</div><div class="stat-value" id="clientesVencidos">0</div></div><div class="stat-icon bg-light-danger"><i class="bi bi-x-circle-fill text-danger"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Mes</div><div class="stat-value" id="ingresosMes">$0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-currency-dollar text-info"></i></div></div></div></div>
        </div>
        <div id="importZone" class="mg-card border-2 border-dashed mb-4 d-none"><div class="card-body text-center py-5"><i class="bi bi-cloud-upload fs-1 text-primary mb-3 d-block"></i><h5>Arrastra tu archivo Excel aquí</h5><p class="text-muted">O haz clic para seleccionar (solo Nombre y Apellido son obligatorios)</p><input type="file" id="excelFileInput" accept=".xlsx,.xls" class="d-none"></div></div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="clientesTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Cliente</th><th>Precio</th><th>Fecha Inicio</th><th>Vencimiento</th><th>Días Rest.</th><th class="text-end">Acciones</th></tr></thead><tbody class="text-gray-600 fw-semibold"></tbody></table></div></div></div>
    </div>

    <!-- TAB LOGS+ -->
    <div class="tab-pane fade" id="logsTab" role="tabpanel">
        <div class="mg-card mb-4"><div class="card-body"><h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Registrar Movimiento</h5><div class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label">Descripción</label><input type="text" class="form-control form-control-lg" id="logDescripcion" placeholder="Ej: Vendido un Gatorade"></div><div class="col-md-3"><label class="form-label">Monto ($)</label><input type="number" step="0.01" class="form-control form-control-lg" id="logMonto" placeholder="4 o -15"></div><div class="col-md-3"><button id="btnRegistrarLog" class="btn btn-primary btn-lg w-100"><i class="bi bi-check-lg me-2"></i>Registrar</button></div></div><small class="text-muted mt-2 d-block">Usa valores positivos para ingresos y negativos para gastos</small></div></div>
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center"><small class="text-muted"><i class="bi bi-shield-lock me-1"></i>Los registros son inmutables para proteger la integridad de tu negocio</small><div class="ms-auto d-flex gap-2"><button id="btnCerrarPeriodo" class="btn btn-outline-danger d-none"><i class="bi bi-calendar-x me-2"></i>Cerrar Periodo</button><button id="btnExportLogsExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button></div></div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="logsTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Descripción</th><th>Cliente</th><th>Monto</th><th>Fecha</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    <!-- TAB VENTAS -->
    <div class="tab-pane fade" id="ventasTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2"><div class="mg-period-pills" id="ventasPeriodPills"><button class="mg-pill active" data-periodo="dia">Día</button><button class="mg-pill" data-periodo="semana">Semana</button><button class="mg-pill" data-periodo="mes">Mes</button></div><button id="btnRefrescarVentas" class="btn btn-outline-primary btn-sm"><i class="bi bi-arrow-clockwise me-2"></i>Refrescar</button></div>
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasIngresosLabel">Ingresos del Día</span><span class="fs-2x fw-bolder" id="ventasIngresos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-danger) 0%, var(--mg-gradient-danger-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGastosLabel">Gastos del Día</span><span class="fs-2x fw-bolder" id="ventasGastos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-success) 0%, var(--mg-gradient-success-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGananciaLabel">Ganancia Neta del Día</span><span class="fs-2x fw-bolder" id="ventasGanancia">$0</span></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="mg-card"><div class="card-body text-center"><i class="bi bi-calendar-check text-primary fs-1 mb-2"></i><h6 class="text-muted">Membresías 30 días (mes)</h6><span class="fs-3 fw-bold" id="ventasMembresias">$0</span></div></div></div>
            <div class="col-md-4"><div class="mg-card"><div class="card-body text-center"><i class="bi bi-person-walking text-info fs-1 mb-2"></i><h6 class="text-muted">Clientes Diarios Hoy</h6><span class="fs-3 fw-bold" id="ventasClientesDiarios">0</span></div></div></div>
            <div class="col-md-4"><div class="mg-card"><div class="card-body text-center"><i class="bi bi-graph-up-arrow text-success fs-1 mb-2"></i><h6 class="text-muted">Ganancia del Mes</h6><span class="fs-3 fw-bold" id="ventasGananciaMes">$0</span></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0">Ingresos vs Gastos</h5></div><div class="card-body"><div id="chartBarVentas"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0">Nuevos Clientes</h5></div><div class="card-body"><div id="chartClientes"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0" id="chartResumenTitle">Resumen del Día</h5></div><div class="card-body"><div id="chartResumen"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0 d-flex justify-content-between align-items-center"><h5 class="fw-bold mb-0">Usuarios Diarios</h5><button id="btnEnviarMensajesMasivos" class="btn btn-sm btn-success"><i class="bi bi-whatsapp me-2"></i>Mensaje</button></div><div class="card-body"><div class="table-responsive" style="max-height: 250px; overflow-y: auto;"><table id="tablaUsuariosDiarios" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Nombre</th><th>Teléfono</th><th>Fecha</th></tr></thead><tbody></tbody></table></div></div></div></div>
        </div>
    </div>

    <!-- TAB NOTIFICACIONES -->
    <div class="tab-pane fade" id="notificacionesTab" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-4"><h4 class="fw-bold mb-0">Notificaciones</h4><div class="d-flex gap-2"><button id="btnGenerarNotificaciones" class="btn btn-primary"><i class="bi bi-arrow-repeat me-2"></i>Generar Notificaciones</button><button id="btnMarcarTodasLeidasTab" class="btn btn-outline-primary"><i class="bi bi-check-all me-2"></i>Marcar todas leídas</button></div></div>
        <div id="notificacionesList" class="d-flex flex-column gap-2"><div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i><p>No hay notificaciones. Haz clic en "Generar Notificaciones" para verificar membresías próximas a vencer.</p></div></div>
    </div>
</div>

<!-- Modal Crear/Editar Cliente -->
<div class="modal fade" id="clienteModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down"><div class="modal-content"><div class="modal-header bg-light"><h3 class="modal-title fw-bolder" id="modalTitle">Nuevo Cliente</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><form id="clienteForm"><input type="hidden" id="clienteId" name="ClienteId" /><input type="hidden" name="NegocioId" value="@negocioId" /><div class="row"><div class="col-md-6 mb-3"><label class="form-label fw-semibold required">Nombre</label><input type="text" class="form-control" name="Nombre" id="nombre" required /></div><div class="col-md-6 mb-3"><label class="form-label fw-semibold required">Apellido</label><input type="text" class="form-control" name="Apellido" id="apellido" required /></div></div><div class="row"><div class="col-md-6 mb-3"><label class="form-label fw-semibold">Email</label><input type="email" class="form-control" name="Email" id="email" /></div><div class="col-md-6 mb-3"><label class="form-label fw-semibold required">Teléfono</label><input type="tel" class="form-control" name="Telefono" id="telefono" required /></div></div><div class="mb-3"><label class="form-label fw-semibold">Dirección</label><input type="text" class="form-control" name="Direccion" id="direccion" /></div><div class="row"><div class="col-md-4 mb-3"><label class="form-label fw-semibold required">Fecha Inicio</label><input type="date" class="form-control" name="FechaInicio" id="fechaInicio" required /></div><div class="col-md-4 mb-3"><label class="form-label fw-semibold required">Fecha Fin</label><input type="date" class="form-control" name="FechaFin" id="fechaFin" required /></div><div class="col-md-4 mb-3"><label class="form-label fw-semibold">Días</label><input type="number" class="form-control" name="Dias" id="dias" min="1" /></div></div><div class="row"><div class="col-md-4 mb-3"><label class="form-label fw-semibold required">Precio ($)</label><input type="number" step="0.01" class="form-control" name="Precio" id="precio" min="0" required /></div><div class="col-md-4 mb-3 pt-4"><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" name="EsDiario" id="esDiario" value="true" /><label class="form-check-label fw-semibold" for="esDiario">Es Diario</label></div></div></div></form></div><div class="modal-footer bg-light"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="button" id="btnGuardarCliente" class="btn btn-primary"><i class="bi bi-save me-2"></i>Guardar</button></div></div></div></div>

<!-- Modal Renovar -->
<div class="modal fade" id="renovarModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down"><div class="modal-content"><div class="modal-header bg-light"><h3 class="modal-title fw-bolder">Renovar Membresía</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="renovarClienteId" /><p class="text-muted mb-4">Cliente: <strong id="renovarClienteNombre"></strong></p><div class="mb-3"><label class="form-label fw-semibold">Fecha de fin actual</label><input type="text" class="form-control" id="renovarFechaActual" readonly disabled /></div><div class="mb-3"><label class="form-label fw-semibold required">Nueva fecha de fin</label><input type="date" class="form-control" id="renovarNuevaFechaFin" required /></div><div class="mb-3"><span class="text-muted">Días a agregar: </span><strong id="renovarDiasInfo">0</strong></div><div class="mb-3"><label class="form-label fw-semibold required">Precio ($)</label><input type="number" step="0.01" class="form-control" id="renovarPrecio" min="0" required /></div></div><div class="modal-footer bg-light"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="button" id="btnConfirmarRenovar" class="btn btn-success"><i class="bi bi-save me-2"></i>Guardar</button></div></div></div></div>

<!-- Modal Import Results -->
<div class="modal fade" id="importResultModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down"><div class="modal-content"><div class="modal-header bg-light"><h3 class="modal-title fw-bolder">Resultado de Importación</h3><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="importResultBody"></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button></div></div></div></div>

@section Scripts {
<script>
const negocioId = '@negocioId';
const negocioNombre = '@ViewData["NegocioNombre"]';
let tablaClientes, tablaLogs, tablaUsuariosDiarios;
let modoEdicion = false;
const swalMG = Swal.mixin({ confirmButtonColor: '#3E97FF', cancelButtonColor: '#E4E6EF', cancelButtonText: 'Cancelar', reverseButtons: true, customClass: { popup: 'mg-swal-popup', confirmButton: 'mg-swal-confirm', cancelButton: 'mg-swal-cancel' } });

$(document).ready(function () { cargarResumen(); cargarNotificacionesCount(); $.post('/Negocios/GenerarNotificaciones', { negocioId }); });
document.addEventListener('mg-tab-shown', function(e) { if (e.detail.tab === 'resumenTab') { cargarResumen(); } else if (e.detail.tab === 'clientesTab') { if (!tablaClientes) { cargarTablaClientes(); } cargarEstadisticas(); } else if (e.detail.tab === 'ventasTab') { cargarVentasStats(); cargarCharts(); } else if (e.detail.tab === 'logsTab') { if (!tablaLogs) cargarTablaLogs(); verificarCerrarPeriodo(); } else if (e.detail.tab === 'notificacionesTab') { cargarNotificacionesTab(); } });

function cargarEstadisticas() { $.get('/Negocios/GetDashboardStats', { negocioId }, function(data) { $('#totalClientes').text(data.totalClientes); $('#clientesActivos').text(data.clientesActivos); $('#clientesVencidos').text(data.clientesVencidos); $('#ingresosMes').text('$' + data.ingresosMes.toFixed(2)); }); }
function cargarTablaClientes() { tablaClientes = $('#clientesTable').DataTable({ ajax: { url: '/Negocios/GetClientes', data: { negocioId }, dataSrc: '' }, columns: [ { data: null, render: (d,t,r) => `<strong>${r.nombreCompleto}</strong><br><small class="text-muted">${r.telefono || '-'}</small>` }, { data: 'precio', render: d => '$' + d.toFixed(2) }, { data: 'fechaDeCreacion', render: d => new Date(d).toLocaleDateString('es-MX') }, { data: 'fechaQueTermina', render: d => new Date(d).toLocaleDateString('es-MX') }, { data: 'diasRestantes', render: d => d < 0 ? '<span class="badge bg-danger">Vencido</span>' : `<span class="badge bg-${d <= 3 ? 'warning' : 'success'}">${d} días</span>` }, { data: null, orderable: false, className: 'text-end', render: (d,t,r) => { let btns = ''; const cleanPhone = r.telefono ? r.telefono.replace(/\D/g, '') : ''; if (cleanPhone.length >= 10) { const waMsg = encodeURIComponent(`Hola ${r.nombreCompleto}, te saludamos de ${negocioNombre}, ¿cómo estás hoy?`); btns += `<a href="https://wa.me/${cleanPhone}?text=${waMsg}" target="_blank" class="btn btn-sm btn-icon btn-light-success me-1" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>`; } const safeName = r.nombreCompleto.replace(/'/g, "\\'"); const safePrecio = r.precio || 0; const safeFechaFin = r.fechaQueTermina ? r.fechaQueTermina.split('T')[0] : ''; const safePhone = cleanPhone; btns += `<button class="btn btn-sm btn-icon btn-light-warning me-1" onclick="abrirModalRenovar('${r.clienteId}','${safeName}', ${safePrecio}, '${safeFechaFin}', '${safePhone}')" title="Renovar"><i class="bi bi-arrow-repeat"></i></button><button class="btn btn-sm btn-icon btn-light-primary me-1" onclick="editarCliente('${r.clienteId}')" title="Editar"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-icon btn-light-danger" onclick="eliminarCliente('${r.clienteId}','${safeName}')" title="Eliminar"><i class="bi bi-trash"></i></button>`; return btns; }} ], order: [[4, 'asc']], responsive: true, language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' } }); }

function toDateInput(d) { return d.toISOString().split('T')[0]; }
function calcDias() { const inicio = $('#fechaInicio').val(); const fin = $('#fechaFin').val(); if (inicio && fin) { const dias = Math.round((new Date(fin) - new Date(inicio)) / 86400000); $('#dias').val(dias > 0 ? dias : ''); } }
$('#fechaInicio, #fechaFin').on('change', calcDias);
$('#dias').on('change', function() { const inicio = $('#fechaInicio').val(); const dias = parseInt($(this).val()); if (inicio && dias > 0) { const fin = new Date(inicio); fin.setDate(fin.getDate() + dias); $('#fechaFin').val(toDateInput(fin)); } });
$('#btnCrearCliente').click(function() { modoEdicion = false; $('#modalTitle').text('Nuevo Cliente'); $('#clienteForm')[0].reset(); $('#clienteId').val(''); $('#fechaInicio').val(toDateInput(new Date())); $('#clienteModal').modal('show'); });
$('#btnGuardarCliente').click(function() { if (!$('#clienteForm')[0].checkValidity()) { $('#clienteForm')[0].reportValidity(); return; } const url = modoEdicion ? '/Negocios/EditarCliente' : '/Negocios/CrearCliente'; $.post(url, $('#clienteForm').serialize(), function(r) { if (r.success) { $('#clienteModal').modal('hide'); tablaClientes.ajax.reload(); cargarEstadisticas(); if (tablaLogs) tablaLogs.ajax.reload(); toastr.success(r.message); } }).fail(xhr => toastr.error(xhr.responseJSON?.message || 'Error')); });
function editarCliente(id) { $.get('/Negocios/GetCliente', { id, negocioId }, function(d) { modoEdicion = true; $('#modalTitle').text('Editar Cliente'); $('#clienteId').val(d.clienteId); $('#nombre').val(d.nombre); $('#apellido').val(d.apellido); $('#email').val(d.email); $('#telefono').val(d.telefono); $('#direccion').val(d.direccion); $('#fechaInicio').val(toDateInput(new Date(d.fechaDeCreacion))); $('#fechaFin').val(toDateInput(new Date(d.fechaQueTermina))); calcDias(); $('#precio').val(d.precio); $('#esDiario').prop('checked', d.esDiario); $('#clienteModal').modal('show'); }); }
function eliminarCliente(id, nombre) { swalMG.fire({ title: '¿Estás seguro?', text: `Se eliminará al cliente "${nombre}". Esta acción no se puede deshacer.`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#F1416C', cancelButtonColor: '#3E97FF', confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar' }).then((result) => { if (result.isConfirmed) { $.post('/Negocios/EliminarCliente', { id, negocioId }, function(r) { if (r.success) { tablaClientes.ajax.reload(); cargarEstadisticas(); if (tablaLogs) tablaLogs.ajax.reload(); swalMG.fire('¡Eliminado!', r.message, 'success'); } else { swalMG.fire('Error', r.message || 'No se pudo eliminar', 'error'); } }).fail(xhr => swalMG.fire('Error', xhr.responseJSON?.message || 'Ocurrió un error', 'error')); } }); }

let renovarFechaFinActual = ''; let renovarClienteTelefono = ''; let renovarClienteNombreStr = '';
function abrirModalRenovar(id, nombre, precio, fechaQueTermina, telefono) { $('#renovarClienteId').val(id); $('#renovarClienteNombre').text(nombre); renovarFechaFinActual = fechaQueTermina; renovarClienteTelefono = telefono || ''; renovarClienteNombreStr = nombre; $('#renovarFechaActual').val(new Date(fechaQueTermina).toLocaleDateString('es-MX')); const minDate = new Date(fechaQueTermina); minDate.setDate(minDate.getDate() + 1); $('#renovarNuevaFechaFin').attr('min', toDateInput(minDate)); const defaultFin = new Date(fechaQueTermina); defaultFin.setDate(defaultFin.getDate() + 30); $('#renovarNuevaFechaFin').val(toDateInput(defaultFin)); $('#renovarDiasInfo').text('30'); $('#renovarPrecio').val(precio || ''); $('#renovarModal').modal('show'); }
$('#renovarNuevaFechaFin').on('change', function() { if (renovarFechaFinActual && $(this).val()) { const dias = Math.round((new Date($(this).val()) - new Date(renovarFechaFinActual)) / 86400000); $('#renovarDiasInfo').text(dias > 0 ? dias : 0); } });
$('#btnConfirmarRenovar').click(function() { const id = $('#renovarClienteId').val(); const nuevaFechaFin = $('#renovarNuevaFechaFin').val(); const precio = $('#renovarPrecio').val(); if (!nuevaFechaFin || !precio) { toastr.error('Complete todos los campos'); return; } const btn = $(this); const originalText = btn.html(); btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...'); $.post('/Negocios/RenovarCliente', { id, negocioId, nuevaFechaFin, precio }, function(r) { if (r.success) { $('#renovarModal').modal('hide'); tablaClientes.ajax.reload(); cargarEstadisticas(); if (tablaLogs) tablaLogs.ajax.reload(); const fechaFormateada = new Date(nuevaFechaFin).toLocaleDateString('es-MX'); if (renovarClienteTelefono && renovarClienteTelefono.length >= 10) { const waMsg = encodeURIComponent(`Hola ${renovarClienteNombreStr}, te informamos que tu membresía en ${negocioNombre} ha sido renovada. Ahora tu suscripción termina el ${fechaFormateada}. ¡Gracias!`); swalMG.fire({ title: '¡Renovado!', text: r.message, icon: 'success', confirmButtonText: 'Enviar WhatsApp', confirmButtonColor: '#25D366', showCancelButton: true, cancelButtonText: 'Cerrar' }).then((result) => { if (result.isConfirmed) window.open(`https://wa.me/${renovarClienteTelefono}?text=${waMsg}`, '_blank'); }); } else { swalMG.fire('¡Renovado!', r.message, 'success'); } } }).fail(xhr => { swalMG.fire('Error', xhr.responseJSON?.message || 'Error al renovar', 'error'); }).always(() => { btn.prop('disabled', false).html(originalText); }); });
$('#btnExportClientesExcel').click(() => window.location.href = '/Negocios/ExportClientesExcel?negocioId=' + negocioId);
$('#btnImportarExcel').click(() => $('#importZone').toggleClass('d-none'));
$('#importZone').on('click', () => $('#excelFileInput').click());
$('#excelFileInput').on('change', function() { if (this.files.length) uploadExcel(this.files[0]); });
$('#importZone').on('dragover', e => { e.preventDefault(); $(e.currentTarget).addClass('border-primary'); });
$('#importZone').on('dragleave', e => $(e.currentTarget).removeClass('border-primary'));
$('#importZone').on('drop', function(e) { e.preventDefault(); $(this).removeClass('border-primary'); if (e.originalEvent.dataTransfer.files.length) uploadExcel(e.originalEvent.dataTransfer.files[0]); });
function uploadExcel(file) { const formData = new FormData(); formData.append('file', file); formData.append('negocioId', negocioId); $.ajax({ url: '/Negocios/ImportarClientesExcel', type: 'POST', data: formData, processData: false, contentType: false, success: function(r) { let html = `<div class="alert alert-success"><strong>${r.clientesCreados}</strong> clientes creados</div>`; if (r.clientesOmitidos > 0) html += `<div class="alert alert-warning"><strong>${r.clientesOmitidos}</strong> omitidos (duplicados)</div>`; if (r.erroresCount > 0) html += `<div class="alert alert-danger"><strong>${r.erroresCount}</strong> errores</div>`; $('#importResultBody').html(html); $('#importResultModal').modal('show'); tablaClientes.ajax.reload(); cargarEstadisticas(); $('#importZone').addClass('d-none'); }, error: xhr => toastr.error(xhr.responseJSON?.message || 'Error al importar') }); }

function initLogsTab() {}
function cargarTablaLogs() { if (tablaLogs) { tablaLogs.destroy(); } tablaLogs = $('#logsTable').DataTable({ ajax: { url: '/Negocios/GetLogs', data: { negocioId: negocioId }, dataSrc: '', error: function(xhr, error, code) { console.error('DataTables error:', xhr.responseText); toastr.error('Error al cargar los logs: ' + (xhr.responseJSON?.message || 'Error desconocido')); } }, columns: [ { data: 'message' }, { data: 'nombreCliente', render: d => d || '<span class="text-muted">-</span>' }, { data: 'monto', render: d => `<span class="${d >= 0 ? 'text-success' : 'text-danger'} fw-bold">${d >= 0 ? '+' : ''}$${d.toFixed(2)}</span>` }, { data: 'fecha', render: function(d, type) { if (type === 'sort' || type === 'type') return d; return new Date(d).toLocaleString('es-MX'); } } ], order: [[3, 'desc']], language: { url: 'https://cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json' } }); }
$('#btnRegistrarLog').click(function() { const message = $('#logDescripcion').val(); const monto = $('#logMonto').val(); if (!message || monto === '') { toastr.error('Complete todos los campos'); return; } $.post('/Negocios/CrearLog', { NegocioId: negocioId, Message: message, Monto: monto }, function(r) { if (r.success) { $('#logDescripcion').val(''); $('#logMonto').val(''); tablaLogs.ajax.reload(); toastr.success(r.message); } }).fail(xhr => toastr.error(xhr.responseJSON?.message || 'Error')); });
$('#btnExportLogsExcel').click(function() { window.location.href = `/Negocios/ExportLogsExcel?negocioId=${negocioId}`; });
function verificarCerrarPeriodo() { $.get('/Negocios/GetOldestLogDate', { negocioId }, function(d) { if (d.fecha) { const oldest = new Date(d.fecha); const diasDesde = Math.round((new Date() - oldest) / 86400000); if (diasDesde >= 30) { $('#btnCerrarPeriodo').removeClass('d-none'); } else { $('#btnCerrarPeriodo').addClass('d-none'); } } }); }
$('#btnCerrarPeriodo').click(function() { swalMG.fire({ title: 'Cerrar Periodo', html: 'Se descargará el Excel de respaldo y luego se eliminarán todos los registros.<br><br><strong>Esta acción no se puede deshacer.</strong>', icon: 'warning', showCancelButton: true, confirmButtonColor: '#F1416C', cancelButtonColor: '#E4E6EF', confirmButtonText: 'Descargar y Cerrar', cancelButtonText: 'Cancelar', reverseButtons: true }).then((result) => { if (result.isConfirmed) { window.location.href = `/Negocios/ExportLogsExcel?negocioId=${negocioId}`; setTimeout(() => { $.post('/Negocios/EliminarTodosLogs', { negocioId }, function(r) { if (r.success) { tablaLogs.ajax.reload(); $('#btnCerrarPeriodo').addClass('d-none'); swalMG.fire('Periodo Cerrado', r.message, 'success'); } }).fail(xhr => swalMG.fire('Error', xhr.responseJSON?.message || 'Ocurrió un error', 'error')); }, 1500); } }); });

let chartBarVentas = null, chartClientes = null, chartResumen = null; let ventasPeriodoActual = 'dia'; let ventasStatsData = null;
const periodoLabels = { dia: { ingresos: 'Ingresos del Día', gastos: 'Gastos del Día', ganancia: 'Ganancia Neta del Día', resumen: 'Resumen del Día' }, semana: { ingresos: 'Ingresos de la Semana', gastos: 'Gastos de la Semana', ganancia: 'Ganancia Neta de la Semana', resumen: 'Resumen de la Semana' }, mes: { ingresos: 'Ingresos del Mes', gastos: 'Gastos del Mes', ganancia: 'Ganancia Neta del Mes', resumen: 'Resumen del Mes' } };
const periodoKeys = { dia: { ingresos: 'ingresosDia', gastos: 'gastosDia', ganancia: 'gananciaDia' }, semana: { ingresos: 'ingresosSemana', gastos: 'gastosSemana', ganancia: 'gananciaSemana' }, mes: { ingresos: 'ingresosMes', gastos: 'gastosMes', ganancia: 'gananciaMes' } };
function cargarVentasStats() { $.get('/Negocios/GetVentasStats', { negocioId }, function(d) { ventasStatsData = d; actualizarStatCards(); $('#ventasMembresias').text('$' + d.membresias30Dias.toFixed(2)); $('#ventasClientesDiarios').text(d.clientesDiariosHoy); $('#ventasGananciaMes').text('$' + d.gananciaMes.toFixed(2)); }); }
function actualizarStatCards() { if (!ventasStatsData) return; const d = ventasStatsData; const keys = periodoKeys[ventasPeriodoActual]; const labels = periodoLabels[ventasPeriodoActual]; $('#ventasIngresosLabel').text(labels.ingresos); $('#ventasGastosLabel').text(labels.gastos); $('#ventasGananciaLabel').text(labels.ganancia); $('#ventasIngresos').text('$' + d[keys.ingresos].toFixed(2)); $('#ventasGastos').text('$' + d[keys.gastos].toFixed(2)); $('#ventasGanancia').text('$' + d[keys.ganancia].toFixed(2)); $('#chartResumenTitle').text(labels.resumen); }
const chartFont = { fontFamily: 'Inter, sans-serif' };
function cargarCharts() { const isMobile = window.innerWidth < 576; const chartH = isMobile ? 220 : 320; const periodo = ventasPeriodoActual; $.get('/Negocios/GetChartData', { negocioId, periodo }, function(d) { if (chartBarVentas) chartBarVentas.destroy(); chartBarVentas = new ApexCharts(document.querySelector("#chartBarVentas"), { series: [{ name: 'Ingresos', data: d.ingresos }, { name: 'Gastos', data: d.gastos }], chart: { type: 'bar', height: chartH, toolbar: { show: false }, fontFamily: chartFont.fontFamily }, colors: ['#50CD89', '#F1416C'], xaxis: { categories: d.labels, labels: { style: { colors: '#A1A5B7', fontSize: '12px' } }, axisBorder: { show: false }, axisTicks: { show: false } }, yaxis: { labels: { style: { colors: '#A1A5B7', fontSize: '12px' }, formatter: v => '$' + v.toFixed(0) } }, grid: { borderColor: '#EFF2F5', strokeDashArray: 4 }, plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } }, dataLabels: { enabled: false }, legend: { position: 'top', labels: { colors: '#5E6278' }, fontSize: '13px', fontWeight: 500 }, tooltip: { y: { formatter: v => '$' + v.toFixed(2) } } }); chartBarVentas.render(); const totalIngresos = d.ingresos.reduce((a, b) => a + b, 0); const totalGastos = d.gastos.reduce((a, b) => a + b, 0); if (chartResumen) chartResumen.destroy(); chartResumen = new ApexCharts(document.querySelector("#chartResumen"), { series: [totalIngresos || 1, totalGastos || 0], chart: { type: 'donut', height: chartH, fontFamily: chartFont.fontFamily }, labels: ['Ingresos', 'Gastos'], colors: ['#50CD89', '#F1416C'], legend: { position: 'bottom', labels: { colors: '#5E6278' }, fontSize: '13px', fontWeight: 500 }, plotOptions: { pie: { donut: { size: '70%', labels: { show: true, name: { fontSize: '14px', fontWeight: 600 }, value: { fontSize: '20px', fontWeight: 700, formatter: v => '$' + parseFloat(v).toFixed(2) }, total: { show: true, label: 'Balance', fontSize: '13px', color: '#A1A5B7', formatter: w => '$' + w.globals.seriesTotals.reduce((a,b)=>a+b,0).toFixed(2) } } } } }, dataLabels: { enabled: false }, tooltip: { y: { formatter: v => '$' + v.toFixed(2) } } }); chartResumen.render(); }); $.get('/Negocios/GetClientesChartData', { negocioId, periodo }, function(d) { if (chartClientes) chartClientes.destroy(); chartClientes = new ApexCharts(document.querySelector("#chartClientes"), { series: [{ name: 'Nuevos Clientes', data: d.nuevosClientes }], chart: { type: 'area', height: chartH, toolbar: { show: false }, fontFamily: chartFont.fontFamily, sparkline: { enabled: false } }, colors: ['#3E97FF'], xaxis: { categories: d.labels, labels: { style: { colors: '#A1A5B7', fontSize: '12px' } }, axisBorder: { show: false }, axisTicks: { show: false } }, yaxis: { labels: { style: { colors: '#A1A5B7', fontSize: '12px' } } }, grid: { borderColor: '#EFF2F5', strokeDashArray: 4 }, fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05 } }, dataLabels: { enabled: false }, stroke: { curve: 'smooth', width: 3 }, tooltip: { y: { formatter: v => v + ' clientes' } } }); chartClientes.render(); }); if (tablaUsuariosDiarios) { tablaUsuariosDiarios.destroy(); } tablaUsuariosDiarios = $('#tablaUsuariosDiarios').DataTable({ ajax: { url: '/Negocios/GetClientesDiarios', data: { negocioId }, dataSrc: '' }, columns: [ { data: 'nombreCompleto' }, { data: 'telefono', render: d => d || '<span class="text-muted">No registrado</span>' }, { data: 'fechaDeCreacion', render: d => new Date(d).toLocaleDateString('es-MX') } ], pageLength: 5, lengthChange: false, searching: false, info: false }); }
$('#ventasPeriodPills').on('click', '.mg-pill', function() { $('#ventasPeriodPills .mg-pill').removeClass('active'); $(this).addClass('active'); ventasPeriodoActual = $(this).data('periodo'); actualizarStatCards(); cargarCharts(); });
$('#btnRefrescarVentas').click(function() { cargarVentasStats(); cargarCharts(); });
$('#btnEnviarMensajesMasivos').off().click(function() { toastr.info('Usa el botón de WhatsApp en cada cliente para enviar mensajes individuales.'); });

function cargarNotificacionesCount() { $.get('/Negocios/GetNotificacionesCount', { negocioId }, function(d) { const count = d.count; if (count > 0) { $('#topbarNotifBadge').text(count).removeClass('d-none'); $('#sidebarNotifBadge').text(count).removeClass('d-none'); } else { $('#topbarNotifBadge').addClass('d-none'); $('#sidebarNotifBadge').addClass('d-none'); } }); }
function cargarNotificacionesDropdown() { $.get('/Negocios/GetNotificaciones', { negocioId }, function(data) { let html = ''; if (data.length === 0) { html = '<div class="text-center py-4 text-muted"><i class="bi bi-bell-slash fs-2 d-block mb-2"></i>Sin notificaciones</div>'; } else { data.slice(0, 10).forEach(n => { html += `<div class="mg-notification-item ${n.leida ? '' : 'unread'}" data-id="${n.id}"><div class="d-flex align-items-start gap-2"><i class="bi bi-clock-fill ${n.leida ? 'text-muted' : 'text-warning'} mt-1"></i><div><p class="mb-1 small ${n.leida ? 'text-muted' : 'fw-semibold'}">${n.mensaje}</p><small class="text-muted">${new Date(n.fechaCreacion).toLocaleString('es-MX')}</small></div></div></div>`; }); } $('#notifDropdownBody').html(html); }); }
function cargarNotificacionesTab() { $.get('/Negocios/GetNotificaciones', { negocioId }, function(data) { let html = ''; if (data.length === 0) { html = '<div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i><p>No hay notificaciones.</p></div>'; } else { data.forEach(n => { html += `<div class="mg-card p-3 ${n.leida ? '' : 'border-start border-3 border-primary'}"><div class="d-flex align-items-start gap-3"><div class="stat-icon ${n.leida ? 'bg-light' : 'bg-light-warning'}" style="min-width:40px;"><i class="bi bi-clock-fill ${n.leida ? 'text-muted' : 'text-warning'}"></i></div><div class="flex-grow-1"><p class="mb-1 ${n.leida ? 'text-muted' : 'fw-semibold'}">${n.mensaje}</p><small class="text-muted">${new Date(n.fechaCreacion).toLocaleString('es-MX')}</small></div>${!n.leida ? `<button class="btn btn-sm btn-light-primary" onclick="marcarLeida('${n.id}')"><i class="bi bi-check"></i></button>` : ''}</div></div>`; }); } $('#notificacionesList').html(html); }); }
function marcarLeida(id) { $.post('/Negocios/MarcarNotificacionLeida', { id, negocioId }, function(r) { if (r.success) { cargarNotificacionesTab(); cargarNotificacionesCount(); } }); }
$('#bellBtn').on('show.bs.dropdown', function() { cargarNotificacionesDropdown(); });
$('#btnMarcarTodasLeidas, #btnMarcarTodasLeidasTab').click(function() { $.post('/Negocios/MarcarTodasNotificacionesLeidas', { negocioId }, function(r) { if (r.success) { toastr.success(r.message); cargarNotificacionesCount(); cargarNotificacionesDropdown(); cargarNotificacionesTab(); } }); });
$('#btnGenerarNotificaciones').click(function() { const btn = $(this); btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Generando...'); $.post('/Negocios/GenerarNotificaciones', { negocioId }, function(r) { if (r.success) { toastr.success(r.message); cargarNotificacionesTab(); cargarNotificacionesCount(); } }).always(() => { btn.prop('disabled', false).html('<i class="bi bi-arrow-repeat me-2"></i>Generar Notificaciones'); }); });

// ===== RESUMEN TAB =====
let resumenPeriodo = 'dia';
let resumenStatsData = null;
let chartOverview = null;

function saludoHora() {
    const h = new Date().getHours();
    if (h < 12) return 'Buenos días';
    if (h < 18) return 'Buenas tardes';
    return 'Buenas noches';
}

function cargarResumen() {
    $('#resumenSaludo').text(saludoHora());
    $.get('/Negocios/GetVentasStats', { negocioId }, function(d) {
        resumenStatsData = d;
        actualizarResumenCards();
    });
    $.get('/Negocios/GetDashboardStats', { negocioId }, function(d) {
        $('#resumenTotalClientes').text(d.totalClientes);
        $('#resumenActivos').text(d.clientesActivos);
        $('#resumenVencidos').text(d.clientesVencidos);
        $('#resumenNuevosHoy').text(d.clientesNuevosHoy);
        renderProximosVencer(d.proximosVencer);
    });
    cargarChartOverview();
}

function actualizarResumenCards() {
    if (!resumenStatsData) return;
    const d = resumenStatsData;
    const keys = {
        dia: { i: 'ingresosDia', g: 'gastosDia', n: 'gananciaDia' },
        semana: { i: 'ingresosSemana', g: 'gastosSemana', n: 'gananciaSemana' },
        mes: { i: 'ingresosMes', g: 'gastosMes', n: 'gananciaMes' }
    };
    const k = keys[resumenPeriodo];
    $('#resumenIngresos').text('$' + d[k.i].toFixed(2));
    $('#resumenGastos').text('$' + d[k.g].toFixed(2));
    $('#resumenGanancia').text('$' + d[k.n].toFixed(2));
}

function renderProximosVencer(lista) {
    if (!lista || lista.length === 0) {
        $('#proximosVencerList').html('<div class="text-center py-4 text-muted"><i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i><p class="mb-0">Sin membresías próximas a vencer</p></div>');
        $('#resumenProximosCount').text('0');
        return;
    }
    $('#resumenProximosCount').text(lista.length);
    let html = '';
    lista.forEach(function(c) {
        const badgeClass = c.diasRestantes <= 1 ? 'bg-danger' : c.diasRestantes <= 3 ? 'bg-warning text-dark' : 'bg-info';
        html += '<div class="d-flex align-items-center gap-3 px-3 py-2 border-bottom">' +
            '<div class="flex-grow-1"><span class="fw-semibold">' + c.nombreCompleto + '</span><br>' +
            '<small class="text-muted">' + new Date(c.fechaQueTermina).toLocaleDateString('es-MX') + '</small></div>' +
            '<span class="badge ' + badgeClass + '">' + c.diasRestantes + 'd</span></div>';
    });
    $('#proximosVencerList').html(html);
}

function cargarChartOverview() {
    $.get('/Negocios/GetChartData', { negocioId, periodo: resumenPeriodo }, function(d) {
        if (chartOverview) chartOverview.destroy();
        chartOverview = new ApexCharts(document.querySelector("#chartResumenOverview"), {
            series: [{ name: 'Ingresos', data: d.ingresos }, { name: 'Gastos', data: d.gastos }],
            chart: { type: 'bar', height: window.innerWidth < 576 ? 220 : 280, toolbar: { show: false }, fontFamily: 'Inter, sans-serif' },
            colors: ['#50CD89', '#F1416C'],
            xaxis: { categories: d.labels, labels: { style: { colors: '#A1A5B7', fontSize: '11px' } }, axisBorder: { show: false }, axisTicks: { show: false } },
            yaxis: { labels: { style: { colors: '#A1A5B7', fontSize: '11px' }, formatter: function(v) { return '$' + v.toFixed(0); } } },
            grid: { borderColor: '#EFF2F5', strokeDashArray: 4 },
            plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } },
            dataLabels: { enabled: false },
            legend: { position: 'top', labels: { colors: '#5E6278' }, fontSize: '12px', fontWeight: 500 },
            tooltip: { y: { formatter: function(v) { return '$' + v.toFixed(2); } } }
        });
        chartOverview.render();
    });
}

$('#resumenPeriodPills').on('click', '.mg-pill', function() {
    $('#resumenPeriodPills .mg-pill').removeClass('active');
    $(this).addClass('active');
    resumenPeriodo = $(this).data('periodo');
    actualizarResumenCards();
    cargarChartOverview();
});
</script>
}
