<div id="waDiariosContent">
    <div class="text-center mb-3">
        <span class="badge bg-success fs-6 px-3 py-2" id="waContador">1 / 5</span>
    </div>
    <div class="mg-card mb-3"><div class="card-body text-center">
        <h4 class="fw-bold mb-1" id="waClienteNombre"></h4>
        <p class="text-muted mb-0" id="waClienteTelefono"></p>
    </div></div>
    <div class="p-3 bg-light rounded mb-3" style="font-size: 0.9rem;">
        <p class="mb-0" id="waMensajePreview"></p>
    </div>
    <div class="d-grid">
        <a id="waEnviarLink" href="#" target="_blank" class="btn btn-success btn-lg"><i class="bi bi-whatsapp me-2"></i>Abrir WhatsApp y enviar</a>
    </div>
</div>
<div id="waDiariosFinished" class="text-center d-none">
    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
    <h4 class="fw-bold mt-3">Todos los mensajes listos</h4>
    <p class="text-muted" id="waResumen"></p>
</div>
</div><div class="modal-footer bg-light">
<button type="button" class="btn btn-light" data-bs-dismiss="modal" id="waCerrarBtn">Cancelar</button>
<button type="button" class="btn btn-primary" id="waSiguienteBtn"><i class="bi bi-arrow-right me-2"></i>Siguiente</button>
<button type="button" class="btn btn-success d-none" id="waFinalizarBtn"><i class="bi bi-check-lg me-2"></i>Finalizar y limpiar lista</button>
</div></div></div></div>

@section Scripts {
<script>
// SEGURIDAD: Json.Serialize escapa correctamente para contexto JavaScript
const negocioId = @Json.Serialize(negocioId.ToString());
const negocioNombre = @Json.Serialize(ViewData["NegocioNombre"] as string ?? "");
let tablaClientes, tablaLogs, tablaUsuariosDiarios, tablaMovimientos;
let modoEdicion = false;
const swalMG = Swal.mixin({ confirmButtonColor: '#3E97FF', cancelButtonColor: '#E4E6EF', cancelButtonText: 'Cancelar', reverseButtons: true, customClass: { popup: 'mg-swal-popup', confirmButton: 'mg-swal-confirm', cancelButton: 'mg-swal-cancel' } });

// Función auxiliar para escapar HTML y prevenir XSS
function escHtml(str) {
    if (!str) return '';
    return $('<span>').text(str).html();
}
// SEGURIDAD: escAttr escapa para uso dentro de atributos HTML (onclick, title, etc.)
// Necesario porque escHtml no escapa comillas simples que rompen contexto JavaScript
function escAttr(str) { if (!str) return ''; return escHtml(str).replace(/'/g, '&#39;'); }

$(document).ready(function () {
    cargarResumen();
    cargarNotificacionesCount();
    $.post('/Negocios/GenerarNotificaciones', { negocioId }).fail(function() {
        console.warn('No se pudieron generar notificaciones automáticas');
    });
    verificarSuscripcion();
});

function verificarSuscripcion() {
    $.get('/Negocios/GetSuscripcionStatus', { negocioId }, function(d) {
        // Update trial banner if exists
        var trialText = document.getElementById('trialDaysText');
        if (trialText && d.diasRestantes !== null) {
            if (d.porEmpezar) {
                const inicioStr = new Date(d.fechaPago).toLocaleDateString('es-ES');
                trialText.innerHTML = '- <span class="badge bg-secondary">Por empezar</span> <small>Inicia: ' + inicioStr + '</small>';
            } else if (d.diasRestantes <= 0) {
                trialText.innerHTML = '<span class="badge bg-danger">Expirado</span>';
            } else if (d.diasRestantes === 1) {
                trialText.innerHTML = '- Te queda <strong class="text-danger">1 día</strong>';
            } else {
                trialText.innerHTML = '- Te quedan <strong>' + d.diasRestantes + ' días</strong>';
            }
        }

        if (d.porEmpezar) return;
        if (d.diasRestantes !== null && d.diasRestantes <= 5 && d.diasRestantes >= 0) {
            swalMG.fire({
                title: 'Tu suscripción está por vencer',
                html: `<p>Te quedan <strong>${d.diasRestantes} día(s)</strong> de servicio.</p><p>Contacta a Mi Negocio Oficial para renovar y evitar interrupciones.</p>`,
                icon: 'warning',
                confirmButtonText: '<i class="bi bi-whatsapp me-1"></i> Contactar por WhatsApp',
                confirmButtonColor: '#25D366',
                showCancelButton: true,
                cancelButtonText: 'Cerrar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.open('https://wa.me/593997143142?text=Hola%2C%20mi%20suscripción%20está%20por%20vencer.%20Necesito%20renovar%20mi%20servicio.', '_blank');
                }
            });
        }
    }).fail(function(xhr) {
        console.warn('Error al verificar suscripción');
    });
}
document.addEventListener('mg-tab-shown', function(e) { if (e.detail.tab === 'resumenTab') { cargarResumen(); } else if (e.detail.tab === 'clientesTab') { if (!tablaClientes) { cargarTablaClientes(); } cargarEstadisticas(); } else if (e.detail.tab === 'ventasTab') { cargarVentasStats(); cargarCharts(); } else if (e.detail.tab === 'logsTab') { if (!tablaLogs) cargarTablaLogs(); verificarCerrarPeriodo(); } else if (e.detail.tab === 'notificacionesTab') { cargarNotificacionesTab(); } else if (e.detail.tab === 'inventarioTab') { cargarProductosGrid(); cargarInventarioStats(); } else if (e.detail.tab === 'recibosTab') { cargarRecibos(); verificarCleanupRecibos(); } });

// Cargar estadísticas de la pestaña Clientes
function cargarEstadisticas() {
    $.get('/Negocios/GetDashboardStats', { negocioId }, function(data) {
        $('#totalClientes').text(data.totalClientes);
        $('#clientesActivos').text(data.clientesActivos);
        $('#clientesVencidos').text(data.clientesVencidos);
        $('#ingresosMes').text('$' + data.ingresosMes.toFixed(2));
    }).fail(function(xhr) {
        console.error('Error al cargar estadísticas:');
        toastr.error('Error al cargar estadísticas del negocio');
    });
}
// Cargar tabla de clientes con protección XSS y manejo de errores
function cargarTablaClientes() {
    tablaClientes = $('#clientesTable').DataTable({
        ajax: {
            url: '/Negocios/GetClientes', data: { negocioId }, dataSrc: '',
            error: function(xhr) {
                console.error('Error al cargar clientes:');
                toastr.error('Error al cargar la lista de clientes');
            }
        },
        columns: [
            { data: null, render: function(d, t, r) {
                var tel = r.telefono ? '<a href="tel:' + escHtml(r.telefono) + '" class="text-muted text-decoration-none">' + escHtml(r.telefono) + '</a>' : '-';
                return '<strong>' + escHtml(r.nombreCompleto) + '</strong><br><small>' + tel + '</small>';
            }},
            { data: 'precio', render: function(d) { return '$' + (d || 0).toFixed(2); } },
            { data: 'fechaDeCreacion', render: function(d) { return d ? new Date(d).toLocaleDateString('es-MX') : '-'; } },
            { data: 'fechaQueTermina', render: function(d) { return d ? new Date(d).toLocaleDateString('es-MX') : '-'; } },
            { data: null, render: function(d, t, r) {
                if (r.porEmpezar) return '<span class="badge bg-info">Por empezar</span> <span class="badge bg-light text-dark">' + r.diasRestantes + ' días</span>';
                if (r.diasRestantes < 0) return '<span class="badge bg-danger">Vencido</span>';
                var badgeCls = r.diasRestantes <= 3 ? 'warning' : 'success';
                return '<span class="badge bg-' + badgeCls + '">' + r.diasRestantes + ' días</span>';
            }},
            { data: null, orderable: false, className: 'text-end', render: function(d, t, r) {
                var btns = '';
                var cleanPhone = r.telefono ? r.telefono.replace(/\D/g, '') : '';
                if (cleanPhone.length >= 10) {
                    var waMsg = encodeURIComponent('Hola ' + (r.nombreCompleto || '') + ', te saludamos de ' + (negocioNombre || '') + ', ¿cómo estás hoy?');
                    btns += '<a href="https://wa.me/' + escHtml(cleanPhone) + '?text=' + waMsg + '" target="_blank" rel="noopener" class="btn btn-sm btn-icon btn-light-success me-1" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>';
                }
                // Escapar datos para prevenir inyección en atributos onclick
                var safeId = escHtml(r.clienteId);
                var safeName = escHtml(r.nombreCompleto).replace(/'/g, "\\'");
                var safePrecio = parseFloat(r.precio) || 0;
                var safeFechaFin = r.fechaQueTermina ? r.fechaQueTermina.split('T')[0] : '';
                var safePhone = escHtml(cleanPhone);
                btns += '<button class="btn btn-sm btn-icon btn-light-warning me-1" onclick="abrirModalRenovar(\'' + safeId + '\',\'' + safeName + '\', ' + safePrecio + ', \'' + safeFechaFin + '\', \'' + safePhone + '\')" title="Renovar"><i class="bi bi-arrow-repeat"></i></button>';
                btns += '<button class="btn btn-sm btn-icon btn-light-primary me-1" onclick="editarCliente(\'' + safeId + '\')" title="Editar"><i class="bi bi-pencil"></i></button>';
                btns += '<button class="btn btn-sm btn-icon btn-light-danger" onclick="eliminarCliente(\'' + safeId + '\',\'' + safeName + '\')" title="Eliminar"><i class="bi bi-trash"></i></button>';
                return btns;
            }}
        ],
        order: [[4, 'asc']], responsive: true
    });
}

function toDateInput(d) { const y = d.getFullYear(); const m = String(d.getMonth() + 1).padStart(2, '0'); const dd = String(d.getDate()).padStart(2, '0'); return y + '-' + m + '-' + dd; }
function calcDias() { const inicio = $('#fechaInicio').val(); const fin = $('#fechaFin').val(); if (inicio && fin) { const p1 = inicio.split('-'); const p2 = fin.split('-'); const d1 = new Date(parseInt(p1[0]), parseInt(p1[1]) - 1, parseInt(p1[2])); const d2 = new Date(parseInt(p2[0]), parseInt(p2[1]) - 1, parseInt(p2[2])); const dias = Math.round((d2 - d1) / 86400000); $('#dias').val(dias > 0 ? dias : ''); } }
$('#fechaInicio, #fechaFin').on('change', calcDias);
$('#dias').on('change', function() { const inicio = $('#fechaInicio').val(); const dias = parseInt($(this).val()); if (inicio && dias > 0) { const parts = inicio.split('-'); const fin = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]) + dias); const y = fin.getFullYear(); const m = String(fin.getMonth() + 1).padStart(2, '0'); const d = String(fin.getDate()).padStart(2, '0'); $('#fechaFin').val(y + '-' + m + '-' + d); } });
$('#btnCrearCliente').click(function() { modoEdicion = false; $('#modalTitle').text('Nuevo Cliente'); $('#clienteForm')[0].reset(); $('#clienteId').val(''); $('#fechaInicio').val(toDateInput(new Date())); $('#clienteModal').modal('show'); });
// Guardar cliente con estado de carga y validación
$('#btnGuardarCliente').click(function() {
    if (!$('#clienteForm')[0].checkValidity()) { $('#clienteForm')[0].reportValidity(); return; }
    var url = modoEdicion ? '/Negocios/EditarCliente' : '/Negocios/CrearCliente';
    var btn = $(this);
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');
    $.post(url, $('#clienteForm').serialize(), function(r) {
        if (r.success) {
            $('#clienteModal').modal('hide');
            if (tablaClientes) tablaClientes.ajax.reload();
            cargarEstadisticas();
            if (tablaLogs) tablaLogs.ajax.reload();
            toastr.success(r.message);
        } else {
            toastr.error(r.message || 'Error al guardar');
        }
    }).fail(function(xhr) {
        toastr.error(xhr.responseJSON?.message || 'Error al guardar cliente');
    }).always(function() {
        btn.prop('disabled', false).html(originalHtml);
    });
});
// Editar cliente con manejo de errores
function editarCliente(id) {
    $.get('/Negocios/GetCliente', { id: id, negocioId: negocioId }, function(d) {
        modoEdicion = true;
        $('#modalTitle').text('Editar Cliente');
        $('#clienteId').val(d.clienteId);
        $('#nombre').val(d.nombre);
        $('#apellido').val(d.apellido);
        $('#email').val(d.email);
        $('#telefono').val(d.telefono);
        $('#direccion').val(d.direccion);
        $('#fechaInicio').val(toDateInput(new Date(d.fechaDeCreacion)));
        $('#fechaFin').val(toDateInput(new Date(d.fechaQueTermina)));
        calcDias();
        $('#precio').val(d.precio);
        $('#esDiario').prop('checked', d.esDiario);
        $('#clienteModal').modal('show');
    }).fail(function(xhr) {
        toastr.error(xhr.responseJSON?.message || 'Error al cargar datos del cliente');
    });
}
function eliminarCliente(id, nombre) { swalMG.fire({ title: '¿Estás seguro?', text: `Se eliminará al cliente "${nombre}". Esta acción no se puede deshacer.`, icon: 'warning', showCancelButton: true, confirmButtonColor: '#F1416C', cancelButtonColor: '#3E97FF', confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar' }).then((result) => { if (result.isConfirmed) { $.post('/Negocios/EliminarCliente', { id, negocioId }, function(r) { if (r.success) { tablaClientes.ajax.reload(); cargarEstadisticas(); if (tablaLogs) tablaLogs.ajax.reload(); swalMG.fire('¡Eliminado!', r.message, 'success'); } else { swalMG.fire('Error', r.message || 'No se pudo eliminar', 'error'); } }).fail(xhr => swalMG.fire('Error', xhr.responseJSON?.message || 'Ocurrió un error', 'error')); } }); }

let renovarFechaFinActual = ''; let renovarClienteTelefono = ''; let renovarClienteNombreStr = '';
function abrirModalRenovar(id, nombre, precio, fechaQueTermina, telefono) { $('#renovarClienteId').val(id); $('#renovarClienteNombre').text(nombre); renovarFechaFinActual = fechaQueTermina; renovarClienteTelefono = telefono || ''; renovarClienteNombreStr = nombre; $('#renovarFechaActual').val(new Date(fechaQueTermina).toLocaleDateString('es-MX')); const minDate = new Date(fechaQueTermina); minDate.setDate(minDate.getDate() + 1); $('#renovarNuevaFechaFin').attr('min', toDateInput(minDate)); const defaultFin = new Date(fechaQueTermina); defaultFin.setDate(defaultFin.getDate() + 30); $('#renovarNuevaFechaFin').val(toDateInput(defaultFin)); $('#renovarDiasInfo').text('30'); $('#renovarPrecio').val(precio || ''); $('#renovarModal').modal('show'); }
$('#renovarNuevaFechaFin').on('change', function() { if (renovarFechaFinActual && $(this).val()) { const dias = Math.round((new Date($(this).val()) - new Date(renovarFechaFinActual)) / 86400000); $('#renovarDiasInfo').text(dias > 0 ? dias : 0); } });
$('#btnConfirmarRenovar').click(function() { const id = $('#renovarClienteId').val(); const nuevaFechaFin = $('#renovarNuevaFechaFin').val(); const precio = $('#renovarPrecio').val(); if (!nuevaFechaFin || !precio) { toastr.error('Complete todos los campos'); return; } const btn = $(this); const originalText = btn.html(); btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...'); $.post('/Negocios/RenovarCliente', { id, negocioId, nuevaFechaFin, precio }, function(r) { if (r.success) { $('#renovarModal').modal('hide'); tablaClientes.ajax.reload(); cargarEstadisticas(); if (tablaLogs) tablaLogs.ajax.reload(); const fechaFormateada = new Date(nuevaFechaFin).toLocaleDateString('es-MX'); if (renovarClienteTelefono && renovarClienteTelefono.length >= 10) { const waMsg = encodeURIComponent(`Hola ${renovarClienteNombreStr}, te informamos que tu membresía en ${negocioNombre} ha sido renovada. Ahora tu suscripción termina el ${fechaFormateada}. ¡Gracias!`); swalMG.fire({ title: '¡Renovado!', text: r.message, icon: 'success', confirmButtonText: 'Enviar WhatsApp', confirmButtonColor: '#25D366', showCancelButton: true, cancelButtonText: 'Cerrar' }).then((result) => { if (result.isConfirmed) window.open(`https://wa.me/${renovarClienteTelefono}?text=${waMsg}`, '_blank'); }); } else { swalMG.fire('¡Renovado!', r.message, 'success'); } } }).fail(xhr => { swalMG.fire('Error', xhr.responseJSON?.message || 'Error al renovar', 'error'); }).always(() => { btn.prop('disabled', false).html(originalText); }); });
// Exportar clientes a Excel con estado de carga
$('#btnExportClientesExcel').click(function() {
    var btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Exportando...');
    window.location.href = '/Negocios/ExportClientesExcel?negocioId=' + negocioId;
    setTimeout(function() { btn.prop('disabled', false).html('<i class="bi bi-file-earmark-excel me-2"></i>Exportar'); }, 3000);
});
$('#btnImportarExcel').click(() => $('#importZone').toggleClass('d-none'));
$('#importZone').on('click', () => $('#excelFileInput').click());
$('#excelFileInput').on('change', function() { if (this.files.length) uploadExcel(this.files[0]); });
$('#importZone').on('dragover', e => { e.preventDefault(); $(e.currentTarget).addClass('border-primary'); });
