function actualizarStatCards() { if (!ventasStatsData) return; const d = ventasStatsData; const keys = periodoKeys[ventasPeriodoActual]; const labels = periodoLabels[ventasPeriodoActual]; $('#ventasIngresosLabel').text(labels.ingresos); $('#ventasGastosLabel').text(labels.gastos); $('#ventasGananciaLabel').text(labels.ganancia); $('#ventasIngresos').text('$' + d[keys.ingresos].toFixed(2)); $('#ventasGastos').text('$' + d[keys.gastos].toFixed(2)); $('#ventasGanancia').text('$' + d[keys.ganancia].toFixed(2)); $('#chartResumenTitle').text(labels.resumen); }
const chartFont = { fontFamily: 'Inter, sans-serif' };
// Función principal para cargar todos los gráficos de la pestaña Ventas
function cargarCharts() {
    const isMobile = window.innerWidth < 576;
    const chartH = isMobile ? 220 : 320;
    const periodo = ventasPeriodoActual;

    // Gráfico de barras: Ingresos vs Gastos
    $.get('/Negocios/GetChartData', { negocioId, periodo }, function(d) {
        if (chartBarVentas) chartBarVentas.destroy();
        chartBarVentas = new ApexCharts(document.querySelector("#chartBarVentas"), {
            series: [{ name: 'Ingresos', data: d.ingresos }, { name: 'Gastos', data: d.gastos }],
            chart: { type: 'bar', height: chartH, toolbar: { show: false }, fontFamily: chartFont.fontFamily },
            colors: ['#50CD89', '#F1416C'],
            xaxis: { categories: d.labels, labels: { style: { colors: '#A1A5B7', fontSize: '12px' } }, axisBorder: { show: false }, axisTicks: { show: false } },
            yaxis: { labels: { style: { colors: '#A1A5B7', fontSize: '12px' }, formatter: function(v) { return '$' + v.toFixed(0); } } },
            grid: { borderColor: '#EFF2F5', strokeDashArray: 4 },
            plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } },
            dataLabels: { enabled: false },
            legend: { position: 'top', labels: { colors: '#5E6278' }, fontSize: '13px', fontWeight: 500 },
            tooltip: { y: { formatter: function(v) { return '$' + v.toFixed(2); } } }
        });
        chartBarVentas.render();

        // Gráfico donut: Resumen de Ingresos vs Gastos con ganancia neta central
        const totalIngresos = d.ingresos.reduce(function(a, b) { return a + b; }, 0);
        const totalGastos = d.gastos.reduce(function(a, b) { return a + b; }, 0);
        if (chartResumen) chartResumen.destroy();

        const chartResumenEl = document.querySelector("#chartResumen");

        // Estado vacío cuando no hay datos
        if (totalIngresos === 0 && totalGastos === 0) {
            chartResumenEl.innerHTML = '<div class="text-center py-5">' +
                '<i class="bi bi-pie-chart fs-1 d-block mb-3 text-muted opacity-50"></i>' +
                '<p class="text-muted mb-1 fw-semibold">Sin datos para este periodo</p>' +
                '<small class="text-muted">Registra ingresos o gastos para ver el resumen</small></div>';
            chartResumen = null;
        } else {
            chartResumenEl.innerHTML = '';
            const gananciaNet = totalIngresos - totalGastos;
            const gananciaTexto = (gananciaNet >= 0 ? '+' : '') + '$' + gananciaNet.toFixed(2);

            chartResumen = new ApexCharts(chartResumenEl, {
                series: [totalIngresos, totalGastos],
                chart: {
                    type: 'donut',
                    height: chartH + 30,
                    fontFamily: chartFont.fontFamily,
                    animations: { enabled: true, easing: 'easeinout', speed: 800, animateGradually: { enabled: true, delay: 150 } },
                    dropShadow: { enabled: true, top: 2, left: 0, blur: 6, color: '#000', opacity: 0.08 }
                },
                labels: ['Ingresos', 'Gastos'],
                colors: ['#50CD89', '#F1416C'],
                // Configuración del donut con ganancia neta en el centro
                plotOptions: {
                    pie: {
                        donut: {
                            size: '72%',
                            labels: {
                                show: true,
                                name: { show: true, fontSize: '14px', fontWeight: 600, color: '#A1A5B7', offsetY: -10 },
                                value: {
                                    show: true, fontSize: '22px', fontWeight: 700,
                                    color: gananciaNet >= 0 ? '#50CD89' : '#F1416C',
                                    offsetY: 4,
                                    formatter: function() { return gananciaTexto; }
                                },
                                total: {
                                    show: true, showAlways: true, label: 'Ganancia Neta',
                                    fontSize: '13px', fontWeight: 500, color: '#A1A5B7',
                                    formatter: function() { return gananciaTexto; }
                                }
                            }
                        },
                        expandOnClick: true
                    }
                },
                // Etiquetas mostrando porcentaje Y monto
                dataLabels: {
                    enabled: true,
                    formatter: function(val, opts) {
                        var monto = opts.w.globals.series[opts.seriesIndex];
                        return val.toFixed(1) + '%\n$' + monto.toFixed(2);
                    },
                    style: { fontSize: '12px', fontWeight: 600, colors: ['#fff'] },
                    dropShadow: { enabled: true, top: 1, left: 0, blur: 2, opacity: 0.3 }
                },
                legend: { position: 'bottom', labels: { colors: '#5E6278' }, fontSize: '13px', fontWeight: 500, markers: { width: 12, height: 12, radius: 6 } },
                tooltip: {
                    y: {
                        formatter: function(v) {
                            var total = totalIngresos + totalGastos;
                            return '$' + v.toFixed(2) + ' (' + (total > 0 ? ((v / total) * 100).toFixed(1) : 0) + '%)';
                        }
                    }
                },
                stroke: { show: true, width: 3, colors: ['#fff'] },
                // Degradados para colores más profesionales
                fill: {
                    type: 'gradient',
                    gradient: { shade: 'dark', type: 'vertical', shadeIntensity: 0.15, gradientToColors: ['#7AE8A5', '#FF7B9C'], inverseColors: false, opacityFrom: 1, opacityTo: 0.9, stops: [0, 100] }
                },
                // Animación hover
                states: {
                    hover: { filter: { type: 'darken', value: 0.15 } },
                    active: { filter: { type: 'darken', value: 0.25 } }
                },
                // Responsive para móviles
                responsive: [{
                    breakpoint: 576,
                    options: {
                        chart: { height: 260 },
                        plotOptions: { pie: { donut: { labels: { value: { fontSize: '18px' } } } } },
                        dataLabels: { style: { fontSize: '10px' } }
                    }
                }]
            });
            chartResumen.render();
        }
    }).fail(function(xhr) {
        console.error('Error al cargar datos del gráfico de barras:');
        toastr.error('Error al cargar gráficos de ventas');
    });

    // Gráfico de área: Nuevos Clientes
    $.get('/Negocios/GetClientesChartData', { negocioId, periodo }, function(d) {
        if (chartClientes) chartClientes.destroy();
        chartClientes = new ApexCharts(document.querySelector("#chartClientes"), {
            series: [{ name: 'Nuevos Clientes', data: d.nuevosClientes }],
            chart: { type: 'area', height: chartH, toolbar: { show: false }, fontFamily: chartFont.fontFamily, sparkline: { enabled: false } },
            colors: ['#3E97FF'],
            xaxis: { categories: d.labels, labels: { style: { colors: '#A1A5B7', fontSize: '12px' } }, axisBorder: { show: false }, axisTicks: { show: false } },
            yaxis: { labels: { style: { colors: '#A1A5B7', fontSize: '12px' } } },
            grid: { borderColor: '#EFF2F5', strokeDashArray: 4 },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05 } },
            dataLabels: { enabled: false },
            stroke: { curve: 'smooth', width: 3 },
            tooltip: { y: { formatter: function(v) { return v + ' clientes'; } } }
        });
        chartClientes.render();
    }).fail(function(xhr) {
        console.error('Error al cargar datos del gráfico de clientes:');
        toastr.error('Error al cargar gráfico de clientes');
    });

    // Tabla de usuarios diarios
    if (tablaUsuariosDiarios) { tablaUsuariosDiarios.destroy(); }
    tablaUsuariosDiarios = $('#tablaUsuariosDiarios').DataTable({
        ajax: {
            url: '/Negocios/GetClientesDiarios', data: { negocioId }, dataSrc: '',
            error: function(xhr) { console.error('Error al cargar usuarios diarios:'); toastr.error('Error al cargar usuarios diarios'); }
        },
        columns: [
            { data: 'nombreCompleto', render: function(d) { return $('<span>').text(d || '-').html(); } },
            { data: 'telefono', render: function(d) { return d ? $('<span>').text(d).html() : '<span class="text-muted">No registrado</span>'; } },
            { data: 'fechaDeCreacion', render: function(d) { return new Date(d).toLocaleDateString('es-MX'); } }
        ],
        pageLength: 5, lengthChange: false, searching: false, info: false
    });
}
