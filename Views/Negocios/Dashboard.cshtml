// Subir archivo Excel con validación y manejo de errores
function uploadExcel(file) {
    // Validar tipo de archivo
    var ext = file.name.split('.').pop().toLowerCase();
    if (ext !== 'xlsx' && ext !== 'xls') {
        toastr.error('Solo se permiten archivos Excel (.xlsx, .xls)');
        return;
    }
    var formData = new FormData();
    formData.append('file', file);
    formData.append('negocioId', negocioId);
    // Mostrar estado de carga en la zona de importación
    $('#importZone .card-body').html('<div class="text-center py-5"><span class="spinner-border text-primary mb-3"></span><p class="mb-0">Importando clientes...</p></div>');
    $.ajax({
        url: '/Negocios/ImportarClientesExcel', type: 'POST', data: formData, processData: false, contentType: false,
        success: function(r) {
            var html = '<div class="alert alert-success"><strong>' + (r.clientesCreados || 0) + '</strong> clientes creados</div>';
            if (r.clientesOmitidos > 0) html += '<div class="alert alert-warning"><strong>' + r.clientesOmitidos + '</strong> omitidos (duplicados)</div>';
            if (r.erroresCount > 0) html += '<div class="alert alert-danger"><strong>' + r.erroresCount + '</strong> errores</div>';
            $('#importResultBody').html(html);
            $('#importResultModal').modal('show');
            if (tablaClientes) tablaClientes.ajax.reload();
            cargarEstadisticas();
            $('#importZone').addClass('d-none');
            // Restaurar contenido de la zona de importación
            $('#importZone .card-body').html('<i class="bi bi-cloud-upload fs-1 text-primary mb-3 d-block"></i><h5>Arrastra tu archivo Excel aquí</h5><p class="text-muted">O haz clic para seleccionar (solo Nombre y Apellido son obligatorios)</p><input type="file" id="excelFileInput" accept=".xlsx,.xls" class="d-none">');
        },
        error: function(xhr) {
            toastr.error(xhr.responseJSON?.message || 'Error al importar archivo');
            // Restaurar zona de importación
            $('#importZone .card-body').html('<i class="bi bi-cloud-upload fs-1 text-primary mb-3 d-block"></i><h5>Arrastra tu archivo Excel aquí</h5><p class="text-muted">O haz clic para seleccionar (solo Nombre y Apellido son obligatorios)</p><input type="file" id="excelFileInput" accept=".xlsx,.xls" class="d-none">');
        }
    });
}

