// ═══════════════ VENTAS/REPORTES ═══════════════
let chartBarVentas, chartResumen;

function cargarVentasStats() {
    $.get('/Negocios/GetLogs', { negocioId }, function(logs) {
        var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo');
        var now = new Date(), filtered;
        if (periodo === 'dia') { filtered = logs.filter(function(l) { return new Date(l.fecha).toDateString() === now.toDateString(); }); }
        else if (periodo === 'semana') { var w = new Date(now); w.setDate(w.getDate() - 7); filtered = logs.filter(function(l) { return new Date(l.fecha) >= w; }); }
        else { filtered = logs.filter(function(l) { return new Date(l.fecha).getMonth() === now.getMonth() && new Date(l.fecha).getFullYear() === now.getFullYear(); }); }

        var ingresos = filtered.filter(function(l) { return l.monto > 0; }).reduce(function(s,l) { return s + l.monto; }, 0);
        var gastos = Math.abs(filtered.filter(function(l) { return l.monto < 0; }).reduce(function(s,l) { return s + l.monto; }, 0));
        $('#ventasIngresos').text('$' + ingresos.toFixed(2));
        $('#ventasGastos').text('$' + gastos.toFixed(2));
        $('#ventasGanancia').text('$' + (ingresos - gastos).toFixed(2));

        var labels = {dia:'del Dia', semana:'de la Semana', mes:'del Mes'};
        $('#ventasIngresosLabel').text('Ingresos ' + labels[periodo]);
        $('#ventasGastosLabel').text('Gastos ' + labels[periodo]);
        $('#ventasGananciaLabel').text('Ganancia ' + labels[periodo]);
    });
}

function cargarCharts() {
    $.get('/Negocios/GetLogs', { negocioId }, function(logs) {
        var meses = [], ingArr = [], gasArr = [];
        for (var i = 5; i >= 0; i--) {
            var d = new Date(); d.setMonth(d.getMonth() - i);
            var m = d.toLocaleDateString('es-EC', {month:'short'}); meses.push(m);
            var ml = logs.filter(function(l) { var ld = new Date(l.fecha); return ld.getMonth() === d.getMonth() && ld.getFullYear() === d.getFullYear(); });
            ingArr.push(ml.filter(function(l) { return l.monto > 0; }).reduce(function(s,l) { return s + l.monto; }, 0));
            gasArr.push(Math.abs(ml.filter(function(l) { return l.monto < 0; }).reduce(function(s,l) { return s + l.monto; }, 0)));
        }
        if (chartBarVentas) chartBarVentas.destroy();
        chartBarVentas = new ApexCharts(document.querySelector('#chartBarVentas'), {
            chart: { type: 'bar', height: 300 }, series: [{ name: 'Ingresos', data: ingArr },{ name: 'Gastos', data: gasArr }],
            xaxis: { categories: meses }, colors: ['#50CD89','#F1416C'], plotOptions: { bar: { borderRadius: 4 } }
        });
        chartBarVentas.render();
        actualizarDonut(logs);
    });
}

function actualizarDonut(logs) {
    var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo');
    var now = new Date(), filtered;
    if (periodo === 'dia') { filtered = logs.filter(function(l) { return new Date(l.fecha).toDateString() === now.toDateString(); }); }
    else if (periodo === 'semana') { var w = new Date(now); w.setDate(w.getDate() - 7); filtered = logs.filter(function(l) { return new Date(l.fecha) >= w; }); }
    else { filtered = logs.filter(function(l) { return new Date(l.fecha).getMonth() === now.getMonth() && new Date(l.fecha).getFullYear() === now.getFullYear(); }); }

    var ing = filtered.filter(function(l) { return l.monto > 0; }).reduce(function(s,l) { return s + l.monto; }, 0);
    var gas = Math.abs(filtered.filter(function(l) { return l.monto < 0; }).reduce(function(s,l) { return s + l.monto; }, 0));
    var labels = {dia:'del Dia', semana:'de la Semana', mes:'del Mes'};
    $('#chartResumenTitle').text('Resumen ' + labels[periodo]);

    if (chartResumen) chartResumen.destroy();
    $('#chartResumen').empty();
    if (ing === 0 && gas === 0) {
        $('#chartResumen').html('<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i>Sin datos para este periodo</div>');
        chartResumen = null;
        return;
    }
    chartResumen = new ApexCharts(document.querySelector('#chartResumen'), {
        chart: { type: 'donut', height: 300 },
        series: [ing, gas],
        labels: ['Ingresos','Gastos'],
        colors: ['#50CD89','#F1416C'],
        plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Ganancia', formatter: function() { return '$' + (ing - gas).toFixed(2); } } } } } }
    });
    chartResumen.render();
}

var chartVentasCategoria;
function cargarVentasPorCategoria() {
    var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo') || 'mes';
    $.get('/Negocios/GetVentasPorCategoria', { negocioId, periodo }, function(datos) {
        if (chartVentasCategoria) chartVentasCategoria.destroy();
        $('#chartVentasCategoria').empty();
        if (!datos.length) { $('#chartVentasCategoria').html('<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i>Sin datos</div>'); return; }
        chartVentasCategoria = new ApexCharts(document.querySelector('#chartVentasCategoria'), {
            chart: { type: 'donut', height: 300 },
            series: datos.map(function(d) { return d.totalVentas; }),
            labels: datos.map(function(d) { return d.categoria; }),
            plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Total', formatter: function(w) { return '$' + w.globals.seriesTotals.reduce(function(a,b){return a+b;},0).toFixed(2); } } } } } }
        });
        chartVentasCategoria.render();
    });
}

var chartProductosMasVendidos;
function cargarProductosMasVendidos() {
    var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo') || 'mes';
    $.get('/Negocios/GetProductosMasVendidos', { negocioId, periodo }, function(datos) {
        if (chartProductosMasVendidos) chartProductosMasVendidos.destroy();
        $('#chartProductosMasVendidos').empty();
        if (!datos.length) { $('#chartProductosMasVendidos').html('<div class="text-center py-5 text-muted"><i class="bi bi-trophy fs-1 d-block mb-2"></i>Sin ventas</div>'); return; }
        chartProductosMasVendidos = new ApexCharts(document.querySelector('#chartProductosMasVendidos'), {
            chart: { type: 'bar', height: 300, toolbar: { show: false } },
            series: [{ name: 'Unidades', data: datos.map(function(d) { return d.unidades; }) }],
            xaxis: { categories: datos.map(function(d) { return d.producto; }), labels: { style: { fontSize: '11px' }, rotate: -45, maxHeight: 80 } },
            plotOptions: { bar: { borderRadius: 4, columnWidth: '60%', distributed: true } },
            colors: ['#3E97FF', '#50CD89', '#F1416C', '#FFC700', '#7239EA', '#00B2FF', '#E4E6EF', '#F59E0B', '#8B5CF6', '#EC4899'],
            dataLabels: { enabled: true, style: { fontSize: '12px', fontWeight: 'bold' } },
            tooltip: { y: { formatter: function(val, opts) { var d = datos[opts.dataPointIndex]; return val + ' uds — $' + d.totalVentas.toFixed(2); } } },
            legend: { show: false }
        });
        chartProductosMasVendidos.render();
    });
}

$('#ventasPeriodPills').on('click', '.mg-pill', function() {
