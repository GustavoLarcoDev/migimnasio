// ── Category folder rendering ──
function renderCategoryFolders() {
    var container = $('#invCategoryFolders');
    var activeVal = container.find('.inv-folder.active').data('cat');
    container.empty();

    var countMap = {}, uncategorized = 0;
    productosCache.forEach(function(p) {
        if (p.categoriaProductoId) countMap[p.categoriaProductoId] = (countMap[p.categoriaProductoId] || 0) + 1;
        else uncategorized++;
    });

    var total = productosCache.length;

    // "Todos" folder
    container.append(
        '<div class="col-xl-2 col-lg-3 col-md-4 col-6">' +
            '<div class="inv-folder' + (!activeVal && activeVal !== 'none' ? ' active' : '') + '" data-cat="" data-folder>' +
                '<div class="inv-folder-icon-wrap">' +
                    '<i class="bi bi-grid-3x3-gap-fill"></i>' +
                '</div>' +
                '<div class="inv-folder-name">Todos</div>' +
                '<div class="inv-folder-count">' + total + ' producto' + (total !== 1 ? 's' : '') + '</div>' +
            '</div>' +
        '</div>'
    );

    categoriasCache.forEach(function(cat) {
        var count = countMap[cat.categoriaId] || 0;
        container.append(
            '<div class="col-xl-2 col-lg-3 col-md-4 col-6">' +
                '<div class="inv-folder' + (activeVal === cat.categoriaId ? ' active' : '') + '" data-cat="' + cat.categoriaId + '" data-folder>' +
                    '<button class="inv-folder-delete" onclick="event.stopPropagation();eliminarCategoria(\'' + cat.categoriaId + '\',\'' + escAttr(cat.nombre) + '\')" title="Eliminar">' +
                        '<i class="bi bi-x"></i>' +
                    '</button>' +
                    '<div class="inv-folder-icon-wrap">' +
                        '<i class="bi bi-folder-fill"></i>' +
                    '</div>' +
                    '<div class="inv-folder-name">' + escHtml(cat.nombre) + '</div>' +
                    '<div class="inv-folder-count">' + count + ' producto' + (count !== 1 ? 's' : '') + '</div>' +
                '</div>' +
            '</div>'
        );
    });

    if (uncategorized > 0) {
        container.append(
            '<div class="col-xl-2 col-lg-3 col-md-4 col-6">' +
                '<div class="inv-folder' + (activeVal === 'none' ? ' active' : '') + '" data-cat="none" data-folder>' +
                    '<div class="inv-folder-icon-wrap muted">' +
                        '<i class="bi bi-inbox"></i>' +
                    '</div>' +
                    '<div class="inv-folder-name">Sin Categoria</div>' +
                    '<div class="inv-folder-count">' + uncategorized + ' producto' + (uncategorized !== 1 ? 's' : '') + '</div>' +
                '</div>' +
            '</div>'
        );
    }

    initFolderDropZones();
}

// ── Drag-and-drop: products → folders ──
function initProductDrag() {
    document.querySelectorAll('#productosGrid .inv-card[draggable]').forEach(function(card) {
        card.addEventListener('dragstart', function(e) {
            e.dataTransfer.setData('text/plain', card.dataset.id);
            e.dataTransfer.effectAllowed = 'move';
            setTimeout(function() { card.classList.add('drag-ghost'); }, 0);
        });
        card.addEventListener('dragend', function() {
            card.classList.remove('drag-ghost');
            document.querySelectorAll('.inv-folder.drag-over').forEach(function(f) { f.classList.remove('drag-over'); });
        });
    });
}

function initFolderDropZones() {
    document.querySelectorAll('#invCategoryFolders [data-folder]').forEach(function(folder) {
        folder.addEventListener('dragenter', function(e) { e.preventDefault(); folder.classList.add('drag-over'); });
        folder.addEventListener('dragover', function(e) { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; });
        folder.addEventListener('dragleave', function(e) {
            if (!folder.contains(e.relatedTarget)) folder.classList.remove('drag-over');
        });
        folder.addEventListener('drop', function(e) {
            e.preventDefault();
            folder.classList.remove('drag-over');
            var productoId = e.dataTransfer.getData('text/plain');
            if (!productoId) return;
            var catId = folder.dataset.cat;
            moverProductoACategoria(productoId, catId === '' || catId === 'none' ? null : catId);
        });
    });
}

// ── Cambiar categoria via selección (fallback para móvil) ──
function cambiarCategoriaProducto(productoId, nombre, categoriaActualId) {
    var opciones = { '': 'Sin Categoria' };
    categoriasCache.forEach(function(c) { opciones[c.categoriaId] = c.nombre; });

    var htmlOptions = '';
    Object.keys(opciones).forEach(function(key) {
        var selected = (key === categoriaActualId) ? ' selected' : '';
        htmlOptions += '<option value="' + key + '"' + selected + '>' + escHtml(opciones[key]) + '</option>';
    });

    swalMG.fire({
        title: 'Mover "' + escHtml(nombre) + '"',
        html: '<label class="form-label fw-semibold text-start d-block">Selecciona la categoria</label>' +
              '<select id="swalCatSelect" class="form-select">' + htmlOptions + '</select>',
        showCancelButton: true,
        confirmButtonText: '<i class="bi bi-folder-symlink me-1"></i>Mover',
        preConfirm: function() {
            return document.getElementById('swalCatSelect').value;
        }
    }).then(function(result) {
        if (result.isConfirmed) {
            var nuevaCat = result.value;
            if (nuevaCat === categoriaActualId) { toastr.info('El producto ya esta en esa categoria'); return; }
            moverProductoACategoria(productoId, nuevaCat || null);
        }
    });
}

function moverProductoACategoria(productoId, categoriaId) {
    $.ajax({
        url: '/Negocios/MoverProductoDeCategoria',
        type: 'POST',
        data: { productoId: productoId, negocioId: negocioId, categoriaId: categoriaId || '' },
        success: function(r) {
            if (r.success) {
                toastr.success(r.message || 'Producto movido');
                // Refresh all views sequentially to ensure fresh data
                $.get('/Negocios/GetProductos', { negocioId: negocioId }, function(prods) {
                    productosCache = prods;
                    cargarInventarioCategorias();
                    cargarProductosGrid();
                    cargarPOS();
                });
            } else {
                toastr.error(r.message || 'Error al mover producto');
            }
        },
        error: function(xhr) {
            console.error('MoverProducto failed:', xhr.status, xhr.responseText);
            toastr.error('Error al mover producto');
        }
    });
}

function eliminarCategoria(id, nombre) {
    swalMG.fire({
        title: 'Eliminar categoria?',
        text: 'Se eliminara "' + nombre + '". Los productos se moveran a "Sin Categoria".',
        icon: 'warning', showCancelButton: true, confirmButtonColor: '#F1416C', confirmButtonText: 'Si, eliminar'
    }).then(function(result) {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarCategoria', { id, negocioId }, function(r) {
                if (r.success) { toastr.success(r.message); cargarProductosGrid(); cargarInventarioCategorias(); cargarPOS(); }
                else toastr.error(r.message);
            }).fail(function() { toastr.error('Error al eliminar categoria'); });
        }
    });
}

function subirImagenProducto(productoId) {
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = '.jpg,.jpeg,.png,.webp';
    input.onchange = function() {
        if (!input.files[0]) return;
        var formData = new FormData();
        formData.append('productoId', productoId);
        formData.append('negocioId', negocioId);
        formData.append('imagen', input.files[0]);
        $.ajax({
            url: '/Negocios/SubirImagenProducto',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function(r) {
                if (r.success) { toastr.success('Imagen subida'); cargarProductosGrid(); cargarPOS(); }
                else toastr.error(r.message);
            },
            error: function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al subir imagen'); }
        });
    };
    input.click();
}

function venderRapido(productoId) {
    var stockEl = $('#stock-' + productoId);
    var stockActual = parseInt(stockEl.text());
    if (stockActual <= 0) { toastr.warning('No hay stock disponible'); return; }

    mostrarModalPago(function(resultado) {
        var cardEl = stockEl.closest('.inv-card');
        cardEl.addClass('inv-card-selling');
        stockEl.text(parseInt(stockEl.text()) - 1);
        $.post('/Negocios/VenderProducto', {
            productoId: productoId,
            negocioId: negocioId,
            cantidad: 1,
            metodoPago: resultado.metodoPago,
            numeroConfirmacion: resultado.numeroConfirmacion
        }, function(r) {
            if (r.success) {
                toastr.success(r.message);
                cargarInventarioStats();
                if (tablaMovimientos) tablaMovimientos.ajax.reload();
                if (tablaLogs) tablaLogs.ajax.reload();
                setTimeout(function() { cargarProductosGrid(); }, 300);
            } else { toastr.error(r.message); cargarProductosGrid(); }
        }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al vender'); cargarProductosGrid(); })
          .always(function() { setTimeout(function() { cardEl.removeClass('inv-card-selling'); }, 300); });
    });
}

function accionSubir(productoId, nombre, precio, stockActual) {
    swalMG.fire({
        title: escHtml(nombre),
        html: '<p class="text-muted mb-0">Stock actual: <strong>' + stockActual + '</strong> | Precio: <strong>$' + precio.toFixed(2) + '</strong></p>',
        icon: 'question', showCancelButton: true, showDenyButton: true,
        confirmButtonText: '<i class="bi bi-arrow-return-left me-1"></i>Devolver Producto',
        denyButtonText: '<i class="bi bi-pencil-square me-1"></i>Actualizar Inventario',
        confirmButtonColor: '#FFC700', denyButtonColor: '#3E97FF'
    }).then(function(result) {
        if (result.isConfirmed) {
            swalMG.fire({
                title: 'Devolver: ' + escHtml(nombre),
                html: '<div class="text-start"><div class="mb-3"><label class="form-label fw-semibold">Cantidad a devolver</label><input type="number" id="swalDevCant" class="form-control" value="1" min="1"></div><div class="mb-3"><label class="form-label fw-semibold">Razon de la devolucion</label><textarea id="swalDevNota" class="form-control" rows="2" placeholder="Ej: Cliente cambio de opinion"></textarea></div></div>',
                showCancelButton: true, confirmButtonText: '<i class="bi bi-check-lg me-1"></i>Confirmar Devolucion', confirmButtonColor: '#FFC700',
                preConfirm: function() {
                    var cant = parseInt(document.getElementById('swalDevCant').value);
                    var nota = document.getElementById('swalDevNota').value.trim();
                    if (!cant || cant <= 0) { Swal.showValidationMessage('Cantidad invalida'); return false; }
                    if (!nota) { Swal.showValidationMessage('La razon es obligatoria'); return false; }
                    return { cantidad: cant, nota: nota };
                }
            }).then(function(res) {
                if (res.isConfirmed) {
                    $.post('/Negocios/DevolverProducto', { productoId, negocioId, cantidad: res.value.cantidad, nota: res.value.nota }, function(r) {
                        if (r.success) { toastr.success(r.message); cargarProductosGrid(); cargarInventarioStats(); if (tablaMovimientos) tablaMovimientos.ajax.reload(); if (tablaLogs) tablaLogs.ajax.reload(); }
                        else { toastr.error(r.message); }
                    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al devolver'); });
                }
            });
        } else if (result.isDenied) {
            swalMG.fire({
                title: 'Actualizar: ' + escHtml(nombre),
                html: '<div class="text-start"><p class="text-muted">Stock en sistema: <strong>' + stockActual + '</strong></p><div class="mb-3"><label class="form-label fw-semibold">Stock real (contado)</label><input type="number" id="swalAjusteStock" class="form-control" min="0" placeholder="Cuantos tienes realmente?"></div><div class="mb-3"><label class="form-label fw-semibold">Nota</label><textarea id="swalAjusteNota" class="form-control" rows="2" placeholder="Ej: Reabastecimiento, conteo fisico"></textarea></div><div id="swalAjusteDiff"></div></div>',
                showCancelButton: true, confirmButtonText: '<i class="bi bi-check-lg me-1"></i>Actualizar Stock',
                didOpen: function() {
                    document.getElementById('swalAjusteStock').addEventListener('input', function() {
                        var real = parseInt(this.value), diffDiv = document.getElementById('swalAjusteDiff');
                        if (isNaN(real)) { diffDiv.innerHTML = ''; return; }
                        var diff = real - stockActual;
                        if (diff === 0) diffDiv.innerHTML = '<div class="p-2 rounded bg-light text-center"><span class="text-muted fw-bold">Sin cambio</span></div>';
                        else if (diff > 0) diffDiv.innerHTML = '<div class="p-2 rounded text-center" style="background:#E8FFF3"><span class="text-success fw-bold">+' + diff + ' unidades</span></div>';
                        else diffDiv.innerHTML = '<div class="p-2 rounded text-center" style="background:#FFF5F8"><span class="text-danger fw-bold">' + diff + ' unidades (posible perdida)</span></div>';
                    });
                },
                preConfirm: function() {
                    var stockReal = parseInt(document.getElementById('swalAjusteStock').value);
                    var nota = document.getElementById('swalAjusteNota').value.trim();
                    if (isNaN(stockReal) || stockReal < 0) { Swal.showValidationMessage('Ingrese un stock valido'); return false; }
                    if (!nota) { Swal.showValidationMessage('La nota es obligatoria'); return false; }
                    if (stockReal === stockActual) { Swal.showValidationMessage('El stock es igual, no hay cambio'); return false; }
                    return { stockReal: stockReal, nota: nota };
                }
            }).then(function(res) {
                if (res.isConfirmed) {
                    $.post('/Negocios/AjustarStock', { productoId, negocioId, stockReal: res.value.stockReal, nota: res.value.nota }, function(r) {
                        if (r.success) { toastr.success(r.message); cargarProductosGrid(); cargarInventarioStats(); if (tablaMovimientos) tablaMovimientos.ajax.reload(); if (tablaLogs) tablaLogs.ajax.reload(); }
                        else { toastr.error(r.message); }
                    }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al ajustar'); });
                }
            });
        }
    });
}

function cargarTablaMovimientos() {
    if (tablaMovimientos) tablaMovimientos.destroy();
    tablaMovimientos = $('#movimientosTable').DataTable({
        ajax: { url: '/Negocios/GetMovimientos', data: { negocioId }, dataSrc: '' },
        columns: [
            { data: 'fecha', render: function(d, type) { if (type === 'sort') return d; return new Date(d).toLocaleString('es-EC'); } },
            { data: 'nombreProducto', render: function(d) { return escHtml(d); } },
            { data: 'tipo', render: function(d) { return '<span class="badge ' + (tipoMovBadges[d] || 'bg-secondary') + '">' + (tipoMovLabels[d] || d) + '</span>'; } },
            { data: 'cantidad' },
            { data: 'total', render: function(d) { return '$' + d.toFixed(2); } },
            { data: null, render: function(d, t, r) { return r.stockAnterior + ' -> ' + r.stockNuevo; } },
            { data: 'nota', render: function(d) { return d ? '<small>' + escHtml(d) + '</small>' : '<span class="text-muted">-</span>'; } }
