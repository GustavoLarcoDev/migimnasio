    if (tab === 'posTab') { cargarPOS(); }
    else if (tab === 'inventarioTab') { cargarInventarioCategorias(); cargarProductosGrid(); cargarInventarioStats(); }
    else if (tab === 'proveedoresTab') { cargarProveedores(); }
    else if (tab === 'catalogoTab') { cargarCatalogo(); }
    else if (tab === 'logsTab') { if (!tablaLogs) cargarTablaLogs(); }
    else if (tab === 'ventasTab') { cargarVentasStats(); cargarCharts(); cargarVentasPorCategoria(); cargarProductosMasVendidos(); }
    else if (tab === 'recibosTab') { cargarRecibos(); verificarCleanupRecibos(); }
    else if (tab === 'notificacionesTab') { cargarNotificacionesTab(); }
    else if (tab === 'metodosPagoTab') { cargarMetodosPago(); }
});

// ═══════════════ MÉTODOS DE PAGO ═══════════════

function cargarMetodosPago() {
    Promise.all([
        $.get('/Negocios/GetPaymentStatsByMethod', { negocioId: negocioId }),
        $.get('/Negocios/GetMetodosPago', { negocioId: negocioId })
    ]).then(function(results) {
        var statsData = results[0];
        var methods = results[1];
        var statsMap = {};
        statsData.forEach(function(s) { statsMap[s.metodoPago.toLowerCase()] = s; });
        var grid = $('#metodosPagoGrid');
        grid.empty();
        var efectivoStats = statsMap['efectivo'] || { totalHoy: 0, totalSemana: 0, totalMes: 0, cantidadMes: 0 };
        grid.append(renderMetodoPagoCard(null, 'Efectivo', null, null, true, false, efectivoStats));
        methods.forEach(function(mp) {
            var mpStats = statsMap[mp.nombre.toLowerCase()] || { totalHoy: 0, totalSemana: 0, totalMes: 0, cantidadMes: 0 };
            grid.append(renderMetodoPagoCard(mp.metodoPagoId, mp.nombre, mp.numeroCuenta, mp.nombreTitular, false, mp.esPredeterminado, mpStats, mp.imagenQR));
        });
    }).fail(function() { toastr.error('Error al cargar métodos de pago'); });
}

function renderMetodoPagoCard(id, nombre, numeroCuenta, nombreTitular, isEfectivo, esPredeterminado, stats, imagenQR) {
    var icon = isEfectivo ? 'bi-cash-stack' : 'bi-bank';
    var qrIcon = imagenQR ? ' <i class="bi bi-qr-code ms-1 text-success" title="Tiene código QR"></i>' : '';
    var defaultBadge = (isEfectivo || esPredeterminado) ? '<span class="badge bg-success bg-opacity-10 text-success mt-1">Predeterminado</span>' : '';
    var menuHtml = '';
    if (!isEfectivo) {
        menuHtml = `<div class="dropdown position-absolute" style="top: 10px; right: 10px;"><button class="btn btn-sm btn-light" data-bs-toggle="dropdown" style="border-radius: 8px;"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu dropdown-menu-end"><li><a class="dropdown-item" href="#" onclick="editarMetodoPago('${id}')"><i class="bi bi-pencil me-2"></i>Editar</a></li>${!esPredeterminado ? `<li><a class="dropdown-item" href="#" onclick="setPredeterminado('${id}')"><i class="bi bi-star me-2"></i>Predeterminado</a></li>` : ''}<li><hr class="dropdown-divider"></li><li><a class="dropdown-item text-danger" href="#" onclick="eliminarMetodoPago('${id}', '${nombre}')"><i class="bi bi-trash me-2"></i>Eliminar</a></li></ul></div>`;
    }
    return `<div class="col-md-4 col-sm-6"><div class="card border-0 shadow-sm h-100" style="border-radius: 16px; background: var(--mg-card-bg);"><div class="card-body p-4 position-relative">${menuHtml}<div class="d-flex align-items-center mb-3"><div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; min-width: 48px; background: var(--mg-primary-light, rgba(62, 151, 255, 0.1));"><i class="bi ${icon} fs-5" style="color: var(--mg-primary);"></i></div><div><h6 class="mb-0 fw-bold" style="color: var(--mg-text-color);">${nombre}${qrIcon}</h6>${numeroCuenta ? `<small class="text-muted">${numeroCuenta}</small>` : ''}${nombreTitular ? `<small class="text-muted d-block">${nombreTitular}</small>` : ''}${defaultBadge}</div></div><div class="border-top pt-3" style="border-color: var(--mg-border-color) !important;"><div class="row text-center g-0"><div class="col-4"><small class="text-muted d-block" style="font-size: 0.7rem;">Hoy</small><strong class="d-block" style="color: var(--mg-primary); font-size: 1rem;">$${(stats.totalHoy || 0).toFixed(2)}</strong></div><div class="col-4"><small class="text-muted d-block" style="font-size: 0.7rem;">Semana</small><strong class="d-block" style="color: var(--mg-text-color); font-size: 1rem;">$${(stats.totalSemana || 0).toFixed(2)}</strong></div><div class="col-4"><small class="text-muted d-block" style="font-size: 0.7rem;">Mes</small><strong class="d-block" style="color: var(--mg-text-color); font-size: 1rem;">$${(stats.totalMes || 0).toFixed(2)}</strong></div></div><div class="text-center mt-2"><small class="text-muted" style="font-size: 0.7rem;">${stats.cantidadMes || 0} transacciones este mes</small></div></div></div></div></div>`;
}

function abrirModalMetodoPago() {
    $('#mpId').val('');
    $('#formMetodoPago')[0].reset();
    $('#mpQrPreview').hide();
    $('#modalMetodoPagoTitle').text('Nuevo Método de Pago');
    new bootstrap.Modal('#modalMetodoPago').show();
}

function editarMetodoPago(id) {
    $.get('/Negocios/GetMetodoPago', { negocioId: negocioId, metodoPagoId: id }, function(data) {
        $('#mpId').val(data.metodoPagoId);
        $('#mpNombre').val(data.nombre);
        $('#mpNumeroCuenta').val(data.numeroCuenta || '');
        $('#mpCedula').val(data.cedula || '');
        $('#mpNombreTitular').val(data.nombreTitular || '');
        $('#mpInstrucciones').val(data.instrucciones || '');
        $('#mpPredeterminado').prop('checked', data.esPredeterminado);

        if (data.imagenQR) {
            $('#mpQrImg').attr('src', data.imagenQR);
            $('#mpQrPreview').show();
        } else {
            $('#mpQrPreview').hide();
        }

        $('#modalMetodoPagoTitle').text('Editar Método de Pago');
        new bootstrap.Modal('#modalMetodoPago').show();
    });
}

function guardarMetodoPago() {
    var nombre = $('#mpNombre').val().trim();
    if (!nombre) { toastr.warning('El nombre es requerido'); return; }

    var id = $('#mpId').val();
    var url = id ? '/Negocios/EditarMetodoPago' : '/Negocios/CrearMetodoPago';

    var formData = new FormData();
    formData.append('NegocioId', negocioId);
    formData.append('Nombre', nombre);
    formData.append('NumeroCuenta', $('#mpNumeroCuenta').val());
    formData.append('Cedula', $('#mpCedula').val());
    formData.append('NombreTitular', $('#mpNombreTitular').val());
    formData.append('Instrucciones', $('#mpInstrucciones').val());
    formData.append('EsPredeterminado', $('#mpPredeterminado').is(':checked'));
    if (id) formData.append('MetodoPagoId', id);

    $.ajax({
        url: url,
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
        success: function(r) {
            if (r.success) {
                toastr.success(r.message);
                bootstrap.Modal.getInstance('#modalMetodoPago')?.hide();
                cargarMetodosPago();

                var qrFile = $('#mpQrFile')[0].files[0];
                var mpId = id || r.metodoPagoId;
                if (qrFile && mpId) {
                    subirQR(mpId, qrFile);
                }
            } else {
                toastr.error(r.message);
            }
        },
        error: function() { toastr.error('Error al guardar'); }
    });
}

function subirQR(metodoPagoId, file) {
    var fd = new FormData();
    fd.append('negocioId', negocioId);
    fd.append('metodoPagoId', metodoPagoId);
    fd.append('imagen', file);

    $.ajax({
        url: '/Negocios/SubirImagenQR',
        type: 'POST',
        data: fd,
        processData: false,
        contentType: false,
        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
        success: function(r) {
            if (r.success) {
                toastr.success('QR subido correctamente');
                cargarMetodosPago();
            }
        }
    });
}

function eliminarQR() {
    var id = $('#mpId').val();
    if (!id) return;

    $.post('/Negocios/EliminarImagenQR', {
        negocioId: negocioId,
        metodoPagoId: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
    }, function(r) {
        if (r.success) {
            $('#mpQrPreview').hide();
            $('#mpQrFile').val('');
            toastr.success('QR eliminado');
        }
    });
}

function eliminarMetodoPago(id, nombre) {
    Swal.fire({
        title: '¿Eliminar método de pago?',
        text: `Se eliminará "${nombre}"`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then(result => {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarMetodoPago', {
                negocioId: negocioId,
                metodoPagoId: id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(r) {
                if (r.success) {
                    toastr.success(r.message);
                    cargarMetodosPago();
                } else {
                    toastr.error(r.message);
                }
            });
        }
    });
}

function setPredeterminado(id) {
    $.post('/Negocios/SetMetodoPagoPredeterminado', {
        negocioId: negocioId,
        metodoPagoId: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
    }, function(r) {
        if (r.success) {
            toastr.success(r.message);
            cargarMetodosPago();
        } else {
            toastr.error(r.message);
        }
    });
}

</script>
}
