        ajax: { url: '/Negocios/GetRecibos', data: { negocioId }, dataSrc: '' },
        columns: [
            { data: 'numeroRecibo', render: function(d) { return '<span class="badge bg-primary">#' + d + '</span>'; } },
            { data: 'destinatarioNombre' },
            { data: 'concepto', render: function(d) { return d && d.length > 40 ? d.substring(0,40)+'...' : d; } },
            { data: 'monto', render: function(d) { return '$' + parseFloat(d).toFixed(2); } },
