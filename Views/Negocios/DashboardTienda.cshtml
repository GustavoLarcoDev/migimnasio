function agregarAlCarrito(productoId) {
    var producto = productosCache.find(function(p) { return p.productoId === productoId; });
    if (!producto || producto.stock <= 0) return;

    var existing = posCart.find(function(c) { return c.productoId === productoId; });
    if (existing) {
        if (existing.cantidad >= producto.stock) {
            toastr.warning('No hay mas stock de ' + producto.nombre);
            return;
        }
        existing.cantidad++;
    } else {
        posCart.push({
            productoId: producto.productoId,
            nombre: producto.nombre,
            precioVenta: producto.precioVenta,
            cantidad: 1,
            stock: producto.stock,
            imagenUrl: producto.imagenUrl || ''
        });
    }
    renderCart();
}

function renderCart() {
    var container = $('#posCartItems');
    container.empty();

    if (!posCart.length) {
        container.html('<div class="text-center py-5 text-muted" id="posCartEmpty"><i class="bi bi-cart3 fs-1 d-block mb-2 opacity-50"></i><p>Selecciona productos para agregar</p></div>');
        $('#btnCobrar').prop('disabled', true);
        calcularTotales();
        return;
    }

    posCart.forEach(function(item, i) {
        var imgTag = item.imagenUrl
            ? '<img src="' + escAttr(item.imagenUrl) + '" class="pos-cart-img" alt="">'
            : '<div class="pos-cart-img-placeholder"><i class="bi bi-box"></i></div>';
        container.append(
            '<div class="pos-cart-item">' +
                imgTag +
                '<div class="pos-cart-name">' + escHtml(item.nombre) + '</div>' +
                '<div class="pos-cart-qty">' +
                    '<button class="btn btn-sm btn-outline-secondary" onclick="cambiarCantidad(' + i + ', -1)"><i class="bi bi-dash"></i></button>' +
                    '<span class="fw-bold px-2">' + item.cantidad + '</span>' +
                    '<button class="btn btn-sm btn-outline-secondary" onclick="cambiarCantidad(' + i + ', 1)"><i class="bi bi-plus"></i></button>' +
                '</div>' +
                '<div class="pos-cart-subtotal">$' + (item.precioVenta * item.cantidad).toFixed(2) + '</div>' +
                '<button class="btn btn-sm btn-outline-danger" onclick="quitarDelCarrito(' + i + ')"><i class="bi bi-x"></i></button>' +
            '</div>'
        );
    });

    $('#btnCobrar').prop('disabled', false);
    calcularTotales();
}

function cambiarCantidad(index, delta) {
    var item = posCart[index];
    if (!item) return;
    item.cantidad += delta;
    if (item.cantidad <= 0) {
        quitarDelCarrito(index);
        return;
    }
    if (item.cantidad > item.stock) {
        item.cantidad = item.stock;
        toastr.warning('Stock maximo: ' + item.stock);
    }
    renderCart();
}

function quitarDelCarrito(index) {
    var item = posCart[index];
    swalMG.fire({
        title: 'Quitar producto',
        text: 'Quitar "' + item.nombre + '" del carrito?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Si, quitar',
        confirmButtonColor: '#F1416C'
    }).then(function(result) {
        if (result.isConfirmed) {
            posCart.splice(index, 1);
            renderCart();
        }
    });
}

function calcularTotales() {
    var subtotal = posCart.reduce(function(s, item) { return s + (item.precioVenta * item.cantidad); }, 0);
    var ivaPct = parseFloat($('#posIva').val()) || 0;
    var descPct = parseFloat($('#posDescuento').val()) || 0;
    var montoIva = subtotal * (ivaPct / 100);
    var montoDescuento = subtotal * (descPct / 100);
    var total = subtotal + montoIva - montoDescuento;
    if (total < 0) total = 0;

    $('#posSubtotal').text('$' + subtotal.toFixed(2));
    $('#posIvaMonto').text('$' + montoIva.toFixed(2));
    $('#posDescuentoDisplay').text('-$' + montoDescuento.toFixed(2));
    $('#posTotal').text('$' + total.toFixed(2));
}

$('#posIva, #posDescuento').on('input', calcularTotales);

// Cobrar — primero seleccionar metodo de pago, luego confirmar
$('#btnCobrar').on('click', function() {
    if (!posCart.length) return;
    var total = parseFloat($('#posTotal').text().replace('$', ''));

    mostrarModalPago(function(resultado) {
        swalMG.fire({
            title: 'Confirmar Cobro',
            html: '<p class="fs-3 fw-bolder text-success mb-0">$' + total.toFixed(2) + '</p><p class="text-muted">' + posCart.length + ' producto(s)</p><p class="text-muted small mt-1"><i class="bi bi-credit-card me-1"></i>' + escHtml(resultado.metodoPago) + '</p>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-check-lg me-1"></i>Confirmar Pago',
            confirmButtonColor: '#50CD89'
        }).then(function(result) {
            if (result.isConfirmed) {
                procesarVenta(resultado.metodoPago, resultado.numeroConfirmacion);
            }
        });
    });
});

function procesarVenta(metodoPago, numeroConfirmacion) {
    var btn = $('#btnCobrar');
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Procesando...');

    var subtotal = posCart.reduce(function(s, item) { return s + (item.precioVenta * item.cantidad); }, 0);
    var descPct = parseFloat($('#posDescuento').val()) || 0;
    var montoDescuento = subtotal * (descPct / 100);

    var payload = {
        NombreCliente: $('#posNombreCliente').val() || 'Mostrador',
        EmailCliente: '',
        DescuentoAdicional: montoDescuento,
        PorcentajeIva: parseFloat($('#posIva').val()) || 0,
        Items: posCart.map(function(c) { return { ProductoId: c.productoId, Cantidad: c.cantidad }; }),
        MetodoPago: metodoPago || 'Efectivo',
        NumeroConfirmacion: numeroConfirmacion || null
    };

    $.ajax({
        url: '/Negocios/ProcesarVentaPOS',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
        success: function(r) {
            if (r.success) {
                // Reset cart
                posCart = [];
                renderCart();
                $('#posNombreCliente').val('');
                $('#posDescuento').val(0);
                cargarPOS();
                if (tablaLogs) tablaLogs.ajax.reload();
                if (tablaRecibos) tablaRecibos.ajax.reload();

                // Show receipt
                if (r.reciboId) {
                    mostrarReciboVenta(r.reciboId);
                } else {
                    swalMG.fire({ title: 'Venta Exitosa!', text: 'Pago procesado. Recibo guardado.', icon: 'success' });
                }
            } else {
                toastr.error(r.message);
            }
        },
        error: function(xhr) {
            toastr.error(xhr.responseJSON?.message || 'Error al procesar venta');
        },
        complete: function() {
            btn.prop('disabled', false).html('<i class="bi bi-cash-stack me-2"></i>Cobrar');
        }
    });
}

function mostrarReciboVenta(reciboId) {
    $.get('/Negocios/GetRecibo', { reciboId, negocioId }, function(r) {
        if (!r) { swalMG.fire({ title: 'Venta Exitosa!', text: 'Pago procesado.', icon: 'success' }); return; }
        $('#reciboModalNumero').text(r.numeroRecibo);
        document.getElementById('reciboIframe').srcdoc = r.contenidoHtml;

        // Replace modal footer with send options
        var footer = $('#reciboModal .modal-footer');
        footer.html(
            '<button type="button" class="btn btn-success" onclick="enviarReciboPOS(\'' + reciboId + '\',\'whatsapp\')"><i class="bi bi-whatsapp me-2"></i>WhatsApp</button>' +
            '<button type="button" class="btn btn-outline-info" onclick="enviarReciboPOS(\'' + reciboId + '\',\'email\')"><i class="bi bi-envelope me-2"></i>Email</button>' +
            '<button type="button" class="btn btn-outline-primary" onclick="imprimirRecibo()"><i class="bi bi-printer me-2"></i>Imprimir</button>' +
            '<button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>'
        );
        new bootstrap.Modal('#reciboModal').show();
    });
}

function enviarReciboPOS(reciboId, tipo) {
    // Close the Bootstrap modal first so SweetAlert input is not blocked by focus trap
    var reciboModalEl = document.getElementById('reciboModal');
    var bsModal = bootstrap.Modal.getInstance(reciboModalEl);
    if (bsModal) bsModal.hide();

    var isWA = tipo === 'whatsapp';
    var label = isWA ? 'Numero de WhatsApp' : 'Correo Electronico';
    var placeholder = isWA ? 'Ej: 0989799891' : 'Ej: cliente@email.com';
    var hint = isWA ? '<small class="text-muted d-block mt-1"><i class="bi bi-info-circle me-1"></i>El codigo de pais (+593) se agrega automaticamente</small>' : '';
    var inputType = isWA ? 'tel' : 'email';

    setTimeout(function() {
        swalMG.fire({
            title: 'Enviar Recibo',
            html: '<label class="form-label fw-semibold text-start d-block">' + label + '</label>' +
                  '<input type="' + inputType + '" id="swalDestinoRecibo" class="form-control" placeholder="' + placeholder + '">' + hint,
            showCancelButton: true,
            confirmButtonText: '<i class="bi bi-send me-1"></i>Enviar',
            didOpen: function() { document.getElementById('swalDestinoRecibo').focus(); },
            preConfirm: function() {
                var dest = document.getElementById('swalDestinoRecibo').value.trim();
                if (!dest) { Swal.showValidationMessage('Ingresa un destino'); return false; }
                return dest;
            }
        }).then(function(result) {
            if (result.isConfirmed) {
                $.post('/Negocios/EnviarRecibo', { reciboId: reciboId, negocioId: negocioId, destino: result.value, tipo: tipo }, function(r) {
                    if (r.success) toastr.success(r.message || 'Recibo enviado');
                    else toastr.error(r.message || 'Error al enviar');
                }).fail(function() { toastr.error('Error de conexion'); });
            }
        });
    }, 300); // Small delay to let Bootstrap modal fully close
}

function imprimirRecibo() {
    var iframe = document.getElementById('reciboIframe');
    var htmlContent = iframe.srcdoc || iframe.getAttribute('srcdoc');
    if (!htmlContent) { toastr.error('No hay recibo para imprimir'); return; }
    var printWin = window.open('', '_blank', 'width=800,height=600');
    printWin.document.write(htmlContent);
    printWin.document.close();
    printWin.focus();
    setTimeout(function() { printWin.print(); }, 400);
}

