$('#prodImagen').on('change', function() {
    var file = this.files[0];
    var preview = $('#prodImagenPreview');
    preview.empty();
    if (file) {
        var reader = new FileReader();
        reader.onload = function(e) {
            preview.html('<img src="' + e.target.result + '" style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:2px solid var(--mg-border-color);">');
        };
        reader.readAsDataURL(file);
    }
});

$('#btnGuardarProducto').click(function() {
    if (!$('#productoForm')[0].checkValidity()) { $('#productoForm')[0].reportValidity(); return; }
    var url = modoEdicionProducto ? '/Negocios/EditarProducto' : '/Negocios/CrearProducto';
    var btn = $(this);
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Guardando...');
    var imageFile = document.getElementById('prodImagen').files[0];
    var cerrarYRecargar = function(msg) {
        $('#productoModal').modal('hide');
        cargarProductosGrid(); cargarInventarioStats(); cargarPOS();
        if (tablaLogs) tablaLogs.ajax.reload();
        toastr.success(msg);
    };
    var subirImagen = function(prodId, msg) {
        var formData = new FormData();
        formData.append('productoId', prodId);
        formData.append('negocioId', negocioId);
        formData.append('imagen', imageFile);
        $.ajax({
            url: '/Negocios/SubirImagenProducto', type: 'POST', data: formData, processData: false, contentType: false,
            headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
            success: function() { cerrarYRecargar(msg || 'Imagen actualizada'); },
            error: function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al subir imagen'); }
        });
    };
    $.post(url, $('#productoForm').serialize(), function(r) {
        if (r.success) {
            var prodIdForImage = r.dataId || $('#prodId').val();
            if (imageFile && prodIdForImage) { subirImagen(prodIdForImage, r.message); }
            else { cerrarYRecargar(r.message); }
        } else if (imageFile && modoEdicionProducto) {
            // Solo cambió la imagen, no los campos de texto — subir igual
            subirImagen($('#prodId').val(), 'Imagen actualizada');
        } else { toastr.error(r.message || 'Error al guardar'); }
    }).fail(function(xhr) {
        if (imageFile && modoEdicionProducto && xhr.responseJSON?.message?.includes('No se detectaron')) {
            subirImagen($('#prodId').val(), 'Imagen actualizada');
        } else { toastr.error(xhr.responseJSON?.message || 'Error al guardar producto'); }
    }).always(function() { btn.prop('disabled', false).html(originalHtml); });
});

function eliminarProducto(id, nombre) {
