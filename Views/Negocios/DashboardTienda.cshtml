@model Gimnasio.Models.Gym

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard - " + Model.NegocioNombre;
    ViewData["NegocioId"] = Model.NegocioId;
    ViewData["NegocioNombre"] = Model.NegocioNombre;
    ViewData["DuenoNombre"] = Model.DuenoNegocio;
    ViewData["TipoNegocio"] = "tienda";
    var negocioId = Model.NegocioId;
}

@if (Model.EsPrueba)
{
    <div class="alert border-0 d-flex align-items-center gap-3 mb-4 shadow-sm" id="trialBanner"
         style="background: linear-gradient(135deg, #FFF8DD 0%, #FFF3CD 100%); border-left: 4px solid #FFC700 !important;">
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 42px; height: 42px; background: rgba(255, 199, 0, 0.2);">
            <i class="bi bi-hourglass-split text-warning fs-5"></i>
        </div>
        <div class="flex-grow-1">
            <strong class="text-dark">Periodo de prueba</strong>
            <span class="d-block d-sm-inline text-muted ms-sm-1" id="trialDaysText">Cargando...</span>
        </div>
        <a href="https://wa.me/593997143142?text=Hola%2C%20quiero%20activar%20mi%20plan%20de%20pago%20en%20Mi%20Negocio" target="_blank" rel="noopener"
           class="btn btn-warning btn-sm fw-bold flex-shrink-0">
            <i class="bi bi-whatsapp me-1"></i>Activar Plan
        </a>
    </div>
}

<div class="tab-content" id="dashboardTabsContent">

    <!-- ═══════════════ TAB POS ═══════════════ -->
    <div class="tab-pane fade show active" id="posTab" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ventas Hoy</div><div class="stat-value" id="posVentasHoy">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-cart-check text-primary"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Hoy</div><div class="stat-value text-success" id="posIngresosHoy">$0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-currency-dollar text-success"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Productos</div><div class="stat-value" id="posTotalProductos">0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-box-seam text-info"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Stock Bajo</div><div class="stat-value text-danger" id="posStockBajo">0</div></div><div class="stat-icon bg-light-danger"><i class="bi bi-exclamation-triangle-fill text-danger"></i></div></div></div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Products panel -->
            <div class="col-lg-7">
                <div class="mg-card h-100">
                    <div class="card-header border-0 pb-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <h5 class="fw-bold mb-0"><i class="bi bi-grid me-2"></i>Productos</h5>
                            <div class="input-group" style="max-width: 250px;">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" id="posBuscar" placeholder="Buscar producto...">
                            </div>
                        </div>
                        <!-- Category tabs -->
                        <div class="d-flex flex-wrap gap-2 mt-3" id="posCategoryTabs">
                            <button class="mg-pill active" data-cat="">Todos</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-2" id="posProductsGrid"></div>
                    </div>
                </div>
            </div>

            <!-- Cart panel -->
            <div class="col-lg-5">
                <div class="mg-card h-100">
                    <div class="card-header border-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-receipt me-2"></i>Recibo</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <input type="text" class="form-control" id="posNombreCliente" placeholder="Nombre del cliente (opcional)">
                        </div>

                        <div class="flex-grow-1" style="min-height: 200px; max-height: 400px; overflow-y: auto;" id="posCartItems">
                            <div class="text-center py-5 text-muted" id="posCartEmpty">
                                <i class="bi bi-cart3 fs-1 d-block mb-2 opacity-50"></i>
                                <p>Selecciona productos para agregar</p>
                            </div>
                        </div>

                        <hr>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold" id="posSubtotal">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">IVA</span>
                                <input type="number" class="form-control form-control-sm" id="posIva" value="0" min="0" max="100" step="1" style="width: 65px;">
                                <span class="text-muted">%</span>
                            </div>
                            <span class="fw-bold" id="posIvaMonto">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Descuento</span>
                                <input type="number" class="form-control form-control-sm" id="posDescuento" value="0" min="0" max="100" step="1" style="width: 65px;">
                                <span class="text-muted">%</span>
                            </div>
                            <span class="fw-bold text-danger" id="posDescuentoDisplay">-$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <span class="fw-bolder">TOTAL</span>
                            <span class="fw-bolder text-success" id="posTotal">$0.00</span>
                        </div>
                        <button class="btn btn-success btn-lg w-100" id="btnCobrar" disabled>
                            <i class="bi bi-cash-stack me-2"></i>Cobrar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent orders -->
        <div class="mg-card mt-4">
            <div class="card-header border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>Ventas Recientes</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ordenesTable" class="table table-row-bordered align-middle gs-0 gy-3">
                        <thead><tr class="fw-bold text-muted"><th>#</th><th>Cliente</th><th>Items</th><th>Total</th><th>Fecha</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB INVENTARIO ═══════════════ -->
    <div class="tab-pane fade" id="inventarioTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button id="btnCrearProducto" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo Producto</button>
            <button id="btnCrearCategoria" class="btn btn-outline-primary"><i class="bi bi-folder-plus me-2"></i>Nueva Categoria</button>
            <button id="btnExportInventarioExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button>
            <button id="btnToggleMovimientos" class="btn btn-outline-primary"><i class="bi bi-clock-history me-2"></i>Historial</button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Total Productos</div><div class="stat-value" id="invTotalProductos">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-box-seam text-primary"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Stock Bajo</div><div class="stat-value text-warning" id="invStockBajo">0</div></div><div class="stat-icon bg-light-warning"><i class="bi bi-exclamation-triangle-fill text-warning"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ventas Hoy</div><div class="stat-value" id="invVentasHoy">0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-cart-check-fill text-success"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Hoy</div><div class="stat-value text-success" id="invIngresosHoy">$0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-currency-dollar text-info"></i></div></div></div></div>
        </div>

        <div class="d-flex align-items-center gap-2 mb-3 px-2 py-2 rounded-3" style="background: rgba(62,151,255,0.04); border: 1px dashed rgba(62,151,255,0.2);">
            <i class="bi bi-arrows-move text-primary"></i>
            <span class="text-muted small">Arrastra productos sobre las carpetas para organizarlos, o usa el boton <i class="bi bi-folder-symlink"></i></span>
        </div>

        <!-- Category folders + products grid -->
        <div class="row g-3 mb-3" id="invCategoryFolders"></div>
        <div class="row g-3 mb-4" id="productosGrid"></div>

        <div id="movimientosSection" class="d-none">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Historial de Movimientos</h5>
            <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="movimientosTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cant.</th><th>Total</th><th>Stock</th><th>Nota</th></tr></thead><tbody></tbody></table></div></div></div>
        </div>
    </div>

    <!-- ═══════════════ TAB PROVEEDORES ═══════════════ -->
    <div class="tab-pane fade" id="proveedoresTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="fw-bold mb-0">Proveedores</h4>
            <button class="btn btn-primary" id="btnNuevoProveedor"><i class="bi bi-plus-circle me-2"></i>Nuevo Proveedor</button>
        </div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive">
            <table id="proveedoresTable" class="table table-row-bordered align-middle gs-0 gy-3">
                <thead><tr class="fw-bold text-muted"><th>Compania</th><th>Contacto</th><th>Telefono</th><th>Email</th><th class="text-end">Acciones</th></tr></thead>
                <tbody></tbody>
            </table>
        </div></div></div>
    </div>

    <!-- ═══════════════ TAB CATALOGO ═══════════════ -->
    <div class="tab-pane fade" id="catalogoTab" role="tabpanel">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="mg-card mb-4">
                    <div class="card-header border-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-book me-2"></i>Mi Catalogo Online</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button class="mg-pill active catEstiloBtn" data-style="moderno">Moderno</button>
                            <button class="mg-pill catEstiloBtn" data-style="elegante">Elegante</button>
                            <button class="mg-pill catEstiloBtn" data-style="minimalista">Minimalista</button>
                            <button class="mg-pill catEstiloBtn" data-style="vibrante">Vibrante</button>
                            <button class="mg-pill catEstiloBtn" data-style="clasico">Clasico</button>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <a id="catDescargarPdf" class="btn btn-primary" target="_blank"><i class="bi bi-download me-2"></i>Descargar PDF</a>
                            <a id="catAbrirLink" class="btn btn-outline-primary" target="_blank"><i class="bi bi-link-45deg me-2"></i>Abrir Link Publico</a>
                            <button class="btn btn-success" id="btnEnviarCatWhatsapp"><i class="bi bi-whatsapp me-2"></i>Enviar por WhatsApp</button>
                            <button class="btn btn-outline-info" id="btnEnviarCatEmail"><i class="bi bi-envelope me-2"></i>Enviar por Email</button>
                        </div>
                        <div class="border rounded overflow-hidden" style="height: 600px;">
                            <iframe id="catPreviewIframe" style="width:100%;height:100%;border:none;"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB MOVIMIENTOS (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="logsTab" role="tabpanel">
        <div class="mg-card mb-4"><div class="card-body"><h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Registrar Movimiento</h5><div class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label">Descripcion</label><input type="text" class="form-control form-control-lg" id="logDescripcion" placeholder="Ej: Compra de mercaderia"></div><div class="col-md-3"><label class="form-label">Monto ($)</label><input type="number" step="0.01" class="form-control form-control-lg" id="logMonto" placeholder="4 o -15"></div><div class="col-md-3"><button id="btnRegistrarLog" class="btn btn-primary btn-lg w-100"><i class="bi bi-check-lg me-2"></i>Registrar</button></div></div><small class="text-muted mt-2 d-block">Usa valores positivos para ingresos y negativos para gastos</small></div></div>
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center"><small class="text-muted"><i class="bi bi-shield-lock me-1"></i>Los registros son inmutables</small><div class="ms-auto d-flex gap-2"><button id="btnExportLogsExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button></div></div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="logsTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Descripcion</th><th>Tipo</th><th>Cliente</th><th>Monto</th><th>Fecha</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    <!-- ═══════════════ TAB REPORTES (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="ventasTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2"><div class="mg-period-pills" id="ventasPeriodPills"><button class="mg-pill active" data-periodo="dia">Dia</button><button class="mg-pill" data-periodo="semana">Semana</button><button class="mg-pill" data-periodo="mes">Mes</button></div><button class="btn btn-outline-primary btn-sm" id="btnRefrescarVentas" title="Refrescar datos"><i class="bi bi-arrow-clockwise me-1"></i>Refrescar</button></div>
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasIngresosLabel">Ingresos del Dia</span><span class="fs-2x fw-bolder" id="ventasIngresos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-danger) 0%, var(--mg-gradient-danger-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGastosLabel">Gastos del Dia</span><span class="fs-2x fw-bolder" id="ventasGastos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-success) 0%, var(--mg-gradient-success-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGananciaLabel">Ganancia Neta</span><span class="fs-2x fw-bolder" id="ventasGanancia">$0</span></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0">Ingresos vs Gastos</h5></div><div class="card-body"><div id="chartBarVentas"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0" id="chartResumenTitle">Resumen del Dia</h5></div><div class="card-body"><div id="chartResumen"></div></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0"><i class="bi bi-pie-chart me-2"></i>Ventas por Categoria</h5></div><div class="card-body"><div id="chartVentasCategoria"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0"><i class="bi bi-trophy me-2"></i>Productos Mas Vendidos</h5></div><div class="card-body"><div id="chartProductosMasVendidos"></div></div></div></div>
        </div>
    </div>

    <!-- ═══════════════ TAB RECIBOS ═══════════════ -->
    <div class="tab-pane fade" id="recibosTab" role="tabpanel">
        <div id="recibosCleanupBanner" class="alert alert-warning d-none mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Tienes recibos con mas de 30 dias. <button class="btn btn-sm btn-warning ms-2" id="btnExportarYLimpiar">Exportar y Limpiar</button>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Recibos</h4>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group input-group-sm" style="width: 200px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="buscarReciboInput" placeholder="# Recibo...">
                </div>
                <button id="btnExportRecibos" class="btn btn-sm btn-success"><i class="bi bi-file-earmark-excel me-1"></i>Exportar</button>
            </div>
        </div>
        <div class="table-responsive">
            <table id="tablaRecibos" class="table table-row-bordered align-middle gs-0 gy-3">
                <thead><tr class="fw-bold text-muted"><th>#Recibo</th><th>Destinatario</th><th>Concepto</th><th>Monto</th><th>Fecha</th><th>Acciones</th></tr></thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- ═══════════════ TAB: MÉTODOS DE PAGO ═══════════════ -->
    <div class="tab-pane fade" id="metodosPagoTab" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-1" style="color: var(--mg-text-color);">Métodos de Pago</h4>
                <small class="text-muted">Configura los métodos de pago que aceptas en tu negocio</small>
            </div>
            <button class="btn btn-sm px-4 py-2" onclick="abrirModalMetodoPago()"
                    style="background: var(--mg-primary); color: white; border-radius: 12px;">
                <i class="bi bi-plus-lg me-1"></i> Nuevo Método
            </button>
        </div>

        <div class="row g-3" id="metodosPagoGrid">
            <!-- Dynamic cards loaded here -->
        </div>
    </div>

    <!-- Modal: Crear/Editar Método de Pago -->
    <div class="modal fade" id="modalMetodoPago" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
            <div class="modal-content border-0" style="border-radius: 20px; background: var(--mg-card-bg);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title" id="modalMetodoPagoTitle" style="color: var(--mg-text-color);">
                        Nuevo Método de Pago
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formMetodoPago">
                        <input type="hidden" id="mpId" value="">
                        <input type="hidden" name="NegocioId" value="@ViewBag.NegocioId">

                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color: var(--mg-text-color);">Nombre del método *</label>
                            <input type="text" class="form-control" name="Nombre" id="mpNombre"
                                   placeholder="Ej: Banco Pichincha, DeUna!, Nequi" required
                                   style="border-radius: 12px; background: var(--mg-card-bg); color: var(--mg-text-color); border-color: var(--mg-border-color);">
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color: var(--mg-text-color);">Número de Cuenta</label>
                            <input type="text" class="form-control" name="NumeroCuenta" id="mpNumeroCuenta"
                                   placeholder="Número de cuenta bancaria"
                                   style="border-radius: 12px; background: var(--mg-card-bg); color: var(--mg-text-color); border-color: var(--mg-border-color);">
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label small fw-semibold" style="color: var(--mg-text-color);">Cédula del titular</label>
                                <input type="text" class="form-control" name="Cedula" id="mpCedula"
                                       placeholder="Ej: 0912345678"
                                       style="border-radius: 12px; background: var(--mg-card-bg); color: var(--mg-text-color); border-color: var(--mg-border-color);">
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold" style="color: var(--mg-text-color);">Nombre del titular</label>
                                <input type="text" class="form-control" name="NombreTitular" id="mpNombreTitular"
                                       placeholder="Nombre completo"
                                       style="border-radius: 12px; background: var(--mg-card-bg); color: var(--mg-text-color); border-color: var(--mg-border-color);">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color: var(--mg-text-color);">Instrucciones adicionales</label>
                            <textarea class="form-control" name="Instrucciones" id="mpInstrucciones" rows="2"
                                      placeholder="Ej: Enviar comprobante al WhatsApp..."
                                      style="border-radius: 12px; background: var(--mg-card-bg); color: var(--mg-text-color); border-color: var(--mg-border-color);"></textarea>
                        </div>

                        <div class="mb-3">
