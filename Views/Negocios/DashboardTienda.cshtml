function poblarSelectCategorias(selectedId) {
    var sel = $('#prodCategoria');
    sel.empty().append('<option value="">Sin Categoria</option>');
    categoriasCache.forEach(function(c) {
        sel.append('<option value="' + c.categoriaId + '"' + (c.categoriaId === selectedId ? ' selected' : '') + '>' + escHtml(c.nombre) + '</option>');
