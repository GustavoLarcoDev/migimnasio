                if (r.success) { cargarProductosGrid(); cargarInventarioStats(); cargarPOS(); if (tablaLogs) tablaLogs.ajax.reload(); swalMG.fire('Eliminado', r.message, 'success'); }
                else { swalMG.fire('Error', r.message, 'error'); }
            }).fail(function(xhr) { swalMG.fire('Error', xhr.responseJSON?.message || 'Error', 'error'); });
        }
    });
}

