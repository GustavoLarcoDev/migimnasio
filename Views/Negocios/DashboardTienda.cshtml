@section Scripts {
<script>
const negocioId = @Json.Serialize(negocioId.ToString());
let tablaLogs, tablaMovimientos, tablaRecibos, tablaOrdenes, tablaProveedores;
var modoEdicionProducto = false;
var productosCache = [];
var posCart = []; // { productoId, nombre, precioVenta, cantidad, stock }
var categoriasCache = [];

const swalMG = Swal.mixin({ confirmButtonColor: '#3E97FF', cancelButtonColor: '#E4E6EF', cancelButtonText: 'Cancelar', reverseButtons: true });

// Prevent browser caching of GET responses (critical for drag-and-drop refresh)
$.ajaxSetup({ cache: false });

// ═══════════════ INIT ═══════════════
$(document).ready(function() {
    cargarPOS();
    verificarSuscripcion();
    cargarNotificacionesCount();
});

function verificarSuscripcion() {
    $.get('/Negocios/GetSuscripcionStatus', { negocioId }, function(d) {
        var t = document.getElementById('trialDaysText');
        if (t && d.diasRestantes !== null) {
            if (d.porEmpezar) t.innerHTML = '- <span class="badge bg-secondary">Por empezar</span>';
            else if (d.diasRestantes <= 0) t.innerHTML = '<span class="badge bg-danger">Expirado</span>';
            else t.innerHTML = '- Te quedan <strong>' + d.diasRestantes + ' dias</strong>';
        }
    });
}

// ═══════════════ POS ═══════════════
function cargarPOS() {
    // Load categories
    $.get('/Negocios/GetCategorias', { negocioId }, function(cats) {
        categoriasCache = cats;
        renderCategoryTabs(cats, '#posCategoryTabs');
    });

    // Load products
    $.get('/Negocios/GetProductos', { negocioId }, function(productos) {
        productosCache = productos;
        renderPOSProducts(productos);
    });

    // Load stats
    $.get('/Negocios/GetInventarioStats', { negocioId }, function(d) {
        $('#posVentasHoy').text(d.ventasHoyUnidades);
        $('#posIngresosHoy').text('$' + d.ingresosHoy.toFixed(2));
        $('#posTotalProductos').text(d.totalProductos);
        $('#posStockBajo').text(d.stockBajo);
    });

    cargarOrdenesRecientes();
}

function renderCategoryTabs(cats, container) {
    var $c = $(container);
    $c.find('.mg-pill:not(:first)').remove();
    // Update "Todos" count
    $c.find('.mg-pill:first').html('Todos <span class="pill-count">' + productosCache.length + '</span>');
    cats.forEach(function(cat) {
        var count = productosCache.filter(function(p) { return p.categoriaProductoId === cat.categoriaId; }).length;
        $c.append('<button class="mg-pill" data-cat="' + cat.categoriaId + '">' + escHtml(cat.nombre) + ' <span class="pill-count">' + count + '</span></button>');
    });
}

function renderPOSProducts(productos, filter) {
    var grid = $('#posProductsGrid');
    grid.empty();

    var filtered = productos;
    if (filter) {
        filtered = productos.filter(function(p) { return p.categoriaProductoId === filter; });
    }

    var search = ($('#posBuscar').val() || '').toLowerCase();
    if (search) {
        filtered = filtered.filter(function(p) { return p.nombre.toLowerCase().includes(search); });
    }

    if (!filtered.length) {
        grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-box-seam fs-1 d-block mb-3 opacity-50"></i><p>No hay productos</p></div>');
        return;
    }

    filtered.forEach(function(p) {
        var imgHtml = p.imagenUrl
            ? '<img src="' + escAttr(p.imagenUrl) + '" class="pos-prod-img" alt="">'
            : '<div class="pos-prod-placeholder"><i class="bi bi-box"></i></div>';

        var card = '<div class="col-xl-3 col-lg-4 col-md-4 col-6">' +
            '<div class="pos-product-card' + (p.stock <= 0 ? ' out-of-stock' : '') + '" data-id="' + p.productoId + '" onclick="agregarAlCarrito(\'' + p.productoId + '\')">' +
                imgHtml +
                '<div class="pos-prod-name" title="' + escAttr(p.nombre) + '">' + escHtml(p.nombre) + '</div>' +
                '<div class="pos-prod-price">$' + p.precioVenta.toFixed(2) + '</div>' +
                '<div class="pos-prod-stock">' + (p.stock <= 0 ? '<span class="text-danger">Agotado</span>' : 'Stock: ' + p.stock) + '</div>' +
            '</div>' +
        '</div>';
        grid.append(card);
    });
}

// POS category filter
