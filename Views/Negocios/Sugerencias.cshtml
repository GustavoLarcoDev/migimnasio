@{
    ViewData["Title"] = "Sugerencias";
}
@Html.AntiForgeryToken()

<div class="container-fluid px-2 px-sm-3 px-md-5 mb-5 pb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 mb-md-5">
        <div>
            <h1 class="fw-bolder text-dark mb-1 fs-3 fs-md-1">Sugerencias</h1>
            <p class="text-muted mb-0 small">Feedback de los dueños de negocios</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Negocios" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>
                <span>Volver</span>
            </a>
            <form method="post" action="@Url.Action("Logout", "Auth")" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="d-none d-sm-inline ms-1">Cerrar Sesión</span>
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Total Sugerencias</div>
                        <div class="stat-value" id="totalSugerencias">0</div>
                    </div>
                    <div class="stat-icon bg-light-primary">
                        <i class="bi bi-chat-left-text text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-6">
            <div class="mg-stat-card">
                <div class="d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="stat-label">Sin Leer</div>
                        <div class="stat-value" id="sinLeer">0</div>
                    </div>
                    <div class="stat-icon bg-light-warning">
                        <i class="bi bi-envelope text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="sugerenciasList" class="d-flex flex-column gap-3">
        <div class="text-center py-5 text-muted">
            <i class="bi bi-chat-left-text fs-1 d-block mb-3"></i>
            <p>Cargando sugerencias...</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
$.ajaxSetup({ headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() } });
$(document).ready(function() {
    cargarSugerencias();
});

function cargarSugerencias() {
    $.get('/Negocios/GetSugerencias', function(data) {
        $('#totalSugerencias').text(data.length);
        $('#sinLeer').text(data.filter(s => !s.leida).length);

        if (data.length === 0) {
            $('#sugerenciasList').html('<div class="text-center py-5 text-muted"><i class="bi bi-chat-left-text fs-1 d-block mb-3"></i><p>No hay sugerencias todavía.</p></div>');
            return;
        }

        let html = '';
        data.forEach(function(s) {
            const fecha = new Date(s.fechaCreacion).toLocaleString('es-MX');
            const unreadClass = s.leida ? '' : 'border-start border-3 border-primary';
            html += `
                <div class="mg-card ${unreadClass}">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-building me-1 text-primary"></i>
                                    ${escHtml(s.negocioNombre)}
                                </h6>
                                <small class="text-muted">${escHtml(fecha)}</small>
                            </div>
                            ${!s.leida ? `<button class="btn btn-sm btn-light-primary" onclick="marcarLeida('${escHtml(s.id)}')"><i class="bi bi-check me-1"></i>Leída</button>` : '<span class="badge bg-light text-muted">Leída</span>'}
                        </div>
                        <p class="mb-0 mt-2">${escHtml(s.mensaje)}</p>
                    </div>
                </div>`;
        });
        $('#sugerenciasList').html(html);
    });
}

function marcarLeida(id) {
    $.post('/Negocios/MarcarSugerenciaLeida', { id }, function(r) {
        if (r.success) cargarSugerencias();
    });
}
</script>

<style>
    .btn-sm { padding: 0.5rem 1rem; font-size: 0.875rem; }
</style>
}
