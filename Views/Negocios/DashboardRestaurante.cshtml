// ═══════════════ INVENTARIO (reutilizado de Tienda) ═══════════════
function cargarInventario() {
    $.get('/Negocios/GetCategorias', { negocioId }, function(cats) {
        categoriasCache = cats;
        renderCategoryFolders(cats);
        var sel = $('#prodCategoria'); sel.find('option:not(:first)').remove();
        cats.forEach(function(c) { sel.append('<option value="' + c.categoriaId + '">' + escHtml(c.nombre) + '</option>'); });
    });
    $.get('/Negocios/GetProductos', { negocioId }, function(prods) {
        productosCache = prods;
        renderProductosGrid(prods);
    });
    $.get('/Negocios/GetInventarioStats', { negocioId }, function(d) {
        $('#invTotalProductos').text(d.totalProductos); $('#invStockBajo').text(d.stockBajo);
        $('#invVentasHoy').text(d.ventasHoyUnidades); $('#invIngresosHoy').text('$' + d.ingresosHoy.toFixed(2));
    });
}

function renderCategoryFolders(cats) {
    var c = $('#invCategoryFolders'); c.empty();
    cats.forEach(function(cat) {
        var count = productosCache.filter(function(p) { return p.categoriaProductoId === cat.categoriaId; }).length;
        c.append('<div class="col-auto"><div class="mg-card px-3 py-2 d-flex align-items-center gap-2 cursor-pointer inv-folder" data-cat="' + cat.categoriaId + '" ondragover="event.preventDefault()" ondrop="dropProductoEnCategoria(event,\'' + cat.categoriaId + '\')"><i class="bi bi-folder-fill text-warning"></i><span class="fw-semibold">' + escHtml(cat.nombre) + '</span><span class="badge bg-primary">' + count + '</span></div></div>');
    });
}

function renderProductosGrid(prods) {
    var c = $('#productosGrid'); c.empty();
    if (!prods.length) { c.html('<div class="col-12 text-center py-5 text-muted"><p>No hay platos en el inventario.</p></div>'); return; }
    prods.forEach(function(p) {
        var imgHtml = p.imagenUrl ? '<img src="' + escAttr(p.imagenUrl) + '" class="rounded mb-2" style="width:60px;height:60px;object-fit:cover;" alt="">' : '<div class="rounded mb-2 d-flex align-items-center justify-content-center bg-light" style="width:60px;height:60px;"><i class="bi bi-cup-hot text-muted fs-4"></i></div>';
        c.append('<div class="col-xl-2 col-lg-3 col-md-4 col-6" draggable="true" ondragstart="event.dataTransfer.setData(\'text/plain\',\'' + p.productoId + '\')"><div class="mg-card text-center p-3 h-100">' + imgHtml + '<div class="fw-semibold small mb-1">' + escHtml(p.nombre) + '</div><div class="text-primary fw-bold">$' + p.precioVenta.toFixed(2) + '</div><div class="small text-muted">Stock: ' + p.stock + '</div><div class="d-flex gap-1 mt-2 justify-content-center"><button class="btn btn-sm btn-outline-success" onclick="venderProducto(\'' + p.productoId + '\')"><i class="bi bi-cart-dash"></i></button><button class="btn btn-sm btn-outline-primary" onclick="editarProducto(\'' + p.productoId + '\')"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-info" onclick="restockProducto(\'' + p.productoId + '\')"><i class="bi bi-box-arrow-in-down"></i></button></div></div></div>');
    });
}

function dropProductoEnCategoria(event, catId) { event.preventDefault(); var prodId = event.dataTransfer.getData('text/plain'); if (!prodId) return; $.ajax({ url: '/Negocios/CambiarCategoriaProducto', type: 'POST', contentType: 'application/json', data: JSON.stringify({ ProductoId: prodId, CategoriaProductoId: catId }), success: function(r) { if (r.success) { toastr.success('Plato movido'); cargarInventario(); cargarPOS(); } else toastr.error(r.message); } }); }

$('#buscarPlato').on('input', function() {
    var q = $(this).val().toLowerCase().trim();
    if (!q) { renderProductosGrid(productosCache); return; }
    var filtrados = productosCache.filter(function(p) { return p.nombre.toLowerCase().includes(q); });
    renderProductosGrid(filtrados);
});

$('#btnCrearProducto').on('click', function() { modoEdicionProducto = false; $('#prodEditId').val(''); $('#prodNombre').val(''); $('#prodPrecio').val(''); $('#prodCosto').val(0); $('#prodStock').val(0); $('#prodStockMin').val(5); $('#prodCategoria').val(''); $('#prodImagen').val(''); $('#prodImagenPreview').empty(); $('#prodReceta').val(''); $('#productoModalTitle').text('Nuevo Plato'); new bootstrap.Modal('#productoModal').show(); });

// Preview de imagen al seleccionar archivo
$('#prodImagen').on('change', function() {
    var file = this.files[0];
    if (file) {
        var reader = new FileReader();
        reader.onload = function(e) { $('#prodImagenPreview').html('<img src="' + e.target.result + '" class="rounded" style="max-height:120px;">'); };
        reader.readAsDataURL(file);
    } else { $('#prodImagenPreview').empty(); }
});

$('#btnGuardarProducto').on('click', function() {
    var id = $('#prodEditId').val();
    var data = { NegocioId: negocioId, Nombre: $('#prodNombre').val(), PrecioVenta: parseFloat($('#prodPrecio').val()) || 0, CostoCompra: parseFloat($('#prodCosto').val()) || 0, Stock: parseInt($('#prodStock').val()) || 0, StockMinimo: parseInt($('#prodStockMin').val()) || 5, CategoriaProductoId: $('#prodCategoria').val() || null, Receta: $('#prodReceta').val() || null };
    if (!data.Nombre) { toastr.error('Nombre obligatorio'); return; }
    if (id) { data.ProductoId = id; }
    var fileInput = document.getElementById('prodImagen');
    var tieneImagen = fileInput.files.length > 0;
    var url = id ? '/Negocios/EditarProducto' : '/Negocios/CrearProducto';
    var cerrarYRecargar = function(msg) { toastr.success(msg); bootstrap.Modal.getInstance(document.getElementById('productoModal')).hide(); cargarInventario(); cargarPOS(); };
    var subirImagen = function(prodId, msg) {
        var fd = new FormData();
        fd.append('productoId', prodId);
        fd.append('negocioId', negocioId);
        fd.append('imagen', fileInput.files[0]);
        $.ajax({ url: '/Negocios/SubirImagenProducto', type: 'POST', data: fd, processData: false, contentType: false,
            success: function() { cerrarYRecargar(msg || 'Imagen actualizada'); },
            error: function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al subir imagen'); }
        });
    };
    $.post(url, data, function(r) {
        if (r.success) {
            var prodId = r.dataId || id;
            if (tieneImagen && prodId) { subirImagen(prodId, r.message); }
            else { cerrarYRecargar(r.message); }
        } else if (tieneImagen && id) {
            // Solo cambió la imagen, no los campos de texto — subir igual
            subirImagen(id, 'Imagen actualizada');
        } else { toastr.error(r.message); }
    }).fail(function(xhr) {
        // Si el backend dice "no hay cambios" pero SÍ hay imagen nueva, subirla igual
        if (tieneImagen && id && xhr.responseJSON?.message?.includes('No se detectaron')) {
            subirImagen(id, 'Imagen actualizada');
        } else { toastr.error(xhr.responseJSON?.message || 'Error al guardar plato'); }
    });
});

function editarProducto(id) {
    var p = productosCache.find(function(x) { return x.productoId === id; }); if (!p) return;
    modoEdicionProducto = true; $('#prodEditId').val(id); $('#prodNombre').val(p.nombre); $('#prodPrecio').val(p.precioVenta); $('#prodCosto').val(p.costoCompra); $('#prodStock').val(p.stock); $('#prodStockMin').val(p.stockMinimo); $('#prodCategoria').val(p.categoriaProductoId || ''); $('#prodImagen').val('');
    if (p.imagenUrl) { $('#prodImagenPreview').html('<img src="' + p.imagenUrl + '" class="rounded" style="max-height:120px;">'); } else { $('#prodImagenPreview').empty(); }
    $('#prodReceta').val(p.receta || ''); $('#productoModalTitle').text('Editar Plato'); new bootstrap.Modal('#productoModal').show();
}

function venderProducto(id) {
    var p = productosCache.find(function(x) { return x.productoId === id; });
    if (!p) return;
    swalMG.fire({
        title: 'Vender ' + p.nombre,
        input: 'number',
        inputValue: 1,
        inputAttributes: { min: 1, max: p.stock },
        showCancelButton: true,
        confirmButtonText: 'Vender'
    }).then(function(r) {
        if (r.isConfirmed) {
            var cantidad = parseInt(r.value);
            mostrarModalPago(function(resultado) {
                $.post('/Negocios/VenderProducto', {
                    productoId: id,
                    negocioId: negocioId,
                    cantidad: cantidad,
                    metodoPago: resultado.metodoPago,
                    numeroConfirmacion: resultado.numeroConfirmacion
                }, function(r) {
                    if (r.success) { toastr.success(r.message); cargarInventario(); cargarPOS(); }
                    else toastr.error(r.message);
                }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al vender'); });
            });
        }
    });
}

function restockProducto(id) { swalMG.fire({ title: 'Restock', input: 'number', inputValue: 10, inputAttributes: { min: 1 }, showCancelButton: true, confirmButtonText: 'Agregar stock' }).then(function(r) { if (r.isConfirmed) $.post('/Negocios/RestockProducto', { productoId: id, negocioId: negocioId, cantidad: parseInt(r.value), costoTotal: 0 }, function(r) { if (r.success) { toastr.success(r.message); cargarInventario(); cargarPOS(); } else toastr.error(r.message); }).fail(function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al restock'); }); }); }

