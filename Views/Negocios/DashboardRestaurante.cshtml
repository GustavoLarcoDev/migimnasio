// ═══════════════ REPORTES (reutilizado) ═══════════════
var chartBar, chartResumen;
function cargarReportes(periodo) {
    periodo = periodo || 'dia';
    $.get('/Negocios/GetVentasStats', { negocioId, periodo }, function(d) {
        var labels = { dia: 'del Dia', semana: 'de la Semana', mes: 'del Mes' };
        $('#ventasIngresosLabel').text('Ingresos ' + labels[periodo]); $('#ventasGastosLabel').text('Gastos ' + labels[periodo]); $('#ventasGananciaLabel').text('Ganancia ' + labels[periodo]);
        $('#ventasIngresos').text('$' + (d.ingresos || 0).toFixed(2)); $('#ventasGastos').text('$' + (d.gastos || 0).toFixed(2)); $('#ventasGanancia').text('$' + (d.ganancia || 0).toFixed(2));
        $('#chartResumenTitle').text('Resumen ' + labels[periodo]);
    });
    $.get('/Negocios/GetChartData', { negocioId, periodo }, function(d) {
        if (chartBar) chartBar.destroy();
        chartBar = new ApexCharts(document.querySelector('#chartBarVentas'), { chart: { type: 'bar', height: 300 }, series: [{ name: 'Ingresos', data: d.ingresos || [] }, { name: 'Gastos', data: d.gastos || [] }], xaxis: { categories: d.labels || [] }, colors: ['#50CD89', '#F1416C'], plotOptions: { bar: { borderRadius: 4 } } });
        chartBar.render();
        if (chartResumen) chartResumen.destroy();
        $('#chartResumen').empty();
        var totalIng = (d.ingresos || []).reduce(function(a, b) { return a + b; }, 0);
        var totalGas = (d.gastos || []).reduce(function(a, b) { return a + b; }, 0);
        if (totalIng === 0 && totalGas === 0) {
            $('#chartResumen').html('<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i>Sin datos para este periodo</div>');
            chartResumen = null;
        } else {
            chartResumen = new ApexCharts(document.querySelector('#chartResumen'), { chart: { type: 'donut', height: 300 }, series: [totalIng, totalGas], labels: ['Ingresos', 'Gastos'], colors: ['#50CD89', '#F1416C'], plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Ganancia', formatter: function() { return '$' + (totalIng - totalGas).toFixed(2); } } } } } } });
            chartResumen.render();
        }
    });
}

$(document).on('click', '#ventasPeriodPills .mg-pill', function() { $('#ventasPeriodPills .mg-pill').removeClass('active'); $(this).addClass('active'); cargarReportes($(this).data('periodo')); });

