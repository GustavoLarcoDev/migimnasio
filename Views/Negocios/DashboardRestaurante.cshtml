document.addEventListener('mg-tab-shown', function(e) {
    var tab = e.detail.tab;
    if (tab === 'posTab') { cargarPOS(); actualizarIndicadorMesa(); }
    else if (tab === 'mesasTab') { if (mesaActiva) { ordenesMesa[mesaActiva] = posCart.slice(); guardarOrdenesMesa(); } cargarMesas(); cargarReservas(); }
    else if (tab === 'menusTab') cargarMenus();
    else if (tab === 'inventarioTab') cargarInventario();
    else if (tab === 'proveedoresTab') cargarProveedores();
    else if (tab === 'repartidoresTab') cargarRepartidores();
    else if (tab === 'logsTab') cargarLogs();
    else if (tab === 'ventasTab') { cargarReportes(); cargarVentasPorCategoria(); }
    else if (tab === 'recibosTab') cargarRecibos();
    else if (tab === 'notificacionesTab') cargarNotificaciones();
    else if (tab === 'metodosPagoTab') cargarMetodosPago();
});

// ═══════════════ RESERVAS ═══════════════

var reservaModal;
$(function() { reservaModal = new bootstrap.Modal('#modalReserva'); });

// Inicializar fecha filtro a hoy
$('#reservasFechaFiltro').val(new Date().toISOString().split('T')[0]);

function cargarReservas(fecha) {
    fecha = fecha || $('#reservasFechaFiltro').val() || '';
    var url = fecha ? '/Negocios/GetReservas?negocioId=' + negocioId + '&fecha=' + fecha : '/Negocios/GetReservas?negocioId=' + negocioId;
    $.get(url, function(data) {
        var c = $('#reservasList');
        if (!data || !data.length) {
            c.html('<div class="text-center py-4 text-muted"><i class="bi bi-calendar-x fs-1 d-block mb-2"></i><p>No hay reservas para esta fecha</p></div>');
            return;
        }
        var html = '<div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr>' +
            '<th>Cliente</th><th>Hora</th><th>Personas</th><th>Mesa</th><th>Estado</th><th>Notas</th><th>Acciones</th>' +
            '</tr></thead><tbody>';
        data.forEach(function(r) {
            var hora = new Date(r.fechaHoraReserva).toLocaleTimeString('es-EC', { hour: '2-digit', minute: '2-digit' });
            var fecha2 = new Date(r.fechaHoraReserva).toLocaleDateString('es-EC');
            var estadoBadge = { confirmada: 'warning', completada: 'success', cancelada: 'secondary', no_presentado: 'danger' };
            var badge = '<span class="badge bg-' + (estadoBadge[r.estado] || 'info') + '">' + escHtml(r.estado) + '</span>';
            var mesa = r.mesaNombre ? escHtml(r.mesaNombre) : '<span class="text-muted">-</span>';
            var tel = r.telefono ? ' <a href="https://wa.me/' + escHtml(r.telefono.replace(/\D/g, '')) + '" target="_blank" class="text-success"><i class="bi bi-whatsapp"></i></a>' : '';
            var acciones = '';
            if (r.estado === 'confirmada') {
                acciones = '<div class="btn-group btn-group-sm">' +
                    '<button class="btn btn-outline-success" onclick="cambiarEstadoReserva(\'' + r.reservaId + '\', \'completada\')" title="Llegó"><i class="bi bi-check-lg"></i></button>' +
                    '<button class="btn btn-outline-primary" onclick="editarReserva(\'' + r.reservaId + '\')" title="Editar"><i class="bi bi-pencil"></i></button>' +
                    '<button class="btn btn-outline-danger" onclick="cambiarEstadoReserva(\'' + r.reservaId + '\', \'cancelada\')" title="Cancelar"><i class="bi bi-x-lg"></i></button>' +
                    '<button class="btn btn-outline-warning" onclick="cambiarEstadoReserva(\'' + r.reservaId + '\', \'no_presentado\')" title="No se presentó"><i class="bi bi-person-x"></i></button>' +
                    '</div>';
            }
            html += '<tr><td><strong>' + escHtml(r.nombreCliente) + '</strong>' + tel + '</td>' +
                '<td>' + fecha2 + ' ' + hora + '</td><td class="text-center">' + r.cantidadPersonas + '</td>' +
                '<td>' + mesa + '</td><td>' + badge + '</td>' +
                '<td><small>' + escHtml(r.notas || '') + '</small></td><td>' + acciones + '</td></tr>';
        });
        html += '</tbody></table></div>';
        c.html(html);
    }).fail(function() {
        $('#reservasList').html('<div class="text-center py-4 text-danger">Error al cargar reservas</div>');
    });
}

$('#reservasFechaFiltro').on('change', function() { cargarReservas($(this).val()); });

$('#btnNuevaReserva').on('click', function() {
    $('#reservaId').val('');
    $('#reservaNombre').val('');
    $('#reservaTelefono').val('');
    $('#reservaPersonas').val(2);
    $('#reservaNotas').val('');
    $('#modalReservaTitle').text('Nueva Reserva');
    // Default: hoy + próxima hora entera
    var now = new Date();
    now.setHours(now.getHours() + 1, 0, 0, 0);
    var local = new Date(now - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    $('#reservaFechaHora').val(local);
    // Cargar mesas disponibles
    cargarMesasSelect();
    reservaModal.show();
});

function cargarMesasSelect(selectedId) {
    $.get('/Negocios/GetMesas', { negocioId: negocioId }, function(mesas) {
        var sel = $('#reservaMesa');
        sel.html('<option value="">Sin asignar</option>');
        mesas.forEach(function(m) {
            var estado = m.estado !== 'libre' ? ' (' + m.estado + ')' : '';
            sel.append('<option value="' + m.mesaId + '"' + (selectedId === m.mesaId ? ' selected' : '') + '>' +
                escHtml(m.nombre) + ' — ' + m.capacidad + ' personas' + estado + '</option>');
        });
    });
}

$('#btnGuardarReserva').on('click', function() {
    var nombre = $('#reservaNombre').val().trim();
    if (!nombre) { toastr.error('El nombre del cliente es obligatorio'); return; }
    var fechaHora = $('#reservaFechaHora').val();
    if (!fechaHora) { toastr.error('La fecha y hora son obligatorias'); return; }

    var data = {
        ReservaId: $('#reservaId').val() || '00000000-0000-0000-0000-000000000000',
        NombreCliente: nombre,
        Telefono: $('#reservaTelefono').val().trim(),
        FechaHoraReserva: fechaHora,
        CantidadPersonas: parseInt($('#reservaPersonas').val()) || 2,
        MesaId: $('#reservaMesa').val() || null,
        Notas: $('#reservaNotas').val().trim()
    };

    var url = $('#reservaId').val() ? '/Negocios/EditarReserva' : '/Negocios/CrearReserva';
    var btn = $(this);
    btn.prop('disabled', true);
    $.ajax({
        url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
        success: function(r) {
            if (r.success) { toastr.success(r.message); reservaModal.hide(); cargarReservas(); cargarMesas(); }
            else toastr.error(r.message);
        },
        error: function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al guardar reserva'); },
        complete: function() { btn.prop('disabled', false); }
    });
});

function editarReserva(reservaId) {
    var fecha = $('#reservasFechaFiltro').val() || '';
    var url = '/Negocios/GetReservas?negocioId=' + negocioId + (fecha ? '&fecha=' + fecha : '');
    $.get(url, function(data) {
        var r = data.find(function(x) { return x.reservaId === reservaId; });
        if (!r) { toastr.error('Reserva no encontrada'); return; }
        $('#reservaId').val(r.reservaId);
        $('#reservaNombre').val(r.nombreCliente);
        $('#reservaTelefono').val(r.telefono || '');
        var dt = new Date(r.fechaHoraReserva);
        var local = new Date(dt - dt.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        $('#reservaFechaHora').val(local);
        $('#reservaPersonas').val(r.cantidadPersonas);
        $('#reservaNotas').val(r.notas || '');
        $('#modalReservaTitle').text('Editar Reserva');
        cargarMesasSelect(r.mesaId);
        reservaModal.show();
    });
}

function cambiarEstadoReserva(reservaId, estado) {
    var labels = { completada: 'completada (cliente llegó)', cancelada: 'cancelada', no_presentado: 'no presentado' };
    Swal.fire({
        title: 'Cambiar estado',
        text: '¿Marcar reserva como ' + (labels[estado] || estado) + '?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí, cambiar',
        cancelButtonText: 'No'
    }).then(function(result) {
        if (!result.isConfirmed) return;
        $.ajax({
            url: '/Negocios/CambiarEstadoReserva', type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ ReservaId: reservaId, Estado: estado }),
            success: function(r) {
                if (r.success) { toastr.success(r.message); cargarReservas(); cargarMesas(); }
                else toastr.error(r.message);
            },
            error: function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error'); }
        });
    });
}

// ═══════════════ MÉTODOS DE PAGO ═══════════════

function cargarMetodosPago() {
    Promise.all([
        $.get('/Negocios/GetPaymentStatsByMethod', { negocioId: negocioId }),
        $.get('/Negocios/GetMetodosPago', { negocioId: negocioId })
    ]).then(function(results) {
        var statsData = results[0];
        var methods = results[1];
        var statsMap = {};
        statsData.forEach(function(s) { statsMap[s.metodoPago.toLowerCase()] = s; });

        var statsRow = $('#paymentStatsRow');
        statsRow.empty();
        var allNames = ['Efectivo'];
        if (methods) methods.forEach(function(m) { allNames.push(m.nombre); });
        var colors = ['#50CD89', '#3E97FF', '#7239EA', '#F1416C', '#FFC700'];
        allNames.forEach(function(name, idx) {
            var s = statsMap[name.toLowerCase()] || { totalHoy: 0, totalSemana: 0, totalMes: 0 };
            var color = colors[idx % colors.length];
            statsRow.append(
                '<div class="col-md-4 col-sm-6"><div class="card border-0 shadow-sm" style="border-radius: 16px; background: linear-gradient(135deg, ' + color + ', ' + color + 'cc);"><div class="card-body p-3"><div class="d-flex align-items-center gap-2 mb-2"><i class="bi ' + (name === 'Efectivo' ? 'bi-cash-stack' : 'bi-bank') + ' text-white"></i><h6 class="mb-0 text-white fw-bold">' + escHtml(name) + '</h6></div><div class="d-flex justify-content-between"><div class="text-center"><small class="text-white-50 d-block" style="font-size:0.65rem;">Hoy</small><span class="text-white fw-bold" style="font-size:0.9rem;">$' + (s.totalHoy || 0).toFixed(2) + '</span></div><div class="text-center"><small class="text-white-50 d-block" style="font-size:0.65rem;">Semana</small><span class="text-white fw-bold" style="font-size:0.9rem;">$' + (s.totalSemana || 0).toFixed(2) + '</span></div><div class="text-center"><small class="text-white-50 d-block" style="font-size:0.65rem;">Mes</small><span class="text-white fw-bold" style="font-size:0.9rem;">$' + (s.totalMes || 0).toFixed(2) + '</span></div></div></div></div></div>'
            );
        });

        var grid = $('#metodosPagoGrid');
        grid.empty();
        var efectivoStats = statsMap['efectivo'] || { totalHoy: 0, totalSemana: 0, totalMes: 0, cantidadMes: 0 };
        grid.append(renderMetodoPagoCard(null, 'Efectivo', null, null, null, true, false, efectivoStats));
        methods.forEach(function(mp) {
            var mpStats = statsMap[mp.nombre.toLowerCase()] || { totalHoy: 0, totalSemana: 0, totalMes: 0, cantidadMes: 0 };
            grid.append(renderMetodoPagoCard(mp.metodoPagoId, mp.nombre, mp.numeroCuenta, mp.nombreTitular, mp.cedula, false, mp.esPredeterminado, mpStats, mp.imagenQR));
        });
    }).fail(function() { toastr.error('Error al cargar métodos de pago'); });
}

function renderMetodoPagoCard(id, nombre, numeroCuenta, nombreTitular, cedula, isEfectivo, esPredeterminado, stats, imagenQR) {
    var icon = isEfectivo ? 'bi-cash-stack' : 'bi-bank';
    var qrIndicator = imagenQR ? '<i class="bi bi-qr-code ms-1 text-success" style="font-size:0.85rem;"></i>' : '';
    var defaultBadge = (isEfectivo || esPredeterminado) ? '<span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem;">Predeterminado</span>' : '';
    var menuHtml = '';
    if (!isEfectivo) {
        menuHtml = '<div class="dropdown position-absolute" style="top:12px;right:12px;"><button class="btn btn-sm btn-light" data-bs-toggle="dropdown" style="border-radius:8px;padding:2px 8px;"><i class="bi bi-three-dots-vertical"></i></button><ul class="dropdown-menu dropdown-menu-end" style="border-radius:12px;background:var(--mg-card-bg);border:1px solid var(--mg-border-color);">';
        if (imagenQR) {
            menuHtml += '<li><a class="dropdown-item" href="#" onclick="verQR(\'' + id + '\',\'' + escHtml(nombre).replace(/'/g,"\\'") + '\')"><i class="bi bi-qr-code me-2"></i>Ver QR</a></li>';
        }
        menuHtml += '<li><a class="dropdown-item" href="#" onclick="editarMetodoPago(\'' + id + '\')"><i class="bi bi-pencil me-2"></i>Editar</a></li>';
        if (!esPredeterminado) {
            menuHtml += '<li><a class="dropdown-item" href="#" onclick="setPredeterminado(\'' + id + '\')"><i class="bi bi-star me-2"></i>Predeterminado</a></li>';
        }
        menuHtml += '<li><hr class="dropdown-divider"></li><li><a class="dropdown-item text-danger" href="#" onclick="eliminarMetodoPago(\'' + id + '\',\'' + escHtml(nombre).replace(/'/g,"\\'") + '\')"><i class="bi bi-trash me-2"></i>Eliminar</a></li></ul></div>';
    }
    var infoHtml = '';
    if (numeroCuenta) infoHtml += '<div class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-credit-card-2-front text-muted" style="font-size:0.8rem;width:16px;"></i><small style="color:var(--mg-text-color);">' + escHtml(numeroCuenta) + '</small></div>';
    if (nombreTitular) infoHtml += '<div class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-person text-muted" style="font-size:0.8rem;width:16px;"></i><small style="color:var(--mg-text-color);">' + escHtml(nombreTitular) + '</small></div>';
    if (cedula) infoHtml += '<div class="d-flex align-items-center gap-2 mb-1"><i class="bi bi-card-text text-muted" style="font-size:0.8rem;width:16px;"></i><small style="color:var(--mg-text-color);">' + escHtml(cedula) + '</small></div>';
    var earningsHtml = '<div class="d-flex justify-content-between mt-2 pt-2" style="border-top:1px dashed var(--mg-border-color);"><div class="text-center"><small class="text-muted d-block" style="font-size:0.65rem;">Hoy</small><span class="fw-bold" style="font-size:0.85rem;color:var(--mg-text-color);">$' + (stats.totalHoy || 0).toFixed(2) + '</span></div><div class="text-center"><small class="text-muted d-block" style="font-size:0.65rem;">Semana</small><span class="fw-bold" style="font-size:0.85rem;color:var(--mg-text-color);">$' + (stats.totalSemana || 0).toFixed(2) + '</span></div><div class="text-center"><small class="text-muted d-block" style="font-size:0.65rem;">Mes</small><span class="fw-bold" style="font-size:0.85rem;color:var(--mg-text-color);">$' + (stats.totalMes || 0).toFixed(2) + '</span></div></div>';
    return '<div class="col-md-4 col-sm-6"><div class="card border-0 shadow-sm h-100" style="border-radius:16px;background:var(--mg-card-bg);"><div class="card-body p-4 position-relative">' + menuHtml + '<div class="d-flex align-items-start gap-3"><div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;background:' + (isEfectivo ? 'rgba(80,205,137,0.12)' : 'var(--mg-primary-light, rgba(62,151,255,0.1))') + ';"><i class="bi ' + icon + ' fs-4" style="color:' + (isEfectivo ? '#50CD89' : 'var(--mg-primary)') + ';"></i></div><div class="flex-grow-1 min-width-0"><h6 class="mb-1 fw-bold" style="color:var(--mg-text-color);">' + escHtml(nombre) + qrIndicator + '</h6>' + defaultBadge + '</div></div>' + (infoHtml ? '<hr class="my-3" style="border-color:var(--mg-border-color);opacity:0.3;">' + infoHtml : '') + earningsHtml + '</div></div></div>';
}

function verQR(id, nombre) {
    $.get('/Negocios/GetMetodoPago', { negocioId: negocioId, metodoPagoId: id }, function(data) {
        if (data.imagenQR) {
            $('#modalVerQRTitle').text(nombre);
            $('#modalVerQRImg').attr('src', data.imagenQR);
            new bootstrap.Modal('#modalVerQR').show();
        }
    });
}

function abrirModalMetodoPago() {
    $('#mpId').val('');
    $('#formMetodoPago')[0].reset();
    $('#mpQrPreview').hide();
    $('#modalMetodoPagoTitle').text('Nuevo Método de Pago');
    new bootstrap.Modal('#modalMetodoPago').show();
}

function editarMetodoPago(id) {
    $.get('/Negocios/GetMetodoPago', { negocioId: negocioId, metodoPagoId: id }, function(data) {
        $('#mpId').val(data.metodoPagoId);
        $('#mpNombre').val(data.nombre);
        $('#mpNumeroCuenta').val(data.numeroCuenta || '');
        $('#mpCedula').val(data.cedula || '');
        $('#mpNombreTitular').val(data.nombreTitular || '');
        $('#mpInstrucciones').val(data.instrucciones || '');
        $('#mpPredeterminado').prop('checked', data.esPredeterminado);

        if (data.imagenQR) {
            $('#mpQrImg').attr('src', data.imagenQR);
            $('#mpQrPreview').show();
        } else {
            $('#mpQrPreview').hide();
        }

        $('#modalMetodoPagoTitle').text('Editar Método de Pago');
        new bootstrap.Modal('#modalMetodoPago').show();
    });
}

function guardarMetodoPago() {
    var nombre = $('#mpNombre').val().trim();
    if (!nombre) { toastr.warning('El nombre es requerido'); return; }

    var id = $('#mpId').val();
    var url = id ? '/Negocios/EditarMetodoPago' : '/Negocios/CrearMetodoPago';

    var formData = new FormData();
    formData.append('NegocioId', negocioId);
    formData.append('Nombre', nombre);
    formData.append('NumeroCuenta', $('#mpNumeroCuenta').val());
    formData.append('Cedula', $('#mpCedula').val());
    formData.append('NombreTitular', $('#mpNombreTitular').val());
    formData.append('Instrucciones', $('#mpInstrucciones').val());
    formData.append('EsPredeterminado', $('#mpPredeterminado').is(':checked'));
    if (id) formData.append('MetodoPagoId', id);

    $.ajax({
        url: url,
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
        success: function(r) {
            if (r.success) {
                toastr.success(r.message);
                bootstrap.Modal.getInstance('#modalMetodoPago')?.hide();
                cargarMetodosPago();

                var qrFile = $('#mpQrFile')[0].files[0];
                var mpId = id || r.metodoPagoId;
                if (qrFile && mpId) {
                    subirQR(mpId, qrFile);
                }
            } else {
                toastr.error(r.message);
            }
        },
        error: function() { toastr.error('Error al guardar'); }
    });
}

function subirQR(metodoPagoId, file) {
    var fd = new FormData();
    fd.append('negocioId', negocioId);
    fd.append('metodoPagoId', metodoPagoId);
    fd.append('imagen', file);

    $.ajax({
        url: '/Negocios/SubirImagenQR',
        type: 'POST',
        data: fd,
        processData: false,
        contentType: false,
        headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
        success: function(r) {
            if (r.success) {
                toastr.success('QR subido correctamente');
                cargarMetodosPago();
            }
        }
    });
}

function eliminarQR() {
    var id = $('#mpId').val();
    if (!id) return;

    $.post('/Negocios/EliminarImagenQR', {
        negocioId: negocioId,
        metodoPagoId: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
    }, function(r) {
        if (r.success) {
            $('#mpQrPreview').hide();
            $('#mpQrFile').val('');
            toastr.success('QR eliminado');
        }
    });
}

function eliminarMetodoPago(id, nombre) {
    Swal.fire({
        title: '¿Eliminar método de pago?',
        text: `Se eliminará "${nombre}"`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    }).then(result => {
        if (result.isConfirmed) {
            $.post('/Negocios/EliminarMetodoPago', {
                negocioId: negocioId,
                metodoPagoId: id,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            }, function(r) {
                if (r.success) {
                    toastr.success(r.message);
                    cargarMetodosPago();
                } else {
                    toastr.error(r.message);
                }
            });
        }
    });
}

function setPredeterminado(id) {
    $.post('/Negocios/SetMetodoPagoPredeterminado', {
        negocioId: negocioId,
        metodoPagoId: id,
        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
    }, function(r) {
        if (r.success) {
            toastr.success(r.message);
            cargarMetodosPago();
        } else {
            toastr.error(r.message);
        }
    });
}

</script>
}
