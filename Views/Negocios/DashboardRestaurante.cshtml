document.addEventListener('mg-tab-shown', function(e) {
    var tab = e.detail.tab;
    if (tab === 'posTab') cargarPOS();
    else if (tab === 'mesasTab') cargarMesas();
    else if (tab === 'menusTab') cargarMenus();
