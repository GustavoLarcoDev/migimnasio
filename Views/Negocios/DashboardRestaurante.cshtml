    line-height: 1;
}
#posCategoryTabs .mg-pill.active .pill-count {
    background: rgba(255,255,255,0.25);
    color: #fff;
}

/* ── Mesa Order System ── */
.mesa-card-wrapper { position: relative; }
.mesa-card-wrapper .mesa-gear-btn {
    position: absolute; top: 6px; right: 6px; z-index: 2;
    width: 28px; height: 28px; border-radius: 50%;
    background: rgba(255,255,255,0.3); border: none;
    display: flex; align-items: center; justify-content: center;
    color: inherit; opacity: 0.6; transition: all 0.2s;
    cursor: pointer; font-size: 0.85rem;
}
.mesa-card-wrapper .mesa-gear-btn:hover { opacity: 1; background: rgba(255,255,255,0.5); }
.mesa-order-info { font-size: 0.75rem; opacity: 0.85; margin-top: 4px; }
.mesa-order-info .mesa-timer { font-family: monospace; }

/* Mesa activa indicator en POS */
#mesaActivaIndicator {
    display: none; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem; border-radius: 8px;
    background: linear-gradient(135deg, #F1416C, #E03E6B);
    color: #fff; font-weight: 700; font-size: 0.9rem;
    animation: mesaPulse 2s ease-in-out infinite;
    margin-bottom: 0.75rem;
}
#mesaActivaIndicator.active { display: flex; }
#mesaActivaIndicator .mesa-close-btn {
    margin-left: auto; background: rgba(255,255,255,0.2); border: none;
    color: #fff; border-radius: 50%; width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 0.75rem;
}
#mesaActivaIndicator .mesa-close-btn:hover { background: rgba(255,255,255,0.4); }
@@keyframes mesaPulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(241, 65, 108, 0.4); }
    50% { box-shadow: 0 0 0 8px rgba(241, 65, 108, 0); }
}
</style>

@await Html.PartialAsync("_ModalSeleccionPago")

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
// ═══════════════════════════════════════════════════════════
// JAVASCRIPT — Dashboard Restaurante
// ═══════════════════════════════════════════════════════════

const negocioId = @Json.Serialize(negocioId.ToString());
const negocioNombre = @Json.Serialize(Model.NegocioNombre ?? "Restaurante");
const negocioDireccion = @Json.Serialize(Model.Direccion ?? "");
let tablaLogs, tablaMovimientos, tablaRecibos, tablaOrdenes, tablaProveedores, tablaMenus, tablaRepartidores;
var modoEdicionProducto = false;
var productosCache = [];
var posCart = [];
var categoriasCache = [];
var mesasCache = [];
var repartidoresCache = [];
var currentTipoOrden = 'local';
var menuBuilderSecciones = [];
var menuEditId = null;
var currentMenuEstilo = 'moderno';
var currentMenuTipo = 'general';

// ── Ordenes por Mesa (persistidas en localStorage) ──
var ordenesMesa = {};
var mesaActiva = null;
var mesaActivaTimestamps = {};

function guardarOrdenesMesa() {
    try { localStorage.setItem('mg-ordenes-mesa-' + negocioId, JSON.stringify(ordenesMesa)); } catch(e) {}
}
function restaurarOrdenesMesa() {
    try {
        var saved = localStorage.getItem('mg-ordenes-mesa-' + negocioId);
        if (saved) ordenesMesa = JSON.parse(saved) || {};
        var ts = localStorage.getItem('mg-mesa-timestamps-' + negocioId);
        if (ts) mesaActivaTimestamps = JSON.parse(ts) || {};
    } catch(e) { ordenesMesa = {}; mesaActivaTimestamps = {}; }
}
function guardarTimestamps() {
    try { localStorage.setItem('mg-mesa-timestamps-' + negocioId, JSON.stringify(mesaActivaTimestamps)); } catch(e) {}
}
restaurarOrdenesMesa();

$.ajaxSetup({ cache: false });

$(document).ready(function() {
    cargarPOS();
    verificarSuscripcion();
    cargarNotificacionesCount();
    $.post('/Negocios/GenerarNotificaciones', { negocioId: negocioId }).done(function() {
        cargarNotificacionesCount();
    }).fail(function() {
        console.warn('No se pudieron generar notificaciones automaticas');
    });
});

// ═══════════════ SUSCRIPCION ═══════════════
function verificarSuscripcion() {
    $.get('/Negocios/GetSuscripcionStatus', { negocioId }, function(d) {
        if (d && d.esPrueba) {
            var dias = d.diasRestantes;
            $('#trialDaysText').text(dias <= 0 ? 'Tu prueba ha expirado' : 'Te quedan ' + dias + ' dias de prueba');
        }
    });
}

// ═══════════════ POS ═══════════════
function cargarPOS() {
    $.get('/Negocios/GetCategorias', { negocioId }, function(cats) {
        categoriasCache = cats;
        renderCategoryTabs(cats, '#posCategoryTabs');
    });
    $.get('/Negocios/GetProductos', { negocioId }, function(productos) {
        productosCache = productos;
        renderPOSProducts(productos);
    });
    $.get('/Negocios/GetInventarioStats', { negocioId }, function(d) {
        $('#posVentasHoy').text(d.ventasHoyUnidades);
        $('#posIngresosHoy').text('$' + d.ingresosHoy.toFixed(2));
        $('#posTotalProductos').text(d.totalProductos);
        $('#posStockBajo').text(d.stockBajo);
    });
    cargarMesasParaPOS();
    cargarRepartidoresParaPOS();
    cargarOrdenesRecientes();
}

function cargarMesasParaPOS() {
    $.get('/Negocios/GetMesas', { negocioId }, function(mesas) {
        mesasCache = mesas;
        var sel = $('#posMesaId');
        sel.find('option:not(:first)').remove();
        mesas.filter(function(m) { return m.estado === 'libre'; }).forEach(function(m) {
            sel.append('<option value="' + m.mesaId + '">' + escHtml(m.nombre) + ' (' + m.capacidad + ' pers.)</option>');
        });
    });
}

function cargarRepartidoresParaPOS() {
    $.get('/Negocios/GetEmpleados', { negocioId }, function(data) {
        repartidoresCache = Array.isArray(data) ? data : (data.empleados || []);
        var sel = $('#posRepartidorId');
        sel.find('option:not(:first)').remove();
        repartidoresCache.forEach(function(r) {
            sel.append('<option value="' + r.empleadoId + '" data-tel="' + escAttr(r.telefono || '') + '">' + escHtml(r.nombre + ' ' + r.apellido) + ' (' + escHtml(r.especialidad || 'N/A') + ')</option>');
        });
    });
}

function renderCategoryTabs(cats, container) {
    var $c = $(container);
    $c.find('.mg-pill:not(:first)').remove();
    $c.find('.mg-pill:first').html('Todos <span class="pill-count">' + productosCache.length + '</span>');
    cats.forEach(function(cat) {
        var count = productosCache.filter(function(p) { return p.categoriaProductoId === cat.categoriaId; }).length;
        $c.append('<button class="mg-pill" data-cat="' + cat.categoriaId + '">' + escHtml(cat.nombre) + ' <span class="pill-count">' + count + '</span></button>');
    });
}

function renderPOSProducts(productos, filter) {
    var grid = $('#posProductsGrid'); grid.empty();
    var filtered = filter ? productos.filter(function(p) { return p.categoriaProductoId === filter; }) : productos;
    var search = ($('#posBuscar').val() || '').toLowerCase();
    if (search) filtered = filtered.filter(function(p) { return p.nombre.toLowerCase().includes(search); });
    if (!filtered.length) { grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-cup-hot fs-1 d-block mb-3 opacity-50"></i><p>No hay platos</p></div>'); return; }
    filtered.forEach(function(p) {
        var imgHtml = p.imagenUrl ? '<img src="' + escAttr(p.imagenUrl) + '" class="pos-prod-img" alt="">' : '<div class="pos-prod-placeholder"><i class="bi bi-cup-hot"></i></div>';
        grid.append('<div class="col-xl-3 col-lg-4 col-md-4 col-6"><div class="pos-product-card' + (p.stock <= 0 ? ' out-of-stock' : '') + '" data-id="' + p.productoId + '" onclick="agregarAlCarrito(\'' + p.productoId + '\')">' + imgHtml + '<div class="pos-prod-name" title="' + escAttr(p.nombre) + '">' + escHtml(p.nombre) + '</div><div class="pos-prod-price">$' + p.precioVenta.toFixed(2) + '</div><div class="pos-prod-stock">' + (p.stock <= 0 ? '<span class="text-danger">Agotado</span>' : 'Stock: ' + p.stock) + '</div></div></div>');
    });
}

$(document).on('click', '#posCategoryTabs .mg-pill', function() {
    $('#posCategoryTabs .mg-pill').removeClass('active'); $(this).addClass('active');
    renderPOSProducts(productosCache, $(this).data('cat') || null);
});
$('#posBuscar').on('input', function() { renderPOSProducts(productosCache, $('#posCategoryTabs .mg-pill.active').data('cat') || null); });

// Tipo orden pills
$(document).on('click', '#tipoOrdenPills .mg-pill', function() {
    $('#tipoOrdenPills .mg-pill').removeClass('active'); $(this).addClass('active');
    currentTipoOrden = $(this).data('tipo');
    $('#mesaSelector').toggleClass('d-none', currentTipoOrden !== 'local').toggle(currentTipoOrden === 'local');
    $('#deliveryFields').toggleClass('d-none', currentTipoOrden !== 'delivery');
    $('#btnLlamarDelivery').toggleClass('d-none', currentTipoOrden !== 'delivery');
    if (currentTipoOrden === 'local') { $('#mesaSelector').removeClass('d-none'); }
});

// Llamar delivery WhatsApp
$('#btnLlamarDelivery').on('click', function() {
    var repOpt = $('#posRepartidorId option:selected');
    var tel = repOpt.data('tel');
    if (!tel) { toastr.warning('Selecciona un repartidor con telefono'); return; }
    tel = tel.replace(/\D/g, '');
    if (tel.startsWith('0')) tel = '593' + tel.substring(1);
    if (!tel.startsWith('593')) tel = '593' + tel;
    var dir = $('#posDireccion').val() || negocioDireccion;
    var msg = encodeURIComponent('Hola ' + repOpt.text().split('(')[0].trim() + ', necesito un servicio de delivery para ' + negocioNombre + ', por favor venga a ' + dir);
    window.open('https://wa.me/' + tel + '?text=' + msg, '_blank');
});

function agregarAlCarrito(productoId) {
    var p = productosCache.find(function(x) { return x.productoId === productoId; });
    if (!p || p.stock <= 0) return;
    var ex = posCart.find(function(c) { return c.productoId === productoId; });
    if (ex) { if (ex.cantidad >= p.stock) { toastr.warning('No hay mas stock de ' + p.nombre); return; } ex.cantidad++; }
    else posCart.push({ productoId: p.productoId, nombre: p.nombre, precioVenta: p.precioVenta, cantidad: 1, stock: p.stock, imagenUrl: p.imagenUrl || '' });
    renderCart();
}

function renderCart() {
    // Sincronizar con ordenesMesa si hay mesa activa
    if (mesaActiva) { ordenesMesa[mesaActiva] = posCart.slice(); guardarOrdenesMesa(); }
    var c = $('#posCartItems'); c.empty();
    if (!posCart.length) { c.html('<div class="text-center py-5 text-muted"><i class="bi bi-cart3 fs-1 d-block mb-2 opacity-50"></i><p>Selecciona platos para agregar</p></div>'); $('#btnCobrar').prop('disabled', true); calcularTotales(); return; }
    posCart.forEach(function(item, i) {
        var cartImg = item.imagenUrl ? '<img src="' + escAttr(item.imagenUrl) + '" class="pos-cart-img" alt="">' : '<div class="pos-cart-img-placeholder"><i class="bi bi-cup-hot"></i></div>';
        c.append('<div class="pos-cart-item">' + cartImg + '<div class="pos-cart-name" title="' + escAttr(item.nombre) + '">' + escHtml(item.nombre) + '</div><div class="pos-cart-qty"><button class="btn btn-sm btn-outline-secondary" onclick="cambiarCantidad(' + i + ',-1)"><i class="bi bi-dash"></i></button><span class="fw-bold px-2">' + item.cantidad + '</span><button class="btn btn-sm btn-outline-secondary" onclick="cambiarCantidad(' + i + ',1)"><i class="bi bi-plus"></i></button></div><div class="pos-cart-subtotal">$' + (item.precioVenta * item.cantidad).toFixed(2) + '</div><button class="btn btn-sm btn-outline-danger" onclick="quitarDelCarrito(' + i + ')"><i class="bi bi-x"></i></button></div>');
    });
    $('#btnCobrar').prop('disabled', false); calcularTotales();
}

function cambiarCantidad(i, d) { var item = posCart[i]; if (!item) return; item.cantidad += d; if (item.cantidad <= 0) { quitarDelCarrito(i); return; } if (item.cantidad > item.stock) { item.cantidad = item.stock; toastr.warning('Stock maximo: ' + item.stock); } renderCart(); }
function quitarDelCarrito(i) { posCart.splice(i, 1); renderCart(); }

function calcularTotales() {
    var sub = posCart.reduce(function(s, i) { return s + i.precioVenta * i.cantidad; }, 0);
    var iva = parseFloat($('#posIva').val()) || 0, desc = parseFloat($('#posDescuento').val()) || 0;
    var mIva = sub * iva / 100, mDesc = sub * desc / 100, total = Math.max(0, sub + mIva - mDesc);
    $('#posSubtotal').text('$' + sub.toFixed(2)); $('#posIvaMonto').text('$' + mIva.toFixed(2));
    $('#posDescuentoDisplay').text('-$' + mDesc.toFixed(2)); $('#posTotal').text('$' + total.toFixed(2));
}
$('#posIva, #posDescuento').on('input', calcularTotales);

$('#btnCobrar').on('click', function() {
    if (!posCart.length) return;
    var total = parseFloat($('#posTotal').text().replace('$', ''));

    mostrarModalPago(function(resultado) {
        swalMG.fire({ title: 'Confirmar Cobro', html: '<p class="fs-3 fw-bolder text-success mb-0">$' + total.toFixed(2) + '</p><p class="text-muted">' + posCart.length + ' plato(s) - ' + currentTipoOrden.replace('_', ' ') + '</p><p class="text-muted small mt-1"><i class="bi bi-credit-card me-1"></i>' + escHtml(resultado.metodoPago) + '</p>', icon: 'question', showCancelButton: true, confirmButtonText: '<i class="bi bi-check-lg me-1"></i>Confirmar Pago', confirmButtonColor: '#50CD89' }).then(function(r) { if (r.isConfirmed) procesarVenta(resultado.metodoPago, resultado.numeroConfirmacion); });
    });
});

function procesarVenta(metodoPago, numeroConfirmacion) {
    var btn = $('#btnCobrar'); btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Procesando...');
    var sub = posCart.reduce(function(s, i) { return s + i.precioVenta * i.cantidad; }, 0);
    var descPct = parseFloat($('#posDescuento').val()) || 0;
    var payload = {
        NombreCliente: $('#posNombreCliente').val() || 'Mostrador',
        EmailCliente: '', DescuentoAdicional: sub * descPct / 100,
        PorcentajeIva: parseFloat($('#posIva').val()) || 0,
        Items: posCart.map(function(c) { return { ProductoId: c.productoId, Cantidad: c.cantidad }; }),
        TipoOrden: currentTipoOrden,
        MesaId: mesaActiva ? mesaActiva : (currentTipoOrden === 'local' ? ($('#posMesaId').val() || null) : null),
        EmpleadoId: currentTipoOrden === 'delivery' ? ($('#posRepartidorId').val() || null) : null,
        DireccionEntrega: currentTipoOrden === 'delivery' ? ($('#posDireccion').val() || '') : null,
        MetodoPago: metodoPago || 'Efectivo',
        NumeroConfirmacion: numeroConfirmacion || null
    };
    $.ajax({ url: '/Negocios/ProcesarVentaPOS', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload),
        success: function(r) {
            if (r.success) {
                var mesaVendida = mesaActiva;
                posCart = []; renderCart(); $('#posNombreCliente').val(''); $('#posDescuento').val(0);
                if (mesaVendida) {
                    liberarMesaTrasVenta(mesaVendida);
                }
                cargarPOS(); if (tablaLogs) tablaLogs.ajax.reload(); if (tablaRecibos) tablaRecibos.ajax.reload();
                if (r.reciboId) mostrarReciboVenta(r.reciboId); else swalMG.fire({ title: 'Venta Exitosa!', icon: 'success' });
            } else toastr.error(r.message);
        },
        error: function(xhr) { toastr.error(xhr.responseJSON?.message || 'Error al procesar venta'); },
        complete: function() { btn.prop('disabled', false).html('<i class="bi bi-cash-stack me-2"></i>Cobrar'); }
    });
}

function mostrarReciboVenta(reciboId) {
    $.get('/Negocios/GetRecibo', { reciboId, negocioId }, function(r) {
        if (!r) { swalMG.fire({ title: 'Venta Exitosa!', icon: 'success' }); return; }
        $('#reciboModalNumero').text(r.numeroRecibo); document.getElementById('reciboIframe').srcdoc = r.contenidoHtml;
        var footer = $('#reciboModal .modal-footer');
        footer.html('<button type="button" class="btn btn-success" onclick="enviarReciboPOS(\'' + reciboId + '\',\'whatsapp\')"><i class="bi bi-whatsapp me-2"></i>WhatsApp</button><button type="button" class="btn btn-outline-info" onclick="enviarReciboPOS(\'' + reciboId + '\',\'email\')"><i class="bi bi-envelope me-2"></i>Email</button><button type="button" class="btn btn-outline-primary" onclick="imprimirRecibo()"><i class="bi bi-printer me-2"></i>Imprimir</button><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>');
        new bootstrap.Modal('#reciboModal').show();
    });
}

function enviarReciboPOS(reciboId, tipo) {
    var m = bootstrap.Modal.getInstance(document.getElementById('reciboModal')); if (m) m.hide();
    var isWA = tipo === 'whatsapp';
    setTimeout(function() {
        swalMG.fire({ title: 'Enviar Recibo', html: '<label class="form-label fw-semibold text-start d-block">' + (isWA ? 'Numero de WhatsApp' : 'Correo Electronico') + '</label><input type="' + (isWA ? 'tel' : 'email') + '" id="swalDestinoRecibo" class="form-control" placeholder="' + (isWA ? 'Ej: 0989799891' : 'Ej: cliente@email.com') + '">' + (isWA ? '<small class="text-muted d-block mt-1"><i class="bi bi-info-circle me-1"></i>El codigo de pais (+593) se agrega automaticamente</small>' : ''), showCancelButton: true, confirmButtonText: '<i class="bi bi-send me-1"></i>Enviar', didOpen: function() { document.getElementById('swalDestinoRecibo').focus(); }, preConfirm: function() { var d = document.getElementById('swalDestinoRecibo').value.trim(); if (!d) { Swal.showValidationMessage('Ingresa un destino'); return false; } return d; }
        }).then(function(result) { if (result.isConfirmed) $.post('/Negocios/EnviarRecibo', { reciboId, negocioId, destino: result.value, tipo }, function(r) { if (r.success) toastr.success(r.message); else toastr.error(r.message); }).fail(function() { toastr.error('Error de conexion'); }); });
    }, 300);
}

function imprimirRecibo() {
    var html = document.getElementById('reciboIframe').srcdoc; if (!html) return;
    var w = window.open('', '_blank', 'width=800,height=600'); w.document.write(html); w.document.close(); w.focus(); setTimeout(function() { w.print(); }, 400);
}

function cargarOrdenesRecientes() {
    if (tablaOrdenes) { tablaOrdenes.ajax.reload(); return; }
    tablaOrdenes = $('#ordenesTable').DataTable({ ajax: { url: '/Negocios/GetOrdenesVenta', data: { negocioId }, dataSrc: '' },
        columns: [
            { data: 'numeroOrden', render: function(d) { return '<span class="badge bg-primary">#' + d + '</span>'; } },
            { data: 'nombreCliente', render: function(d) { return escHtml(d || 'Mostrador'); } },
            { data: 'tipoOrden', render: function(d) { var m = { local: 'Local', para_llevar: 'Para Llevar', delivery: 'Delivery' }; return '<span class="badge bg-' + (d === 'delivery' ? 'info' : d === 'para_llevar' ? 'warning text-dark' : 'success') + '">' + (m[d] || d || 'Local') + '</span>'; } },
            { data: 'items' },
            { data: 'total', render: function(d) { return '<span class="fw-bold text-success">$' + d.toFixed(2) + '</span>'; } },
            { data: 'fechaCreacion', render: function(d) { return new Date(d).toLocaleString('es-EC'); } }
        ], order: [[5, 'desc']], pageLength: 5
    });
}

// ═══════════════ MESAS ═══════════════
function cargarMesas() {
    $.get('/Negocios/GetMesas', { negocioId }, function(mesas) {
        mesasCache = mesas;
        var grid = $('#mesasGrid'); grid.empty();
        if (!mesas.length) { grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-grid-3x3 fs-1 d-block mb-3 opacity-50"></i><p>No hay mesas. Crea la primera.</p></div>'); return; }
        mesas.forEach(function(m) {
            var color = m.estado === 'libre' ? 'success' : m.estado === 'ocupada' ? 'danger' : 'warning';
            var textColor = m.estado === 'reservada' ? 'text-dark' : 'text-white';
            var orden = ordenesMesa[m.mesaId];
            var orderInfo = '';
            if (m.estado === 'ocupada' && orden && orden.length > 0) {
                var totalItems = orden.reduce(function(s, i) { return s + i.cantidad; }, 0);
                var totalMonto = orden.reduce(function(s, i) { return s + i.precioVenta * i.cantidad; }, 0);
                var tiempoStr = '';
                if (mesaActivaTimestamps[m.mesaId]) {
                    var mins = Math.floor((Date.now() - mesaActivaTimestamps[m.mesaId]) / 60000);
                    tiempoStr = '<div class="mesa-timer"><i class="bi bi-clock me-1"></i>' + (mins < 60 ? mins + ' min' : Math.floor(mins/60) + 'h ' + (mins%60) + 'm') + '</div>';
                }
                orderInfo = '<div class="mesa-order-info"><div><i class="bi bi-cart me-1"></i>' + totalItems + ' items &middot; <strong>$' + totalMonto.toFixed(2) + '</strong></div>' + tiempoStr + '</div>';
            }
            grid.append(
                '<div class="col-xl-2 col-lg-3 col-md-4 col-6">' +
                '<div class="mesa-card-wrapper">' +
                '<button class="mesa-gear-btn ' + textColor + '" onclick="event.stopPropagation(); editarMesaModal(\'' + m.mesaId + '\')" title="Editar mesa"><i class="bi bi-gear"></i></button>' +
                '<div class="mg-card border-0 text-center cursor-pointer" style="background: var(--mg-' + color + '); border-radius: 12px;" onclick="clickMesa(\'' + m.mesaId + '\')">' +
                '<div class="card-body py-3 ' + textColor + '">' +
                '<div class="fs-3 fw-bolder">' + m.numero + '</div>' +
                '<div class="small fw-semibold">' + escHtml(m.nombre) + '</div>' +
                '<div class="small opacity-75"><i class="bi bi-people me-1"></i>' + m.capacidad + '</div>' +
                '<span class="badge bg-white bg-opacity-25 mt-1">' + m.estado + '</span>' +
                orderInfo +
                '</div></div></div></div>'
            );
        });
        // Limpiar ordenes huerfanas
        Object.keys(ordenesMesa).forEach(function(mid) {
            if (!mesas.find(function(m) { return m.mesaId === mid; })) { delete ordenesMesa[mid]; delete mesaActivaTimestamps[mid]; }
        });
        guardarOrdenesMesa(); guardarTimestamps();
    });
}

function clickMesa(mesaId) {
    var m = mesasCache.find(function(x) { return x.mesaId === mesaId; });
    if (!m) return;

    if (m.estado === 'libre') {
        // Marcar como ocupada y abrir POS
        $.ajax({ url: '/Negocios/CambiarEstadoMesa', type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ MesaId: mesaId, Estado: 'ocupada' }),
            success: function(r) {
                if (r.success) {
                    if (!ordenesMesa[mesaId]) ordenesMesa[mesaId] = [];
                    mesaActivaTimestamps[mesaId] = Date.now();
                    guardarOrdenesMesa(); guardarTimestamps();
                    abrirPOSParaMesa(mesaId);
                } else toastr.error(r.message);
            }
        });
    } else if (m.estado === 'ocupada') {
        abrirPOSParaMesa(mesaId);
    } else if (m.estado === 'reservada') {
        swalMG.fire({
            title: escHtml(m.nombre), html: '<p><i class="bi bi-bookmark-star me-1"></i>Mesa reservada</p><p>Capacidad: ' + m.capacidad + ' personas</p>',
            showDenyButton: true, showCancelButton: true,
            confirmButtonText: '<i class="bi bi-door-open me-1"></i>Abrir Mesa',
            denyButtonText: '<i class="bi bi-unlock me-1"></i>Liberar',
            cancelButtonText: 'Cerrar'
        }).then(function(r) {
            if (r.isConfirmed) {
                $.ajax({ url: '/Negocios/CambiarEstadoMesa', type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ MesaId: mesaId, Estado: 'ocupada' }),
                    success: function(r2) {
                        if (r2.success) {
                            if (!ordenesMesa[mesaId]) ordenesMesa[mesaId] = [];
                            mesaActivaTimestamps[mesaId] = Date.now();
                            guardarOrdenesMesa(); guardarTimestamps();
                            abrirPOSParaMesa(mesaId);
                        } else toastr.error(r2.message);
                    }
                });
            } else if (r.isDenied) {
                $.ajax({ url: '/Negocios/CambiarEstadoMesa', type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ MesaId: mesaId, Estado: 'libre' }),
                    success: function(r2) { if (r2.success) { toastr.success('Mesa liberada'); cargarMesas(); cargarMesasParaPOS(); } else toastr.error(r2.message); }
                });
            }
        });
    }
}

function abrirPOSParaMesa(mesaId) {
    // Guardar carrito actual si hay otra mesa activa
    if (mesaActiva && mesaActiva !== mesaId) {
        ordenesMesa[mesaActiva] = posCart.slice();
        guardarOrdenesMesa();
    }
    mesaActiva = mesaId;
    // Restaurar carrito de esta mesa
    posCart = (ordenesMesa[mesaId] || []).slice();
    // Forzar tipo local
    currentTipoOrden = 'local';
    $('#tipoOrdenPills .mg-pill').removeClass('active');
    $('#tipoOrdenPills .mg-pill[data-tipo="local"]').addClass('active');
    renderCart();
    actualizarIndicadorMesa();
    switchToTab('posTab');
}

function actualizarIndicadorMesa() {
    if (mesaActiva) {
        var m = mesasCache.find(function(x) { return x.mesaId === mesaActiva; });
        var nombre = m ? m.nombre : 'Mesa';
        $('#mesaActivaNombre').text(nombre);
        $('#mesaActivaIndicator').addClass('active');
        $('#tipoOrdenPills').addClass('d-none');
        $('#mesaSelector').addClass('d-none');
        $('#btnCancelarOrden').removeClass('d-none');
    } else {
        $('#mesaActivaIndicator').removeClass('active');
        $('#tipoOrdenPills').removeClass('d-none');
        if (currentTipoOrden === 'local') $('#mesaSelector').removeClass('d-none');
        $('#btnCancelarOrden').addClass('d-none');
    }
}

function cerrarMesaActiva() {
    if (mesaActiva) {
        ordenesMesa[mesaActiva] = posCart.slice();
        guardarOrdenesMesa();
    }
    mesaActiva = null;
    posCart = [];
    renderCart();
    actualizarIndicadorMesa();
    switchToTab('mesasTab');
}

function cancelarOrdenMesa() {
    if (!mesaActiva) return;
    var mid = mesaActiva;
    swalMG.fire({
        title: 'Cancelar Orden?', text: 'Se vaciara el carrito y la mesa se liberara.',
        icon: 'warning', showCancelButton: true,
        confirmButtonText: '<i class="bi bi-x-circle me-1"></i>Si, cancelar',
        confirmButtonColor: '#F1416C', cancelButtonText: 'No'
    }).then(function(r) {
        if (r.isConfirmed) liberarMesaTrasVenta(mid);
    });
}

function liberarMesaTrasVenta(mesaId) {
    delete ordenesMesa[mesaId];
    delete mesaActivaTimestamps[mesaId];
    guardarOrdenesMesa(); guardarTimestamps();
    if (mesaActiva === mesaId) {
        mesaActiva = null;
        posCart = [];
        renderCart();
        actualizarIndicadorMesa();
    }
    $.ajax({ url: '/Negocios/CambiarEstadoMesa', type: 'POST', contentType: 'application/json',
        data: JSON.stringify({ MesaId: mesaId, Estado: 'libre' }),
        success: function(r) {
            if (r.success) { cargarMesas(); cargarMesasParaPOS(); }
        }
    });
    switchToTab('mesasTab');
}

function editarMesaModal(mesaId) {
    var m = mesasCache.find(function(x) { return x.mesaId === mesaId; });
    if (!m) return;
    swalMG.fire({
        title: escHtml(m.nombre),
        html: '<p>Estado: <strong>' + m.estado + '</strong></p><p>Capacidad: ' + m.capacidad + ' personas</p>',
        showDenyButton: true, showCancelButton: true,
        confirmButtonText: '<i class="bi bi-pencil me-1"></i>Editar',
        denyButtonText: '<i class="bi bi-trash me-1"></i>Eliminar',
        cancelButtonText: 'Cerrar'
    }).then(function(r) {
        if (r.isConfirmed) {
            $('#mesaEditId').val(mesaId); $('#mesaNombre').val(m.nombre); $('#mesaNumero').val(m.numero); $('#mesaCapacidad').val(m.capacidad);
            $('#mesaModalTitle').text('Editar Mesa'); new bootstrap.Modal('#mesaModal').show();
        } else if (r.isDenied) {
            swalMG.fire({ title: 'Eliminar ' + escHtml(m.nombre) + '?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Si, eliminar', confirmButtonColor: '#F1416C'
            }).then(function(r2) {
                if (r2.isConfirmed) $.ajax({ url: '/Negocios/EliminarMesa', type: 'POST', contentType: 'application/json', data: JSON.stringify({ MesaId: mesaId }),
                    success: function(r3) { if (r3.success) { toastr.success('Mesa eliminada'); delete ordenesMesa[mesaId]; delete mesaActivaTimestamps[mesaId]; guardarOrdenesMesa(); guardarTimestamps(); cargarMesas(); cargarMesasParaPOS(); } else toastr.error(r3.message); }
                });
            });
        }
    });
}

function switchToTab(tabId) {
    var link = document.querySelector('[data-mg-tab="' + tabId + '"]');
    if (link) link.click();
}

$('#btnNuevaMesa').on('click', function() { $('#mesaEditId').val(''); $('#mesaNombre').val(''); $('#mesaNumero').val(mesasCache.length + 1); $('#mesaCapacidad').val(4); $('#mesaModalTitle').text('Nueva Mesa'); new bootstrap.Modal('#mesaModal').show(); });

$('#btnGuardarMesa').on('click', function() {
    var id = $('#mesaEditId').val(), data = { Nombre: $('#mesaNombre').val(), Numero: parseInt($('#mesaNumero').val()) || 1, Capacidad: parseInt($('#mesaCapacidad').val()) || 4 };
    if (!data.Nombre) { toastr.error('Nombre obligatorio'); return; }
    var url = id ? '/Negocios/EditarMesa' : '/Negocios/CrearMesa';
    if (id) data.MesaId = id;
    $.ajax({ url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(data), success: function(r) { if (r.success) { toastr.success(r.message); bootstrap.Modal.getInstance(document.getElementById('mesaModal')).hide(); cargarMesas(); cargarMesasParaPOS(); } else toastr.error(r.message); } });
});

// ═══════════════ MENUS ═══════════════
var _menuPreviewCurrentId = null;

function cargarMenus() {
    if (tablaMenus) { tablaMenus.ajax.reload(); return; }
    tablaMenus = $('#menusTable').DataTable({ ajax: { url: '/Negocios/GetMenus', data: { negocioId }, dataSrc: '' },
        columns: [
            { data: 'nombre', render: function(d) { return '<strong>' + escHtml(d) + '</strong>'; } },
            { data: 'tipoMenu', render: function(d) { var colors = { desayuno: 'warning', almuerzo: 'primary', cena: 'info', general: 'secondary' }; return '<span class="badge bg-' + (colors[d] || 'secondary') + '">' + escHtml(d) + '</span>'; } },
            { data: 'precioFijo', render: function(d) { return d ? '$' + d.toFixed(2) : '-'; } },
            { data: 'estilo', render: function(d) { return escHtml(d || 'moderno'); } },
            { data: 'fechaCreacion', render: function(d) { return new Date(d).toLocaleDateString('es-EC'); } },
            { data: 'menuId', render: function(d) { return '<div class="d-flex gap-1 justify-content-end"><button class="btn btn-sm btn-outline-success" onclick="mostrarQRMenu(\'' + d + '\')" title="Codigo QR"><i class="bi bi-qr-code"></i></button><button class="btn btn-sm btn-outline-secondary" onclick="copiarLinkMenu(\'' + d + '\')" title="Copiar link"><i class="bi bi-link-45deg"></i></button><button class="btn btn-sm btn-outline-info" onclick="previewMenuGuardado(\'' + d + '\')"><i class="bi bi-eye"></i></button><button class="btn btn-sm btn-outline-primary" onclick="editarMenuGuardado(\'' + d + '\')"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-danger" onclick="eliminarMenu(\'' + d + '\')"><i class="bi bi-trash"></i></button></div>'; } }
        ], order: [[4, 'desc']]
    });
}

$('#btnNuevoMenu').on('click', function() { menuEditId = null; menuBuilderSecciones = []; currentMenuEstilo = 'moderno'; currentMenuTipo = 'general'; $('#menuNombre').val(''); $('#menuPrecioFijo').val(''); $('#menuPrecioFijoGroup').addClass('d-none'); $('#menuBuilderSection').removeClass('d-none'); $('#menusSavedSection').addClass('d-none'); renderMenuBuilder(); cargarPlatosParaMenu(); });
$('#btnCancelarMenu').on('click', function() { $('#menuBuilderSection').addClass('d-none'); $('#menusSavedSection').removeClass('d-none'); });

$(document).on('click', '#menuTipoPills .mg-pill', function() { $('#menuTipoPills .mg-pill').removeClass('active'); $(this).addClass('active'); currentMenuTipo = $(this).data('tipo'); $('#menuPrecioFijoGroup').toggleClass('d-none', currentMenuTipo !== 'almuerzo' && currentMenuTipo !== 'cena'); });
$(document).on('click', '.menuEstiloBtn', function() { $('.menuEstiloBtn').removeClass('active'); $(this).addClass('active'); currentMenuEstilo = $(this).data('style'); });

function cargarPlatosParaMenu() {
    $.get('/Negocios/GetProductos', { negocioId }, function(prods) {
        var container = $('#menuPlatosDisponibles'); container.empty();
        prods.forEach(function(p) {
            container.append('<div class="d-flex align-items-center justify-content-between p-2 border-bottom cursor-pointer menu-plato-item" data-id="' + p.productoId + '" data-nombre="' + escAttr(p.nombre) + '" data-precio="' + p.precioVenta + '"><div><strong>' + escHtml(p.nombre) + '</strong><br><small class="text-muted">$' + p.precioVenta.toFixed(2) + '</small></div><button class="btn btn-sm btn-outline-primary" onclick="agregarPlatoAlMenu(\'' + p.productoId + '\',\'' + escAttr(p.nombre) + '\',' + p.precioVenta + ')"><i class="bi bi-plus"></i></button></div>');
        });
    });
}

$('#menuBuscarPlato').on('input', function() { var q = $(this).val().toLowerCase(); $('.menu-plato-item').each(function() { $(this).toggle($(this).data('nombre').toLowerCase().includes(q)); }); });

$('#btnAgregarSeccion').on('click', function() {
    swalMG.fire({ title: 'Nueva Seccion', input: 'text', inputPlaceholder: 'Ej: Sopas, Platos Fuertes, Postres...', showCancelButton: true, confirmButtonText: 'Agregar'
    }).then(function(r) { if (r.isConfirmed && r.value) { menuBuilderSecciones.push({ nombre: r.value, items: [] }); renderMenuBuilder(); } });
});

function agregarPlatoAlMenu(prodId, nombre, precio) {
    if (!menuBuilderSecciones.length) { menuBuilderSecciones.push({ nombre: 'General', items: [] }); }
    var lastSec = menuBuilderSecciones[menuBuilderSecciones.length - 1];
    lastSec.items.push({ productoId: prodId, nombre: nombre, precio: precio });
    renderMenuBuilder();
    toastr.info(nombre + ' agregado');
}

function renderMenuBuilder() {
    var c = $('#menuBuilderItems'); c.empty();
    if (!menuBuilderSecciones.length) { c.html('<div class="text-center py-4 text-muted">Agrega secciones y platos para construir tu menu</div>'); return; }
    menuBuilderSecciones.forEach(function(sec, si) {
        var html = '<div class="mb-3 p-2 rounded" style="background: rgba(62,151,255,0.04); border: 1px solid rgba(62,151,255,0.15);">';
        html += '<div class="d-flex justify-content-between align-items-center mb-2"><strong class="text-primary"><i class="bi bi-folder me-1"></i>' + escHtml(sec.nombre) + '</strong><button class="btn btn-sm btn-outline-danger" onclick="eliminarSeccion(' + si + ')"><i class="bi bi-x"></i></button></div>';
        html += '<div class="menu-section-items" data-section="' + si + '">';
        sec.items.forEach(function(item, ii) {
            html += '<div class="d-flex align-items-center gap-2 p-1 mb-1 rounded bg-white" data-item="' + ii + '"><i class="bi bi-grip-vertical text-muted handle"></i><span class="flex-grow-1">' + escHtml(item.nombre) + '</span><span class="text-muted">$' + item.precio.toFixed(2) + '</span><button class="btn btn-sm text-danger p-0" onclick="quitarItemMenu(' + si + ',' + ii + ')"><i class="bi bi-x-circle"></i></button></div>';
        });
        html += '</div></div>';
        c.append(html);
    });
    // Init Sortable for each section
    document.querySelectorAll('.menu-section-items').forEach(function(el) {
        new Sortable(el, { handle: '.handle', animation: 150, onEnd: function(evt) {
            var si = parseInt(el.dataset.section);
            var items = menuBuilderSecciones[si].items;
            var moved = items.splice(evt.oldIndex, 1)[0];
            items.splice(evt.newIndex, 0, moved);
        }});
    });
}

function eliminarSeccion(si) { menuBuilderSecciones.splice(si, 1); renderMenuBuilder(); }
function quitarItemMenu(si, ii) { menuBuilderSecciones[si].items.splice(ii, 1); renderMenuBuilder(); }

$('#btnGuardarMenu').on('click', function() {
    var nombre = $('#menuNombre').val(); if (!nombre) { toastr.error('Nombre del menu obligatorio'); return; }
    var precioFijo = (currentMenuTipo === 'almuerzo' || currentMenuTipo === 'cena') ? parseFloat($('#menuPrecioFijo').val()) || null : null;
    var dto = { Nombre: nombre, TipoMenu: currentMenuTipo, PrecioFijo: precioFijo, ItemsJson: JSON.stringify(menuBuilderSecciones), Estilo: currentMenuEstilo };
    if (menuEditId) dto.MenuId = menuEditId;
    var url = menuEditId ? '/Negocios/EditarMenu' : '/Negocios/CrearMenu';
    $.ajax({ url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(dto), success: function(r) { if (r.success) { toastr.success(r.message); $('#menuBuilderSection').addClass('d-none'); $('#menusSavedSection').removeClass('d-none'); cargarMenus(); } else toastr.error(r.message); } });
});

function previewMenuGuardado(menuId) {
    _menuPreviewCurrentId = menuId;
    $.get('/Negocios/PreviewMenu', { menuId }, function(html) { document.getElementById('menuPreviewIframe').srcdoc = html; new bootstrap.Modal('#menuPreviewModal').show(); }).fail(function() { toastr.error('Error al cargar preview'); });
}

$('#btnPreviewMenu').on('click', function() {
    var nombre = $('#menuNombre').val() || 'Preview'; var precioFijo = (currentMenuTipo === 'almuerzo' || currentMenuTipo === 'cena') ? parseFloat($('#menuPrecioFijo').val()) || null : null;
    var dto = { Nombre: nombre, TipoMenu: currentMenuTipo, PrecioFijo: precioFijo, ItemsJson: JSON.stringify(menuBuilderSecciones), Estilo: currentMenuEstilo };
    // Save temp then preview
    if (menuEditId) { dto.MenuId = menuEditId; $.ajax({ url: '/Negocios/EditarMenu', type: 'POST', contentType: 'application/json', data: JSON.stringify(dto), success: function(r) { if (r.success) previewMenuGuardado(menuEditId); else toastr.error(r.message); } }); }
    else { $.ajax({ url: '/Negocios/CrearMenu', type: 'POST', contentType: 'application/json', data: JSON.stringify(dto), success: function(r) { if (r.success) { cargarMenus(); toastr.info('Menu guardado para preview'); } else toastr.error(r.message); } }); }
});

$('#btnDescargarMenuPreview').on('click', function() { var html = document.getElementById('menuPreviewIframe').srcdoc; if (!html) return; var w = window.open('', '_blank'); w.document.write(html); w.document.close(); w.focus(); setTimeout(function() { w.print(); }, 400); });

function editarMenuGuardado(menuId) {
    $.get('/Negocios/GetMenu', { menuId }, function(m) {
        menuEditId = m.menuId; $('#menuNombre').val(m.nombre); currentMenuTipo = m.tipoMenu; currentMenuEstilo = m.estilo || 'moderno';
        $('#menuTipoPills .mg-pill').removeClass('active').filter('[data-tipo="' + m.tipoMenu + '"]').addClass('active');
        $('.menuEstiloBtn').removeClass('active').filter('[data-style="' + currentMenuEstilo + '"]').addClass('active');
        $('#menuPrecioFijoGroup').toggleClass('d-none', m.tipoMenu !== 'almuerzo' && m.tipoMenu !== 'cena');
        if (m.precioFijo) $('#menuPrecioFijo').val(m.precioFijo);
        try { menuBuilderSecciones = JSON.parse(m.itemsJson || '[]'); } catch(e) { menuBuilderSecciones = []; }
        $('#menuBuilderSection').removeClass('d-none'); $('#menusSavedSection').addClass('d-none');
        renderMenuBuilder(); cargarPlatosParaMenu();
    });
}

function eliminarMenu(menuId) {
    swalMG.fire({ title: 'Eliminar menu?', icon: 'warning', showCancelButton: true, confirmButtonText: 'Si, eliminar', confirmButtonColor: '#F1416C' }).then(function(r) {
        if (r.isConfirmed) $.ajax({ url: '/Negocios/EliminarMenu', type: 'POST', contentType: 'application/json', data: JSON.stringify({ MenuId: menuId }), success: function(r) { if (r.success) { toastr.success(r.message); cargarMenus(); } else toastr.error(r.message); } });
    });
}

