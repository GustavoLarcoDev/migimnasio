function cargarMesas() {
    $.get('/Negocios/GetMesas', { negocioId }, function(mesas) {
        mesasCache = mesas;
        var grid = $('#mesasGrid'); grid.empty();
        if (!mesas.length) { grid.html('<div class="col-12 text-center py-5 text-muted"><i class="bi bi-grid-3x3 fs-1 d-block mb-3 opacity-50"></i><p>No hay mesas. Crea la primera.</p></div>'); return; }
        mesas.forEach(function(m) {
            var color = m.estado === 'libre' ? 'success' : m.estado === 'ocupada' ? 'danger' : 'warning';
            var textColor = m.estado === 'reservada' ? 'text-dark' : 'text-white';
            grid.append('<div class="col-xl-2 col-lg-3 col-md-4 col-6"><div class="mg-card border-0 text-center cursor-pointer" style="background: var(--mg-' + color + '); border-radius: 12px;" onclick="mostrarOpcionesMesa(\'' + m.mesaId + '\')">' +
                '<div class="card-body py-3 ' + textColor + '">' +
                '<div class="fs-3 fw-bolder">' + m.numero + '</div>' +
                '<div class="small fw-semibold">' + escHtml(m.nombre) + '</div>' +
                '<div class="small opacity-75"><i class="bi bi-people me-1"></i>' + m.capacidad + '</div>' +
                '<span class="badge bg-white bg-opacity-25 mt-1">' + m.estado + '</span>' +
                '</div></div></div>');
        });
    });
}

function mostrarOpcionesMesa(mesaId) {
    var m = mesasCache.find(function(x) { return x.mesaId === mesaId; });
    if (!m) return;
    swalMG.fire({ title: m.nombre, html: '<p>Estado: <strong>' + m.estado + '</strong></p><p>Capacidad: ' + m.capacidad + ' personas</p>', showDenyButton: true, showCancelButton: true, confirmButtonText: 'Cambiar Estado', denyButtonText: 'Editar', cancelButtonText: 'Cerrar'
    }).then(function(r) {
        if (r.isConfirmed) {
            swalMG.fire({ title: 'Cambiar Estado', input: 'select', inputOptions: { libre: 'Libre', ocupada: 'Ocupada', reservada: 'Reservada' }, inputValue: m.estado, showCancelButton: true, confirmButtonText: 'Cambiar'
            }).then(function(r2) { if (r2.isConfirmed) $.ajax({ url: '/Negocios/CambiarEstadoMesa', type: 'POST', contentType: 'application/json', data: JSON.stringify({ MesaId: mesaId, Estado: r2.value }), success: function(r3) { if (r3.success) { toastr.success(r3.message); cargarMesas(); cargarMesasParaPOS(); } else toastr.error(r3.message); } }); });
        } else if (r.isDenied) {
            $('#mesaEditId').val(mesaId); $('#mesaNombre').val(m.nombre); $('#mesaNumero').val(m.numero); $('#mesaCapacidad').val(m.capacidad); $('#mesaModalTitle').text('Editar Mesa'); new bootstrap.Modal('#mesaModal').show();
        }
    });
}

