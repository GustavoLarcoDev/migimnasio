@model Gimnasio.Models.Gym

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Dashboard - " + Model.NegocioNombre;
    ViewData["NegocioId"] = Model.NegocioId;
    ViewData["NegocioNombre"] = Model.NegocioNombre;
    ViewData["DuenoNombre"] = Model.DuenoNegocio;
    ViewData["TipoNegocio"] = "restaurante";
    var negocioId = Model.NegocioId;
}

@if (Model.EsPrueba)
{
    <div class="alert border-0 d-flex align-items-center gap-3 mb-4 shadow-sm" id="trialBanner"
         style="background: linear-gradient(135deg, #FFF8DD 0%, #FFF3CD 100%); border-left: 4px solid #FFC700 !important;">
        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
             style="width: 42px; height: 42px; background: rgba(255, 199, 0, 0.2);">
            <i class="bi bi-hourglass-split text-warning fs-5"></i>
        </div>
        <div class="flex-grow-1">
            <strong class="text-dark">Periodo de prueba</strong>
            <span class="d-block d-sm-inline text-muted ms-sm-1" id="trialDaysText">Cargando...</span>
        </div>
        <a href="https://wa.me/593997143142?text=Hola%2C%20quiero%20activar%20mi%20plan%20de%20pago%20en%20Mi%20Negocio" target="_blank" rel="noopener"
           class="btn btn-warning btn-sm fw-bold flex-shrink-0">
            <i class="bi bi-whatsapp me-1"></i>Activar Plan
        </a>
    </div>
}

<div class="tab-content" id="dashboardTabsContent">

    <!-- ═══════════════ TAB POS ═══════════════ -->
    <div class="tab-pane fade show active" id="posTab" role="tabpanel">
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ventas Hoy</div><div class="stat-value" id="posVentasHoy">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-cart-check text-primary"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Hoy</div><div class="stat-value text-success" id="posIngresosHoy">$0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-currency-dollar text-success"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Platos</div><div class="stat-value" id="posTotalProductos">0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-cup-hot text-info"></i></div></div></div>
            </div>
            <div class="col-xl-3 col-md-6 col-6">
                <div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Stock Bajo</div><div class="stat-value text-danger" id="posStockBajo">0</div></div><div class="stat-icon bg-light-danger"><i class="bi bi-exclamation-triangle-fill text-danger"></i></div></div></div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Products/Platos panel -->
            <div class="col-lg-7">
                <div class="mg-card h-100">
                    <div class="card-header border-0 pb-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <h5 class="fw-bold mb-0"><i class="bi bi-grid me-2"></i>Platos</h5>
                            <div class="input-group" style="max-width: 250px;">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" id="posBuscar" placeholder="Buscar plato...">
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3" id="posCategoryTabs">
                            <button class="mg-pill active" data-cat="">Todos</button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-2" id="posProductsGrid"></div>
                    </div>
                </div>
            </div>

            <!-- Cart panel -->
            <div class="col-lg-5">
                <div class="mg-card h-100">
                    <div class="card-header border-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-receipt me-2"></i>Factura</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <!-- Tipo de orden -->
                        <div class="d-flex gap-2 mb-3" id="tipoOrdenPills">
                            <button class="mg-pill active" data-tipo="local"><i class="bi bi-shop me-1"></i>Local</button>
                            <button class="mg-pill" data-tipo="para_llevar"><i class="bi bi-bag me-1"></i>Para Llevar</button>
                            <button class="mg-pill" data-tipo="delivery"><i class="bi bi-bicycle me-1"></i>Delivery</button>
                        </div>

                        <!-- Mesa selector (solo si tipo=local) -->
                        <div class="mb-3" id="mesaSelector">
                            <select class="form-select form-select-sm" id="posMesaId">
                                <option value="">Sin mesa asignada</option>
                            </select>
                        </div>

                        <!-- Delivery fields (solo si tipo=delivery) -->
                        <div class="mb-3 d-none" id="deliveryFields">
                            <select class="form-select form-select-sm mb-2" id="posRepartidorId">
                                <option value="">Seleccionar repartidor...</option>
                            </select>
                            <input type="text" class="form-control form-control-sm" id="posDireccion" placeholder="Direccion de entrega">
                        </div>

                        <div class="mb-3">
                            <input type="text" class="form-control" id="posNombreCliente" placeholder="Nombre del cliente (opcional)">
                        </div>

                        <div class="flex-grow-1" style="min-height: 200px; max-height: 400px; overflow-y: auto;" id="posCartItems">
                            <div class="text-center py-5 text-muted" id="posCartEmpty">
                                <i class="bi bi-cart3 fs-1 d-block mb-2 opacity-50"></i>
                                <p>Selecciona platos para agregar</p>
                            </div>
                        </div>

                        <hr>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold" id="posSubtotal">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">IVA</span>
                                <input type="number" class="form-control form-control-sm" id="posIva" value="0" min="0" max="100" step="1" style="width: 65px;">
                                <span class="text-muted">%</span>
                            </div>
                            <span class="fw-bold" id="posIvaMonto">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted">Descuento</span>
                                <input type="number" class="form-control form-control-sm" id="posDescuento" value="0" min="0" max="100" step="1" style="width: 65px;">
                                <span class="text-muted">%</span>
                            </div>
                            <span class="fw-bold text-danger" id="posDescuentoDisplay">-$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 fs-5">
                            <span class="fw-bolder">TOTAL</span>
                            <span class="fw-bolder text-success" id="posTotal">$0.00</span>
                        </div>
                        <!-- Boton delivery WhatsApp -->
                        <button class="btn btn-success mb-2 d-none" id="btnLlamarDelivery">
                            <i class="bi bi-whatsapp me-2"></i>Llamar Delivery
                        </button>
                        <button class="btn btn-success btn-lg w-100" id="btnCobrar" disabled>
                            <i class="bi bi-cash-stack me-2"></i>Cobrar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent orders -->
        <div class="mg-card mt-4">
            <div class="card-header border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>Ventas Recientes</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="ordenesTable" class="table table-row-bordered align-middle gs-0 gy-3">
                        <thead><tr class="fw-bold text-muted"><th>#</th><th>Cliente</th><th>Tipo</th><th>Items</th><th>Total</th><th>Fecha</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB MESAS ═══════════════ -->
    <div class="tab-pane fade" id="mesasTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <h4 class="fw-bold mb-0"><i class="bi bi-grid-3x3 me-2"></i>Mesas del Restaurante</h4>
            <button class="btn btn-primary" id="btnNuevaMesa"><i class="bi bi-plus-circle me-2"></i>Nueva Mesa</button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-auto"><span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-circle-fill me-1"></i>Libre</span></div>
            <div class="col-auto"><span class="badge bg-danger fs-6 px-3 py-2"><i class="bi bi-circle-fill me-1"></i>Ocupada</span></div>
            <div class="col-auto"><span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-circle-fill me-1"></i>Reservada</span></div>
        </div>
        <div class="row g-3" id="mesasGrid"></div>
    </div>

    <!-- ═══════════════ TAB MENUS ═══════════════ -->
    <div class="tab-pane fade" id="menusTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <h4 class="fw-bold mb-0"><i class="bi bi-journal-richtext me-2"></i>Menus del Restaurante</h4>
            <button class="btn btn-primary" id="btnNuevoMenu"><i class="bi bi-plus-circle me-2"></i>Nuevo Menu</button>
        </div>

        <!-- Menu Builder -->
        <div class="d-none" id="menuBuilderSection">
            <div class="row g-3">
                <!-- Platos disponibles -->
                <div class="col-lg-5">
                    <div class="mg-card h-100">
                        <div class="card-header border-0">
                            <h5 class="fw-bold mb-0"><i class="bi bi-cup-hot me-2"></i>Platos Disponibles</h5>
                            <input type="text" class="form-control form-control-sm mt-2" id="menuBuscarPlato" placeholder="Buscar plato...">
                        </div>
                        <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                            <div id="menuPlatosDisponibles"></div>
                        </div>
                    </div>
                </div>
                <!-- Builder area -->
                <div class="col-lg-7">
                    <div class="mg-card h-100">
                        <div class="card-header border-0">
                            <h5 class="fw-bold mb-0"><i class="bi bi-tools me-2"></i>Constructor de Menu</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <input type="text" class="form-control" id="menuNombre" placeholder="Nombre del menu">
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex gap-2" id="menuTipoPills">
                                        <button class="mg-pill active" data-tipo="general">General</button>
                                        <button class="mg-pill" data-tipo="desayuno">Desayuno</button>
                                        <button class="mg-pill" data-tipo="almuerzo">Almuerzo</button>
                                        <button class="mg-pill" data-tipo="cena">Cena</button>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-3 d-none" id="menuPrecioFijoGroup">
                                <div class="input-group" style="max-width:200px;">
                                    <span class="input-group-text">$</span>
                                    <input type="number" class="form-control" id="menuPrecioFijo" placeholder="Precio fijo" step="0.01" min="0">
                                </div>
                            </div>
                            <div class="d-flex gap-2 mb-3">
                                <button class="btn btn-sm btn-outline-primary" id="btnAgregarSeccion"><i class="bi bi-folder-plus me-1"></i>Agregar Seccion</button>
                            </div>
                            <div id="menuBuilderItems" style="min-height: 200px; max-height: 400px; overflow-y: auto;">
                                <div class="text-center py-4 text-muted">Agrega secciones y platos para construir tu menu</div>
                            </div>
                            <hr>
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="text-muted me-2">Estilo:</span>
                                <button class="mg-pill active menuEstiloBtn" data-style="moderno">Moderno</button>
                                <button class="mg-pill menuEstiloBtn" data-style="elegante">Elegante</button>
                                <button class="mg-pill menuEstiloBtn" data-style="minimalista">Minimalista</button>
                                <button class="mg-pill menuEstiloBtn" data-style="vibrante">Vibrante</button>
                                <button class="mg-pill menuEstiloBtn" data-style="clasico">Clasico</button>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-primary" id="btnGuardarMenu"><i class="bi bi-save me-1"></i>Guardar Menu</button>
                                <button class="btn btn-outline-info" id="btnPreviewMenu"><i class="bi bi-eye me-1"></i>Vista Previa</button>
                                <button class="btn btn-outline-secondary" id="btnCancelarMenu"><i class="bi bi-x me-1"></i>Cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Saved menus table -->
        <div id="menusSavedSection">
            <div class="mg-card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="menusTable" class="table table-row-bordered align-middle gs-0 gy-3">
                            <thead><tr class="fw-bold text-muted"><th>Nombre</th><th>Tipo</th><th>Precio</th><th>Estilo</th><th>Fecha</th><th class="text-end">Acciones</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════ TAB INVENTARIO (reutilizado de Tienda) ═══════════════ -->
    <div class="tab-pane fade" id="inventarioTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
            <button id="btnCrearProducto" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo Plato</button>
            <button id="btnCrearCategoria" class="btn btn-outline-primary"><i class="bi bi-folder-plus me-2"></i>Nueva Categoria</button>
            <button id="btnExportInventarioExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button>
            <button id="btnToggleMovimientos" class="btn btn-outline-primary"><i class="bi bi-clock-history me-2"></i>Historial</button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Total Platos</div><div class="stat-value" id="invTotalProductos">0</div></div><div class="stat-icon bg-light-primary"><i class="bi bi-cup-hot text-primary"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Stock Bajo</div><div class="stat-value text-warning" id="invStockBajo">0</div></div><div class="stat-icon bg-light-warning"><i class="bi bi-exclamation-triangle-fill text-warning"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ventas Hoy</div><div class="stat-value" id="invVentasHoy">0</div></div><div class="stat-icon bg-light-success"><i class="bi bi-cart-check-fill text-success"></i></div></div></div></div>
            <div class="col-xl-3 col-md-6 col-6"><div class="mg-stat-card"><div class="d-flex align-items-center justify-content-between"><div><div class="stat-label">Ingresos Hoy</div><div class="stat-value text-success" id="invIngresosHoy">$0</div></div><div class="stat-icon bg-light-info"><i class="bi bi-currency-dollar text-info"></i></div></div></div></div>
        </div>
        <div class="d-flex align-items-center gap-2 mb-3 px-2 py-2 rounded-3" style="background: rgba(62,151,255,0.04); border: 1px dashed rgba(62,151,255,0.2);">
            <i class="bi bi-arrows-move text-primary"></i>
            <span class="text-muted small">Arrastra platos sobre las carpetas para organizarlos</span>
        </div>
        <div class="row g-3 mb-3" id="invCategoryFolders"></div>
        <div class="row g-3 mb-4" id="productosGrid"></div>
        <div id="movimientosSection" class="d-none">
            <h5 class="fw-bold mb-3"><i class="bi bi-clock-history me-2"></i>Historial de Movimientos</h5>
            <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="movimientosTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cant.</th><th>Total</th><th>Stock</th><th>Nota</th></tr></thead><tbody></tbody></table></div></div></div>
        </div>
    </div>

    <!-- ═══════════════ TAB DISTRIBUIDORES (reutiliza proveedores/ClienteArtesanal) ═══════════════ -->
    <div class="tab-pane fade" id="proveedoresTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="fw-bold mb-0">Distribuidores</h4>
            <button class="btn btn-primary" id="btnNuevoProveedor"><i class="bi bi-plus-circle me-2"></i>Nuevo Distribuidor</button>
        </div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive">
            <table id="proveedoresTable" class="table table-row-bordered align-middle gs-0 gy-3">
                <thead><tr class="fw-bold text-muted"><th>Compania</th><th>Contacto</th><th>Telefono</th><th>Email</th><th class="text-end">Acciones</th></tr></thead>
                <tbody></tbody>
            </table>
        </div></div></div>
    </div>

    <!-- ═══════════════ TAB REPARTIDORES (reutiliza Empleado) ═══════════════ -->
    <div class="tab-pane fade" id="repartidoresTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <h4 class="fw-bold mb-0">Repartidores</h4>
            <button class="btn btn-primary" id="btnNuevoRepartidor"><i class="bi bi-plus-circle me-2"></i>Nuevo Repartidor</button>
        </div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive">
            <table id="repartidoresTable" class="table table-row-bordered align-middle gs-0 gy-3">
                <thead><tr class="fw-bold text-muted"><th>Nombre</th><th>Apellido</th><th>Telefono</th><th>Email</th><th>Vehiculo</th><th class="text-end">Acciones</th></tr></thead>
                <tbody></tbody>
            </table>
        </div></div></div>
    </div>

    <!-- ═══════════════ TAB MOVIMIENTOS (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="logsTab" role="tabpanel">
        <div class="mg-card mb-4"><div class="card-body"><h5 class="fw-bold mb-3"><i class="bi bi-plus-circle me-2"></i>Registrar Movimiento</h5><div class="row g-3 align-items-end"><div class="col-md-6"><label class="form-label">Descripcion</label><input type="text" class="form-control form-control-lg" id="logDescripcion" placeholder="Ej: Compra de ingredientes"></div><div class="col-md-3"><label class="form-label">Monto ($)</label><input type="number" step="0.01" class="form-control form-control-lg" id="logMonto" placeholder="4 o -15"></div><div class="col-md-3"><button id="btnRegistrarLog" class="btn btn-primary btn-lg w-100"><i class="bi bi-check-lg me-2"></i>Registrar</button></div></div><small class="text-muted mt-2 d-block">Usa valores positivos para ingresos y negativos para gastos</small></div></div>
        <div class="d-flex flex-wrap gap-2 mb-3 align-items-center"><small class="text-muted"><i class="bi bi-shield-lock me-1"></i>Los registros son inmutables</small><div class="ms-auto d-flex gap-2"><button id="btnExportLogsExcel" class="btn btn-success"><i class="bi bi-file-earmark-excel me-2"></i>Exportar</button></div></div>
        <div class="mg-card"><div class="card-body"><div class="table-responsive"><table id="logsTable" class="table table-row-bordered align-middle gs-0 gy-3"><thead><tr class="fw-bold text-muted"><th>Descripcion</th><th>Tipo</th><th>Cliente</th><th>Monto</th><th>Fecha</th></tr></thead><tbody></tbody></table></div></div></div>
    </div>

    <!-- ═══════════════ TAB REPORTES (reutilizado) ═══════════════ -->
    <div class="tab-pane fade" id="ventasTab" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2"><div class="mg-period-pills" id="ventasPeriodPills"><button class="mg-pill active" data-periodo="dia">Dia</button><button class="mg-pill" data-periodo="semana">Semana</button><button class="mg-pill" data-periodo="mes">Mes</button></div></div>
        <div class="row g-3 mb-4">
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-primary) 0%, var(--mg-gradient-primary-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasIngresosLabel">Ingresos del Dia</span><span class="fs-2x fw-bolder" id="ventasIngresos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-danger) 0%, var(--mg-gradient-danger-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGastosLabel">Gastos del Dia</span><span class="fs-2x fw-bolder" id="ventasGastos">$0</span></div></div></div>
            <div class="col-xl-4 col-md-6 col-12"><div class="mg-card h-100" style="background: linear-gradient(135deg, var(--mg-success) 0%, var(--mg-gradient-success-end) 100%);"><div class="card-body text-white"><span class="d-block mb-2 opacity-75" id="ventasGananciaLabel">Ganancia Neta</span><span class="fs-2x fw-bolder" id="ventasGanancia">$0</span></div></div></div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0">Ingresos vs Gastos</h5></div><div class="card-body"><div id="chartBarVentas"></div></div></div></div>
            <div class="col-md-6"><div class="mg-card"><div class="card-header border-0"><h5 class="fw-bold mb-0" id="chartResumenTitle">Resumen del Dia</h5></div><div class="card-body"><div id="chartResumen"></div></div></div></div>
        </div>
    </div>

    <!-- ═══════════════ TAB RECIBOS ═══════════════ -->
    <div class="tab-pane fade" id="recibosTab" role="tabpanel">
