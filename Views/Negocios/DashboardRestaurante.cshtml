/* ── POS Category Pills ── */
#posCategoryTabs .mg-pill,
#tipoOrdenPills .mg-pill,
#menuTipoPills .mg-pill,
#menuEstiloPills .mg-pill {
    padding: 0.45rem 1.1rem;
    border: 1.5px solid var(--mg-border-color);
    background: var(--mg-card-bg);
    color: var(--mg-gray-600);
    font-weight: 600;
    font-size: 0.8rem;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(.4,0,.2,1);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}
#posCategoryTabs .mg-pill:hover,
#tipoOrdenPills .mg-pill:hover,
#menuTipoPills .mg-pill:hover,
#menuEstiloPills .mg-pill:hover {
    border-color: var(--mg-primary);
    color: var(--mg-primary);
    background: rgba(62, 151, 255, 0.06);
    transform: translateY(-1px);
}
#posCategoryTabs .mg-pill.active,
#tipoOrdenPills .mg-pill.active,
#menuTipoPills .mg-pill.active,
#menuEstiloPills .mg-pill.active {
    background: linear-gradient(135deg, var(--mg-primary), #1B74E4);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 4px 14px rgba(62, 151, 255, 0.35);
    transform: translateY(-1px);
}
#posCategoryTabs .mg-pill .pill-count {
