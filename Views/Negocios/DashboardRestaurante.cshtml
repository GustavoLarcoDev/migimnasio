function getMenuPublicUrl(menuId) {
    return window.location.origin + '/Restaurante/VerMenu?negocioId=' + negocioId + '&menuId=' + menuId;
}

function mostrarQRMenu(menuId) {
    var url = getMenuPublicUrl(menuId);
    mostrarQRLink(url, 'QR del Menu', 'Tus clientes pueden escanear este codigo para ver el menu');
}

function copiarLinkMenu(menuId) {
    var url = getMenuPublicUrl(menuId);
    navigator.clipboard.writeText(url).then(function() {
        toastr.success('Link del menu copiado al portapapeles');
    }).catch(function() {
        // Fallback
        var tmp = document.createElement('textarea');
        tmp.value = url;
        document.body.appendChild(tmp);
        tmp.select();
        document.execCommand('copy');
        document.body.removeChild(tmp);
        toastr.success('Link del menu copiado al portapapeles');
    });
}

$('#btnQRMenuPreview').on('click', function() {
    if (_menuPreviewCurrentId) {
