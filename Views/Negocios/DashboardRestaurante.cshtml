function cargarLogs() {
    if (tablaLogs) { tablaLogs.ajax.reload(); return; }
    tablaLogs = $('#logsTable').DataTable({ ajax: { url: '/Negocios/GetLogs', data: { negocioId: negocioId }, dataSrc: '', error: function(xhr) { toastr.error('Error al cargar los logs: ' + (xhr.responseJSON?.message || 'Error desconocido')); } },
        columns: [
            { data: 'message' },
            { data: 'tipo', render: function(d) { var badge = tipoLogBadges[d] || 'bg-secondary'; var label = tipoLogLabels[d] || d; return '<span class="badge ' + badge + '">' + escHtml(label) + '</span>'; } },
            { data: 'nombreCliente', render: function(d) { return d ? escHtml(d) : '<span class="text-muted">-</span>'; } },
            { data: 'monto', render: function(d) { return d === 0 ? '<span class="text-muted">-</span>' : '<span class="fw-bold ' + (d >= 0 ? 'text-success' : 'text-danger') + '">' + (d >= 0 ? '+' : '') + '$' + d.toFixed(2) + '</span>'; } },
            { data: 'fecha', render: function(d, type) { if (type === 'sort' || type === 'type') return d; return new Date(d).toLocaleString('es-EC'); } }
        ], order: [[4, 'desc']]
    });
}

$('#btnRegistrarLog').on('click', function() {
    var message = $('#logDescripcion').val(), monto = $('#logMonto').val();
    if (!message || monto === '') { toastr.error('Complete todos los campos'); return; }
    var btn = $(this);
    var originalHtml = btn.html();
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Registrando...');
    $.post('/Negocios/CrearLog', { NegocioId: negocioId, Message: message, Monto: monto }, function(r) {
        if (r.success) { toastr.success(r.message); $('#logDescripcion').val(''); $('#logMonto').val(''); if (tablaLogs) tablaLogs.ajax.reload(); } else toastr.error(r.message || 'Error al registrar');
    }).fail(function(xhr) {
        toastr.error(xhr.responseJSON?.message || 'Error al registrar movimiento');
    }).always(function() {
        btn.prop('disabled', false).html(originalHtml);
    });
});

$('#btnExportLogsExcel').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Exportando...');
    window.location.href = '/Negocios/ExportLogsExcel?negocioId=' + negocioId;
    setTimeout(function() { btn.prop('disabled', false).html('<i class="bi bi-file-earmark-excel me-2"></i>Exportar'); }, 3000);
});

// ═══════════════ REPORTES (reutilizado) ═══════════════
var chartBar, chartResumen;
function cargarReportes(periodo) {
    periodo = periodo || 'dia';
    $.get('/Negocios/GetVentasStats', { negocioId, periodo }, function(d) {
        var labels = { dia: 'del Dia', semana: 'de la Semana', mes: 'del Mes' };
        $('#ventasIngresosLabel').text('Ingresos ' + labels[periodo]); $('#ventasGastosLabel').text('Gastos ' + labels[periodo]); $('#ventasGananciaLabel').text('Ganancia ' + labels[periodo]);
        $('#ventasIngresos').text('$' + (d.ingresos || 0).toFixed(2)); $('#ventasGastos').text('$' + (d.gastos || 0).toFixed(2)); $('#ventasGanancia').text('$' + (d.ganancia || 0).toFixed(2));
        $('#chartResumenTitle').text('Resumen ' + labels[periodo]);
    });
    $.get('/Negocios/GetChartData', { negocioId, periodo }, function(d) {
        if (chartBar) chartBar.destroy();
        chartBar = new ApexCharts(document.querySelector('#chartBarVentas'), { chart: { type: 'bar', height: 300 }, series: [{ name: 'Ingresos', data: d.ingresos || [] }, { name: 'Gastos', data: d.gastos || [] }], xaxis: { categories: d.labels || [] }, colors: ['#50CD89', '#F1416C'], plotOptions: { bar: { borderRadius: 4 } } });
        chartBar.render();
        if (chartResumen) chartResumen.destroy();
        $('#chartResumen').empty();
        var totalIng = (d.ingresos || []).reduce(function(a, b) { return a + b; }, 0);
        var totalGas = (d.gastos || []).reduce(function(a, b) { return a + b; }, 0);
        if (totalIng === 0 && totalGas === 0) {
            $('#chartResumen').html('<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i>Sin datos para este periodo</div>');
            chartResumen = null;
        } else {
            chartResumen = new ApexCharts(document.querySelector('#chartResumen'), { chart: { type: 'donut', height: 300 }, series: [totalIng, totalGas], labels: ['Ingresos', 'Gastos'], colors: ['#50CD89', '#F1416C'], plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Ganancia', formatter: function() { return '$' + (totalIng - totalGas).toFixed(2); } } } } } } });
            chartResumen.render();
        }
    });
}

var chartVentasCategoria;
function cargarVentasPorCategoria() {
    var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo') || 'mes';
    $.get('/Negocios/GetVentasPorCategoria', { negocioId, periodo }, function(datos) {
        var tbody = $('#tablaVentasCategoria tbody'); tbody.empty();
        if (!datos.length) { tbody.html('<tr><td colspan="3" class="text-center text-muted py-3">Sin ventas en este periodo</td></tr>'); }
        else { datos.forEach(function(d) { tbody.append('<tr><td>' + escHtml(d.categoria) + '</td><td class="text-end">' + d.unidades + '</td><td class="text-end fw-bold text-success">$' + d.totalVentas.toFixed(2) + '</td></tr>'); }); }
        if (chartVentasCategoria) chartVentasCategoria.destroy();
        $('#chartVentasCategoria').empty();
        if (!datos.length) { $('#chartVentasCategoria').html('<div class="text-center py-5 text-muted"><i class="bi bi-pie-chart fs-1 d-block mb-2"></i>Sin datos</div>'); return; }
        chartVentasCategoria = new ApexCharts(document.querySelector('#chartVentasCategoria'), {
            chart: { type: 'donut', height: 300 },
            series: datos.map(function(d) { return d.totalVentas; }),
            labels: datos.map(function(d) { return d.categoria; }),
            plotOptions: { pie: { donut: { labels: { show: true, total: { show: true, label: 'Total', formatter: function(w) { return '$' + w.globals.seriesTotals.reduce(function(a,b){return a+b;},0).toFixed(2); } } } } } }
        });
        chartVentasCategoria.render();
    });
}

$(document).on('click', '#ventasPeriodPills .mg-pill', function() { $('#ventasPeriodPills .mg-pill').removeClass('active'); $(this).addClass('active'); cargarReportes($(this).data('periodo')); cargarVentasPorCategoria(); });

$('#btnRefrescarVentas').on('click', function() {
    var btn = $(this);
    btn.find('i').addClass('spin-animation');
    var periodo = $('#ventasPeriodPills .mg-pill.active').data('periodo') || 'dia';
    cargarReportes(periodo);
    cargarVentasPorCategoria();
    setTimeout(function() { btn.find('i').removeClass('spin-animation'); toastr.info('Datos actualizados'); }, 800);
});

