function cargarNotificaciones() {
    $.get('/Negocios/GetNotificaciones', { negocioId }, function(notifs) {
        var c = $('#notificacionesList'); c.empty();
        if (!notifs || !notifs.length) { c.html('<div class="text-center py-5 text-muted"><i class="bi bi-bell-slash fs-1 d-block mb-3"></i><p>No hay notificaciones.</p></div>'); return; }
        notifs.forEach(function(n) {
            c.append('<div class="mg-card ' + (n.leida ? 'opacity-50' : '') + '"><div class="card-body py-2 d-flex align-items-center gap-3">' +
                '<i class="bi bi-bell' + (n.leida ? '' : '-fill') + ' ' + (n.leida ? 'text-muted' : 'text-warning') + '"></i>' +
                '<div class="flex-grow-1"><p class="mb-0 small">' + escHtml(n.mensaje) + '</p><small class="text-muted">' + new Date(n.fechaCreacion).toLocaleDateString('es-EC') + '</small></div>' +
                (!n.leida ? '<button class="btn btn-sm btn-outline-primary" onclick="marcarLeida(\'' + n.id + '\')"><i class="bi bi-check"></i></button>' : '') +
            '</div></div>');
        });
    });
}

function marcarLeida(id) {
    $.post('/Negocios/MarcarNotificacionLeida', { id: id, negocioId: negocioId }, function() { cargarNotificaciones(); cargarNotificacionesCount(); });
}

function cargarNotificacionesCount() {
    $.get('/Negocios/GetNotificacionesCount', { negocioId }, function(d) {
        var count = d.count || 0;
        if (count > 0) { $('#sidebarNotifBadge, #topbarNotifBadge').text(count).removeClass('d-none'); }
        else { $('#sidebarNotifBadge, #topbarNotifBadge').addClass('d-none'); }
    });
}

$('#btnMarcarTodasLeidasTab').on('click', function() { $.post('/Negocios/MarcarTodasNotificacionesLeidas', { NegocioId: negocioId }, function(r) { if (r.success) { toastr.success('Notificaciones marcadas como leidas'); cargarNotificaciones(); cargarNotificacionesCount(); } }); });

$('#btnGenerarNotificaciones').on('click', function() {
    var btn = $(this);
    btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Generando...');
    $.post('/Negocios/GenerarNotificaciones', { negocioId: negocioId }, function(r) {
        if (r.success) { toastr.success(r.message); cargarNotificaciones(); cargarNotificacionesCount(); }
    }).fail(function(xhr) {
        toastr.error(xhr.responseJSON?.message || 'Error al generar notificaciones');
