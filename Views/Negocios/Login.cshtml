@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
    <title>My-Negocio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #FAFAFA;
        }

        .login-wrapper {
            width: 100%;
            max-width: 400px;
            padding: 1.5rem;
        }

        /* Greeting */
        .greeting {
            text-align: center;
            margin-bottom: 2.5rem;
        }

        .greeting-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #3E97FF, #7239EA);
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.25rem;
        }

        .greeting-text {
            font-size: 1.35rem;
            font-weight: 300;
            color: #1E293B;
            line-height: 1.5;
        }

        /* Form */
        .login-form {
            background: #fff;
            border: 1px solid #E8E8E8;
            border-radius: 16px;
            padding: 2rem;
        }

        .form-control {
            padding: 0.75rem 1rem;
            font-size: 0.9rem;
            border-radius: 10px;
            border: 1.5px solid #E2E8F0;
            transition: all 0.15s ease;
            background: #FAFAFA;
        }

        .form-control:focus {
            border-color: #3E97FF;
            box-shadow: 0 0 0 3px rgba(62, 151, 255, 0.1);
            background: #fff;
        }

        .form-control::placeholder {
            color: #A0AEC0;
        }

        .btn-login {
            width: 100%;
            padding: 0.75rem;
            font-size: 0.925rem;
            font-weight: 600;
            border: none;
            border-radius: 10px;
            background: #1E293B;
            color: #fff;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-login:hover {
            background: #0F172A;
        }

        .btn-login:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .pw-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #A0AEC0;
            cursor: pointer;
            padding: 4px;
            display: flex;
            z-index: 5;
        }

        .pw-toggle:hover { color: #64748B; }

        .alert {
            border-radius: 10px;
            border: none;
            padding: 0.7rem 1rem;
            font-size: 0.85rem;
        }

        .footer-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.825rem;
            color: #94A3B8;
        }

        .footer-link a {
            color: #3E97FF;
            text-decoration: none;
            font-weight: 500;
        }

        .footer-link a:hover { text-decoration: underline; }
    </style>
</head>
<body>

<div class="login-wrapper">
    <!-- Greeting -->
    <div class="greeting">
        <div class="greeting-icon">
            <i class="bi bi-shop text-white" style="font-size: 1.4rem;"></i>
        </div>
        <div class="greeting-text" id="greetingText"></div>
    </div>

    <!-- Form Card -->
    <div class="login-form">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger d-flex align-items-center mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        @if (ViewBag.Expired != null && (bool)ViewBag.Expired)
        {
            <div class="alert alert-warning mb-3 text-center">
                <i class="bi bi-lock-fill d-block mb-2" style="font-size: 2rem; color: #F1416C;"></i>
                <strong>Sistema bloqueado por pago pendiente</strong>
                <p class="mb-2 mt-1" style="font-size: 0.85rem;">Tu suscripción ha expirado. Contacta a My-Negocio Oficial para renovar tu servicio.</p>
                <a href="https://wa.me/593988757851?text=Hola%2C%20mi%20sistema%20está%20bloqueado%20por%20pago%20pendiente.%20Necesito%20renovar%20mi%20suscripción."
                   target="_blank" rel="noopener"
                   class="btn btn-success btn-sm w-100">
                    <i class="bi bi-whatsapp me-1"></i>
                    Contactar por WhatsApp
                </a>
                <div class="mt-2" style="font-size: 0.8rem;">
                    <i class="bi bi-envelope me-1"></i>mynegociooficiall@gmail.com
                </div>
            </div>
        }

        @if (ViewBag.Success != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-3">
                <i class="bi bi-check-circle me-2"></i>
                <span>@ViewBag.Success</span>
            </div>
        }

        <form method="post" action="@Url.Action("Login", "Auth")" id="loginForm">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <input type="text"
                       name="email"
                       id="email"
                       class="form-control"
                       placeholder="Email o teléfono"
                       autocomplete="email"
                       required />
            </div>

            <div class="mb-3 position-relative">
                <input type="password"
                       name="password"
                       id="password"
                       class="form-control"
                       placeholder="Contraseña"
                       autocomplete="current-password"
                       style="padding-right: 2.5rem;"
                       required />
                <button type="button" class="pw-toggle" id="togglePassword">
                    <i class="bi bi-eye" id="eyeIcon" style="font-size: 1rem;"></i>
                </button>
            </div>

            <button type="submit" id="submitBtn" class="btn-login">
                Iniciar Sesión
            </button>
        </form>
    </div>
    
</div>

<script>
    // Random greeting on load
    const greetings = [
        "Hola, ¿cómo estás hoy?",
        "¡Listo para enseñarle al sol cómo brillar!",
        "Que tengas un día muy productivo.",
        "Que tu negocio prospere tanto como tú.",
        "Mira hasta donde has llegado.",
        "Hoy es un gran día para hacer cosas grandes.",
        "Tu esfuerzo de hoy es el éxito de mañana.",
        "Cada cliente que atiendes es una historia de éxito.",
        "El mundo necesita lo que tú ofreces.",
        "Bienvenido de vuelta, crack."
    ];
    document.getElementById('greetingText').textContent = greetings[Math.floor(Math.random() * greetings.length)];

    // Toggle password
    document.getElementById('togglePassword').addEventListener('click', function() {
        const pw = document.getElementById('password');
        const icon = document.getElementById('eyeIcon');
        if (pw.type === 'password') { pw.type = 'text'; icon.className = 'bi bi-eye-slash'; }
        else { pw.type = 'password'; icon.className = 'bi bi-eye'; }
    });

    // Loading state
    document.getElementById('loginForm').addEventListener('submit', function() {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Ingresando...';
    });

    window.addEventListener('load', () => document.getElementById('email').focus());
</script>

</body>
</html>