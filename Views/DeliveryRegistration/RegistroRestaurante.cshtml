@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Registro de Restaurante";
}

@section Styles {
<style>
    .wizard-container {
        max-width: 700px;
        margin: 2rem auto;
    }

    .wizard-header {
        background: linear-gradient(135deg, #0047AB, #00D4FF);
        color: #fff;
        border-radius: 1rem 1rem 0 0;
        padding: 2rem 1.5rem 1.5rem;
        text-align: center;
    }

    .wizard-header h2 {
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .wizard-header p {
        opacity: 0.85;
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .wizard-body {
        background: #fff;
        border-radius: 0 0 1rem 1rem;
        padding: 2rem 1.5rem;
        box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.08);
    }

    /* Stepper */
    .stepper {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 1.5rem;
        gap: 0;
    }

    .stepper-step {
        display: flex;
        align-items: center;
    }

    .stepper-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        background: rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.7);
        border: 2px solid rgba(255,255,255,0.4);
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .stepper-circle.active {
        background: #fff;
        color: #0047AB;
        border-color: #fff;
        box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
    }

    .stepper-circle.completed {
        background: #fff;
        color: #0047AB;
        border-color: #fff;
    }

    .stepper-line {
        width: 50px;
        height: 3px;
        background: rgba(255,255,255,0.3);
        margin: 0 4px;
        border-radius: 2px;
        transition: background 0.3s ease;
    }

    .stepper-line.active {
        background: #fff;
    }

    /* Step content */
    .step-content {
        display: none;
    }

    .step-content.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Food type checkboxes */
    .food-type-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 0.75rem;
    }

    .food-type-card {
        border: 2px solid #dee2e6;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        cursor: pointer;
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        user-select: none;
    }

    .food-type-card:hover {
        border-color: #00D4FF;
        background: #f0faff;
    }

    .food-type-card.selected {
        border-color: #0047AB;
        background: linear-gradient(135deg, rgba(0,71,171,0.05), rgba(0,212,255,0.05));
        box-shadow: 0 0 0 3px rgba(0,71,171,0.15);
    }

    .food-type-card .food-icon {
        font-size: 1.3rem;
    }

    .food-type-card .food-label {
        font-weight: 500;
        font-size: 0.9rem;
        color: #333;
    }

    .food-type-card .check-indicator {
        margin-left: auto;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 2px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        color: transparent;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .food-type-card.selected .check-indicator {
        background: #0047AB;
        border-color: #0047AB;
        color: #fff;
    }

    /* Photo upload */
    .photo-upload {
        border: 2px dashed #dee2e6;
        border-radius: 0.75rem;
        padding: 1.5rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .photo-upload:hover {
        border-color: #00D4FF;
        background: #f8fcff;
    }

    .photo-upload.has-photo {
        border-color: #0047AB;
        border-style: solid;
        background: #f0f7ff;
    }

    .photo-upload .upload-icon {
        font-size: 2rem;
        color: #adb5bd;
        margin-bottom: 0.5rem;
    }

    .photo-upload.has-photo .upload-icon {
        color: #0047AB;
    }

    .photo-upload .upload-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: #6c757d;
    }

    .photo-upload input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .photo-preview {
        width: 100px;
        height: 100px;
        object-fit: contain;
        border-radius: 0.5rem;
        display: none;
        margin-top: 0.5rem;
        border: 2px solid #0047AB;
        background: #fff;
    }

    .photo-preview.visible {
        display: block;
    }

    /* Location inputs */
    .coord-help {
        font-size: 0.8rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    .map-placeholder {
        border: 2px dashed #dee2e6;
        border-radius: 0.75rem;
        padding: 2rem;
        text-align: center;
        background: #f8f9fa;
        color: #6c757d;
    }

    /* Summary */
    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .summary-item:last-child {
        border-bottom: none;
    }

    .summary-label {
        font-weight: 500;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .summary-value {
        font-weight: 600;
        color: #333;
        font-size: 0.9rem;
        text-align: right;
        max-width: 60%;
        word-break: break-word;
    }

    /* Buttons */
    .btn-wizard-primary {
        background: linear-gradient(135deg, #0047AB, #00D4FF);
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-wizard-primary:hover {
        color: #fff;
        box-shadow: 0 4px 12px rgba(0,71,171,0.3);
        transform: translateY(-1px);
    }

    .btn-wizard-primary:disabled {
        opacity: 0.65;
        transform: none;
        box-shadow: none;
    }

    .btn-wizard-outline {
        border: 2px solid #dee2e6;
        color: #6c757d;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        background: #fff;
        transition: all 0.3s ease;
    }

    .btn-wizard-outline:hover {
        border-color: #adb5bd;
        color: #333;
    }

    .step-title {
        font-weight: 700;
        font-size: 1.15rem;
        margin-bottom: 1.25rem;
        color: #0047AB;
    }

    .validation-error {
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: none;
    }

    .validation-error.visible {
        display: block;
    }

    @@media (max-width: 576px) {
        .wizard-container { margin: 1rem; }
        .wizard-header { padding: 1.5rem 1rem 1rem; }
        .wizard-body { padding: 1.5rem 1rem; }
        .stepper-line { width: 30px; }
        .stepper-circle { width: 32px; height: 32px; font-size: 0.8rem; }
        .food-type-grid { grid-template-columns: 1fr 1fr; }
    }
</style>
}

<div class="wizard-container">
    <!-- Header -->
    <div class="wizard-header">
        <i class="bi bi-shop fs-1 mb-2 d-block"></i>
        <h2>Registro de Restaurante</h2>
        <p>Registra tu negocio y empieza a recibir pedidos de delivery</p>

        <!-- Stepper -->
        <div class="stepper">
            <div class="stepper-step">
                <div class="stepper-circle active" id="stepCircle1">1</div>
            </div>
            <div class="stepper-line" id="stepLine1"></div>
            <div class="stepper-step">
                <div class="stepper-circle" id="stepCircle2">2</div>
            </div>
            <div class="stepper-line" id="stepLine2"></div>
            <div class="stepper-step">
                <div class="stepper-circle" id="stepCircle3">3</div>
            </div>
            <div class="stepper-line" id="stepLine3"></div>
            <div class="stepper-step">
                <div class="stepper-circle" id="stepCircle4">4</div>
            </div>
        </div>
    </div>

    <!-- Body -->
    <div class="wizard-body">

        <!-- Step 1: Datos del Negocio -->
        <div class="step-content active" id="step1">
            <div class="step-title"><i class="bi bi-building me-2"></i>Datos del Negocio</div>

            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Nombre del Negocio <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="rNombreNegocio" placeholder="Ej: Restaurante El Sabor">
                    <div class="validation-error" id="errNombreNegocio">El nombre del negocio es obligatorio</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Nombre del Dueño <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="rNombreDueno" placeholder="Nombre completo del propietario">
                    <div class="validation-error" id="errNombreDueno">El nombre del dueño es obligatorio</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="rEmail" placeholder="correo@ejemplo.com">
                    <div class="validation-error" id="errEmail">Ingresa un email válido</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="rPassword" placeholder="Mínimo 6 caracteres" minlength="6">
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('rPassword', this)"><i class="bi bi-eye"></i></button>
                    </div>
                    <div class="validation-error" id="errPassword">Mínimo 6 caracteres</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Confirmar Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="rPasswordConfirm" placeholder="Repite la contraseña">
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('rPasswordConfirm', this)"><i class="bi bi-eye"></i></button>
                    </div>
                    <div class="validation-error" id="errPasswordConfirm">Las contraseñas no coinciden</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Teléfono <span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="rTelefono" placeholder="09XXXXXXXX" maxlength="10">
                    <div class="validation-error" id="errTelefono">Ingresa un teléfono válido (10 dígitos)</div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-wizard-primary" onclick="nextStep()">
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Step 2: Tipos de Comida -->
        <div class="step-content" id="step2">
            <div class="step-title"><i class="bi bi-egg-fried me-2"></i>Tipos de Comida</div>
            <p class="text-muted small mb-3">Selecciona al menos un tipo de comida que ofreces.</p>

            <div class="food-type-grid mb-3">
                <div class="food-type-card" onclick="toggleFoodType(this, 'Comida Clásica')">
                    <span class="food-icon">&#127858;</span>
                    <span class="food-label">Comida Clásica</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Almuerzos')">
                    <span class="food-icon">&#127869;</span>
                    <span class="food-label">Almuerzos</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Comida Rápida')">
                    <span class="food-icon">&#127828;</span>
                    <span class="food-label">Comida Rápida</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Mariscos')">
                    <span class="food-icon">&#129424;</span>
                    <span class="food-label">Mariscos</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Parrilladas')">
                    <span class="food-icon">&#129385;</span>
                    <span class="food-label">Parrilladas</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Postres')">
                    <span class="food-icon">&#127856;</span>
                    <span class="food-label">Postres</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Bebidas')">
                    <span class="food-icon">&#129380;</span>
                    <span class="food-label">Bebidas</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Comida Saludable')">
                    <span class="food-icon">&#129367;</span>
                    <span class="food-label">Comida Saludable</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Comida Internacional')">
                    <span class="food-icon">&#127759;</span>
                    <span class="food-label">Internacional</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
                <div class="food-type-card" onclick="toggleFoodType(this, 'Otro')">
                    <span class="food-icon"><i class="bi bi-plus-circle"></i></span>
                    <span class="food-label">Otro</span>
                    <span class="check-indicator"><i class="bi bi-check"></i></span>
                </div>
            </div>
            <div class="validation-error" id="errTiposComida">Selecciona al menos un tipo de comida</div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Ciudad <span class="text-danger">*</span></label>
                <select class="form-select" id="rCiudad">
                    <option value="">Selecciona tu ciudad</option>
                    <option value="Guayaquil">Guayaquil</option>
                    <option value="Quito">Quito</option>
                    <option value="Cuenca">Cuenca</option>
                    <option value="Ambato">Ambato</option>
                    <option value="Loja">Loja</option>
                    <option value="Machala">Machala</option>
                    <option value="Otro">Otro</option>
                </select>
                <div class="validation-error" id="errCiudad">Selecciona una ciudad</div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-wizard-outline" onclick="prevStep()">
                    <i class="bi bi-arrow-left me-1"></i> Anterior
                </button>
                <button class="btn btn-wizard-primary" onclick="nextStep()">
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Step 3: Ubicación -->
        <div class="step-content" id="step3">
            <div class="step-title"><i class="bi bi-geo-alt-fill me-2"></i>Ubicación</div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Dirección <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="rDireccion" placeholder="Ej: Av. 9 de Octubre y Malecón, local 3">
                <div class="validation-error" id="errDireccion">La dirección es obligatoria</div>
            </div>

            <div class="map-placeholder mb-3">
                <i class="bi bi-geo-alt fs-1 d-block mb-2 text-secondary"></i>
                <p class="mb-2 fw-semibold">Coordenadas de tu ubicación</p>
                <p class="small text-muted mb-3">Puedes obtener estas coordenadas desde <a href="https://www.google.com/maps" target="_blank" rel="noopener" class="text-decoration-none" style="color:#0047AB;">Google Maps</a> haciendo clic derecho en tu ubicación.</p>
                <div class="row g-2 justify-content-center" style="max-width: 400px; margin: 0 auto;">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Latitud</label>
                        <input type="number" step="any" class="form-control form-control-sm" id="rLatitud" placeholder="-2.1894">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Longitud</label>
                        <input type="number" step="any" class="form-control form-control-sm" id="rLongitud" placeholder="-79.8891">
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Logo del Negocio <span class="text-muted fw-normal">(Opcional)</span></label>
                <div class="photo-upload" id="uploadLogo" style="max-width: 250px; margin: 0 auto;">
                    <i class="bi bi-image upload-icon"></i>
                    <span class="upload-label">Sube tu logo</span>
                    <img class="photo-preview" id="previewLogo" alt="Logo preview">
                    <input type="file" accept="image/*" onchange="handleLogo(this)">
                </div>
                <p class="text-center text-muted small mt-1">Máximo 5MB. Formato: JPG, PNG o SVG</p>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-wizard-outline" onclick="prevStep()">
                    <i class="bi bi-arrow-left me-1"></i> Anterior
                </button>
                <button class="btn btn-wizard-primary" onclick="nextStep()">
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Step 4: Revisar y Enviar -->
        <div class="step-content" id="step4">
            <div class="step-title"><i class="bi bi-check-circle-fill me-2"></i>Revisar y Enviar</div>

            <div class="card border-0 bg-light rounded-3 p-3 mb-3">
                <div class="summary-item">
                    <span class="summary-label">Nombre del Negocio</span>
                    <span class="summary-value" id="sumNombreNegocio">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Dueño</span>
                    <span class="summary-value" id="sumNombreDueno">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Email</span>
                    <span class="summary-value" id="sumEmail">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Teléfono</span>
                    <span class="summary-value" id="sumTelefono">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Tipos de Comida</span>
                    <span class="summary-value" id="sumTiposComida">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Ciudad</span>
                    <span class="summary-value" id="sumCiudad">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Dirección</span>
                    <span class="summary-value" id="sumDireccion">-</span>
                </div>
                <div class="summary-item" id="sumCoordsRow" style="display:none;">
                    <span class="summary-label">Coordenadas</span>
                    <span class="summary-value" id="sumCoords">-</span>
                </div>
            </div>

            <!-- Logo preview in summary -->
            <div class="mb-3 text-center" id="sumLogoContainer" style="display:none;">
                <p class="fw-semibold mb-2">Logo:</p>
                <img id="sumLogo" src="" alt="Logo" style="max-width:120px; max-height:120px; border-radius:0.5rem; border:2px solid #dee2e6; object-fit:contain; background:#fff; padding:4px;">
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="rTerminos">
                <label class="form-check-label" for="rTerminos">
                    Acepto los <a href="#" class="text-decoration-none" style="color: #0047AB;">términos y condiciones</a> del servicio de delivery
                </label>
                <div class="validation-error" id="errTerminos">Debes aceptar los términos y condiciones</div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-wizard-outline" onclick="prevStep()">
                    <i class="bi bi-arrow-left me-1"></i> Anterior
                </button>
                <button class="btn btn-wizard-primary w-100 ms-3" id="submitBtn" onclick="submitRestaurante()">
                    <i class="bi bi-send-fill me-2"></i>Enviar Solicitud
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
(function() {
    'use strict';

    let currentStep = 1;
    let selectedFoodTypes = [];
    let logoBase64 = null;

    // Toggle password visibility
    window.togglePassword = function(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    };

    // Stepper update
    function updateStepper() {
        for (let i = 1; i <= 4; i++) {
            const circle = document.getElementById('stepCircle' + i);
            circle.classList.remove('active', 'completed');
            if (i < currentStep) {
                circle.classList.add('completed');
                circle.innerHTML = '<i class="bi bi-check-lg"></i>';
            } else if (i === currentStep) {
                circle.classList.add('active');
                circle.textContent = i;
            } else {
                circle.textContent = i;
            }
        }
        for (let i = 1; i <= 3; i++) {
            const line = document.getElementById('stepLine' + i);
            line.classList.toggle('active', i < currentStep);
        }
    }

    // Show step
    function showStep(step) {
        document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
        document.getElementById('step' + step).classList.add('active');
        currentStep = step;
        updateStepper();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Helpers
    function val(id) { return document.getElementById(id).value.trim(); }
    function showErr(id) { document.getElementById(id).classList.add('visible'); }
    function hideErr(id) { document.getElementById(id).classList.remove('visible'); }
    function hideAllErrors() { document.querySelectorAll('.validation-error').forEach(el => el.classList.remove('visible')); }

    // Food type toggle
    window.toggleFoodType = function(card, type) {
        const idx = selectedFoodTypes.indexOf(type);
        if (idx >= 0) {
            selectedFoodTypes.splice(idx, 1);
            card.classList.remove('selected');
        } else {
            selectedFoodTypes.push(type);
            card.classList.add('selected');
        }
        hideErr('errTiposComida');
    };

    // Logo handling
    window.handleLogo = function(input) {
        const file = input.files[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
            alert('El archivo es demasiado grande. Máximo 5MB.');
            input.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById('previewLogo');
            preview.src = e.target.result;
            preview.classList.add('visible');
            document.getElementById('uploadLogo').classList.add('has-photo');
            logoBase64 = e.target.result;
        };
        reader.readAsDataURL(file);
    };

    // Validate step
    function validateStep(step) {
        hideAllErrors();
        let valid = true;

        if (step === 1) {
            if (!val('rNombreNegocio')) { showErr('errNombreNegocio'); valid = false; }
            if (!val('rNombreDueno')) { showErr('errNombreDueno'); valid = false; }
            const email = val('rEmail');
            if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) { showErr('errEmail'); valid = false; }
            if (val('rPassword').length < 6) { showErr('errPassword'); valid = false; }
            if (val('rPassword') !== val('rPasswordConfirm')) { showErr('errPasswordConfirm'); valid = false; }
            if (!/^\d{10}$/.test(val('rTelefono'))) { showErr('errTelefono'); valid = false; }
        }

        if (step === 2) {
            if (selectedFoodTypes.length === 0) { showErr('errTiposComida'); valid = false; }
            if (!val('rCiudad')) { showErr('errCiudad'); valid = false; }
        }

        if (step === 3) {
            if (!val('rDireccion')) { showErr('errDireccion'); valid = false; }
        }

        if (step === 4) {
            if (!document.getElementById('rTerminos').checked) { showErr('errTerminos'); valid = false; }
        }

        return valid;
    }

    // Step navigation
    window.nextStep = function() {
        if (!validateStep(currentStep)) return;
        if (currentStep === 3) populateSummary();
        if (currentStep < 4) showStep(currentStep + 1);
    };

    window.prevStep = function() {
        if (currentStep > 1) showStep(currentStep - 1);
    };

    // Populate summary
    function populateSummary() {
        document.getElementById('sumNombreNegocio').textContent = val('rNombreNegocio');
        document.getElementById('sumNombreDueno').textContent = val('rNombreDueno');
        document.getElementById('sumEmail').textContent = val('rEmail');
        document.getElementById('sumTelefono').textContent = val('rTelefono');
        document.getElementById('sumTiposComida').textContent = selectedFoodTypes.join(', ');
        document.getElementById('sumCiudad').textContent = val('rCiudad');
        document.getElementById('sumDireccion').textContent = val('rDireccion');

        const lat = val('rLatitud');
        const lng = val('rLongitud');
        const coordsRow = document.getElementById('sumCoordsRow');
        if (lat && lng) {
            coordsRow.style.display = '';
            document.getElementById('sumCoords').textContent = lat + ', ' + lng;
        } else {
            coordsRow.style.display = 'none';
        }

        const logoContainer = document.getElementById('sumLogoContainer');
        if (logoBase64) {
            logoContainer.style.display = '';
            document.getElementById('sumLogo').src = logoBase64;
        } else {
            logoContainer.style.display = 'none';
        }
    }

    // Submit — send as FormData (multipart/form-data) for IFormFile support
    window.submitRestaurante = async function() {
        if (!validateStep(4)) return;

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';

        // Build FormData with PascalCase field names matching [FromForm] params
        const fd = new FormData();

        // Split rNombreDueno into Nombre (first word) + Apellido (rest)
        const fullName = val('rNombreDueno');
        const spaceIdx = fullName.indexOf(' ');
        const nombre = spaceIdx > 0 ? fullName.substring(0, spaceIdx) : fullName;
        const apellido = spaceIdx > 0 ? fullName.substring(spaceIdx + 1) : '';

        fd.append('Nombre', nombre);
        fd.append('Apellido', apellido);
        fd.append('Email', val('rEmail'));
        fd.append('Password', val('rPassword'));
        fd.append('Telefono', val('rTelefono'));
        fd.append('NombreNegocio', val('rNombreNegocio'));
        fd.append('DuenoNegocio', fullName);
        fd.append('Direccion', val('rDireccion'));
        fd.append('Ciudad', val('rCiudad'));
        fd.append('TiposComida', selectedFoodTypes.join(','));

        // Latitud/Longitud — send as strings, controller binds double?
        const lat = val('rLatitud');
        const lng = val('rLongitud');
        if (lat) fd.append('Latitud', lat);
        if (lng) fd.append('Longitud', lng);

        // Logo — append the actual File object (NOT base64)
        const logoFile = document.getElementById('uploadLogo').querySelector('input[type="file"]').files[0];
        if (logoFile) fd.append('Logo', logoFile);

        try {
            // Do NOT set Content-Type — browser auto-sets multipart/form-data with boundary
            const res = await fetch('/Delivery/Registro/RegistrarRestaurante', {
                method: 'POST',
                body: fd
            });
            const json = await res.json();
            if (json.success) {
                window.location.href = '/Delivery/Registro/Estado/' + json.solicitudId;
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: json.message || 'Ocurrió un error al enviar la solicitud',
                    confirmButtonColor: '#0047AB'
                });
            }
        } catch (e) {
            Swal.fire({
                icon: 'error',
                title: 'Error de conexión',
                text: 'No se pudo conectar con el servidor. Intenta de nuevo.',
                confirmButtonColor: '#0047AB'
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Enviar Solicitud';
        }
    };

})();
</script>
}
