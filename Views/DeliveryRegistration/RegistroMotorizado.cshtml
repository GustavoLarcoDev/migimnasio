@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Registro de Motorizado";
}

@section Styles {
<style>
    .wizard-container {
        max-width: 700px;
        margin: 2rem auto;
    }

    .wizard-header {
        background: linear-gradient(135deg, #0047AB, #00D4FF);
        color: #fff;
        border-radius: 1rem 1rem 0 0;
        padding: 2rem 1.5rem 1.5rem;
        text-align: center;
    }

    .wizard-header h2 {
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .wizard-header p {
        opacity: 0.85;
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .wizard-body {
        background: #fff;
        border-radius: 0 0 1rem 1rem;
        padding: 2rem 1.5rem;
        box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.08);
    }

    /* Stepper */
    .stepper {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 1.5rem;
        gap: 0;
    }

    .stepper-step {
        display: flex;
        align-items: center;
    }

    .stepper-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        background: rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.7);
        border: 2px solid rgba(255,255,255,0.4);
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .stepper-circle.active {
        background: #fff;
        color: #0047AB;
        border-color: #fff;
        box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
    }

    .stepper-circle.completed {
        background: #fff;
        color: #0047AB;
        border-color: #fff;
    }

    .stepper-line {
        width: 50px;
        height: 3px;
        background: rgba(255,255,255,0.3);
        margin: 0 4px;
        border-radius: 2px;
        transition: background 0.3s ease;
    }

    .stepper-line.active {
        background: #fff;
    }

    /* Step content */
    .step-content {
        display: none;
    }

    .step-content.active {
        display: block;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Vehicle radio cards */
    .vehicle-card {
        border: 2px solid #dee2e6;
        border-radius: 0.75rem;
        padding: 1.25rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        background: #fff;
    }

    .vehicle-card:hover {
        border-color: #00D4FF;
        background: #f0faff;
    }

    .vehicle-card.selected {
        border-color: #0047AB;
        background: linear-gradient(135deg, rgba(0,71,171,0.05), rgba(0,212,255,0.05));
        box-shadow: 0 0 0 3px rgba(0,71,171,0.15);
    }

    .vehicle-card .vehicle-icon {
        font-size: 2.5rem;
        display: block;
        margin-bottom: 0.5rem;
        color: #0047AB;
    }

    .vehicle-card .vehicle-label {
        font-weight: 600;
        color: #333;
    }

    /* Photo upload boxes */
    .photo-upload {
        border: 2px dashed #dee2e6;
        border-radius: 0.75rem;
        padding: 1.5rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
        min-height: 140px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .photo-upload:hover {
        border-color: #00D4FF;
        background: #f8fcff;
    }

    .photo-upload.has-photo {
        border-color: #0047AB;
        border-style: solid;
        background: #f0f7ff;
    }

    .photo-upload .upload-icon {
        font-size: 2rem;
        color: #adb5bd;
        margin-bottom: 0.5rem;
    }

    .photo-upload.has-photo .upload-icon {
        color: #0047AB;
    }

    .photo-upload .upload-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: #6c757d;
    }

    .photo-upload input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .photo-preview {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 0.5rem;
        display: none;
        margin-top: 0.5rem;
        border: 2px solid #0047AB;
    }

    .photo-preview.visible {
        display: block;
    }

    /* Summary */
    .summary-item {
        display: flex;
        justify-content: space-between;
        padding: 0.6rem 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .summary-item:last-child {
        border-bottom: none;
    }

    .summary-label {
        font-weight: 500;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .summary-value {
        font-weight: 600;
        color: #333;
        font-size: 0.9rem;
    }

    .summary-photos {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 0.75rem;
    }

    .summary-photos img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 0.5rem;
        border: 2px solid #dee2e6;
    }

    /* Buttons */
    .btn-wizard-primary {
        background: linear-gradient(135deg, #0047AB, #00D4FF);
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-wizard-primary:hover {
        color: #fff;
        box-shadow: 0 4px 12px rgba(0,71,171,0.3);
        transform: translateY(-1px);
    }

    .btn-wizard-primary:disabled {
        opacity: 0.65;
        transform: none;
        box-shadow: none;
    }

    .btn-wizard-outline {
        border: 2px solid #dee2e6;
        color: #6c757d;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        background: #fff;
        transition: all 0.3s ease;
    }

    .btn-wizard-outline:hover {
        border-color: #adb5bd;
        color: #333;
    }

    .step-title {
        font-weight: 700;
        font-size: 1.15rem;
        margin-bottom: 1.25rem;
        color: #0047AB;
    }

    .validation-error {
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: none;
    }

    .validation-error.visible {
        display: block;
    }

    .form-control.is-invalid-custom,
    .form-control:invalid:not(:placeholder-shown) {
        border-color: #dc3545;
    }

    @@media (max-width: 576px) {
        .wizard-container { margin: 1rem; }
        .wizard-header { padding: 1.5rem 1rem 1rem; }
        .wizard-body { padding: 1.5rem 1rem; }
        .stepper-line { width: 30px; }
        .stepper-circle { width: 32px; height: 32px; font-size: 0.8rem; }
    }
</style>
}

<div class="wizard-container">
    <!-- Header -->
    <div class="wizard-header">
        <i class="bi bi-truck fs-1 mb-2 d-block"></i>
        <h2>Registro de Motorizado</h2>
        <p>Completa tu solicitud para empezar a entregar pedidos</p>

        <!-- Stepper -->
        <div class="stepper">
            <div class="stepper-step">
                <div class="stepper-circle active" id="stepCircle1">1</div>
            </div>
            <div class="stepper-line" id="stepLine1"></div>
            <div class="stepper-step">
                <div class="stepper-circle" id="stepCircle2">2</div>
            </div>
            <div class="stepper-line" id="stepLine2"></div>
            <div class="stepper-step">
                <div class="stepper-circle" id="stepCircle3">3</div>
            </div>
            <div class="stepper-line" id="stepLine3"></div>
            <div class="stepper-step">
                <div class="stepper-circle" id="stepCircle4">4</div>
            </div>
        </div>
    </div>

    <!-- Body -->
    <div class="wizard-body">

        <!-- Step 1: Datos Personales -->
        <div class="step-content active" id="step1">
            <div class="step-title"><i class="bi bi-person-fill me-2"></i>Datos Personales</div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="mNombre" placeholder="Tu nombre" required>
                    <div class="validation-error" id="errNombre">El nombre es obligatorio</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Apellido <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="mApellido" placeholder="Tu apellido" required>
                    <div class="validation-error" id="errApellido">El apellido es obligatorio</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="mEmail" placeholder="correo@ejemplo.com" required>
                    <div class="validation-error" id="errEmail">Ingresa un email válido</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="mPassword" placeholder="Mínimo 6 caracteres" required minlength="6">
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('mPassword', this)"><i class="bi bi-eye"></i></button>
                    </div>
                    <div class="validation-error" id="errPassword">Mínimo 6 caracteres</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Confirmar Contraseña <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="mPasswordConfirm" placeholder="Repite la contraseña" required>
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('mPasswordConfirm', this)"><i class="bi bi-eye"></i></button>
                    </div>
                    <div class="validation-error" id="errPasswordConfirm">Las contraseñas no coinciden</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Teléfono <span class="text-danger">*</span></label>
                    <input type="tel" class="form-control" id="mTelefono" placeholder="09XXXXXXXX" maxlength="10" required>
                    <div class="validation-error" id="errTelefono">Ingresa un teléfono válido (10 dígitos)</div>
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold">Cédula <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="mCedula" placeholder="10 dígitos" maxlength="10" required>
                    <div class="validation-error" id="errCedula">Ingresa una cédula válida (10 dígitos)</div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button class="btn btn-wizard-primary" onclick="nextStep()">
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Step 2: Vehículo -->
        <div class="step-content" id="step2">
            <div class="step-title"><i class="bi bi-truck me-2"></i>Tipo de Vehículo</div>

            <div class="row g-3 mb-3">
                <div class="col-4">
                    <div class="vehicle-card" onclick="selectVehicle('bicicleta', this)" id="cardBicicleta">
                        <span class="vehicle-icon"><i class="bi bi-bicycle"></i></span>
                        <span class="vehicle-label">Bicicleta</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="vehicle-card" onclick="selectVehicle('moto', this)" id="cardMoto">
                        <span class="vehicle-icon" style="font-size: 2.2rem;">&#127949;</span>
                        <span class="vehicle-label">Moto</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="vehicle-card" onclick="selectVehicle('auto', this)" id="cardAuto">
                        <span class="vehicle-icon"><i class="bi bi-car-front"></i></span>
                        <span class="vehicle-label">Auto</span>
                    </div>
                </div>
            </div>
            <div class="validation-error" id="errVehicle">Selecciona un tipo de vehículo</div>

            <div class="mb-3" id="placaGroup" style="display: none;">
                <label class="form-label fw-semibold">Placa del Vehículo</label>
                <input type="text" class="form-control" id="mPlaca" placeholder="Ej: ABC-1234" style="text-transform: uppercase;">
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-wizard-outline" onclick="prevStep()">
                    <i class="bi bi-arrow-left me-1"></i> Anterior
                </button>
                <button class="btn btn-wizard-primary" onclick="nextStep()">
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Step 3: Fotos de Verificación -->
        <div class="step-content" id="step3">
            <div class="step-title"><i class="bi bi-camera-fill me-2"></i>Fotos de Verificación</div>
            <p class="text-muted small mb-3">Las fotos deben ser claras y legibles. Máximo 5MB por imagen.</p>

            <div class="row g-3">
                <!-- Cédula Frontal -->
                <div class="col-sm-6">
                    <div class="photo-upload" id="uploadCedulaFrontal">
                        <i class="bi bi-card-heading upload-icon"></i>
                        <span class="upload-label">Cédula (Frontal)</span>
                        <img class="photo-preview" id="previewCedulaFrontal" alt="Preview">
                        <input type="file" accept="image/*" capture="environment" onchange="handlePhoto(this, 'previewCedulaFrontal', 'uploadCedulaFrontal', 'fotoCedulaFrontal')">
                    </div>
                    <div class="validation-error" id="errFotoCedulaFrontal">Esta foto es obligatoria</div>
                </div>
                <!-- Cédula Trasera -->
                <div class="col-sm-6">
                    <div class="photo-upload" id="uploadCedulaTrasera">
                        <i class="bi bi-card-heading upload-icon"></i>
                        <span class="upload-label">Cédula (Trasera)</span>
                        <img class="photo-preview" id="previewCedulaTrasera" alt="Preview">
                        <input type="file" accept="image/*" capture="environment" onchange="handlePhoto(this, 'previewCedulaTrasera', 'uploadCedulaTrasera', 'fotoCedulaTrasera')">
                    </div>
                    <div class="validation-error" id="errFotoCedulaTrasera">Esta foto es obligatoria</div>
                </div>
                <!-- Licencia (solo Moto/Auto) -->
                <div class="col-sm-6 photo-motorized" style="display: none;">
                    <div class="photo-upload" id="uploadLicencia">
                        <i class="bi bi-card-text upload-icon"></i>
                        <span class="upload-label">Licencia de Conducir</span>
                        <img class="photo-preview" id="previewLicencia" alt="Preview">
                        <input type="file" accept="image/*" capture="environment" onchange="handlePhoto(this, 'previewLicencia', 'uploadLicencia', 'fotoLicencia')">
                    </div>
                    <div class="validation-error" id="errFotoLicencia">Esta foto es obligatoria</div>
                </div>
                <!-- Selfie -->
                <div class="col-sm-6">
                    <div class="photo-upload" id="uploadSelfie">
                        <i class="bi bi-person-bounding-box upload-icon"></i>
                        <span class="upload-label">Selfie</span>
                        <img class="photo-preview" id="previewSelfie" alt="Preview">
                        <input type="file" accept="image/*" capture="user" onchange="handlePhoto(this, 'previewSelfie', 'uploadSelfie', 'fotoSelfie')">
                    </div>
                    <div class="validation-error" id="errFotoSelfie">Esta foto es obligatoria</div>
                </div>
                <!-- Foto Vehículo (solo Moto/Auto) -->
                <div class="col-sm-6 photo-motorized" style="display: none;">
                    <div class="photo-upload" id="uploadVehiculo">
                        <i class="bi bi-truck upload-icon"></i>
                        <span class="upload-label">Foto del Vehículo</span>
                        <img class="photo-preview" id="previewVehiculo" alt="Preview">
                        <input type="file" accept="image/*" capture="environment" onchange="handlePhoto(this, 'previewVehiculo', 'uploadVehiculo', 'fotoVehiculo')">
                    </div>
                    <div class="validation-error" id="errFotoVehiculo">Esta foto es obligatoria</div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-wizard-outline" onclick="prevStep()">
                    <i class="bi bi-arrow-left me-1"></i> Anterior
                </button>
                <button class="btn btn-wizard-primary" onclick="nextStep()">
                    Siguiente <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- Step 4: Revisar y Enviar -->
        <div class="step-content" id="step4">
            <div class="step-title"><i class="bi bi-check-circle-fill me-2"></i>Revisar y Enviar</div>

            <div class="card border-0 bg-light rounded-3 p-3 mb-3">
                <div class="summary-item">
                    <span class="summary-label">Nombre</span>
                    <span class="summary-value" id="sumNombre">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Apellido</span>
                    <span class="summary-value" id="sumApellido">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Email</span>
                    <span class="summary-value" id="sumEmail">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Teléfono</span>
                    <span class="summary-value" id="sumTelefono">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Cédula</span>
                    <span class="summary-value" id="sumCedula">-</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Vehículo</span>
                    <span class="summary-value" id="sumVehiculo">-</span>
                </div>
                <div class="summary-item" id="sumPlacaRow" style="display: none;">
                    <span class="summary-label">Placa</span>
                    <span class="summary-value" id="sumPlaca">-</span>
                </div>
            </div>

            <div class="mb-3">
                <p class="fw-semibold mb-2">Fotos adjuntas:</p>
                <div class="summary-photos" id="summaryPhotos">
                    <!-- Filled by JS -->
                </div>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="mTerminos">
                <label class="form-check-label" for="mTerminos">
                    Acepto los <a href="#" class="text-decoration-none" style="color: #0047AB;">términos y condiciones</a> del servicio de delivery
                </label>
                <div class="validation-error" id="errTerminos">Debes aceptar los términos y condiciones</div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-wizard-outline" onclick="prevStep()">
                    <i class="bi bi-arrow-left me-1"></i> Anterior
                </button>
                <button class="btn btn-wizard-primary w-100 ms-3" id="submitBtn" onclick="submitMotorizado()">
                    <i class="bi bi-send-fill me-2"></i>Enviar Solicitud
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
(function() {
    'use strict';

    let currentStep = 1;
    let selectedVehicle = '';
    const photoData = {
        fotoCedulaFrontal: null,
        fotoCedulaTrasera: null,
        fotoLicencia: null,
        fotoSelfie: null,
        fotoVehiculo: null
    };

    // Toggle password visibility
    window.togglePassword = function(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    };

    // Stepper update
    function updateStepper() {
        for (let i = 1; i <= 4; i++) {
            const circle = document.getElementById('stepCircle' + i);
            circle.classList.remove('active', 'completed');
            if (i < currentStep) {
                circle.classList.add('completed');
                circle.innerHTML = '<i class="bi bi-check-lg"></i>';
            } else if (i === currentStep) {
                circle.classList.add('active');
                circle.textContent = i;
            } else {
                circle.textContent = i;
            }
        }
        for (let i = 1; i <= 3; i++) {
            const line = document.getElementById('stepLine' + i);
            line.classList.toggle('active', i < currentStep);
        }
    }

    // Show step
    function showStep(step) {
        document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
        document.getElementById('step' + step).classList.add('active');
        currentStep = step;
        updateStepper();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Helpers
    function val(id) { return document.getElementById(id).value.trim(); }
    function showErr(id) { document.getElementById(id).classList.add('visible'); }
    function hideErr(id) { document.getElementById(id).classList.remove('visible'); }
    function hideAllErrors() { document.querySelectorAll('.validation-error').forEach(el => el.classList.remove('visible')); }

    // Validate step
    function validateStep(step) {
        hideAllErrors();
        let valid = true;

        if (step === 1) {
            if (!val('mNombre')) { showErr('errNombre'); valid = false; }
            if (!val('mApellido')) { showErr('errApellido'); valid = false; }
            const email = val('mEmail');
            if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) { showErr('errEmail'); valid = false; }
            if (val('mPassword').length < 6) { showErr('errPassword'); valid = false; }
            if (val('mPassword') !== val('mPasswordConfirm')) { showErr('errPasswordConfirm'); valid = false; }
            if (!/^\d{10}$/.test(val('mTelefono'))) { showErr('errTelefono'); valid = false; }
            if (!/^\d{10}$/.test(val('mCedula'))) { showErr('errCedula'); valid = false; }
        }

        if (step === 2) {
            if (!selectedVehicle) { showErr('errVehicle'); valid = false; }
        }

        if (step === 3) {
            if (!photoData.fotoCedulaFrontal) { showErr('errFotoCedulaFrontal'); valid = false; }
            if (!photoData.fotoCedulaTrasera) { showErr('errFotoCedulaTrasera'); valid = false; }
            if (!photoData.fotoSelfie) { showErr('errFotoSelfie'); valid = false; }
            if (selectedVehicle === 'moto' || selectedVehicle === 'auto') {
                if (!photoData.fotoLicencia) { showErr('errFotoLicencia'); valid = false; }
                if (!photoData.fotoVehiculo) { showErr('errFotoVehiculo'); valid = false; }
            }
        }

        if (step === 4) {
            if (!document.getElementById('mTerminos').checked) { showErr('errTerminos'); valid = false; }
        }

        return valid;
    }

    // Step navigation
    window.nextStep = function() {
        if (!validateStep(currentStep)) return;
        if (currentStep === 3) populateSummary();
        if (currentStep < 4) showStep(currentStep + 1);
    };

    window.prevStep = function() {
        if (currentStep > 1) showStep(currentStep - 1);
    };

    // Vehicle selection
    window.selectVehicle = function(type, card) {
        selectedVehicle = type;
        document.querySelectorAll('.vehicle-card').forEach(c => c.classList.remove('selected'));
        card.classList.add('selected');
        hideErr('errVehicle');

        const showMotorized = (type === 'moto' || type === 'auto');
        document.getElementById('placaGroup').style.display = showMotorized ? 'block' : 'none';
        document.querySelectorAll('.photo-motorized').forEach(el => {
            el.style.display = showMotorized ? '' : 'none';
        });
    };

    // Photo handling
    window.handlePhoto = function(input, previewId, uploadId, dataKey) {
        const file = input.files[0];
        if (!file) return;

        if (file.size > 5 * 1024 * 1024) {
            alert('El archivo es demasiado grande. Máximo 5MB.');
            input.value = '';
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            const preview = document.getElementById(previewId);
            preview.src = e.target.result;
            preview.classList.add('visible');
            document.getElementById(uploadId).classList.add('has-photo');
            photoData[dataKey] = e.target.result;
        };
        reader.readAsDataURL(file);
    };

    // Populate summary
    function populateSummary() {
        document.getElementById('sumNombre').textContent = val('mNombre');
        document.getElementById('sumApellido').textContent = val('mApellido');
        document.getElementById('sumEmail').textContent = val('mEmail');
        document.getElementById('sumTelefono').textContent = val('mTelefono');
        document.getElementById('sumCedula').textContent = val('mCedula');

        const vehicleLabels = { bicicleta: 'Bicicleta', moto: 'Moto', auto: 'Auto' };
        document.getElementById('sumVehiculo').textContent = vehicleLabels[selectedVehicle] || '-';

        const placa = val('mPlaca');
        const placaRow = document.getElementById('sumPlacaRow');
        if (placa && (selectedVehicle === 'moto' || selectedVehicle === 'auto')) {
            placaRow.style.display = '';
            document.getElementById('sumPlaca').textContent = placa.toUpperCase();
        } else {
            placaRow.style.display = 'none';
        }

        // Photos grid
        const photosContainer = document.getElementById('summaryPhotos');
        photosContainer.innerHTML = '';
        const photoLabels = {
            fotoCedulaFrontal: 'Cédula Frontal',
            fotoCedulaTrasera: 'Cédula Trasera',
            fotoLicencia: 'Licencia',
            fotoSelfie: 'Selfie',
            fotoVehiculo: 'Vehículo'
        };
        for (const [key, label] of Object.entries(photoLabels)) {
            if (photoData[key]) {
                const wrapper = document.createElement('div');
                wrapper.className = 'text-center';
                wrapper.innerHTML = '<img src="' + photoData[key] + '" alt="' + label + '" title="' + label + '">'
                    + '<div class="small text-muted mt-1">' + label + '</div>';
                photosContainer.appendChild(wrapper);
            }
        }
    }

    // Submit — send as FormData (multipart/form-data) for IFormFile support
    window.submitMotorizado = async function() {
        if (!validateStep(4)) return;

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';

        // Build FormData with PascalCase field names matching [FromForm] params
        const fd = new FormData();
        fd.append('Nombre', val('mNombre'));
        fd.append('Apellido', val('mApellido'));
        fd.append('Email', val('mEmail'));
        fd.append('Password', val('mPassword'));
        fd.append('Telefono', val('mTelefono'));
        fd.append('Cedula', val('mCedula'));
        fd.append('TipoVehiculo', selectedVehicle);
        fd.append('Placa', val('mPlaca').toUpperCase());

        // Append actual File objects from the file inputs (NOT base64)
        const fileInput = (containerId) => document.getElementById(containerId).querySelector('input[type="file"]');
        const cedulaFrontal = fileInput('uploadCedulaFrontal').files[0];
        const cedulaTrasera = fileInput('uploadCedulaTrasera').files[0];
        const licencia = fileInput('uploadLicencia').files[0];
        const selfie = fileInput('uploadSelfie').files[0];
        const vehiculo = fileInput('uploadVehiculo').files[0];

        if (cedulaFrontal) fd.append('FotoCedulaFrontal', cedulaFrontal);
        if (cedulaTrasera) fd.append('FotoCedulaTrasera', cedulaTrasera);
        if (licencia) fd.append('FotoLicencia', licencia);
        if (selfie) fd.append('FotoSelfie', selfie);
        if (vehiculo) fd.append('FotoVehiculo', vehiculo);

        try {
            // Do NOT set Content-Type — browser auto-sets multipart/form-data with boundary
            const res = await fetch('/Delivery/Registro/RegistrarMotorizado', {
                method: 'POST',
                body: fd
            });
            const json = await res.json();
            if (json.success) {
                window.location.href = '/Delivery/Registro/Estado/' + json.solicitudId;
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: json.message || 'Ocurrió un error al enviar la solicitud',
                    confirmButtonColor: '#0047AB'
                });
            }
        } catch (e) {
            Swal.fire({
                icon: 'error',
                title: 'Error de conexión',
                text: 'No se pudo conectar con el servidor. Intenta de nuevo.',
                confirmButtonColor: '#0047AB'
            });
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill me-2"></i>Enviar Solicitud';
        }
    };

})();
</script>
}
