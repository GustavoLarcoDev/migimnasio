@section Styles {
    <style>
        /* ============================== */
        /* UTILITY CLASSES                */
        /* ============================== */
        .py-7 { padding-top: 5rem; padding-bottom: 5rem; }
        .py-6 { padding-top: 4rem; padding-bottom: 4rem; }
        .mb-6 { margin-bottom: 3rem; }

        .backdrop-blur { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

        .bg-light-primary { background-color: rgba(62, 151, 255, 0.1) !important; }
        .bg-light-success { background-color: rgba(80, 205, 137, 0.1) !important; }
        .bg-light-warning { background-color: rgba(255, 199, 0, 0.1) !important; }
        .bg-light-danger  { background-color: rgba(241, 65, 108, 0.1) !important; }
        .bg-light-info    { background-color: rgba(114, 57, 234, 0.1) !important; }

        /* ============================== */
        /* HOVER EFFECTS                  */
        /* ============================== */
        .shadow-hover { transition: transform .2s ease, box-shadow .2s ease; }
        .shadow-hover:hover { transform: translateY(-4px); box-shadow: 0 1rem 2.5rem rgba(0,0,0,.12) !important; }

        .feature-card { transition: transform .25s ease, box-shadow .25s ease; cursor: default; }
        .feature-card:hover { transform: translateY(-6px); box-shadow: 0 1rem 2.5rem rgba(0,0,0,.10) !important; }

        .btn-hover-lift { transition: transform .2s ease, box-shadow .2s ease; }
        .btn-hover-lift:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15) !important; }

        .modelo-card { transition: transform .25s ease, box-shadow .25s ease; }
        .modelo-card:hover { transform: translateY(-4px); box-shadow: 0 1.5rem 3rem rgba(0,0,0,.10) !important; }

        /* ============================== */
        /* HERO                           */
        /* ============================== */
        .hero-gradient {
            background: linear-gradient(135deg, #181C32 0%, #1B2559 40%, #3E97FF 100%);
        }

        .hero-grid-overlay {
            opacity: .2;
            background-image:
                linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
            background-size: 48px 48px;
        }

        .hero-text-gradient {
            background: linear-gradient(90deg, #FFC700, #F97316);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-orb {
            border-radius: 50%;
            filter: blur(80px);
            opacity: .25;
        }
        .hero-orb-1 {
            width: 400px; height: 400px;
            background: #7239EA;
            top: -100px; right: -100px;
        }
        .hero-orb-2 {
            width: 300px; height: 300px;
            background: #3E97FF;
            bottom: 10%; left: -80px;
        }

        /* ============================== */
        /* ANIMATIONS                     */
        /* ============================== */
        .pulse-animation { animation: pulse 2.2s ease-in-out infinite; }
        @@keyframes pulse {
            0%   { transform: scale(1);   box-shadow: 0 0 0 0 rgba(25,135,84,.35); }
            70%  { transform: scale(1.06); box-shadow: 0 0 0 18px rgba(25,135,84,0); }
            100% { transform: scale(1);   box-shadow: 0 0 0 0 rgba(25,135,84,0); }
        }

        .floating-mockup { animation: float 6s ease-in-out infinite; }
        @@keyframes float {
            0%   { transform: rotate(-2deg) translateY(0); }
            50%  { transform: rotate(-2deg) translateY(-14px); }
            100% { transform: rotate(-2deg) translateY(0); }
        }

        /* ============================== */
        /* SHOWCASE TABS                  */
        /* ============================== */
        .showcase-tab { color: #999; border-bottom: 3px solid transparent; border-radius: 0; font-size: 0.9rem; transition: all .2s ease; }
        .showcase-tab.active { color: #3E97FF; border-bottom-color: #3E97FF; background: rgba(62,151,255,0.04); }
        .showcase-tab:hover { color: #3E97FF; }

        .showcase-panel { animation: panelFadeIn 0.35s ease; }
        @@keyframes panelFadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ============================== */
        /* ACTIVITY FEED                  */
        /* ============================== */
        .activity-feed-scroll { overflow: hidden; position: relative; }
        .activity-feed-inner { animation: feedScroll 10s linear infinite; }
        .activity-feed-scroll:hover .activity-feed-inner { animation-play-state: paused; }
        @@keyframes feedScroll {
            0%   { transform: translateY(0); }
            100% { transform: translateY(-50%); }
        }

        /* ============================== */
        /* SCHEDULE ITEMS                 */
        /* ============================== */
        .schedule-item.visible {
            opacity: 1 !important;
            transform: translateX(0) !important;
            transition: opacity 0.5s ease, transform 0.5s ease;
        }

        /* ============================== */
        /* POS PRODUCT ITEMS              */
        /* ============================== */
        .pos-product-item {
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }
        .pos-product-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 12px rgba(249,115,22,0.15);
        }
        .pos-product-item.visible {
            opacity: 1 !important;
            transform: translateY(0) !important;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .pos-receipt {
            background: repeating-linear-gradient(
                180deg,
                #fff 0px,
                #fff 3px,
                transparent 3px,
                transparent 4px
            ) !important;
            background-color: #fff !important;
            border: 1px dashed #ddd !important;
        }

        /* ============================== */
        /* BADGE PULSE                    */
        /* ============================== */
        .badge-pulse { animation: badgePulse 2s ease-in-out infinite; }
        @@keyframes badgePulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }

        /* ============================== */
        /* WHATSAPP BUTTON                */
        /* ============================== */
        #btnWhatsApp:hover { transform: scale(1.12); }

        /* ============================== */
        /* RESPONSIVE                     */
        /* ============================== */
        @@media (max-width: 768px) {
            .py-7 { padding-top: 3.5rem; padding-bottom: 3.5rem; }
            .display-2 { font-size: 2.4rem; }
            .display-5 { font-size: 1.8rem; }
            .hero-orb { display: none; }
        }
    </style>
}

@section Scripts {
    <!-- AOS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <script>
    (function () {
        // ============================
        // AOS INIT
        // ============================
        if (window.AOS) {
            AOS.init({ duration: 750, once: true, offset: 80 });
        }

        // ============================
        // BACK TO TOP
        // ============================
        var btnTop = document.getElementById('btnTop');
        function toggleTop() {
            if (!btnTop) return;
            if (window.scrollY > 500) btnTop.classList.remove('d-none');
            else btnTop.classList.add('d-none');
        }
        window.addEventListener('scroll', toggleTop);
        toggleTop();
        if (btnTop) {
            btnTop.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }

        // ============================
        // DASHBOARD SHOWCASE
        // ============================
        (function () {
            var showcase = document.getElementById('dashboardShowcase');
            if (!showcase) return;

            // Tab switching
            var tabs = showcase.querySelectorAll('.showcase-tab');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    tabs.forEach(function (t) { t.classList.remove('active'); });
                    tab.classList.add('active');
                    var targetId = tab.getAttribute('data-target');
                    showcase.querySelectorAll('.showcase-panel').forEach(function (p) {
                        p.style.display = 'none';
                        p.classList.remove('active');
                    });
                    var target = document.getElementById(targetId);
                    if (target) {
                        target.style.display = '';
                        target.classList.add('active');
                        animatePanel(target);
                    }
                });
            });

            // Counter animation with requestAnimationFrame + easeOutCubic
            function animateCounters(container) {
                var counters = container.querySelectorAll('.counter');
                counters.forEach(function (el) {
                    var target = parseInt(el.getAttribute('data-target'), 10);
                    if (isNaN(target)) return;
                    el.textContent = '0';
                    var duration = 1500;
                    var startTime = null;
                    function step(ts) {
                        if (!startTime) startTime = ts;
                        var progress = Math.min((ts - startTime) / duration, 1);
                        var eased = 1 - Math.pow(1 - progress, 3);
                        el.textContent = Math.round(eased * target).toLocaleString();
                        if (progress < 1) requestAnimationFrame(step);
                    }
                    requestAnimationFrame(step);
                });
            }

            // Bar chart animation
            function animateBars(container) {
                container.querySelectorAll('.bar-income, .bar-expense').forEach(function (bar) {
                    var h = bar.getAttribute('data-height');
                    if (h) {
                        bar.style.height = '0px';
                        setTimeout(function() { bar.style.height = h + 'px'; }, 50);
                    }
                });
            }

            // Schedule items stagger animation
            function animateSchedule(container) {
                var items = container.querySelectorAll('.schedule-item');
                items.forEach(function (item, i) {
                    item.classList.remove('visible');
                    setTimeout(function () { item.classList.add('visible'); }, 200 * (i + 1));
                });
            }

            // POS product items stagger animation
            function animatePosItems(container) {
                var items = container.querySelectorAll('.pos-product-item');
                items.forEach(function (item, i) {
                    item.classList.remove('visible');
                    setTimeout(function () { item.classList.add('visible'); }, 120 * (i + 1));
                });
            }

            function animatePanel(panel) {
                animateCounters(panel);
                animateBars(panel);
                animateSchedule(panel);
                animatePosItems(panel);
            }

            // IntersectionObserver to trigger animations when visible
            var animated = false;
            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting && !animated) {
                            animated = true;
                            var activePanel = showcase.querySelector('.showcase-panel.active');
                            if (activePanel) animatePanel(activePanel);
                        }
                    });
                }, { threshold: 0.25 });
                observer.observe(showcase);
            } else {
                var activePanel = showcase.querySelector('.showcase-panel.active');
                if (activePanel) animatePanel(activePanel);
            }
        })();

        // ============================
        // SOCIAL PROOF COUNTERS
        // ============================
        (function () {
            var section = document.getElementById('socialProofSection');
            if (!section) return;

            var socialAnimated = false;

            function animateSocialCounters() {
                var counters = section.querySelectorAll('.social-counter');
                counters.forEach(function (el) {
                    var target = parseInt(el.getAttribute('data-target'), 10);
                    if (isNaN(target)) return;
                    el.textContent = '0';
                    var duration = 2000;
                    var startTime = null;
                    function step(ts) {
                        if (!startTime) startTime = ts;
                        var progress = Math.min((ts - startTime) / duration, 1);
                        var eased = 1 - Math.pow(1 - progress, 3);
                        var val = Math.round(eased * target);
                        el.textContent = val.toLocaleString();
                        if (progress < 1) requestAnimationFrame(step);
                    }
                    requestAnimationFrame(step);
                });
            }

            if ('IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting && !socialAnimated) {
                            socialAnimated = true;
                            animateSocialCounters();
                        }
                    });
                }, { threshold: 0.3 });
                observer.observe(section);
            } else {
                animateSocialCounters();
            }
        })();

        // ============================
        // LEAD FORM FETCH SUBMIT
        // ============================
        var form = document.getElementById('leadForm');
        if (!form) return;

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            try {
                var formData = new FormData(form);
                var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : null;

                var res = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: token ? { 'RequestVerificationToken': token } : {}
                });

                if (!res.ok) throw new Error('Bad response');

                var toastEl = document.getElementById('leadToast');
                if (toastEl && window.bootstrap) new bootstrap.Toast(toastEl).show();
                form.reset();
            } catch (err) {
                var toastErrEl = document.getElementById('leadToastError');
                if (toastErrEl && window.bootstrap) new bootstrap.Toast(toastErrEl).show();
            }
        });
    })();
    </script>
}
